#include <macros.h>

// Quest names in macros, so the quest helpers, the gate and any check use the same text.
// The quest helpers mark a quest "<name> Ongoing", then "<name> Complete", in pc.quests.
#define QUEST_LAMP          "Steward's Lamp"
#define QUEST_LAMP_COMPLETE "Steward's Lamp Complete"

%zone example
title "Example Keep@Mainland"
lifespan 20
reset RESET_ANYHOW
creators {"papi"}
notes "A small example: a hall, a storeroom and a locked vault; a steward with a quest, a
guard who lets only those who did it pass, and their gear."

%dil

// The zone's own templates. Units run them with dilcopy (no @zone needed in this zone).

// When a player says one of the words, the unit answers them by name.
dilbegin answer(words : stringlist, reply : string);
var
   pc : unitptr;
   said : string;
   i : integer;
code
{
   // Asleep or fighting: ignore it. With skip, those events are lost, not queued.
   on_activation((self.position <= POSITION_SLEEPING) or
                 (self.position == POSITION_FIGHTING), skip);

:start:
   wait(SFB_CMD, command("say") and (activator.type == UNIT_ST_PC));

   // activator and argument describe this event only, and an unsecured unitptr is null
   // after the next wake. Keep what's needed before waiting again.
   pc := activator;
   said := argument;
   secure(pc, start);   // if pc leaves before the answer, go back to waiting
   pause;               // let the player's words appear first

   i := 0;
   while (i < length(words))
   {
      if (words.[i] in said)
      {
         exec("say " + pc.name + ", " + reply, self);
         break;
      }
      i := i + 1;
   }
   unsecure(pc);
   goto start;
}
dilend

// Blocks a way for players who haven't done a quest. fnpri(FN_PRI_BLOCK) runs it before the
// unit's other programs, and block stops the command.
dilbegin fnpri(FN_PRI_BLOCK) vault_gate(dir : string, quest : string, refusal : string);
code
{
:start:
   wait(SFB_CMD, command(dir) and (activator.type == UNIT_ST_PC));

   if (not (quest in activator.quests))
   {
      exec(refusal, self);
      block;
   }
   goto start;
}
dilend

%rooms

hall
title "The Great Hall"
names {"great hall", "hall"}
descr "A long hall with a stone floor. A heavy oak door leads north, a
storeroom lies to the west, and the town lies to the east."
movement SECT_INSIDE
flags {UNIT_FL_INDOORS, UNIT_FL_NO_WEATHER}
ALWAYS_LIGHT
extra {"floor", "stone floor"}
"The stones are worn smooth by many feet."
north to vault open {EX_OPEN_CLOSE, EX_CLOSED, EX_LOCKED}
   key vault_key keyword {"oak door", "door"}
   descr "A heavy oak door blocks the way north.";
west to storeroom;
east to temple@udgaard;
end

storeroom
title "A Storeroom"
descr "Shelves of old crates and sacks line the walls."
movement SECT_INSIDE
flags {UNIT_FL_INDOORS, UNIT_FL_NO_WEATHER}
ALWAYS_LIGHT
east to hall;
end

vault
title "The Vault"
descr "A small stone vault."
movement SECT_INSIDE
flags {UNIT_FL_INDOORS, UNIT_FL_NO_WEATHER}
IN_ALWAYS_DARK
south to hall open {EX_OPEN_CLOSE, EX_CLOSED, EX_LOCKED}
   key vault_key keyword {"oak door", "door"};
end

%objects

vault_key
names {"iron key", "key"}
title "an iron key"
descr "An iron key lies here."
type ITEM_KEY
manipulate {MANIPULATE_TAKE, MANIPULATE_HOLD}
weight 1
end

short_sword
names {"short sword", "sword"}
title "a short sword"
descr "A short sword lies here."
manipulate {MANIPULATE_TAKE, MANIPULATE_WIELD}
WEAPON_DEF(WPN_SHORT_SWORD, BONUS_GOOD, BONUS_AVERAGE)
weight 5
cost 2 SILVER_PIECE, 4 COPPER_PIECE
rent 10 IRON_PIECE
extra {}
"A plain but well balanced iron blade."
// Extras whose name starts with $ aren't shown by look; this one is what identify shows.
extra {"$identify"}
"The keep's smith made this blade for its guards."
// From another zone, with a string list built from macros (values.h): only members of
// these guilds can use it; 0 damage, 25% chance, default message.
dilcopy guild_restrict@function({GUILD_UDG_FIGHTER, GUILD_PALADIN}, 0, 25, "");
end

leather_cap
names {"leather cap", "cap"}
title "a leather cap"
descr "A leather cap lies here."
ARMOUR_LEATHER(BONUS_AVERAGE, BONUS_AVERAGE)
manipulate {MANIPULATE_TAKE, MANIPULATE_WEAR_HEAD}
weight 1
cost 8 COPPER_PIECE
end

sack
names {"canvas sack", "sack"}
title "a canvas sack"
descr "A canvas sack lies here."
manipulate {MANIPULATE_TAKE, MANIPULATE_ENTER}
CONTAINER_DEF(30)
open {EX_OPEN_CLOSE, EX_CLOSED}
weight 1
cost 3 COPPER_PIECE
end

oil_lamp
names {"oil lamp", "lamp"}
title "an oil lamp"
descr "An oil lamp stands here."
manipulate {MANIPULATE_TAKE, MANIPULATE_HOLD}
LIGHT_DEF(24, 1)
weight 2
cost 5 COPPER_PIECE
end

// The quest's reward. NOSAVE: it's gone when the player quits.
keep_badge
names {"steward's badge", "badge"}
title "a steward's badge"
descr "A small copper badge lies here."
manipulate {MANIPULATE_TAKE, MANIPULATE_HOLD}
flags {UNIT_FL_NOSAVE}
weight 1
end

%mobiles

guard
names {"keep guard", "guard"}
title "a keep guard"
descr "A keep guard stands here, watching the door."
extra {}
"He looks bored."
M_HUMAN_WARRIOR_SWORD(5, SEX_MALE)
alignment 200
money 3 COPPER_PIECE
// The zone's own templates, with a string and with a string list.
dilcopy vault_gate("north", QUEST_LAMP_COMPLETE,
                   "say Only those who have helped the steward go north.");
dilcopy answer({"vault", "key"}, "the key stays on my belt, and the vault stays shut.");
end

steward
names {"steward"}
title "the steward"
descr "The steward of the keep stands here, counting crates."
M_AVG_HUMAN(4, SEX_FEMALE)
alignment 300
// A whole quest from quests.zon. In these string lists $1n is the player, $3n the steward.
// The quest is offered when a player does something in the room; nod or say yes accepts.
dilcopy qstSimpleQuest@quests(QUEST_LAMP,
         {"say Oh, it's so dark in here.",
          "say Would you fetch me the oil lamp from the storeroom?"},
         {"say Thank you, $1n."},
         "The steward of the Example Keep wants the oil lamp from the storeroom.",
         {"say Now I can see my crates. Take this badge, and the guard will let you pass."},
         100, 2 * COPPER_MULT, {"keep_badge@example"}, "");
// Takes the lamp when it's given. Anything else is given back: with the last line while the
// player is on the quest, otherwise with "won't accept your item".
dilcopy qstItemsWanted@quests(QUEST_LAMP, {"lamp"}, {""},
         {"say Ah, the lamp. Thank you, $1n."},
         "say That's kind, $1n, but it's the oil lamp I need.");
end

%reset

door hall NORTH {EX_OPEN_CLOSE, EX_CLOSED, EX_LOCKED}
door vault SOUTH {EX_OPEN_CLOSE, EX_CLOSED, EX_LOCKED}

load guard into hall local 1
{
   equip short_sword position WEAR_WIELD
   equip leather_cap position WEAR_HEAD
   load vault_key                   // into the guard's inventory
   load rnd0_avg@randomt local 1    // random treasure of the lowest grade (randomt.zon)
}

load steward into hall local 1
load oil_lamp into storeroom local 1
load sack into vault local 1

%end
