&gt; <a cmd='#'>Help Peaceful</a>
&gt; <a cmd='#'>Help Prompt</a>
&gt; <a cmd='#'>Help Exits</a>
&gt; <a cmd='#'>Help Columns</a>
&gt; <a cmd='#'>Help Rows</a>
&gt; <a cmd='#'>Help Terminal</a>
&gt; <a cmd='#'>Help Telnet</a>
&gt; <a cmd='#'>Help Who</a>
</pre>




</div>