<a cmd='#'>help resize</a>, <a cmd='#'>help scan</a>, <a cmd='#'>help scroll use</a>, <a cmd='#'>help search</a>, <a cmd='#'>help shelter</a>,
<a cmd='#'>help shield</a>, <a cmd='#'>help shoot</a>, <a cmd='#'>help skin</a>, slam, <a cmd='#'>help slip</a>, <a cmd='#'>help sneak</a>,
<a cmd='#'>help soothe</a>, <a cmd='#'>help stalk</a>, <a cmd='#'>help stealing</a>, <a cmd='#'>help swimming</a>, <a cmd='#'>help taunt</a>,
