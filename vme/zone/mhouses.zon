#include <macros.h>
#include <housing.h>

// Midgaard's houses and townhouses: Penny Lane (its plots open off penny_lane1/2@midgaard),
// Beech Row off Park Road and Chestnut Close off Royal Avenue. The rooms only; the DIL and
// the architect are in housing.zon. Every house has a back room and an upper floor: a house
// opens the back room, a townhouse both.

%zone mhouses
title "Midgaard houses@Mainland"
lifespan 60
reset RESET_NOT
creators {"papi"}
notes "Player houses in Midgaard (see housing.zon), sold by the architect in Midgaard's Town Hall."

%rooms

#define HOUSE_DOOR descr "A polished oak door leads into a house."

                                 beech1

title "Beech Row"
descr
"   A row of handsome houses leads east from Park Road, shaded by tall
beeches. Between the houses you glimpse the green of the city park. The row
goes on to the east, and Park Road is to the west."
movement SECT_CITY
gmap(609,749)
west to park_rd1@midgaard;
east to beech2;
north to plot5 HOUSE_DOOR;
south to plot6 HOUSE_DOOR;
dilcopy house_gate@housing();
ALWAYS_LIGHT
end

                                 beech2

title "The end of Beech Row"
descr
"   Beech Row ends at a house with a carved oak door, facing back down the
row toward Park Road. More houses stand to the north and south, under the
beeches."
movement SECT_CITY
gmap(630,749)
west to beech1;
north to plot7 HOUSE_DOOR;
south to plot8 HOUSE_DOOR;
east to plot9 HOUSE_DOOR;
dilcopy house_gate@housing();
ALWAYS_LIGHT
end

                                 chestnut1

title "Chestnut Close"
descr
"   A quiet close of fine houses leads west from Royal Avenue, under the
spreading branches of old chestnut trees. Each house stands behind a polished
door. The close goes on to the west, and Royal Avenue is to the east."
movement SECT_CITY
gmap(459,721)
east to royal_av4@midgaard;
west to chestnut2;
north to plot10 HOUSE_DOOR;
south to plot11 HOUSE_DOOR;
dilcopy house_gate@housing();
ALWAYS_LIGHT
end

                                 chestnut2

title "The end of Chestnut Close"
descr
"   Chestnut Close ends at a tall house that faces down the close toward
Royal Avenue, between the doors of its neighbours to the north and south.
The flagstones are swept clean."
movement SECT_CITY
gmap(438,721)
east to chestnut1;
north to plot12 HOUSE_DOOR;
south to plot13 HOUSE_DOOR;
west to plot14 HOUSE_DOOR;
dilcopy house_gate@housing();
ALWAYS_LIGHT
end

// A house's front room, its title TITLE, on the street named by its word KEY (the first word of
// its name, for the architect); WHERE says where its door is (the architect tells the buyer).
#define MHOUSE_FRONT(TITLE, KEY, WHERE) \
title TITLE \
extra {HOUSE_STREET} KEY \
descr \
"   A fine front room with oak-panelled walls and a polished floor. Tall \
windows look out on the street, and a stone fireplace fills one wall. A \
narrow flight of stairs leads up." \
extra {HOUSE_WHERE} WHERE \
flags {UNIT_FL_NO_WEATHER, UNIT_FL_INDOORS, UNIT_FL_NO_TELEPORT, UNIT_FL_NO_MOB} \
movement SECT_INSIDE \
hit HOUSE_HP \
dilcopy house_room@housing(); \
ALWAYS_LIGHT

#define MHOUSE_BACKROOM \
title "The back room" \
descr \
"   A quiet room at the back of the house, with a window onto a small walled \
garden." \
extra {HOUSE_BACK} "" \
flags {UNIT_FL_NO_WEATHER, UNIT_FL_INDOORS, UNIT_FL_NO_TELEPORT, UNIT_FL_NO_MOB} \
movement SECT_INSIDE \
ALWAYS_LIGHT

#define MHOUSE_UPPER \
title "The upper floor" \
descr \
"   A bright room under the roof beams, at the top of a narrow flight of \
stairs. Its window looks out over the rooftops of Midgaard." \
extra {HOUSE_UPPER} "" \
flags {UNIT_FL_NO_WEATHER, UNIT_FL_INDOORS, UNIT_FL_NO_TELEPORT, UNIT_FL_NO_MOB} \
movement SECT_INSIDE \
ALWAYS_LIGHT

                                 plot1
MHOUSE_FRONT("A house on Penny Lane", "penny", "on Penny Lane in Midgaard, between Royal Avenue and the city park: the north door nearer the avenue")
gmap(509,828)
south to penny_lane1@midgaard;
north to plot1b;
up to plot1u;
end

                                 plot1b
MHOUSE_BACKROOM
south to plot1;
end

                                 plot1u
MHOUSE_UPPER
down to plot1;
end

