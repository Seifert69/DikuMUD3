/* 2021 Helpers for quests */

%zone quests

#include <macros.h>

lifespan 60
reset RESET_ANYHOW
creators {"Papi"}

notes
"Helper function for building quests"

%dil

// ============ GENERIC prereqfunc() helper functions ===============

// HasQuest() returns (1) if the character has the specified quest string, otherwith (0)
// quest string is in the string s.
//
dilbegin integer hasQuest(u : unitptr, i : integer, s : string);
code
{
   if (s in u.quests)
      return (1);
   else
      return (0);
}
dilend

// NotQuest() returns (1) if the character does NOT have the quest string s, otherwise (0).
// For quests that mustn't be offered again once a later quest is done, e.g.
// "AllOf@quests 0 hasQuest@quests 0 Guard Quest Complete && NotQuest@quests 0 Settler Complete"
//
dilbegin integer NotQuest(u : unitptr, i : integer, s : string);
code
{
   if (s in u.quests)
      return (0);
   else
      return (1);
}
dilend

// NotInGuid() returns (1) if the character in NOT in the specified guild, otherwith (0)
// quest string is in the string s. E.g. "notinguild@quests 0 "+GUILD_UDG_FIGHTER
//
dilbegin integer NotInGuild(u : unitptr, i : integer, s : string);
external 
   integer IsInGuild@guilds(pc : unitptr, sGuild : string);
var
   exd : extraptr;
code
{
   if (not IsInGuild@guilds(u, s))
      return (1);
   else
      return (0);
}
dilend

// MinLevel() / MaxLevel() return (1) if the character's level is at least / at most i.
// MinVLevel() / MaxVLevel() do the same with the virtual level (pc.vlevel).
// E.g. "MinLevel@quests 30"
//
dilbegin integer MinLevel(u : unitptr, i : integer, s : string);
code
{
   return (u.level >= i);
}
dilend

dilbegin integer MaxLevel(u : unitptr, i : integer, s : string);
code
{
   return (u.level <= i);
}
dilend

dilbegin integer MinVLevel(u : unitptr, i : integer, s : string);
code
{
   return (u.vlevel >= i);
}
dilend

dilbegin integer MaxVLevel(u : unitptr, i : integer, s : string);
code
{
   return (u.vlevel <= i);
}
dilend

// InGuild() returns (1) if the character is in the guild s. E.g. "InGuild@quests 0 "+GUILD_UDG_FIGHTER
//
dilbegin integer InGuild(u : unitptr, i : integer, s : string);
external
   integer IsInGuild@guilds(pc : unitptr, sGuild : string);
code
{
   if (IsInGuild@guilds(u, s))
      return (1);
   return (0);
}
dilend

// AllOf() returns (1) if every check in s holds, AnyOf() if at least one does. The checks are
// prereqfuncs separated by " && ", e.g.
//    "AllOf@quests 0 MinLevel@quests 30 && hasQuest@quests 0 Reputation Finished"
//    "AnyOf@quests 0 hasQuest@quests 0 Piers Mission Ongoing && hasQuest@quests 0 Steven Mission Ongoing"
//
dilbegin integer AllOf(u : unitptr, i : integer, s : string);
var
   sl : stringlist;
   t : string;
   f : string;
   n : integer;
code
{
   sl := split(s, " && ");
   n := 0;
   while (n < length(sl))
   {
      t := sl.[n];
      f := getword(t);
      i := atoi(getword(t));
      if (dilcall(f)(u, i, t) == 0)
         return (0);
      n := n + 1;
   }
   return (1);
}
dilend

dilbegin integer AnyOf(u : unitptr, i : integer, s : string);
var
   sl : stringlist;
   t : string;
   f : string;
   n : integer;
code
{
   sl := split(s, " && ");
   n := 0;
   while (n < length(sl))
   {
      t := sl.[n];
      f := getword(t);
      i := atoi(getword(t));
      if (dilcall(f)(u, i, t))
         return (1);
      n := n + 1;
   }
   return (0);
}
dilend


// ============ Quest names
//
// A quest name (qname) is either a base name, e.g. "Mary's Pot", which gives the flags
// "Mary's Pot Ongoing" and "Mary's Pot Complete", or three parts "Title|Ongoing flag|Complete flag",
// e.g. "Reputation|Reputation Continues|Reputation Finished", for a quest whose flags have other
// names that players already carry or other code reads.
//
dilbegin string qstTitle(qname : string);
var
   sl : stringlist;
code
{
   sl := split(qname, "|");
   return (sl.[0]);
}
dilend

dilbegin string qstOngoing(qname : string);
var
   sl : stringlist;
code
{
   sl := split(qname, "|");
   if (length(sl) == 3)
      return (sl.[1]);
   return (qname + " Ongoing");
}
dilend

dilbegin string qstComplete(qname : string);
var
   sl : stringlist;
code
{
   sl := split(qname, "|");
   if (length(sl) == 3)
      return (sl.[2]);
   return (qname + " Complete");
}
dilend


// ============ GENERIC qstItemsWait() Helper function

// For getting a decapitated head:
//
// You'll want to pass on s as the sym-name of the head, e.g. "mob@zone"
// i is not used (but needed for the dilcall function because I'm too lazy to make it dynamic)
//
dilbegin integer decapCheck(u : unitptr, i : integer, s : string);
var
   exd : extraptr;
code
{
   exd := "$living_sym" in u.extra;

   if (exd)
      if (exd.descr == s)
         return (1);

   return(0);
}
dilend




// For receiving money:
//
// You'll want to pass on i which is the amount of money and
// s which is the money type. These will be compared against
// 'power' (built-in) and argument
//
dilbegin integer moneycheck(u : unitptr, i : integer, s : string);
code
{
   if (power < i)
   {
      // exec("say That's too little.", self);
      return(0);
   }

   if (power > i)
   {
      // exec("say That's too much.", self);
      return(0);
   }

   if (s != argument)
   {
      // exec("say That's not the right kind of money.", self);
      return(0);
   }

   return(1);
}
dilend


// For checking how much fluid is left:
//
// You'll want to pass on i which is the amount of fluid to 
// at least be in the container
//
dilbegin integer fluidcheck(u : unitptr, i : integer, s : string);
code
{
   if (u.objecttype != ITEM_DRINKCON)
   {
      exec("say That's not a drink container.", self);
      return(0);
   }

   if (u.value[0]< i)
   {
      exec("say There's not enough liquid inside.", self);
      return(0);
   }

   return(1);
}
dilend


dilbegin integer boatcheck(u : unitptr, i : integer, s : string);
code
{
   if (u.objecttype != ITEM_BOAT)
   {
      exec("say That's not a boat.", self);
      return(0);
   }

   return(1);
}
dilend




// ===========================================================


// The default function to check if player accepts quest
//
// Return 1 if quest accepted, 0 if quest rejected
// 

dilbegin integer default_accept(pc : unitptr, ip : integer, s : string);
external
   integer qstBusyGive@quests(arg : string);

var
   i : integer;
   t : string;
   w : string;
code
{
   if (pc == null)
      return (0);

   i := 0;
   secure(pc, lostpc);
   interrupt(SFB_CMD, command("give"), busygive);

:loop:
   //log("Waiting for quest accept command.");
   //log(pc.name);
   // Now wait for an acceptance
	wait(SFB_CMD, activator == pc);
   //log("Got a command.");
   //log(pc.name);

   i := i + 1;

	if (command("nod"))
   {
      return (1);
   }
	else if (command("shake"))
   {
		return (0);
   }
   else if (command("say"))
   {
      // w, not s: s is the line repeated below, and overwriting it made the NPC run the
      // player's first word as a command
      t := argument;
      w := getword(t);
      if ((left(w,3)=="yes") or (left(w,3)=="yup") or (left(w,3)=="aye") or (left(w,3)=="yez") or ((left(w,3)=="yea")) or (w=="y"))
         return (1);

      if ((left(w,2)=="no") or (w=="n"))
         return (0);
   }

   if ((i == 2) or (i == 5))
   {
      t := sact(s, A_SOMEONE, pc, null, self, TO_CHAR);
      exec(t, self);
   }

   if (i > 7)
   {
      return (0);
   }

   goto loop;

   :lostpc:
   return(0);

:busygive:
   if (qstBusyGive@quests(argument))
      block;
   goto loop;
}
dilend


// ========== EXPLAINER - GENERIC REALLY NICE ============

//Explain() is the atomic form of Explainer.
//
// Executes the msg, also interprets :: codes for acts(). See Explainer()
//    returns 0 if not done.
//    returns 1 if successful
// 'self' is the mob explaining (arg3, i.e. $3n)
// 'arg1' is the involved character ($1n)
// 'arg2' is optional, e.g. an object ($2n)
//
// :: commands::
//    ::$3n pats you on the head.::$3n pats $1n on the head.::
//    ::walkto::sym@name::
//  
dilbegin integer Explain(arg1 : unitptr, arg2 : unitptr, msg : string);
external 
   integer walk_room@function(room : string, spd : integer);
var
   tsl : stringlist;
code
{
   if ((self.position <= POSITION_SLEEPING) or (self.position == POSITION_FIGHTING))
      return (0);

   if ((msg.[0] == ":") and (msg.[1] == ":"))
   {
      tsl := split(msg, "::");
      if (length(tsl) == 3)
      {
         if (tsl.[1] == "walkto")
         {
            walk_room@function(tsl.[2], 5);
         }
         else
         {
            act(tsl.[1], A_SOMEONE, arg1, arg2, self, TO_CHAR);
            act(tsl.[2], A_SOMEONE, arg1, arg2, self, TO_REST);
         }
      }
      else
      {
         log("Found act code :: in Explain() but not the two expected strings = " + msg);
         return (0);
      }
   }
   else
   {
      exec(sact(msg, A_SOMEONE, arg1, arg2, self, TO_CHAR), self);
   }
   return (1);
}
dilend



// expl:
//   list of strings for the NPC to execute to explain the quest.
//   You can use $ variables, e.g. $1n = self (npc), $3 = player. Strings formatted with "TO_CHAR", "SOMEONE"
//   You can use a special code "::string1::string2" to send an act(string1, pc, null, npc, TO_CHAR) and act(string2, pc, null, npc, TO_REST)
//
// Example:
//   {"say $1n, do you want this quest?", "jump", "hug $1n", 
//    "say <a cmd='"'>nod</a> if you wish to accept",
//    "::$3n hands you an empty barrel and a crumpled map.::$3n hands an empty barrel and a crumpled map to $1n.",
//    "::walkto::temple@udgaard"}
//
dilbegin Explainer(pc : unitptr, sl : stringlist);
external
   integer qstBusyGive@quests(arg : string);
   integer Explain@quests(arg1 : unitptr, arg2 : unitptr, msg : string);

var
   i : integer;
   ln : integer;
   hb : integer;
code
{
   on_activation((self.position <= POSITION_SLEEPING) or (self.position == POSITION_FIGHTING), skip);
   on_activation((pc.position <= POSITION_SLEEPING) or (pc.position == POSITION_FIGHTING), skip);

   secure(pc, lostpc);
   i := 0;
   ln := length(sl);

   hb := heartbeat;
	heartbeat := 1;

   interrupt(SFB_CMD, command("give"), busygive);

   // Give the explanation
   while (i < ln)
   {
:between:
      pause;
      Explain@quests(pc, null, sl.[i]);
   	heartbeat := PULSE_SEC * 3;
      i := i + 1;
   }

:lostpc:
   heartbeat := hb;
   return;

:busygive:
   if (qstBusyGive@quests(argument))
      block;
   goto between;
}
dilend


//Action() is the atomic form of DailyRoutine.
//
// Executes the msg, also interprets :: codes for acts(). See Explainer()
// Additionally:
//    "::descr::$1n is merrily skipping along."  changes the outside description.
//    "::walkto::temple@udgaard"     walks there, 5 seconds per room;
//    "::walkto::temple@udgaard::9"  9 seconds per room.
//    "::linkto::temple@udgaard"     moves straight there, for places with no exit leading there
//                                   (no messages: add an act pair before and after).
//    "::wait::30"                   waits 30 seconds.
//    "::ready::"                    gets the NPC on its feet: wakes it if asleep, stands it up if
//                                   resting or sitting, a step per heartbeat, and tries again
//                                   (magic sleep, a fight, stunned) up to 10 times before giving up.
//    "::call::myfunc@myzone 0 text" calls integer myfunc(u : unitptr, i : integer, s : string)
//                                   with the NPC, 0 and "text": for whatever the list can't do,
//                                   e.g. loading an item or checking that someone is here.
//                                   A pause in myfunc clears unitptr variables that aren't
//                                   secured, u included: after one, use self.
//    returns 0 if not done (a walk that didn't get there, a call that returned 0, a bad code).
//    returns 1 if successful
// 'self' is the mob unit (arg3, i.e. $1n)
// 'arg2' is a string ($2t) which is passed to all act() as string argument 2.
// 'arg3' is a unit ($3n)
//
dilbegin integer Action(msg : string, arg2 : string, arg3 : unitptr);
external 
   integer walk_room@function(room : string, spd : integer);
var
   tsl : stringlist;
   s : string;
   t : string;
   i : integer;
   u : unitptr;
code
{
   if ((msg.[0] == ":") and (msg.[1] == ":"))
   {
      tsl := split(msg, "::");
      if ((length(tsl) >= 2) and (tsl.[1] == "ready"))
      {
         i := 0;
         while (self.position != POSITION_STANDING)
         {
            i := i + 1;
            if (i > 10)
               return (0);
            if (self.position == POSITION_SLEEPING)
               exec("wake", self);
            else if ((self.position == POSITION_RESTING) or (self.position == POSITION_SITTING))
               exec("stand", self);
            if (self.position != POSITION_STANDING)
               pause;
         }
      }
      else if ((length(tsl) == 4) and (tsl.[1] == "walkto"))
      {
         s := sact(tsl.[2], A_ALWAYS, self, arg2, arg3, TO_CHAR);
         i := walk_room@function(s, atoi(tsl.[3]));
         return (i);
      }
      else if (length(tsl) == 3)
      {
         if (tsl.[1] == "walkto")
         {
            s := sact(tsl.[2], A_ALWAYS, self, arg2, arg3, TO_CHAR);
            // log("walkto room = " + s);
            i := walk_room@function(s, 5);
            return (i);
         }
         else if (tsl.[1] == "descr")
         {
            s := sact(tsl.[2], A_ALWAYS, self, arg2, arg3, TO_CHAR);
            // log("outside descr = " + s);
            self.outside_descr := s;
         }
         else if (tsl.[1] == "linkto")
         {
            s := sact(tsl.[2], A_ALWAYS, self, arg2, arg3, TO_CHAR);
            u := findroom(s);
            if (u == null)
            {
               log("Action() linkto: no room " + s);
               return (0);
            }
            link(self, u);
         }
         else if (tsl.[1] == "wait")
         {
            heartbeat := atoi(tsl.[2]) * PULSE_SEC;
            pause;
         }
         else if (tsl.[1] == "call")
         {
            s := tsl.[2];
            t := getword(s);       // the function
            i := atoi(getword(s)); // the integer; the rest of s is the string
            i := dilcall(t)(self, i, s);
            return (i);
         }
         else
         {
            act(tsl.[1], A_SOMEONE, self, arg2, arg3, TO_CHAR);
            act(tsl.[2], A_SOMEONE, self, arg2, arg3, TO_REST);
         }
      }
      else
      {
         log("Found act code :: in Action() but not the expected strings = " + msg);
         return (0);
      }
   }
   else
   {
      // A_ALWAYS: sact to a sleeping NPC is otherwise empty, and "snore" after "sleep" vanishes
      exec(sact(msg, A_ALWAYS, self, arg2, arg3, TO_CHAR), self);
   }  
   return (1);
}
dilend



// Same as Explainer() except it is a daily routine and doesn't pause on "sleeping", etc.
// A step that fails (see Action) ends the list: the NPC doesn't eat at a table it never reached.
//
dilbegin DailyRoutine(sl : stringlist, sarg2 : string);
external
   integer Action@quests(msg : string, arg2 : string, arg3 : unitptr);

var
   i : integer;
   ln : integer;
   phb : integer;
code
{
   on_activation((self.position < POSITION_SLEEPING) or (self.position == POSITION_FIGHTING), skip);

   i := 0;
   ln := length(sl);

   phb := heartbeat;
   if (phb < 3*PULSE_SEC)
      phb := 3*PULSE_SEC;
	heartbeat := 1;

   // Do the chores
   while (i < ln)
   {
      pause;
      if (Action@quests(sl.[i], sarg2, null) == 0)
         break;
   	heartbeat := phb;
      i := i + 1;
   }

   heartbeat := phb;
   return;
}
dilend


// 1 if the mud hour is in [from, until); the hours wrap, so 20 to 6 is the night.
//
dilbegin integer inHours(from : integer, until : integer);
code
{
   if (from < until)
      return ((mudhour >= from) and (mudhour < until));
   return ((mudhour >= from) or (mudhour < until));
}
dilend


// An NPC's whole day: dilcopy DailySchedule@quests(...) onto the NPC, or call it last in its DIL.
//
// sched : time blocks, each a header line followed by its steps (the steps of Action()):
//    "@13"           the steps run once when 13 o'clock comes (the hour 13 to 14)
//    "@0-6"          the steps run once at the start of 0 to 6 (or when the NPC is loaded then)
//    "@6-13 repeat"  the steps run over and over from 6 until 13. Between steps the NPC checks
//                    the time, so a long round of work never makes it miss 13 o'clock.
//    Hours wrap: "@20-6" is the night. When several blocks cover the hour, one of them is
//    picked at random. A step that fails (a walk that didn't get there) ends its block.
// sarg2 : $2t in the steps
// pace  : seconds between steps (at least 3)
//
// e.g. dilcopy DailySchedule@quests({
//         "@5", "wake", "::walkto::$2t", "::descr::$1n is guarding the gate.",
//         "@18", "::walkto::grunting_inn@midgaard", "buy beer", "drink beer",
//                "::walkto::guard_dorm@midgaard", "sleep",
//         "@18", "::walkto::park_cafe@midgaard", "buy coffee", "drink coffee",
//                "::walkto::guard_dorm@midgaard", "sleep"},
//         "in_ngate@midgaard", 5);
//
dilbegin DailySchedule(sched : stringlist, sarg2 : string, pace : integer);
external
   integer Action@quests(msg : string, arg2 : string, arg3 : unitptr);
   integer inHours@quests(from : integer, until : integer);

var
   hdr : intlist;     // index in sched of each block's header
   froms : intlist;
   untils : intlist;
   reps : intlist;    // 1 for a repeat block
   tsl : stringlist;
   s : string;
   i : integer;
   j : integer;
   n : integer;
   b : integer;
   ln : integer;
   nb : integer;
   phb : integer;
   donefrom : integer;
   doneuntil : integer;
code
{
   on_activation((self.position < POSITION_SLEEPING) or (self.position == POSITION_FIGHTING), skip);

   phb := pace * PULSE_SEC;
   if (phb < 3*PULSE_SEC)
      phb := 3*PULSE_SEC;

   // Read the block headers
   ln := length(sched);
   i := 0;
   while (i < ln)
   {
      s := sched.[i];
      if (s.[0] == "@")
      {
         tsl := split(s, " ");
         n := 0;
         if (length(tsl) > 1)
            if (tsl.[1] == "repeat")
               n := 1;
         s := right(tsl.[0], length(tsl.[0]) - 1);
         tsl := split(s, "-");
         j := atoi(tsl.[0]);
         insert(hdr, length(hdr), i);
         insert(froms, length(froms), j);
         if (length(tsl) > 1)
            insert(untils, length(untils), atoi(tsl.[1]));
         else
            insert(untils, length(untils), j + 1);
         insert(reps, length(reps), n);
      }
      else if (length(hdr) == 0)
         log(self.symname + " DailySchedule: step before the first @hour header: " + s);
      i := i + 1;
   }
   nb := length(hdr);
   donefrom := -1;
   doneuntil := -1;

:start:
   heartbeat := phb;
   pause;

   // A block that runs once has run: wait until its hours are over
   if (donefrom >= 0)
   {
      if (inHours@quests(donefrom, doneuntil))
         goto start;
      donefrom := -1;
   }

   // Pick one of the blocks that cover this hour
   n := 0;
   i := 0;
   while (i < nb)
   {
      if (inHours@quests(froms.[i], untils.[i]))
         n := n + 1;
      i := i + 1;
   }
   if (n == 0)
      goto start;

   n := rnd(1, n);
   b := 0;
   i := 0;
   while (i < nb)
   {
      if (inHours@quests(froms.[i], untils.[i]))
      {
         n := n - 1;
         if (n == 0)
         {
            b := i;
            break;
         }
      }
      i := i + 1;
   }

   // Run its steps
   i := hdr.[b] + 1;
   if (b + 1 < nb)
      ln := hdr.[b + 1];
   else
      ln := length(sched);

   while (i < ln)
   {
      if (Action@quests(sched.[i], sarg2, null) == 0)
         break;
      i := i + 1;
      if (i < ln)
      {
         if (reps.[b])
            if (not inHours@quests(froms.[b], untils.[b]))
               break;
         heartbeat := phb;
         pause;
      }
   }

   if (not reps.[b])
   {
      donefrom := froms.[b];
      doneuntil := untils.[b];
   }
   goto start;
}
dilend


// ===========================================================


// Try to see if "pc" is willing to take on this quest
//
// qName :
//    The base name of the quest. E.g. "Mary's Pot". 
//    The system will append " Ongoing" and " Complete" as needed.
//    Or "Title|Ongoing flag|Complete flag" to use other flag names (see qstTitle).
//
// pc :
//    The player that is the target of this quest request
//
// sl:
//     List of Explainer strings for the NPC to execute to explain the quest.
//     See Explainer() (You can use $ variables, :: commands, etc)
//     The very last string is normally a "nod to accept..." and will be repeated.
//     e.g. {"say $1n, do you want this quest?", "jump", "hug $1n", "say <a cmd='"'>nod</a> if you wish to accept"}
//
// acptfunc:
//     Optional. if blank uses default acceptance function, otherwise write your own. Copy default_accept@quests
//     and make your own code. Use the name of your function in acptfunc, e.g. "myfunc@myzone".
//
// prereqfunc:
//     Optional. If set, the dilfunc() to call to check if the quest is to be given or not. 
//     If nothing given, then no check will be performed.
//     Example: "hasquest@quests 0 Boldin Rogue Ongoing"
//
// Return unitptr to the hero that wants the quest
//
dilbegin unitptr qstWaitHero(qname : string, pc : unitptr, sl : stringlist, acptfunc : string, prereqfunc : string);
external
   integer default_accept@quests(pc : unitptr, ip : integer, s : string);
   Explainer@quests(pc : unitptr, sl : stringlist);
   string qstOngoing@quests(qname : string);
   string qstComplete@quests(qname : string);
var
   i : integer;
   hb : integer;
   ln : integer;
   s : string;
   t : string;
code
{
   on_activation((self.position <= POSITION_SLEEPING) or (self.position == POSITION_FIGHTING), skip);
   on_activation((pc.position <= POSITION_SLEEPING) or (pc.position == POSITION_FIGHTING), skip);

   if ((qstOngoing@quests(qname) in pc.quests) or (qstComplete@quests(qname) in pc.quests))
   {
      pc := null;
      return(pc);
   }

   if (prereqfunc != "")
   {
      s := getword(prereqfunc);       // Get the function
      t := getword(prereqfunc);       // Get the function
      i := atoi(getword(t)); // get the integer
      i := dilcall(s)(pc, i, prereqfunc);
      if (i == 0)
      {
         pc := null;
         return(pc);
      }
   }


   hb := heartbeat;

   // Only deal with visible creatures
   if (not visible(self, pc))
   {
   	heartbeat := PULSE_SEC * 1;
      pause;
      exec("peer", self);
      // log("odd peer in qstWaitHero()");
      pc := null;
   	heartbeat := hb;
      return(pc);
   }

   secure(pc, lostpc);

   priority;

   // Give the explanation
   Explainer(pc, sl);

   if (pc == null)
      goto lostpc;

   if (acptfunc == "")
      acptfunc := "default_accept@quests";

   ln := length(sl);
   i := dilcall(acptfunc)(pc, 0, sl.[ln-1]);

   nopriority;

   if (i == 0)
      goto no_quest;

   return(pc);

:no_quest:
   heartbeat := PULSE_SEC * 1;
   pause;
	exec("sulk", self);
	unsecure(pc);
   pc := null;
   heartbeat := hb;
	return(pc);

:lostpc:
   nopriority;
   heartbeat := PULSE_SEC * 1;
   pause;
	exec("sigh", self);
   pc := null;
   heartbeat := hb;
	return(pc);
}
dilend


// Add quest to pc and set it to "ongoing"
//
dilbegin extraptr qstSetOngoing(qname : string, pc : unitptr, qdescr : string);
external
   string qstTitle@quests(qname : string);
   string qstOngoing@quests(qname : string);
var
   s : string;
   sl : stringlist;
   exd : extraptr;
code
{
   s := qstOngoing@quests(qname);
   addstring(sl, s);
   addextra(pc.quests, sl, qdescr);
   exd := s in pc.quests;
   sendtext("<div class='cpy'>New Quest: " + qstTitle@quests(qname) +"</div><br/>", pc);
   return (exd);
}
dilend


// Mark the pc's ongoing quest as 'done' (e.g. all items received)
//
dilbegin extraptr qstSetDone(qname : string, pc : unitptr);
external
   string qstOngoing@quests(qname : string);
var
   exdp : extraptr;
code
{
   exdp := qstOngoing@quests(qname) in pc.quests;

   if (not ("$done" in exdp.names))
      addstring(exdp.names, "$done");

   return(exdp);
}
dilend




// pc : The player that is the target of this explanation
// expl: list of strings for the NPC to execute to explain the quest.
//       YOu can use $ variables, e.g. $1n. $1 = self, $3 = player. Strings formatted with "TO_CHAR", "SOMEONE"
//       You can use a special code "::string1::string2" to send an act(string1, pc, null, npc, TO_CHAR) and act(string2, pc, null, npc, TO_REST)
//       The very last string should be "nod to accept..." as it will be repeated
//   {"say $1n, do you want this quest?", "jump", "hug $1n", "say <a cmd='"'>nod</a> if you wish to accept"}
//
// Return unitptr to the hero that wants the quest
//
dilbegin extraptr qstAssign(qname : string, pc : unitptr, sl : stringlist, qdescr : string);
external
   integer qstBusyGive@quests(arg : string);
   extraptr qstSetOngoing@quests(qname : string, pc : unitptr, qdescr : string);

var
   i : integer;
   ln : integer;
   s : string;
   exd : extraptr;
   tsl : stringlist;
   u : unitptr;

code
{
   on_activation((self.position <= POSITION_SLEEPING) or (self.position == POSITION_FIGHTING), skip);

   heartbeat := PULSE_SEC * 3;
   exd := null;

	secure(pc, lostpc);

   // Only deal with visible creatures
   if (not visible(self, pc))
   {
      exec("peer", self);
      //log("odd peer in qstAssign()");
      return(exd);
   }

   i := 0;
   ln := length(sl);
	pause;
	heartbeat := PULSE_SEC * 3;

   priority;

   interrupt(SFB_CMD, command("give"), busygive);

   // Give the explanation
   while (i < ln)
   {
      if ((sl.[i].[0] == ":") and (sl.[i].[1] == ":"))
      {
         tsl := split(sl.[i], "::");
         if ((length(tsl) == 3) and (tsl.[1] == "give"))
         {
            // "::give::sym@zone": hand the player an item for the quest (a bag, a jar, a map)
            u := load(tsl.[2]);
            if (u == null)
               log("qstAssign " + qname + " unable to load item " + tsl.[2]);
            else
            {
               link(u, pc);
               act("$3n gives you $2n.", A_SOMEONE, pc, u, self, TO_CHAR);
               act("$3n gives $2n to $1n.", A_SOMEONE, pc, u, self, TO_REST);
               pause;
            }
         }
         else if (length(tsl) == 3)
         {
            act(tsl.[1], A_SOMEONE, pc, null, self, TO_CHAR);
            act(tsl.[2], A_SOMEONE, pc, null, self, TO_REST);
            pause;
         }
         else
            log("Found act code :: in qstAssign but not the two expected strings = " + sl.[i]);
      }
      else
      {
         s := sact(sl.[i], A_SOMEONE, pc, null, self, TO_CHAR);
         exec(s, self);
         pause;
      }
:nextline:
      i := i + 1;
   }

   exd := qstSetOngoing@quests(qname, pc, qdescr);

:lostpc:
   nopriority;
   return(exd);

:busygive:
   if (qstBusyGive@quests(argument))
      block;
   goto nextline;
}
dilend


// On the player 'pc' mark the quest 'qname' complete
// Return 1 if marked successfully, 0 otherwise
//
dilbegin integer qstMarkComplete(pc : unitptr, qname : string);
external
   string qstOngoing@quests(qname : string);
var
   exdp : extraptr;
code
{
   exdp := qstOngoing@quests(qname) in pc.quests;

   if (exdp == null)
      return (0);

   if (not ("$done" in exdp.names))
   {
      exdp.descr := exdp.descr + "<br/>Quest objectives completed.";
      addstring(exdp.names, "$done");
      return (1);
   }

   return (0);
}
dilend



// Add this to a quest NPC that's waiting to "get items" from a player.
// The items received will be destroyed, and incorrect items given back.
//
// Parameters:
//   qname: The 'core' name of the quest. E.g. "Stew Quest".
//          Program will react to any PC which has a "Stew Quest Ongoing".
//
//   itemsl: String list of items to accept. Either the symname or a substring. 
//           E.g. {"mushroom", "black_berries@haon_dor", "garlic", "corpse of rabbit"};
//           For non-symnames if any name in the given item matches the substrings in 
//           the list then it's a match. If the name begins with $ it will match ANY name.
//           That's useful to e.g. accept any kind of drink container, and then check
//           validity in the func call (see sventer@gremlin, $anyboat).
//           What is recorded on the Ongoing flag is the entry itself, or, for "match=token",
//           the token: "desh2@hades6=desh" takes the sword and records "desh", so a converted
//           quest reads the progress its old code wrote. An item whose entry is recorded already
//           doesn't match again (it goes to nothanks instead of being eaten).
//   itemfunc:  String list of DIL functions that can validate something special. 
//              Must match the itemsl. Not needed for normal items. Needed e.g. for 
//              money or to check if e.g. a barrel is full of water.
//              Format is: <function> <int> <string> like this:
//              {"", "", "", "corpsecheck@quests 0 a string"}
//
// thanksl : String list of thank you statements / actions, one matching each item above. 
//             {"say Thank you $3n, these are really nice mushrooms.",
//             "say Thank you $3n these are really nice berries.",
//             "say Thank you $3n this is really some nice garlic.",
//             "say Look at all the blood, $3n! Well I thank you anyway."};
//             
// thanksl : $1 = pc, $2 = item, $3 = self
//
dilbegin fnpri(FN_PRI_MISSION+5) integer qstItemsWanted(qname : string, 
                                                     itemsl : stringlist,
                                                     itemfunc : stringlist,
                                                     thanksl : stringlist, nothanks : string);
external
   integer qstMarkComplete@quests(pc : unitptr, qname : string);
   string qstOngoing@quests(qname : string);

var
  qon    : string;
  m      : string;
  tok    : string;
  tsl    : stringlist;
  pc     : unitptr;
  item   : unitptr;
  exdp   : extraptr;
  u      : unitptr;
  i      : integer;
  ln     : integer;
  j      : integer;
  s      : string;
  t      : string;

code
{
   qon := qstOngoing@quests(qname);

   if (length(itemfunc) != length(itemsl))
   {
      log(self.symname + " length of itemsl and itemfunc differs." + itoa(length(itemsl)) + " vs func of " + itoa(length(itemfunc)));
      log(qname + " " + itemsl.[0]);
   }

   // The nothanks line is kept in a hidden extra on self, where qstItemNoThank looks it up.
   // (It used to be sent as a message one tick after the dilcopy, which most copies weren't
   // listening for yet, so players got "won't accept your item" instead.)
   if (nothanks != "")
   {
      tsl := null;
      addstring(tsl, "$nothanks " + qon);
      addextra(self.extra, tsl, nothanks);
      s := "qstItemNoThank@quests()";
      dilcopy(s, self);
   }

   on_activation((self.position <= POSITION_SLEEPING) or (self.position == POSITION_FIGHTING), skip);

   :start:
   wait(SFB_DONE, command("give") and (target == self));

   // log(medium.symname + " : " + medium.name);

   exdp := qon in activator.quests;

   if (not exdp)
      goto start;

   pc := activator;
   item := medium;

   i := 0;
   ln := length(itemsl);

   while (i < ln)
   {
      tsl := split(itemsl.[i], "=");
      m := tsl.[0];
      tok := m;
      if (length(tsl) == 2)
         tok := tsl.[1];

      if (((m == item.symname) or (m in item.names) or (m.[0] == "$")) and (not (tok in exdp.names)))
      {
         if (itemfunc.[i] != "")
         {
            s := itemfunc.[i];
            t := getword(s); // get the function
            j := atoi(getword(s)); // get the integer
            j := dilcall(t)(item, j, s);
            // log("dilcall()()  returned: " + itoa(j));
         }
         else 
            j := 1;
         if (j == 1)
         {
            addstring(exdp.names, tok);
            s := sact(thanksl.[i], A_SOMEONE, pc, item, self, TO_CHAR);
            exec(s, self);
            s := sact("<br/>You've given $3m $2n", A_SOMEONE, pc, item, self, TO_CHAR);
            exdp.descr := exdp.descr + s;
            destroy(item);
            block;  // Important to block here or the NoThanks DIL will trigger too.
            goto checkit;
         }
      }

      i := i + 1;
   }

   // If there is no match, don't give it back. 
   // If item is to be given back then that's a separate function at the end
   //

   goto start;

:checkit:
   // Check if we have all the items
   i := 0;
   ln := length(itemsl);

   while (i < ln)
   {
      tsl := split(itemsl.[i], "=");
      tok := tsl.[0];
      if (length(tsl) == 2)
         tok := tsl.[1];
      if (not (tok in exdp.names))
         goto start;
      i := i + 1;
   }

   if (qstMarkComplete@quests(pc, qname))
   {
      sendto("quest$done " + pc.symname, self);  // Trigger self, to recognize quest completion
   }

   goto start;
}
dilend



// While the NPC talks a player through a quest (offer, acceptance, completion) the library
// runs with priority, which shuts out the NPC's DILs further down the list: qstItemsWanted
// and qstItemNoThank (fnpri MISSION+5/+6) never saw an item given then, when the talking DIL
// came first (e.g. MISSION), and the NPC simply kept it. So each part that talks under
// priority refuses the give command itself, before anything changes hands:
//
//    interrupt(SFB_CMD, command("give"), busygive);
//    ...
// :busygive:
//    if (qstBusyGive@quests(argument))
//       block;
//    goto <where it was>;
//
// The interrupt goes away with its frame, so nothing is left behind when the talk ends or
// breaks off. qstBusyGive returns 1 (and tells the giver) when the give is to self.
//
dilbegin integer qstBusyGive(arg : string);
var
   sl : stringlist;
   u : unitptr;
code
{
   // give <item> <receiver>: the receiver is the last word
   sl := getwords(arg);
   if (length(sl) < 2)
      return (0);
   u := findunit(activator, sl.[length(sl) - 1], FIND_UNIT_SURRO, null);
   if (u != self)
      return (0);

   act("$3n is busy talking and can't take your item right now.", A_SOMEONE, activator, null, self, TO_CHAR);
   return (1);
}
dilend


dilbegin aware unique fnpri(FN_PRI_MISSION+6) qstItemNoThank();
external
   unitptr make_money@baseget(i1 : integer, i2 : integer);

var
   s : string;
   i : integer;
   t : integer;
   u : unitptr;
   exd : extraptr;
code
{
:start:
   wait(SFB_DONE, command("give") and (target == self));

   if (medium.objecttype == ITEM_MONEY)
   {
      // This is tricky because the money is now merged with char's local money

      t := medium.value[0];
      i := medium.cost - power;

      // If the receiving char didn't have any coins of this type, just give the full monty back
      if (i == 0)
      {
         link(medium, activator);
         goto sayit;
      }

      // NPC already had money of this type
      //
      destroy(medium);

      u := make_money@baseget(t, power);
      link(u, activator);

      if (i > 0)
      {
         //log("Creating money for self: " + itoa(i) + " pieces  of type " + itoa(t));
         u := make_money@baseget(t, i);
      }
   }
   else
   {
      // Just link the item back
      link(medium, activator);
   }

:sayit:
   // qstItemsWanted left "$nothanks <ongoing flag>" extras on self, the line in their descr
   exd := self.extra;
   while (exd != null)
   {
      if (length(exd.names) > 0)
         s := exd.names.[0];
      else
         s := "";
      if (left(s, 10) == "$nothanks ")
      {
         s := right(s, length(s) - 10);
         if (s in activator.quests)
            goto sayit2;
      }
      exd := exd.next;
   }
   exec("emote won't accept your item.", self);
   goto start;

:sayit2:
   s := sact(exd.descr, A_SOMEONE, activator, medium, self, TO_CHAR);
   exec(s, self);

   goto start;
}
dilend

// sl stringlist of explanations
//
//
// Waits for the next player a quest giver should check: one who types a command near it, or
// the one named in the "quest$done <player>" message qstItemsWanted sends when the last item
// is handed over (a give is a command too, but it arrives before the item changes hands).
dilbegin unitptr qstWaitPc();
var
   words : stringlist;
   u     : unitptr;
code
{
   :start:
   wait(SFB_MSG|SFB_CMD, TRUE);

   if (command(CMD_AUTO_MSG))
   {
      words := getwords(argument);
      if (length(words) < 2)
         goto start;
      if (words.[0] != "quest$done")
         goto start;
      u := findsymbolic(words.[1]);
      if (u == null)
         goto start;
      return (u);
   }

   u := activator;
   if (u.type != UNIT_ST_PC)
      goto start;
   return (u);
}
dilend


// Gives pc the reward items: each entry in itemsl is a symname, e.g. "ring@ego", or a symname
// and "bound", e.g. "ring@ego bound", for an item only pc can use (ply_restrict, as quest rewards
// have always been). Wearables are sized to fit pc. Called by qstWaitDone and qstOnComplete.
//
dilbegin qstGiveRewards(pc : unitptr, itemsl : stringlist);
var
   u : unitptr;
   i : integer;
   s : string;
   sym : string;
code
{
   i := 0;
   while (i < length(itemsl))
   {
      s := itemsl.[i];
      sym := getword(s);
      if (sym != "")
      {
         u := load(sym);
         if (u == null)
            log("Quest reward: unable to load item " + sym);
         else
         {
            if ((u.manipulate & (MANIPULATE_WEAR_FINGER | MANIPULATE_WEAR_NECK  |
                  MANIPULATE_WEAR_BODY   | MANIPULATE_WEAR_HEAD  |
                  MANIPULATE_WEAR_LEGS   | MANIPULATE_WEAR_FEET  |
                  MANIPULATE_WEAR_HANDS  | MANIPULATE_WEAR_ARMS  |
                  MANIPULATE_WEAR_SHIELD | MANIPULATE_WEAR_ABOUT |
                  MANIPULATE_WEAR_WAIST  | MANIPULATE_WEAR_WRIST |
                  MANIPULATE_WIELD       | MANIPULATE_WEAR_EAR   |
                  MANIPULATE_WEAR_BACK   | MANIPULATE_WEAR_CHEST |
                  MANIPULATE_WEAR_ANKLE)) or (u.objecttype == ITEM_WEAPON))
               u.height := pc.height; // For wearable items, make them fit

            if (s == "bound")
               dilcopy("ply_restrict@function(" + pc.name + ",0,25,quest_act@gnome)", u);

            link(u, pc);
            act("$3n gives you $2n.", A_SOMEONE, pc, u, self, TO_CHAR);
            act("$3n gives $2n to $1n.", A_SOMEONE, pc, u, self, TO_REST);
         }
      }
      i := i + 1;
   }
   return;
}
dilend


dilbegin unitptr qstWaitDone(qname : string, pc : unitptr,
                             sl : stringlist, xp : integer, gold : integer, itemsl : stringlist);
external
   integer qstBusyGive@quests(arg : string);
   string qstOngoing@quests(qname : string);
   string qstComplete@quests(qname : string);
   qstGiveRewards@quests(pc : unitptr, itemsl : stringlist);
   integer Explain@quests(arg1 : unitptr, arg2 : unitptr, msg : string);
var
   qon    : string;
   qdone  : string;
   pcname : string;
   u      : unitptr;
   i      : integer;
   ln     : integer;
   exdp   : extraptr;
   s      : string;

code
{
   on_activation((self.position <= POSITION_SLEEPING) or (self.position == POSITION_FIGHTING), skip);
   u := null;
   qon := qstOngoing@quests(qname);
   qdone := qstComplete@quests(qname);

   :start:
   if (qdone in pc.quests)
     return(u);

   exdp := qon in pc.quests;

   if (not exdp)
      return(u);

   // log("Got ongoing " + qname);

   if (not ("$done" in exdp.names))
      return(u);

   // log("found $done  " + qname);
   // We collected all the items
   secure(pc, lostpc);

   i := 0;
   ln := length(sl);
	heartbeat := PULSE_SEC * 3;
	pause;

   priority;

   interrupt(SFB_CMD, command("give"), busygive);

   // Give the explanation (Explain: "::to player::to room" act pairs work here too)
   while (i < ln)
   {
      Explain@quests(pc, null, sl.[i]);
      pause;
:nextline:
      i := i + 1;
   }

   subextra(pc.quests, qon);
   sl := null;
   addstring(sl, qdone);
   addextra(pc.quests, sl, "");
   if (xp > 0)
   {
      experience(xp, pc);
      sendtext("You earned " + itoa(xp) + " experience.<br/>", pc);
   }
   if (gold > 0)
   {
      i := transfermoney(null, pc, gold);
      sendtext("You received " + moneystring(gold, TRUE) + "<br/>", pc);
   }

   qstGiveRewards@quests(pc, itemsl);

   nopriority;
   return(pc);

   :lostpc:
   nopriority;
   exec("say How rude!", self);
   u := null;
   return(u);

:busygive:
   if (qstBusyGive@quests(argument))
      block;
   goto nextline;
}
dilend

//
// Similar to qstWaitDone but can be applied directly on the npc
// with dilcopy()
//
dilbegin  aware fnpri(FN_PRI_MISSION+8) qstOnComplete(qname : string,
                       sl : stringlist, xp : integer, gold : integer, itemsl : stringlist);
external
   Explainer(pc : unitptr, sl : stringlist);
   string qstOngoing@quests(qname : string);
   string qstComplete@quests(qname : string);
   qstGiveRewards@quests(pc : unitptr, itemsl : stringlist);

var
   qon    : string;
   qdone  : string;
   pc     : unitptr;
   pcname : string;
   u      : unitptr;
   i      : integer;
   ln     : integer;
   exdp   : extraptr;
   words  : stringlist;
   s      : string;

code
{
   on_activation((self.position <= POSITION_SLEEPING) or (self.position == POSITION_FIGHTING), skip);
   u := null;
   qon := qstOngoing@quests(qname);
   qdone := qstComplete@quests(qname);

   :start:
   unsecure(pc);
   wait(SFB_MSG|SFB_CMD, TRUE);

   if (command(CMD_AUTO_MSG)) 
      goto domsg;

   pc := activator;

   if (pc.type != UNIT_ST_PC)
      goto start;
   goto checkit;

:domsg:

   // log("MSG : " + argument);
   
   words := getwords(argument);
   s := words.[0];
   if (s != "quest$done")
      goto start;
   
   pcname := words.[1];

   // log("ARG: " + s);
   // log("PC: " + pcname);

   pc := findsymbolic(pcname); // The player activator

   if (pc == null) {
      // log("PC is null...");
      goto start;
   }

   // log("checking complete stuff..");

:checkit:
   if (qdone in pc.quests) {
     goto start;
   }

   exdp := qon in pc.quests;

   if (not exdp) {
      // log("not exdp");
      goto start;
   }

   if (not ("$done" in exdp.names)) {
      // log("$done not in expd.names");
      goto start;
   }

   // We collected all the items
   secure(pc, lostpc);

   priority;
   Explainer(pc, sl);

   if (pc == null)
   {
      nopriority;
      goto start;
   }

   subextra(pc.quests, qon);
   sl := null;
   addstring(sl, qdone);
   addextra(pc.quests, sl, "");
   if (xp > 0)
   {
      experience(xp, pc);
      sendtext("You earned " + itoa(xp) + " experience.<br/>", pc);
   }
   if (gold > 0)
   {
      i := transfermoney(null, pc, gold);
      sendtext("You received " + moneystring(gold, TRUE) + "<br/>", pc);
   }

   qstGiveRewards@quests(pc, itemsl);

   nopriority;
   goto start;

   :lostpc:
   nopriority;
   exec("say How rude!", self);
   u := null;
   goto start;
}

dilend


// Copy this to an NPC to get an "all in one" quest.
//
// prereqfunc : See qstWaitHero
//
dilbegin fnpri(FN_PRI_MISSION+7)
          qstSimpleQuest(qname : string,
                        qstAsk : stringlist,
                        qstAccepted : stringlist,
                        qstDescr : string,
                        qstDone : stringlist,
                        xp : integer, gold : integer, itemsl : stringlist, prereqfunc : string);
external
   unitptr qstWaitHero@quests(qname : string, pc : unitptr, sl : stringlist, acptfunc : string, prereqfunc : string);
   extraptr qstAssign@quests(qname : string, pc : unitptr, sl : stringlist, qdescr : string);
   unitptr qstWaitDone@quests(qname : string, pc : unitptr,
                             sl : stringlist, xp : integer, gold : integer, itemsl : stringlist);

var
   pc     : unitptr;
   pot    : unitptr;
   exdp   : extraptr;
   s      : string;

code
{
   heartbeat := PULSE_SEC *3;
   
   :start:
   wait(SFB_CMD | SFB_MSG, TRUE);

   // This little code block is optional and a quick hack.
   // When present it ensures that
   // on quest completion ($done) a message is received and the NPC
   // can automatically start giving the reward. 
   //
   // It is very tempting to move the entire qstWaitDone into its own
   // running DIL program on the NPC that only gets triggered via sendto().
   // It would be less messy.
   //
   if (command(CMD_AUTO_MSG)) 
   {
      // log("MSG : " + argument);

      s := getword(argument);

      if (s != "quest$done")
         goto start;
      pc := findsymbolic(argument); // The player activator
      pc := qstWaitDone@quests(qname, pc, qstDone, xp, gold, itemsl);
      goto start;
   }

   if (activator.type != UNIT_ST_PC)
      goto start;

   pc := qstWaitHero@quests(qname, activator, qstAsk, "", prereqfunc);

   if (pc != null)
   {
      exdp := qstAssign@quests(qname, pc, qstAccepted, qstDescr);
      goto start;
   }

   pc := qstWaitDone@quests(qname, activator, qstDone, xp, gold, itemsl);
   goto start;
}
dilend



%mobiles

zombie
names {"zombie"}
title "the zombie"
descr "A mindless zombie is here."

/* Test scripts */
end


%end
