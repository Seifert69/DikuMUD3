#include <macros.h>
#include <housing.h>

// Player houses: what every house lane shares. A lane is a zone of its own (uhouses: Hearth
// Lane in Udgaard; mhouses: Midgaard's streets), with rooms only:
//   - each lane room runs house_gate(): a door from it into a house lets anyone in, unless the
//     owner bought a lock (from the architect) and locked it: then only the owner, those they
//     gave a key (invite) and gods;
//   - each house's front room has the extra HOUSE_WHERE (where its door is, for the architect),
//     `hit HOUSE_HP`, and runs house_room(); a back room, closed in a cottage, has the extra
//     HOUSE_BACK, and an upper floor, open only in a townhouse, HOUSE_UPPER. The front rooms
//     are called plot1, plot2 ... in a row.
// The architect in Midgaard's Town Hall sells the houses and door locks; Calvin the carpenter
// in Midgaard (furniture()) sells beds, chests and chest locks and has them carried in. A
// locked chest opens only for its owner, whether the door is locked or not.
//
// A house's state lives on its front room and in the file <lane zone>.<room> in the DIL file
// directory (uhouses.plot1): the owner, the type, the condition (the room's hit points), who has
// a key and the door lock ("locked", "open", or none), a line each. Each piece of furniture is a file of its own (uhouses.plot1.bed,
// uhouses.plot1.chest1 ...), brought in the first time someone enters after a boot; a chest
// saves itself, with what is in it, after things are put in or taken out.

// The house lanes: Udgaard's Hearth Lane (cottages and houses, with the timber and ore
// discounts) and Midgaard's streets (houses and townhouses, dearer the finer the street).
#define HOUSE_LANES    {"uhouses", "mhouses"}
#define MHOUSE_STREETS {"Penny Lane", "Beech Row", "Chestnut Close"}   // a buyer names one by its first word
#define MHOUSE_PLACES  {"between Royal Avenue and the city park", "off Park Road", "off Royal Avenue"}
#define MHOUSE_PRESTIGE {100, 120, 160}                 // each street's price, in % of the base
#define HOUSE_MINLEVEL 10
#define COTTAGE_PRICE  (5 * PLATINUM_MULT)
#define HOUSE_PRICE    (10 * PLATINUM_MULT)
#define MHOUSE_PRICE   (15 * PLATINUM_MULT)   // a house in Midgaard, on its plainest street
#define TOWNHOUSE_PRICE (25 * PLATINUM_MULT)
#define LOCK_PRICE     (3 * PLATINUM_MULT)
// Building materials (handed in, counted on the player): this many cover HOUSE_DISCOUNT percent
#define LOGS_COTTAGE   10
#define LOGS_HOUSE     20     // a house takes logs and ore
#define ORE_HOUSE      5
#define LOCK_ORE       5
#define HOUSE_DISCOUNT 90
#define TIMBER_QUEST   "Timber for a House"
#define IRON_QUEST     "Iron for a Lock"
#define MATERIAL_XP    1000
#define WORK_XP        51     // experience for a tree felled or ore mined: this minus the level
#define FELL_AGAIN     3600   // seconds before a forest room has trees worth felling again
#define MINE_AGAIN     600    // seconds before a vein gives ore again
#define PICK           "pick@hobgob"   // what Sam sells: the hobgoblin miners' pick
#define PICK_PRICE     (3 * SILVER_MULT)
#define CUT_BY         "$cut by"   // on a log or load of ore: who felled or mined it (or for whom)
#define CUT_AT         "$cut at"   // and the room it was felled or mined in (room@zone)
#define CART_PRICE     (1 * GOLD_MULT)
#define CART_YARD      "col_sq7@midgaard"   // where Calvin's hired carts stand, outside his shop
#define CART_RECALL    "house cart back "   // + a hirer's name: Calvin takes their cart and horse back
#define CART_TIP       "A horse and a cart carry a dozen at once: Calvin the carpenter on " + \
                       "Colosseum Square hires them out."
#define HOUSE_CHESTS   3
#define HOUSE_FRIENDS  10
#define HOUSE_DIRS     {"north", "east", "south", "west", "up", "down", \
                        "northeast", "northwest", "southeast", "southwest"}

%zone housing
title "Housing"
lifespan 30
reset RESET_ANYHOW
creators {"papi"}
notes "Player houses: the DIL, furniture and architect every house lane (uhouses) shares."

%dil

// The file a house's state is kept in: uhouses.plot1
dilbegin string house_file(room : unitptr);
code
{
   return (room.zoneidx + "." + room.nameidx);
}
dilend

// Writes the house's state to its file, or removes the file when nobody owns it.
dilbegin house_save(room : unitptr);
external
   string house_file(room : unitptr);
var
   hfile : string;
   buf : string;
   own : extraptr;
   typ : extraptr;
   frd : extraptr;
   lk : extraptr;
   i : integer;
   err : integer;
code
{
   hfile := house_file(room);
   err := delstr(hfile);   // savestr "w" doesn't shorten the file
   own := HOUSE_OWNER in room.extra;
   if (own == null)
      return;
   typ := HOUSE_TYPE in room.extra;
   buf := own.descr + "\n" + typ.descr + "\n" + itoa(room.hp) + "\n";
   frd := HOUSE_FRIEND in room.extra;
   i := 1;
   while (i < length(frd.names))
   {
      buf := buf + right(frd.names.[i], length(frd.names.[i]) - 1) + " ";
      i := i + 1;
   }
   lk := HOUSE_LOCK in room.extra;
   if (lk != null)
      buf := buf + "\n" + lk.descr;
   err := savestr(hfile, buf + "\n", "w");
   return;
}
dilend

// The front room of the house pname owns, or, with pname "", the first free plot in the lane
// zone (any lane when it is ""), on the street with that word (HOUSE_STREET; any when "").
// Null when there is none.
dilbegin unitptr house_find(pname : string, lane : string, street : string);
var
   lanes : stringlist;
   i : integer;
   n : integer;
   r : unitptr;
   none : unitptr;
   own : extraptr;
   st : extraptr;
code
{
   lanes := HOUSE_LANES;
   i := 0;
   while (i < length(lanes))
   {
      if ((lane == "") or (lane == lanes.[i]))
      {
         n := 1;
         r := findroom("plot1@" + lanes.[i]);
         while (r != null)
         {
            own := HOUSE_OWNER in r.extra;
            st := HOUSE_STREET in r.extra;
            if ((pname == "") and (own == null) and
                ((street == "") or ((st != null) and (st.descr == street))))
               return (r);
            if ((pname != "") and (own != null) and (own.descr == pname))
               return (r);
            n := n + 1;
            r := findroom("plot" + itoa(n) + "@" + lanes.[i]);
         }
      }
      i := i + 1;
   }
   return (none);
}
dilend

// A counter on the player (HOUSE_LOGS, HOUSE_ORE): how many they have handed in.
dilbegin integer house_counter(pc : unitptr, which : string);
var
   ex : extraptr;
code
{
   ex := which in pc.extra;
   if (ex == null)
      return (0);
   return (atoi(ex.descr));
}
dilend

dilbegin house_setcount(pc : unitptr, which : string, n : integer);
var
   sl : stringlist;
code
{
   subextra(pc.extra, which);
   if (n > 0)
   {
      addstring(sl, which);   // {which} takes only constants
      addextra(pc.extra, sl, itoa(n));
   }
   return;
}
dilend

// The price after the materials pc handed in: each of the `need` pieces takes its share of
// HOUSE_DISCOUNT percent off. `have` is how many they have.
dilbegin integer house_cost(price : integer, have : integer, need : integer);
var
   used : integer;
code
{
   used := have;
   if (used > need)
      used := need;
   price := price - (price * HOUSE_DISCOUNT * used) / (100 * need);
   return (((price + GOLD_MULT / 2) / GOLD_MULT) * GOLD_MULT);   // in whole gold pieces
}
dilend

// A price at a street's prestige (pct, in % of the base), in whole gold pieces.
dilbegin integer house_dear(price : integer, pct : integer);
code
{
   price := (price * pct) / 100;
   return (((price + GOLD_MULT / 2) / GOLD_MULT) * GOLD_MULT);
}
dilend

// What pc pays the architect for what ("cottage", "house", "lock"; "mhouse" and "townhouse"
// in Midgaard): the full price less the share the logs and ore they handed in take off. A
// house takes logs and ore alike; Midgaard's houses take none.
dilbegin integer house_price(pc : unitptr, what : string);
external
   integer house_counter(pc : unitptr, which : string);
   integer house_cost(price : integer, have : integer, need : integer);
var
   logs : integer;
   ore : integer;
code
{
   if (what == "mhouse")   // Midgaard's: no discounts (the street's prestige is the architect's)
      return (MHOUSE_PRICE);
   if (what == "townhouse")
      return (TOWNHOUSE_PRICE);
   logs := house_counter(pc, HOUSE_LOGS);
   ore := house_counter(pc, HOUSE_ORE);
   if (what == "cottage")
      return (house_cost(COTTAGE_PRICE, logs, LOGS_COTTAGE));
   if (what == "lock")
      return (house_cost(LOCK_PRICE, ore, LOCK_ORE));
   if (logs > LOGS_HOUSE)
      logs := LOGS_HOUSE;
   if (ore > ORE_HOUSE)
      ore := ORE_HOUSE;
   return (house_cost(HOUSE_PRICE, logs + ore, LOGS_HOUSE + ORE_HOUSE));
}
dilend

// After pc bought what: the logs and ore that took off its price are used up; the rest stay.
dilbegin house_spend(pc : unitptr, what : string);
external
   integer house_counter(pc : unitptr, which : string);
   house_setcount(pc : unitptr, which : string, n : integer);
var
   logs : integer;
   ore : integer;
   n : integer;
code
{
   if ((what == "mhouse") or (what == "townhouse"))
      return;
   logs := 0;
   ore := 0;
   if (what == "cottage")
      logs := LOGS_COTTAGE;
   else if (what == "lock")
      ore := LOCK_ORE;
   else
   {
      logs := LOGS_HOUSE;
      ore := ORE_HOUSE;
   }
   n := house_counter(pc, HOUSE_LOGS) - logs;
   if (n < 0)
      n := 0;
   house_setcount(pc, HOUSE_LOGS, n);
   n := house_counter(pc, HOUSE_ORE) - ore;
   if (n < 0)
      n := 0;
   house_setcount(pc, HOUSE_ORE, n);
   return;
}
dilend

// What the architect would now charge pc, for John (which: HOUSE_LOGS) or Sam (HOUSE_ORE) to
// say; whom is "you" or pc's name.
dilbegin string house_newprice(pc : unitptr, which : string, whom : string);
external
   integer house_price(pc : unitptr, what : string);
code
{
   if (which == HOUSE_LOGS)
      return ("the architect in Midgaard builds " + whom + " a cottage for " +
              moneystring(house_price(pc, "cottage"), TRUE) + ", or a house for " +
              moneystring(house_price(pc, "house"), TRUE));
   return ("the architect in Midgaard fits " + whom + " a lock for " +
           moneystring(house_price(pc, "lock"), TRUE) + ", or builds a house for " +
           moneystring(house_price(pc, "house"), TRUE));
}
dilend

// fell: in a forest, with an axe wielded, fell a tree for a log (one per room per FELL_AGAIN).
// An axe is a hand or battle axe called an axe: cleavers and kopeshes are hand axes too.
dilbegin do_fell(arg : string);
external
   string house_forwho(arg : string, me : string);
   house_workxp(pc : unitptr);
var
   forwho : string;
   room : unitptr;
   w : unitptr;
   u : unitptr;
   ex : extraptr;
   place : string;
   tool : string;
code
{
   forwho := house_forwho(arg, self.name);   // "fell tree for Asta": the credit is Asta's
   if (forwho == "")
   {
      act("There is nobody by that name to do it for.", A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   room := self.outside;
   if (room.type != UNIT_ST_ROOM)
   {
      act("You need solid ground under your feet to fell a tree.", A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   if (room.movement != SECT_FOREST)
   {
      act("There are no trees here worth felling.", A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   w := equipment(self, WEAR_WIELD);
   if ((w == null) or ((w.value[0] != WPN_HAND_AXE) and (w.value[0] != WPN_BATTLE_AXE)) or
       (not ("axe" in w.title)) or ("pick" in w.title))
   {
      act("You need to wield an axe to fell a tree.", A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   ex := "$felled" in room.extra;
   if ((ex != null) and (realtime - atoi(ex.descr) < FELL_AGAIN))
   {
      act("The good trees here have been felled not long ago. Try deeper in the forest.",
          A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   if (self.endurance < 20)
   {
      act("You are too tired to swing an axe.", A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   self.endurance := self.endurance - 20;
   place := room.nameidx + "@" + room.zoneidx;
   tool := w.nameidx + "@" + w.zoneidx;

   heartbeat := PULSE_SEC * 2;
   act("You pick a tall, straight tree and swing $2n at its trunk.", A_ALWAYS, self, w, null, TO_CHAR);
   act("$1n swings $1s $2N at the trunk of a tall tree.", A_HIDEINV, self, w, null, TO_ROOM);
   pause;
   act("Chips fly as you cut deeper into the trunk.", A_ALWAYS, self, null, null, TO_CHAR);
   pause;

   // still at that tree, axe in hand, and nobody felled it meanwhile
   room := self.outside;
   w := equipment(self, WEAR_WIELD);
   ex := "$felled" in room.extra;
   if ((room.nameidx + "@" + room.zoneidx != place) or (w == null) or (w.nameidx + "@" + w.zoneidx != tool) or
       ((ex != null) and (realtime - atoi(ex.descr) < FELL_AGAIN)))
   {
      act("You stop before the tree comes down.", A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   subextra(room.extra, "$felled");
   addextra(room.extra, {"$felled"}, itoa(realtime));
   act("The tree creaks, sways, and crashes to the ground. You trim it into a log.",
       A_ALWAYS, self, null, null, TO_CHAR);
   act("The tree creaks, sways and crashes to the ground. $1n trims it into a log.",
       A_HIDEINV, self, null, null, TO_ROOM);
   u := load("house_log@housing");
   addextra(u.extra, {CUT_BY}, forwho);   // the credit is the feller's (or whom it's for), whoever hands it in
   addextra(u.extra, {CUT_AT}, place);
   link(u, room);
   if (forwho != self.name)
      act("It's for " + forwho + ": whoever hands it to John, it counts for " + forwho + ".",
          A_ALWAYS, self, null, null, TO_CHAR);
   house_workxp(self);
   quit;
}
dilend

// mine: at a vein (a room with ORE_VEIN), with a pick wielded (not an ice pick), mine a load
// of iron ore (one per vein per MINE_AGAIN).
dilbegin do_mine(arg : string);
external
   string house_forwho(arg : string, me : string);
   house_workxp(pc : unitptr);
var
   forwho : string;
   room : unitptr;
   w : unitptr;
   u : unitptr;
   ex : extraptr;
   place : string;
   tool : string;
code
{
   forwho := house_forwho(arg, self.name);   // "fell tree for Asta": the credit is Asta's
   if (forwho == "")
   {
      act("There is nobody by that name to do it for.", A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   room := self.outside;
   if ((room.type != UNIT_ST_ROOM) or (not (ORE_VEIN in room.extra)))
   {
      act("There is no ore to mine here.", A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   w := equipment(self, WEAR_WIELD);
   if ((w == null) or (not ("pick" in w.title)) or ("ice pick" in w.title))
   {
      act("You need to wield a pick to mine.", A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   ex := "$mined" in room.extra;
   if ((ex != null) and (realtime - atoi(ex.descr) < MINE_AGAIN))
   {
      act("The vein has been worked not long ago; the loose ore is gone. Come back later.",
          A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   if (self.endurance < 25)
   {
      act("You are too tired to swing a pick.", A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   self.endurance := self.endurance - 25;
   place := room.nameidx + "@" + room.zoneidx;
   tool := w.nameidx + "@" + w.zoneidx;

   heartbeat := PULSE_SEC * 2;
   act("You swing $2n at the rust-red seam in the rock.", A_ALWAYS, self, w, null, TO_CHAR);
   act("$1n swings $1s $2N at the rock.", A_HIDEINV, self, w, null, TO_ROOM);
   pause;
   act("Sparks fly, and the rock begins to crack.", A_ALWAYS, self, null, null, TO_CHAR);
   pause;

   // still at that vein, pick in hand, and nobody worked it meanwhile
   room := self.outside;
   w := equipment(self, WEAR_WIELD);
   ex := "$mined" in room.extra;
   if ((room.nameidx + "@" + room.zoneidx != place) or (w == null) or (w.nameidx + "@" + w.zoneidx != tool) or
       ((ex != null) and (realtime - atoi(ex.descr) < MINE_AGAIN)))
   {
      act("You stop before the ore breaks loose.", A_ALWAYS, self, null, null, TO_CHAR);
      quit;
   }
   subextra(room.extra, "$mined");
   addextra(room.extra, {"$mined"}, itoa(realtime));
   act("A heavy lump of iron ore breaks loose and thuds to the ground.", A_ALWAYS, self, null, null, TO_CHAR);
   act("A heavy lump of rock breaks loose under $1n's pick.", A_HIDEINV, self, null, null, TO_ROOM);
   u := load("iron_ore@housing");
   addextra(u.extra, {CUT_BY}, forwho);
   addextra(u.extra, {CUT_AT}, place);
   link(u, room);
   if (forwho != self.name)
      act("It's for " + forwho + ": whoever hands it to Sam, it counts for " + forwho + ".",
          A_ALWAYS, self, null, null, TO_CHAR);
   house_workxp(self);
   quit;
}
dilend

// Who a log or ore is cut for: the name after "for" in what was typed ("fell tree for Asta"),
// or the one doing it. "" when that name isn't a player.
dilbegin string house_forwho(arg : string, me : string);
var
   w : string;
   who : string;
code
{
   who := me;
   w := getword(arg);
   while (w != "")
   {
      if (w == "for")
      {
         who := getword(arg);
         who := toupper(left(who, 1)) + tolower(right(who, length(who) - 1));
         if (not isplayer(who))
            return ("");
         break;
      }
      w := getword(arg);
   }
   return (who);
}
dilend

// A little experience for the work, for low levels: WORK_XP minus the level (level 11: 40).
dilbegin house_workxp(pc : unitptr);
var
   xp : integer;
code
{
   xp := WORK_XP - pc.level;
   if (xp > 0)
   {
      experience(xp, pc);
      act("You earned " + itoa(xp) + " experience.", A_ALWAYS, pc, null, null, TO_CHAR);
   }
   return;
}
dilend

// How many of a material, in words: "1 log", "3 logs", "1 load of ore"
dilbegin string house_many(n : integer, one : string, many : string);
code
{
   if (n == 1)
      return ("1 " + one);
   return (itoa(n) + " " + many);
}
dilend

// Who gets the credit for a log or load of ore u: the player who felled or mined it, if in
// the game; for one without a mark, the one handing it in (by). Null when the cutter is away.
dilbegin unitptr house_cutter(u : unitptr, by : unitptr);
var
   ex : extraptr;
   pc : unitptr;
code
{
   ex := CUT_BY in u.extra;
   if (ex == null)
      return (by);
   pc := ghead();   // players come first in the global list
   while ((pc.type == UNIT_ST_PC) and (pc.name != ex.descr))
      pc := pc.gnext;
   if (pc.type != UNIT_ST_PC)
      pc := null;
   return (pc);
}
dilend

// Counts k pieces of a material handed in by pc (which: HOUSE_LOGS, HOUSE_ORE); the first
// solves the quest qname. Returns the new total.
dilbegin integer house_credit(pc : unitptr, which : string, qname : string, k : integer);
external
   integer house_counter(pc : unitptr, which : string);
   house_setcount(pc : unitptr, which : string, n : integer);
   string qstComplete@quests(qname : string);
var
   n : integer;
   qdone : string;
   sl : stringlist;
code
{
   n := house_counter(pc, which) + k;
   house_setcount(pc, which, n);
   qdone := qstComplete@quests(qname);
   if (not (qdone in pc.quests))
   {
      addstring(sl, qdone);
      addextra(pc.quests, sl, "");
      experience(MATERIAL_XP, pc);
      act("<div class='cpw'>Quest complete: " + qname + ".</div> You earned " + itoa(MATERIAL_XP) +
          " experience.", A_ALWAYS, pc, null, null, TO_CHAR);
   }
   return (n);
}
dilend

// On John the Lumberjack (logs) and Sam the blacksmith (ore): takes the material sym, counted
// for the player (which; the first one solves the quest qname). It may be given to him by
// those strong enough to carry it, dragged or dropped at his feet, or brought in a cart:
// `unload cart` hands him all of it from the player's hired cart. Who drags or drops it
// one at a time hears about carts.
dilbegin fnpri(FN_PRI_BLOCK) house_material(sym : string, which : string, qname : string,
                                             one : string, many : string);
external
   string house_many(n : integer, one : string, many : string);
   integer house_credit(pc : unitptr, which : string, qname : string, k : integer);
   unitptr house_cutter(u : unitptr, by : unitptr);
   string house_newprice(pc : unitptr, which : string, whom : string);
var
   who : unitptr;
   item : unitptr;
   away : integer;
   others : integer;
   pc : unitptr;
   u : unitptr;
   nxt : unitptr;
   cart : unitptr;
   hr : extraptr;
   n : integer;
   k : integer;
   s : string;
code
{
:start:
   wait(SFB_DONE | SFB_CMD,
        (command("give") and (target == self) and (medium != null) and
         (medium.nameidx + "@" + medium.zoneidx == sym)) or
        ((command("drop") or command("drag")) and (target != null) and
         (target.outside == self.outside) and (target.nameidx + "@" + target.zoneidx == sym)) or
        (command("unload") and ((activator.outside == self.outside) or
                                (activator.outside.outside == self.outside))));   // or mounted
   if (activator.type != UNIT_ST_PC)
      goto start;   // only players get the count
   pc := activator;

   if (command("unload"))
   {
      // the player's hired cart, here
      cart := null;
      u := self.outside.inside;
      while (u != null)
      {
         hr := "$cart hirer" in u.extra;   // the hired horse has one too
         if ((hr != null) and (hr.descr == pc.name) and (u.nameidx == "house_cart"))
            cart := u;
         u := u.next;
      }
      if (cart == null)
         goto start;
      block;
      k := 0;
      away := 0;
      others := 0;
      u := cart.inside;
      while (u != null)
      {
         nxt := u.next;
         if (u.nameidx + "@" + u.zoneidx == sym)
         {
            who := house_cutter(u, pc);
            if (who == null)
               away := away + 1;   // its cutter isn't in the game: it stays in the cart
            else
            {
               n := house_credit(who, which, qname, 1);
               if (who != pc)
                  others := others + 1;
               destroy(u);
               k := k + 1;
            }
         }
         u := nxt;
      }
      if (k > 0)
      {
         s := house_many(k, one, many);
         act("$1n unloads " + s + " from $2n.", A_ALWAYS, self, cart, null, TO_ROOM);
         if (others == 0)   // all pc's own: n is their total
            exec("say Thank you, " + pc.name + ". That's " + house_many(n, one, many) + " from you: now " +
                 house_newprice(pc, which, "you") + ".", self);
         else
            exec("say Thank you, " + pc.name + ". I've counted each for whoever cut it; the " +
                 "architect in Midgaard takes them off their price.", self);
      }
      else if (away == 0)
         exec("say There's nothing in that cart for me, " + pc.name + ".", self);
      if (away > 0)
         exec("say I'll take the rest when whoever cut them is about, " + pc.name + ".", self);
      goto start;
   }

   block;
   if (command("give"))
      item := medium;
   else
      item := target;
   who := house_cutter(item, pc);
   if (who == null)
   {
      // its cutter isn't in the game: give it back, or leave it lying
      if (command("give"))
      {
         link(item, pc);
         act("$1n hands $2n back to you.", A_ALWAYS, self, item, pc, TO_VICT);
      }
      exec("say Whoever cut this should be about when it's handed in, " + pc.name + ".", self);
      goto start;
   }
   if (not command("give"))
      act("$1n takes $2n.", A_ALWAYS, self, item, null, TO_ROOM);
   destroy(item);
   n := house_credit(who, which, qname, 1);
   s := house_many(n, one, many);
   if (who == pc)
      exec("say Thank you, " + pc.name + ". That's " + s + " from you: now " +
           house_newprice(who, which, "you") + ".", self);
   else
      exec("say Thank you, " + pc.name + ". I've counted it for " + who.name + ": that's " + s +
           " from " + who.name + ", and now " + house_newprice(who, which, who.name) + ".", self);
   if ((n <= 3) and (who == pc) and (not command("give")))
      exec("say " + CART_TIP, self);
   goto start;
}
dilend

// On Sam the blacksmith: sells a miner's pick (list, buy pick).
dilbegin fnpri(FN_PRI_BLOCK) house_picks();
var
   pc : unitptr;
   u : unitptr;
code
{
:start:
   wait(SFB_CMD, (command("list") or command("buy")) and (activator.type == UNIT_ST_PC) and
                 (activator.outside == self.outside));
   pc := activator;
   if (command("buy") and (not ("pick" in argument)))
      goto start;
   block;
   if (command("list"))
   {
      act("$1n says, 'I sell a miner's pick for " + moneystring(PICK_PRICE, TRUE) + ". Bring me " +
          "iron ore from the caves behind the hobgoblin waterfall, and the architect takes it " +
          "off the price of a lock.'", A_ALWAYS, self, null, pc, TO_VICT);
      goto start;
   }
   if (not transfermoney(pc, null, PICK_PRICE))
   {
      act("$1n says, 'A pick costs " + moneystring(PICK_PRICE, TRUE) + ", $3n.'", A_ALWAYS, self, null, pc, TO_VICT);
      goto start;
   }
   u := load(PICK);
   link(u, pc);
   act("$1n gives you $2n.", A_ALWAYS, self, u, pc, TO_VICT);
   act("$1n gives $3n $2n.", A_HIDEINV, self, u, pc, TO_NOTVICT);
   goto start;
}
dilend

// How the house looks, from its condition (its hit points), like a wound in combat.
dilbegin string house_state(room : unitptr);
var
   pct : integer;
code
{
   pct := 0;
   if (room.max_hp > 0)
      pct := (room.hp * 100) / room.max_hp;
   if (pct >= 100)
      return ("It is in perfect repair.");
   if (pct >= 90)
      return ("It is in good repair.");
   if (pct >= 75)
      return ("It shows a little wear: the paint on the shutters is fading.");
   if (pct >= 50)
      return ("It is weathered: the door sticks and a draught comes under it.");
   if (pct >= 25)
      return ("It is run-down: slates are missing and damp creeps up the walls.");
   if (room.hp > 0)   // not pct: 100 of 18000 rounds down to 0%
      return ("It is dilapidated: the roof sags and the shutters hang loose.");
   return ("It is a ruin.");
}
dilend

// TRUE when pname may come in: anyone while the door isn't locked; then only the owner and
// those they gave a key (invited).
dilbegin integer house_allowed(room : unitptr, pname : string);
var
   own : extraptr;
   frd : extraptr;
   lk : extraptr;
code
{
   own := HOUSE_OWNER in room.extra;
   if (own == null)
      return (FALSE);
   if (own.descr == pname)
      return (TRUE);
   lk := HOUSE_LOCK in room.extra;
   if ((lk == null) or (lk.descr != "locked"))
      return (TRUE);
   frd := HOUSE_FRIEND in room.extra;
   if (("$" + pname) in frd.names)
      return (TRUE);
   return (FALSE);
}
dilend

// Brings the house's saved furniture in, once after each boot.
dilbegin house_furnish(room : unitptr);
external
   string house_file(room : unitptr);
var
   base : string;
   u : unitptr;
   i : integer;
code
{
   if (HOUSE_FURNISH in room.extra)
      return;
   addextra(room.extra, {HOUSE_FURNISH}, "");
   base := house_file(room);
   u := restore(base + ".bed", null);
   if (u != null)
      link(u, room);
   i := 1;
   while (i <= HOUSE_CHESTS)
   {
      u := restore(base + ".chest" + itoa(i), null);
      if (u != null)
         link(u, room);
      i := i + 1;
   }
   return;
}
dilend

// Clears a house for a new owner: whoever is in it is shown out to the lane, Calvin's
// furniture goes with its files (what was in it to heir, or gone without one), and so does
// anything lying about. The plot is free again. Returns how many things heir got.
dilbegin integer house_clear(room : unitptr, heir : unitptr);
external
   house_save(room : unitptr);
   house_furnish(room : unitptr);
   string house_file(room : unitptr);
var
   lane : unitptr;
   back : unitptr;
   upper : unitptr;
   i : integer;
   r : unitptr;
   u : unitptr;
   nxt : unitptr;
   c : unitptr;
   cnxt : unitptr;
   d : integer;
   k : integer;
   err : integer;
   base : string;
code
{
   house_furnish(room);   // the furniture, if nobody came in since the boot
   d := 0;
   while (d <= MAX_EXIT)
   {
      r := room.exit_to[d];
      if (r != null)
      {
         if (HOUSE_BACK in r.extra)
            back := r;
         else if (HOUSE_UPPER in r.extra)
            upper := r;
         else
            lane := r;
      }
      d := d + 1;
   }
   k := 0;
   i := 0;
   while (i < 3)   // the front room, the back room, the upper floor
   {
      if (i == 0)
         r := room;
      else if (i == 1)
         r := back;
      else
         r := upper;
      u := null;
      if (r != null)
         u := r.inside;
      while (u != null)
      {
         nxt := u.next;
         if ((u.type == UNIT_ST_PC) or (u.type == UNIT_ST_NPC))
         {
            act("The house changes hands, and you are shown out.", A_ALWAYS, u, null, null, TO_CHAR);
            link(u, lane);
         }
         else if (HOUSE_FILE in u.extra)
         {
            // furniture: whoever lies in it out, what is in it to heir
            c := u.inside;
            while (c != null)
            {
               cnxt := c.next;
               if ((c.type == UNIT_ST_PC) or (c.type == UNIT_ST_NPC))
               {
                  act("The house changes hands, and you are shown out.", A_ALWAYS, c, null, null, TO_CHAR);
                  link(c, lane);
               }
               else if (heir != null)
               {
                  link(c, heir);
                  k := k + 1;
               }
               else
                  destroy(c);
               c := cnxt;
            }
            destroy(u);
         }
         else if (heir != null)
         {
            link(u, heir);
            k := k + 1;
         }
         else
            destroy(u);
         u := nxt;
      }
      i := i + 1;
   }

   base := house_file(room);
   err := delunit(base + ".bed");   // store()d units: delunit, not delstr
   d := 1;
   while (d <= HOUSE_CHESTS)
   {
      err := delunit(base + ".chest" + itoa(d));
      d := d + 1;
   }
   subextra(room.extra, HOUSE_OWNER);
   subextra(room.extra, HOUSE_TYPE);
   subextra(room.extra, HOUSE_LOCK);
   subextra(room.extra, HOUSE_FRIEND);
   addextra(room.extra, {HOUSE_FRIEND}, "");
   room.hp := room.max_hp;
   house_save(room);   // no owner: removes the file
   return (k);
}
dilend

// On a lane room: a door from it into a house (a room with HOUSE_WHERE) lets in anyone while
// the house's door isn't locked; then only the owner, those with a key and gods. Monsters are kept out by UNIT_FL_NO_MOB.
dilbegin fnpri(FN_PRI_BLOCK) house_gate();
external
   integer house_allowed(room : unitptr, pname : string);
   house_furnish(room : unitptr);
var
   pc : unitptr;
   room : unitptr;
   own : extraptr;
   dirs : stringlist;
   d : integer;
   ok : integer;
code
{
   dirs := HOUSE_DIRS;
:start:
   wait(SFB_CMD, activator.type == UNIT_ST_PC);
   pc := activator;
   d := 0;
   while (d <= MAX_EXIT)   // not in the condition: "and" evaluates both sides, dirs.[10] fails
   {
      if (command(dirs.[d]))
         break;
      d := d + 1;
   }
   if (d > MAX_EXIT)
      goto start;
   room := self.exit_to[d];
   if ((room == null) or (not (HOUSE_WHERE in room.extra)))
      goto start;
   if (pc.level >= IMMORTAL_LEVEL)
   {
      house_furnish(room);
      goto start;
   }
   own := HOUSE_OWNER in room.extra;
   if (own == null)
   {
      block;
      act("The door is shut, and a sign on it says: 'For sale. Ask the architect in the Hall " +
          "of the Citizens, in Midgaard's Town Hall.'", A_ALWAYS, pc, null, null, TO_CHAR);
      goto start;
   }
   ok := house_allowed(room, pc.name);
   if (ok)
   {
      house_furnish(room);
      goto start;
   }
   block;
   act("The door is locked. This is " + own.descr + "'s house.", A_ALWAYS, pc, null, null, TO_CHAR);
   goto start;
}
dilend

// On a house's front room: reads the house's state at boot; its hit points are the house's
// condition. A house is open to anyone until its owner buys a door lock (HOUSE_LOCK) and locks
// it; then those without a key are shown out to the lane. Here, `house` shows the owner and
// the condition in words (house_state); with a lock the owner can `lock door`, `unlock door`,
// and hand out keys: `invite <name>`, `uninvite <name>`. The back room (the exit to a
// HOUSE_BACK room) is closed in a cottage, the upper floor (HOUSE_UPPER) open only in a
// townhouse.
dilbegin fnpri(FN_PRI_BLOCK) house_room();
external
   integer house_allowed(room : unitptr, pname : string);
   house_save(room : unitptr);
   house_furnish(room : unitptr);
   string house_file(room : unitptr);
   string house_state(room : unitptr);
var
   buf : string;
   sl : stringlist;
   fl : stringlist;
   dirs : stringlist;
   lane : string;
   back : integer;
   upper : integer;
   bname : string;   // the back room and the upper floor, by name: unitptr variables are
   uname : string;   // cleared when the program wakes
   d : integer;
   err : integer;
   pc : unitptr;
   r : unitptr;
   own : extraptr;
   typ : extraptr;
   frd : extraptr;
   lk : extraptr;
   ok : integer;
   arg : string;
   who : string;
code
{
   // the lane and the back room, from the exits
   dirs := HOUSE_DIRS;
   back := -1;
   upper := -1;
   d := 0;
   while (d <= MAX_EXIT)
   {
      r := self.exit_to[d];
      if (r != null)
      {
         if (HOUSE_BACK in r.extra)
         {
            back := d;
            bname := r.nameidx;
         }
         else if (HOUSE_UPPER in r.extra)
         {
            upper := d;
            uname := r.nameidx;
         }
         else
            lane := r.nameidx + "@" + r.zoneidx;
      }
      d := d + 1;
   }

   // the state saved by house_save
   self.hp := self.max_hp;
   fl := {HOUSE_FRIEND};
   err := loadstr(house_file(self), buf);
   if (err == FILE_LOADED)
   {
      sl := split(buf, "\n");
      if ((length(sl) >= 3) and (sl.[0] != ""))
      {
         addextra(self.extra, {HOUSE_OWNER}, sl.[0]);
         addextra(self.extra, {HOUSE_TYPE}, sl.[1]);
         self.hp := atoi(sl.[2]);
         if ((length(sl) > 4) and (sl.[4] != ""))
            addextra(self.extra, {HOUSE_LOCK}, sl.[4]);
         if (length(sl) > 3)
         {
            sl := split(sl.[3], " ");
            while (length(sl) > 0)
            {
               if (sl.[0] != "")
                  addstring(fl, "$" + sl.[0]);
               remove(sl, 0);
            }
         }
      }
   }
   addextra(self.extra, fl, "");

:start:
   // in any of the house's rooms: who has no key after the door was locked is shown out
   wait(SFB_CMD, (activator.type == UNIT_ST_PC) and ((activator.outside == self) or
                 ((activator.outside.zoneidx == self.zoneidx) and
                  ((activator.outside.nameidx == bname) or (activator.outside.nameidx == uname)))));
   pc := activator;
   if (not (HOUSE_FURNISH in self.extra))
      house_furnish(self);   // someone came in without the door (a god's goto)
   if (pc.level >= IMMORTAL_LEVEL)
      goto start;
   ok := house_allowed(self, pc.name);
   if (not ok)
   {
      block;
      act("The door has been locked, and you have no key: you are shown out.", A_ALWAYS, pc, null, null, TO_CHAR);
      act("$1n is shown the door.", A_HIDEINV, pc, null, null, TO_ROOM);
      link(pc, findroom(lane));
      exec("look", pc);
      goto start;
   }

   typ := HOUSE_TYPE in self.extra;
   if ((pc.outside == self) and (back >= 0) and command(dirs.[back]) and (typ.descr == "cottage"))
   {
      block;
      act("This cottage has only the one room.", A_ALWAYS, pc, null, null, TO_CHAR);
      goto start;
   }
   if ((pc.outside == self) and (upper >= 0) and command(dirs.[upper]) and (typ.descr != "townhouse"))
   {
      block;
      act("The stairs are closed off at the top: the upper floor is a townhouse's.",
          A_ALWAYS, pc, null, null, TO_CHAR);
      goto start;
   }

   own := HOUSE_OWNER in self.extra;
   frd := HOUSE_FRIEND in self.extra;
   lk := HOUSE_LOCK in self.extra;
   if (command("house"))
   {
      block;
      buf := house_state(self);
      act("This " + typ.descr + " belongs to " + own.descr + ". " + buf, A_ALWAYS, pc, null, null, TO_CHAR);
      if (lk == null)
         act("Its door has no lock: anyone may come in.", A_ALWAYS, pc, null, null, TO_CHAR);
      else if (lk.descr == "locked")
         act("Its door is locked.", A_ALWAYS, pc, null, null, TO_CHAR);
      else
         act("Its door has a lock, but it is open: anyone may come in.", A_ALWAYS, pc, null, null, TO_CHAR);
      if ((lk != null) and (pc.name == own.descr))
      {
         if (length(frd.names) <= 1)
            act("Nobody else has a key.", A_ALWAYS, pc, null, null, TO_CHAR);
         else
         {
            buf := "";
            d := 1;
            while (d < length(frd.names))
            {
               buf := buf + " " + right(frd.names.[d], length(frd.names.[d]) - 1);
               d := d + 1;
            }
            act("Keys:" + buf + ".", A_ALWAYS, pc, null, null, TO_CHAR);
         }
         act("You can 'lock door' and 'unlock door', give a friend a key ('invite &lt;name&gt;') " +
             "and take it back ('uninvite &lt;name&gt;').", A_ALWAYS, pc, null, null, TO_CHAR);
      }
      goto start;
   }

   // the door lock: lock door, unlock door
   if ((command("lock") or command("unlock")) and ("door" in argument))
   {
      block;
      if (lk == null)
      {
         act("The door has no lock. The architect in Midgaard's Town Hall fits one.",
             A_ALWAYS, pc, null, null, TO_CHAR);
         goto start;
      }
      if (pc.name != own.descr)
      {
         act("Only " + own.descr + " can lock and unlock this door.", A_ALWAYS, pc, null, null, TO_CHAR);
         goto start;
      }
      subextra(self.extra, HOUSE_LOCK);
      if (command("lock"))
      {
         addextra(self.extra, {HOUSE_LOCK}, "locked");
         act("You lock the door: only those with a key may come in now.", A_ALWAYS, pc, null, null, TO_CHAR);
      }
      else
      {
         addextra(self.extra, {HOUSE_LOCK}, "open");
         act("You unlock the door: anyone may come in now.", A_ALWAYS, pc, null, null, TO_CHAR);
      }
      house_save(self);
      goto start;
   }

   // keys: invite, uninvite; only with a door lock
   if ((not command("invite")) and (not command("uninvite")))
      goto start;
   block;
   if (pc.name != own.descr)
   {
      act("Only " + own.descr + " hands out keys to this house.", A_ALWAYS, pc, null, null, TO_CHAR);
      goto start;
   }
   if (lk == null)
   {
      act("Your door has no lock to give keys to. The architect in Midgaard's Town Hall fits one.",
          A_ALWAYS, pc, null, null, TO_CHAR);
      goto start;
   }
   arg := argument;
   who := getword(arg);
   if (who == "")
   {
      act("Whom?", A_ALWAYS, pc, null, null, TO_CHAR);
      goto start;
   }
   who := toupper(left(who, 1)) + tolower(right(who, length(who) - 1));

   if (command("invite"))
   {
      if (not isplayer(who))
      {
         act("There is nobody called " + who + ".", A_ALWAYS, pc, null, null, TO_CHAR);
         goto start;
      }
      if ((who == own.descr) or (("$" + who) in frd.names))
      {
         act(who + " has a key already.", A_ALWAYS, pc, null, null, TO_CHAR);
         goto start;
      }
      if (length(frd.names) > HOUSE_FRIENDS)
      {
         act("You have given out " + itoa(HOUSE_FRIENDS) + " keys already.", A_ALWAYS, pc, null, null, TO_CHAR);
         goto start;
      }
      addstring(frd.names, "$" + who);
      act(who + " has a key to your house now.", A_ALWAYS, pc, null, null, TO_CHAR);
   }
   else
   {
      if (not (("$" + who) in frd.names))
      {
         act(who + " has no key.", A_ALWAYS, pc, null, null, TO_CHAR);
         goto start;
      }
      substring(frd.names, "$" + who);
      act("You take back " + who + "'s key.", A_ALWAYS, pc, null, null, TO_CHAR);
   }
   house_save(self);
   goto start;
}
dilend

// How many things are in u, counting what is inside them (a bag of 30 things is 31).
dilbegin integer house_count(u : unitptr);
var
   c : unitptr;
   n : integer;
   m : integer;
code
{
   n := 0;
   c := u.inside;
   while (c != null)
   {
      m := house_count(c);
      n := n + 1 + m;
      c := c.next;
   }
   return (n);
}
dilend

// On a chest: holds at most HOUSE_HOLDS things (counting what is inside bags), and saves
// itself, with what is in it, a moment after things are put in or taken out (one save for a
// whole "put all" or "get all"). What is put in beyond that goes back to the one who put it in;
// if they have left, it stays in the chest. The limit is an extra, not an argument: a restored
// chest whose template has changed gets its variables back as 0.
dilbegin house_chest();
external
   integer house_count(u : unitptr);
var
   fl : extraptr;
   u : unitptr;
   pc : unitptr;
   over : integer;
   maxitems : integer;
code
{
   heartbeat := PULSE_SEC;
:start:
   wait(SFB_DONE, (command("put") and (target == self)) or (command("get") and (medium == self)));
   pc := activator;
   secure(pc, save);
   pause;   // the rest of a "put all" or "get all" comes in the meantime

:save:
   fl := HOUSE_HOLDS in self.extra;
   maxitems := 0;
   if (fl != null)
      maxitems := atoi(fl.descr);
   over := FALSE;
   while ((pc != null) and (maxitems > 0) and (self.inside != null) and (house_count(self) > maxitems))
   {
      u := self.inside;   // the last thing put in
      link(u, pc);
      over := TRUE;
   }
   if (over)
      act("There is no more room in $2n: it holds " + itoa(maxitems) + " things.",
          A_ALWAYS, pc, self, null, TO_CHAR);
   unsecure(pc);
   fl := HOUSE_FILE in self.extra;
   if (fl != null)
      store(self, fl.descr, TRUE);
   goto start;
}
dilend

// On a chest with a lock (HOUSE_CHESTLOCK holds its owner's name): only the owner (and gods)
// open it. Opening unlocks it, closing locks it, and when it stands open without its owner in
// the room, it closes and locks itself. The lock can't be picked.
dilbegin fnpri(FN_PRI_BLOCK) house_chestlock();
var
   lk : extraptr;
   fl : extraptr;
   u : unitptr;
   pc : unitptr;
   arg : string;
   here : integer;
code
{
   heartbeat := PULSE_SEC * 5;   // how long it may stand open after its owner left
:start:
   wait(SFB_CMD | SFB_TICK, TRUE);
   lk := HOUSE_CHESTLOCK in self.extra;
   if (lk == null)
      goto start;

   if (command(CMD_AUTO_TICK))
   {
      if (isset(self.openflags, EX_CLOSED))
         goto start;
      here := FALSE;
      foreach (UNIT_ST_PC, u)
      {
         if (u.name == lk.descr)
            here := TRUE;
      }
      if (here)
         goto start;
      set(self.openflags, EX_CLOSED);
      set(self.openflags, EX_LOCKED);
      act("$1n swings shut, and its lock clicks.", A_ALWAYS, self, null, null, TO_ROOM);
      goto save;
   }

   if (not (command("open") or command("close") or command("lock") or command("unlock") or
            command("pick")))
      goto start;
   pc := activator;
   arg := argument;
   u := findunit(pc, arg, FIND_UNIT_SURRO, null);
   if (u != self)
      goto start;

   if ((pc.name == lk.descr) or (pc.level >= IMMORTAL_LEVEL))
   {
      block;
      if (command("open") or command("unlock"))
      {
         unset(self.openflags, EX_LOCKED);
         if (command("open"))
         {
            unset(self.openflags, EX_CLOSED);
            act("You unlock $2n and open it.", A_ALWAYS, pc, self, null, TO_CHAR);
            act("$1n unlocks $2n and opens it.", A_HIDEINV, pc, self, null, TO_ROOM);
         }
         else
            act("You unlock $2n.", A_ALWAYS, pc, self, null, TO_CHAR);
      }
      else
      {
         set(self.openflags, EX_CLOSED);
         set(self.openflags, EX_LOCKED);
         act("You close $2n and lock it.", A_ALWAYS, pc, self, null, TO_CHAR);
         act("$1n closes $2n and locks it.", A_HIDEINV, pc, self, null, TO_ROOM);
      }
      goto save;
   }

   // someone else: anyone may close it, nobody else opens, unlocks or picks it
   if (command("close") or (not isset(self.openflags, EX_CLOSED)))
      goto start;
   block;
   if (command("pick"))
      act("The lock on $2n can't be picked.", A_ALWAYS, pc, self, null, TO_CHAR);
   else
      act("$2n is locked, and only " + lk.descr + " has the key.", A_ALWAYS, pc, self, null, TO_CHAR);
   goto start;

:save:
   fl := HOUSE_FILE in self.extra;
   if (fl != null)
      store(self, fl.descr, TRUE);
   goto start;
}
dilend

// On a hired cart (house_cart): it goes along with the horse it is hitched to. A move's
// done event comes in the room being left, naming the room ahead (target), for the horse or
// its rider: the cart goes there at once. Its hirer (only) may `unhitch cart` and `hitch cart
// to horse` (the hired draught horse comes hitched; a horse they hitched before, or any free
// one, will do), and `put log in cart` heaves a log or ore lying on the ground into it, at a
// cost in endurance. Anyone may climb in and ride along, leaving less room for cargo.
// Unloading is the receiver's (house_material). When its hirer hires another, Calvin takes it
// back (CART_RECALL), leaving what is in it. The hitch is kept in extras ("$cart mark" here,
// "$hitched" on the horse), not in variables.
dilbegin fnpri(FN_PRI_BLOCK) house_cart();
var
   pc : unitptr;
   horse : unitptr;
   u : unitptr;
   hr : extraptr;
   hx : extraptr;
   mk : extraptr;
   mark : string;
   arg : string;
   w : string;
   dirs : stringlist;
   d : integer;
   effort : integer;
code
{
   dirs := HOUSE_DIRS;
:start:
   wait(SFB_DONE | SFB_CMD | SFB_MSG, command(CMD_AUTO_MSG) or (activator.outside == self.outside) or
                                      (activator.outside.outside == self.outside));
   if (command(CMD_AUTO_MSG))
   {
      // Calvin takes it back (its hirer hired another): what is in it stays where it stood
      hr := "$cart hirer" in self.extra;
      if ((hr == null) or (argument != CART_RECALL + hr.descr))
         goto start;
      while (self.inside != null)
         link(self.inside, self.outside);
      act("A lad from Calvin's shop wheels $1n away.", A_ALWAYS, self, null, null, TO_ROOM);
      destroy(self);
      quit;
   }
   mk := "$cart mark" in self.extra;
   mark := "";
   if (mk != null)
      mark := mk.descr;

   // a move about to happen: if it is our horse (or its rider), go ahead to the room ahead
   if ((target != null) and (target.type == UNIT_ST_ROOM) and (mark != ""))
   {
      d := 0;
      while (d <= MAX_EXIT)
      {
         if (command(dirs.[d]))
            break;
         d := d + 1;
      }
      if (d > MAX_EXIT)
         goto start;
      horse := activator;
      if (activator.outside.type != UNIT_ST_ROOM)
         horse := activator.outside;   // ridden
      hx := "$hitched" in horse.extra;
      if ((hx != null) and (hx.descr == mark))
      {
         act("$1n rattles off after $3n.", A_ALWAYS, self, null, horse, TO_ROOM);
         link(self, target);
         act("$1n rattles in.", A_ALWAYS, self, null, null, TO_ROOM);
      }
      goto start;
   }

   if (not (command("hitch") or command("unhitch") or command("put")))
      goto start;
   pc := activator;
   if (pc.type != UNIT_ST_PC)
      goto start;
   arg := argument;
   if (not ("cart" in arg))
      goto start;
   hr := "$cart hirer" in self.extra;
   if ((hr == null) or (hr.descr != pc.name))
      goto start;   // each cart answers only its hirer

   if (command("put"))
   {
      // a log or ore lying here (one carried in the hands is put in as usual)
      w := getword(arg);
      if (findunit(pc, w, FIND_UNIT_INVEN, null) != null)
         goto start;
      arg := argument;
      w := getword(arg);
      u := findunit(pc, w, FIND_UNIT_SURRO, null);
      if ((u == null) or (u.type != UNIT_ST_OBJ) or (u.outside != self.outside) or
          ((u.nameidx + "@" + u.zoneidx != "house_log@housing") and
           (u.nameidx + "@" + u.zoneidx != "iron_ore@housing")))
         goto start;
      block;
      if (pc.position < POSITION_STANDING)
      {
         act("You must be standing to heave $2n up.", A_ALWAYS, pc, u, null, TO_CHAR);
         goto start;
      }
      if (self.weight - self.baseweight + u.weight > self.capacity)
      {
         act("$2n is full.", A_ALWAYS, pc, self, null, TO_CHAR);
         goto start;
      }
      effort := u.weight / 10;
      if (pc.endurance < effort)
      {
         act("You are too tired to heave $2n up.", A_ALWAYS, pc, u, null, TO_CHAR);
         goto start;
      }
      pc.endurance := pc.endurance - effort;
      link(u, self);
      act("You heave $2n up into $3n.", A_ALWAYS, pc, u, self, TO_CHAR);
      act("$1n heaves $2n up into $3n.", A_HIDEINV, pc, u, self, TO_ROOM);
      goto start;
   }

   block;
   if (command("unhitch"))
   {
      if (mark == "")
      {
         act("$2n isn't hitched to anything.", A_ALWAYS, pc, self, null, TO_CHAR);
         goto start;
      }
      subextra(self.extra, "$cart mark");
      act("You unhitch $2n.", A_ALWAYS, pc, self, null, TO_CHAR);
      goto start;   // the horse keeps its mark: it is the hirer's to hitch again
   }
   if (mark != "")
   {
      act("$2n is hitched already.", A_ALWAYS, pc, self, null, TO_CHAR);
      goto start;
   }
   // hitch: a horse here that pulls nothing, or one this player hitched before
   horse := null;
   u := self.outside.inside;
   while (u != null)
   {
      if ((u.type == UNIT_ST_NPC) and ("horse" in u.names))
      {
         hx := "$hitched" in u.extra;
         if ((hx == null) or (left(hx.descr, length(pc.name) + 1) == pc.name + " "))
            horse := u;
      }
      u := u.next;
   }
   if (horse == null)
   {
      act("There is no horse here to hitch $2n to.", A_ALWAYS, pc, self, null, TO_CHAR);
      goto start;
   }
   mark := pc.name + " " + itoa(realtime) + " " + itoa(rnd(1, 99999));
   subextra(horse.extra, "$hitched");
   addextra(horse.extra, {"$hitched"}, mark);
   addextra(self.extra, {"$cart mark"}, mark);
   act("You hitch $2n to $3n.", A_ALWAYS, pc, self, horse, TO_CHAR);
   act("$1n hitches $2n to $3n.", A_HIDEINV, pc, self, horse, TO_ROOM);
   goto start;
}
dilend

// On a hired draught horse: only its hirer may mount it. Calvin takes it back when its hirer
// hires another (CART_RECALL).
dilbegin fnpri(FN_PRI_BLOCK) house_horse();
var
   pc : unitptr;
   u : unitptr;
   hr : extraptr;
   arg : string;
code
{
:start:
   wait(SFB_CMD | SFB_MSG, command(CMD_AUTO_MSG) or
                           (command("mount") and (activator.type == UNIT_ST_PC) and
                            (activator.outside == self.outside)));
   hr := "$cart hirer" in self.extra;
   if (command(CMD_AUTO_MSG))
   {
      // Calvin takes it back (its hirer hired another): a rider is set down first
      if ((hr == null) or (argument != CART_RECALL + hr.descr))
         goto start;
      while (self.inside != null)
         link(self.inside, self.outside);
      act("A lad from Calvin's shop leads $1n away.", A_ALWAYS, self, null, null, TO_ROOM);
      destroy(self);
      quit;
   }
   pc := activator;
   arg := argument;
   u := findunit(pc, arg, FIND_UNIT_SURRO, null, UNIT_ST_NPC);   // as mount finds it
   if (u != self)
      goto start;
   if ((hr != null) and (hr.descr != pc.name))
   {
      block;
      act("$2n is hired to " + hr.descr + ".", A_ALWAYS, pc, self, null, TO_CHAR);
   }
   goto start;
}
dilend

// On a bed: it is for sleeping in (enter bed, sleep, leave). Things put or dropped in it go
// back to the floor, since only the chests are saved.
dilbegin house_bed();
var
   u : unitptr;
code
{
:start:
   wait(SFB_DONE, (command("put") and (target == self)) or
                  (command("drop") and (activator.outside == self)));
   if (command("put"))
      u := medium;   // put: medium is the thing, target the bed
   else
      u := target;   // drop: target is the thing
   if ((u != null) and (u.outside == self))
   {
      link(u, self.outside);
      act("$2n tumbles out of the bed onto the floor: a bed is for sleeping in.",
          A_ALWAYS, activator, u, null, TO_CHAR);
   }
   goto start;
}
dilend

// The architect: sells cottages and houses on Hearth Lane in Udgaard, houses and townhouses on
// Midgaard's streets at each street's price (list; buy cottage, buy house, buy house on penny
// lane, buy townhouse on chestnut close), and door locks (buy lock). `sell house`, said twice
// within a minute, takes a house back for half of what it cost; a god may `evict plot3`.
dilbegin fnpri(FN_PRI_BLOCK) architect();
external
   unitptr house_find(pname : string, lane : string, street : string);
   house_save(room : unitptr);
   integer house_counter(pc : unitptr, which : string);
   integer house_price(pc : unitptr, what : string);
   integer house_dear(price : integer, pct : integer);
   house_spend(pc : unitptr, what : string);
   string house_many(n : integer, one : string, many : string);
   integer house_clear(room : unitptr, heir : unitptr);
var
   pc : unitptr;
   room : unitptr;
   arg : string;
   what : string;
   lane : string;
   price : integer;
   logs : integer;
   ore : integer;
   p1 : integer;
   p2 : integer;
   p3 : integer;
   where : extraptr;
   lanes : stringlist;
   mstreets : stringlist;
   mplaces : stringlist;
   skey : string;
   word : string;
   sellat : integer;   // when they were asked
   prestige : intlist;
   street : integer;
   kind : string;
   r : unitptr;
   i : integer;
   k : integer;
   paid : extraptr;
   selling : string;   // who was asked to say "sell house" again to seal it
code
{
   lanes := HOUSE_LANES;
   mstreets := MHOUSE_STREETS;
   mplaces := MHOUSE_PLACES;
   prestige := MHOUSE_PRESTIGE;
:start:
   wait(SFB_CMD, (command("list") or command("buy") or
                  (command("sell") and (("house" in argument) or ("cottage" in argument))) or
                  (command("evict") and (activator.level >= IMMORTAL_LEVEL))) and
                 (activator.type == UNIT_ST_PC) and (activator.outside == self.outside));
   block;
   pc := activator;
   arg := argument;

   if (command("evict"))
   {
      // a god frees a plot whose owner is gone: "evict plot3", or "evict plot10@mhouses"
      // (not "free": that is how freeze begins)
      what := getword(arg);
      if (not ("@" in what))
         what := what + "@" + lanes.[0];
      room := findroom(what);
      if ((room == null) or (not (HOUSE_WHERE in room.extra)))
      {
         exec("say Which plot, " + pc.name + "? evict plot3, or evict plot10@mhouses.", self);
         goto start;
      }
      where := HOUSE_OWNER in room.extra;
      if (where == null)
      {
         exec("say " + what + " is free already, " + pc.name + ".", self);
         goto start;
      }
      lane := where.descr;
      k := house_clear(room, pc);
      log(pc.name + " freed " + what + ", " + lane + "'s house; " + itoa(k) + " things to " + pc.name + ".");
      exec("say " + what + " was " + lane + "'s; it is free now. What was in it, " + itoa(k) +
           " things, I gave to you, " + pc.name + ".", self);
      goto start;
   }

   if (command("sell"))
   {
      room := house_find(pc.name, "", "");
      if (room == null)
      {
         exec("say You have no house to sell, " + pc.name + ".", self);
         goto start;
      }
      paid := HOUSE_PAID in pc.extra;
      price := 0;
      if (paid != null)
         price := atoi(paid.descr) / 2;
      if ((selling != pc.name) or (realtime - sellat > 60))
      {
         selling := pc.name;   // a minute to say it again
         sellat := realtime;
         if (price > 0)
            what := "pay you " + moneystring(price, TRUE) + ", half of what it cost you";
         else
            what := "pay you nothing, for I have no record of what it cost you";
         exec("say I'll take your house back and " + what + ". Calvin's furniture stays with " +
              "it, and what is in it comes back to you. Say 'sell house' again to seal it.", self);
         goto start;
      }
      selling := "";
      k := house_clear(room, pc);
      if (price > 0)
      {
         i := transfermoney(null, pc, price);
         act("Haldor pays you " + moneystring(price, TRUE) + ".", A_ALWAYS, pc, null, null, TO_CHAR);
      }
      subextra(pc.extra, HOUSE_PAID);
      log(pc.name + " sold the house " + room.nameidx + "@" + room.zoneidx + " for " + itoa(price) +
          "; " + itoa(k) + " things back.");
      if (k > 0)
         act("What was in your house is carried back to you.", A_ALWAYS, pc, null, null, TO_CHAR);
      exec("say It's mine again, " + pc.name + ". Should you want another, you know where I am.", self);
      goto start;
   }
   selling := "";
   logs := house_counter(pc, HOUSE_LOGS);   // the materials pc handed in
   ore := house_counter(pc, HOUSE_ORE);

   if (command("list"))
   {
      arg := "";
      i := 0;
      while (i < length(mstreets))
      {
         arg := arg + "   on " + mstreets.[i] + ", " + mplaces.[i] + ": a house " +
                moneystring(house_dear(MHOUSE_PRICE, prestige.[i]), TRUE) + ", a townhouse " +
                moneystring(house_dear(TOWNHOUSE_PRICE, prestige.[i]), TRUE) + "<br/>";
         i := i + 1;
      }
      p1 := house_price(pc, "cottage");
      p2 := house_price(pc, "house");
      p3 := house_price(pc, "lock");
      what := house_many(logs, "log", "logs");
      lane := house_many(ore, "load of ore", "loads of ore");
      act("$1n unrolls his plans:<br/>" +
          "In Udgaard, on Hearth Lane west of the market:<br/>" +
          "   a cottage (one room) " + moneystring(COTTAGE_PRICE, TRUE) + ", a house (two rooms) " +
          moneystring(HOUSE_PRICE, TRUE) + ": 'buy cottage', 'buy house'<br/>" +
          "In Midgaard, a house (two rooms) or a townhouse (three rooms), dearer the finer the " +
          "street:<br/>" + arg +
          "   'buy house on penny lane', 'buy townhouse on chestnut close' ...<br/>" +
          "A lock for your door, " + moneystring(LOCK_PRICE, TRUE) + ": 'buy lock'. Then only " +
          "those you give a key come in.<br/>" +
          "Timber and iron make Udgaard's houses and a lock cheaper, each piece its share: " +
          itoa(LOGS_COTTAGE) + " felled logs, handed to John the Lumberjack in Haon-Dor, take " +
          itoa(HOUSE_DISCOUNT) + "% off a cottage; " + itoa(LOGS_HOUSE) + " logs and " +
          itoa(ORE_HOUSE) + " loads of iron ore, handed to Sam the blacksmith, " +
          itoa(HOUSE_DISCOUNT) + "% off a house; and " + itoa(LOCK_ORE) + " loads of ore " +
          itoa(HOUSE_DISCOUNT) + "% off a lock.<br/>" +
          "You have handed in " + what + " and " + lane + ": for you a cottage is " +
          moneystring(p1, TRUE) + ", a house in Udgaard " + moneystring(p2, TRUE) + " and a lock " +
          moneystring(p3, TRUE) + ".", A_ALWAYS, self, null, pc, TO_VICT);
      goto start;
   }

   what := getword(arg);
   if (what == "lock")
   {
      room := house_find(pc.name, "", "");
      if (room == null)
      {
         exec("say A lock for which door, " + pc.name + "? You have no house yet.", self);
         goto start;
      }
      if (HOUSE_LOCK in room.extra)
      {
         exec("say Your door has a lock already, " + pc.name + ".", self);
         goto start;
      }
      price := house_price(pc, "lock");
      if (not transfermoney(pc, null, price))
      {
         exec("say A lock costs you " + moneystring(price, TRUE) + ", " + pc.name + ".", self);
         goto start;
      }
      house_spend(pc, "lock");
      paid := HOUSE_PAID in pc.extra;   // what the house cost them, now with the lock
      k := price;
      if (paid != null)
         k := k + atoi(paid.descr);
      subextra(pc.extra, HOUSE_PAID);
      addextra(pc.extra, {HOUSE_PAID}, itoa(k));
      addextra(room.extra, {HOUSE_LOCK}, "locked");
      house_save(room);
      act("You pay $3n " + moneystring(price, TRUE) + ".", A_ALWAYS, pc, null, self, TO_CHAR);
      exec("say Your door is fitted with a lock, and locked, " + pc.name + ". Inside you can " +
           "lock and unlock it, and give your friends a key with invite.", self);
      log(pc.name + " bought a lock for " + room.nameidx + "@" + room.zoneidx + ".");
      goto start;
   }
   if ((what != "cottage") and (what != "house") and (what != "townhouse"))
   {
      exec("say I build cottages and houses in Udgaard, houses and townhouses in Midgaard, and " +
           "fit locks, " + pc.name + ": buy cottage, buy house, buy house on penny lane, buy " +
           "townhouse on chestnut close, or buy lock.", self);
      goto start;
   }

   // which street: Hearth Lane in Udgaard, or one of Midgaard's, named by its first word
   arg := tolower(arg);
   street := -1;
   i := 0;
   while (i < length(mstreets))
   {
      word := mstreets.[i];
      skey := tolower(getword(word));
      if (skey in arg)
         break;
      i := i + 1;
   }
   if (i < length(mstreets))
      street := i;
   lane := lanes.[0];
   kind := what;
   if ((what == "townhouse") or (street >= 0) or ("midgaard" in arg))
   {
      if (what == "cottage")
      {
         exec("say I build no cottages in Midgaard, " + pc.name + ": houses and townhouses.", self);
         goto start;
      }
      if (street < 0)
      {
         exec("say On which street, " + pc.name + "? Penny Lane, Beech Row or Chestnut Close: " +
              "buy " + what + " on penny lane, say. 'list' shows what each costs.", self);
         goto start;
      }
      lane := lanes.[1];
      if (what == "house")
         kind := "mhouse";
   }
   else
   {
      word := arg;
      if ((getword(word) != "") and (not ("udgaard" in arg)) and (not ("hearth" in arg)))
      {
         // a place he doesn't know: ask, rather than build in Udgaard
         exec("say Where, " + pc.name + "? On Hearth Lane in Udgaard (buy " + what + " in " +
              "udgaard), or in Midgaard on Penny Lane, Beech Row or Chestnut Close (buy house " +
              "on penny lane). 'list' shows what each costs.", self);
         goto start;
      }
   }

   if (pc.level < HOUSE_MINLEVEL)
   {
      exec("say Come back when you are level " + itoa(HOUSE_MINLEVEL) + ", " + pc.name + ".", self);
      goto start;
   }
   room := house_find(pc.name, "", "");
   if (room != null)
   {
      where := HOUSE_WHERE in room.extra;
      exec("say You have a house already, " + pc.name + ": " + where.descr + ".", self);
      goto start;
   }
   skey := "";
   if (street >= 0)
   {
      word := mstreets.[street];
      skey := tolower(getword(word));
   }
   room := house_find("", lane, skey);
   if (room == null)
   {
      exec("say Every plot there is taken, " + pc.name + ". More will be laid out.", self);
      goto start;
   }
   price := house_price(pc, kind);
   if (street >= 0)
      price := house_dear(price, prestige.[street]);
   if (not transfermoney(pc, null, price))
   {
      exec("say A " + what + " costs you " + moneystring(price, TRUE) + ", " + pc.name + ".", self);
      goto start;
   }
   house_spend(pc, kind);
   subextra(pc.extra, HOUSE_PAID);
   addextra(pc.extra, {HOUSE_PAID}, itoa(price));

   addextra(room.extra, {HOUSE_OWNER}, pc.name);
   addextra(room.extra, {HOUSE_TYPE}, what);
   subextra(room.extra, HOUSE_FRIEND);
   addextra(room.extra, {HOUSE_FRIEND}, "");
   subextra(room.extra, HOUSE_LOCK);
   room.hp := room.max_hp;
   house_save(room);
   where := HOUSE_WHERE in room.extra;
   act("You pay $3n " + moneystring(price, TRUE) + ".", A_ALWAYS, pc, null, self, TO_CHAR);
   exec("say Done, " + pc.name + ": your " + what + " is " + where.descr + ". The door knows you.", self);
   exec("say Calvin the carpenter, on Colosseum Square, makes beds and chests and has them " +
        "carried to your house.", self);
   log(pc.name + " bought a " + what + ": " + room.nameidx + "@" + room.zoneidx + ".");
   goto start;
}
dilend

// Calvin the carpenter: sells furniture (list, buy bed, buy small/medium/large chest) and has
// it carried into the buyer's house. The prices are the objects' costs.
dilbegin fnpri(FN_PRI_BLOCK) furniture();
external
   unitptr house_find(pname : string, lane : string, street : string);
   house_furnish(room : unitptr);
   string house_file(room : unitptr);
var
   pc : unitptr;
   room : unitptr;
   u : unitptr;
   found : unitptr;
   fl : extraptr;
   arg : string;
   hfile : string;
   menu : string;
   hirers : stringlist;   // who hired a cart this boot: they may have one out
   mark : string;
   words : stringlist;
   which : intlist;
   syms : stringlist;
   i : integer;
   n : integer;
   price : integer;
code
{
   syms := {"house_bed", "chest_small", "chest_medium", "chest_large"};
   words := {"bed", "small", "medium", "cabinet", "large", "crate"};   // what a buyer may say,
   which := {0, 1, 2, 2, 3, 3};                                        // and which of syms it is

   // the list, from the objects' titles and costs
   menu := "";
   i := 0;
   while (i < length(syms))
   {
      u := load(syms.[i] + "@housing");
      menu := menu + "   " + u.title;
      fl := HOUSE_HOLDS in u.extra;
      if (fl != null)
         menu := menu + " (holds " + fl.descr + " things)";
      menu := menu + ": " + moneystring(u.cost, TRUE) + "<br/>";
      destroy(u);
      i := i + 1;
   }
:start:
   wait(SFB_CMD, (command("list") or command("buy") or command("hire")) and
                 (activator.type == UNIT_ST_PC) and (activator.outside == self.outside));
   block;
   pc := activator;
   arg := argument;

   if (command("hire"))
   {
      if (not ("cart" in arg))
      {
         exec("say I hire out a cart with a horse, " + pc.name + ": hire cart.", self);
         goto start;
      }
      if (not transfermoney(pc, null, CART_PRICE))
      {
         exec("say A cart and a horse cost " + moneystring(CART_PRICE, TRUE) + " to hire, " +
              pc.name + ".", self);
         goto start;
      }
      // one at a time: an old cart and horse come back wherever they are
      if (pc.name in hirers)
      {
         sendtoalldil(CART_RECALL + pc.name, "house_cart@housing");
         sendtoalldil(CART_RECALL + pc.name, "house_horse@housing");
         exec("say My lad will fetch your old cart and horse, " + pc.name + "; whatever was in " +
              "the cart he leaves where it stood.", self);
      }
      else
         addstring(hirers, pc.name);
      // a cart and a draught horse, hitched, outside on the square
      mark := pc.name + " " + itoa(realtime) + " " + itoa(rnd(1, 99999));
      u := load("draught_horse@housing");
      addextra(u.extra, {"$cart hirer"}, pc.name);
      addextra(u.extra, {"$hitched"}, mark);
      link(u, findroom(CART_YARD));
      u := load("house_cart@housing");
      addextra(u.extra, {"$cart hirer"}, pc.name);
      addextra(u.extra, {"$cart mark"}, mark);
      link(u, findroom(CART_YARD));
      act("You pay $3n " + moneystring(CART_PRICE, TRUE) + ".", A_ALWAYS, pc, null, self, TO_CHAR);
      exec("say Your cart and horse stand outside on the square, " + pc.name + ". Mount the " +
           "horse and ride: the cart follows. They're yours till you hire another, or the " +
           "next great storm (a reboot) brings them back to me.", self);
      goto start;
   }

   if (command("list"))
   {
      act("$1n points at his work:<br/>" + menu + "   a lock for a chest: half the chest's price<br/>" +
          "   a cart and a horse, to hire for hauling logs and ore: " + moneystring(CART_PRICE, TRUE) +
          " ('hire cart')<br/>" +
          "He has it carried to your house: 'buy bed', 'buy small chest', 'buy medium chest' or " +
          "'buy large chest'; 'buy lock for small chest' fits a lock to one you have.",
          A_ALWAYS, self, null, pc, TO_VICT);
      goto start;
   }

   n := 0;
   while (n < length(words))   // "and" evaluates both sides: no words.[n] in the condition
   {
      if (words.[n] in arg)
         break;
      n := n + 1;
   }
   if (n >= length(words))
   {
      if ("lock" in arg)
         exec("say A lock for which chest, " + pc.name + "? Buy lock for small chest, " +
              "medium chest or large chest.", self);
      else
         exec("say I make beds and chests, " + pc.name + ". Have a look: 'list'.", self);
      goto start;
   }
   i := which.[n];

   room := house_find(pc.name, "", "");
   if (room == null)
   {
      exec("say And where would I carry it, " + pc.name + "? The architect in the Town Hall " +
           "sells houses.", self);
      goto start;
   }
   house_furnish(room);

   // a lock for a chest in the house: half the chest's price
   if ("lock" in arg)
   {
      if (i == 0)
      {
         exec("say A bed needs no lock, " + pc.name + ".", self);
         goto start;
      }
      n := 0;   // chests of that kind; u: the first without a lock
      found := null;
      u := room.inside;
      while (u != null)
      {
         if (u.nameidx == syms.[i])
         {
            n := n + 1;
            if ((found == null) and (not (HOUSE_CHESTLOCK in u.extra)))
               found := u;
         }
         u := u.next;
      }
      if (found == null)
      {
         if (n == 0)
            exec("say You have no such chest in your house, " + pc.name + ".", self);
         else
            exec("say That chest has a lock already, " + pc.name + ".", self);
         goto start;
      }
      price := found.cost / 2;
      if (not transfermoney(pc, null, price))
      {
         exec("say A lock for it costs " + moneystring(price, TRUE) + ", " + pc.name + ".", self);
         goto start;
      }
      addextra(found.extra, {HOUSE_CHESTLOCK}, pc.name);
      set(found.openflags, EX_CLOSED);
      set(found.openflags, EX_LOCKED);
      fl := HOUSE_FILE in found.extra;
      if (fl != null)
         store(found, fl.descr, TRUE);
      act("You pay $3n " + moneystring(price, TRUE) + ".", A_ALWAYS, pc, null, self, TO_CHAR);
      exec("say I'll fit a lock to " + found.title + " in your house today, " + pc.name + ". Only " +
           "you can open it, and closing it locks it again.", self);
      goto start;
   }

   // a bed and up to HOUSE_CHESTS chests, each saved in a file of its own
   if (i == 0)
   {
      if (findsymbolic(room, "house_bed@housing", FIND_UNIT_INVEN) != null)
      {
         exec("say You have a bed already, " + pc.name + ".", self);
         goto start;
      }
      hfile := house_file(room) + ".bed";
   }
   else
   {
      n := 1;
      hfile := "";
      while ((n <= HOUSE_CHESTS) and (hfile == ""))
      {
         hfile := house_file(room) + ".chest" + itoa(n);
         u := room.inside;
         while (u != null)
         {
            fl := HOUSE_FILE in u.extra;
            if ((fl != null) and (fl.descr == hfile))
            {
               hfile := "";
               break;
            }
            u := u.next;
         }
         n := n + 1;
      }
      if (hfile == "")
      {
         exec("say Your house has room for " + itoa(HOUSE_CHESTS) + " chests, " + pc.name + ".", self);
         goto start;
      }
   }

   u := load(syms.[i] + "@housing");
   price := u.cost;
   if (not transfermoney(pc, null, price))
   {
      exec("say " + u.title + " costs " + moneystring(price, TRUE) + ", " + pc.name + ".", self);
      destroy(u);
      goto start;
   }
   addextra(u.extra, {HOUSE_FILE}, hfile);
   link(u, room);
   store(u, hfile, TRUE);
   act("You pay $3n " + moneystring(price, TRUE) + ".", A_ALWAYS, pc, null, self, TO_CHAR);
   exec("say It'll be in your house before you get there, " + pc.name + ".", self);
   goto start;
}
dilend


%objects

                                 house_bed
names {"bed"}
title "a bed"
descr "A wooden bed with a thick woollen blanket stands against the wall."
inside_descr "You lie in a wooden bed under a thick woollen blanket."
extra {}
"A sturdy bed of pine, made by Calvin the carpenter, with a straw mattress and
a thick woollen blanket, wide enough for two. You can lie in it: 'enter bed',
then 'sleep'; 'leave' gets you out."
manipulate {MANIPULATE_ENTER}
flags {UNIT_FL_TRANS}
capacity 1000
weight 200
cost 2 GOLD_PIECE
dilcopy house_bed@housing();
end

                                 house_log
names {"felled log", "log"}
title "a felled log"
descr "A felled log, trimmed of its branches, lies here."
extra {}
"A heavy log of good straight timber, too heavy for most to carry: drag it, or
haul it in a cart. John the Lumberjack in Haon-Dor takes logs for houses, and
the architect in Midgaard takes them off the price."
manipulate {MANIPULATE_TAKE}
weight 100
cost 1 IRON_PIECE
end

                                 iron_ore
names {"iron ore", "lump of iron ore", "ore", "lump"}
title "a lump of iron ore"
descr "A heavy lump of rust-red iron ore lies here."
extra {}
"Rock streaked with rust-red iron. Sam the blacksmith in Midgaard takes ore for
locks: give it to him, and the architect takes it off the price of a lock."
manipulate {MANIPULATE_TAKE}
weight 60
cost 1 IRON_PIECE
end

                                 house_cart
names {"cart"}
title "a cart"
descr "A sturdy wooden cart stands here."
extra {}
"A sturdy two-wheeled cart of oak, hired from Calvin the carpenter. A painted
board on its side reads:
   Mount the horse and ride: the cart follows it.
   'put log in cart' heaves a log or ore up from the ground; a dozen logs fit.
   'unload cart' by John the Lumberjack or Sam the blacksmith hands it all over.
   'unhitch cart' leaves the cart standing; 'hitch cart to horse' again.
   Friends may climb in ('enter cart') and ride, taking room from the load.
   More: 'help cart'."
manipulate {MANIPULATE_ENTER}
flags {UNIT_FL_TRANS}
CONTAINER_DEF(1250)
weight 300
cost 1 GOLD_PIECE
dilcopy house_cart@housing();
end

#define HOUSE_CHEST(ITEMS) \
manipulate {MANIPULATE_ENTER} \
CONTAINER_DEF(2000) \
open {EX_OPEN_CLOSE, EX_CLOSED} \
extra {HOUSE_HOLDS} ITEMS \
dilcopy house_chestlock@housing(); \
dilcopy house_chest@housing();

                                 chest_small
names {"small chest", "chest"}
title "a small chest"
descr "A small wooden chest stands at the foot of the bed."
extra {}
"A plain chest of six pine boards, made by Calvin the carpenter."
HOUSE_CHEST("10")
weight 40
cost 4 GOLD_PIECE
end

                                 chest_medium
names {"medium chest", "tall cabinet", "cabinet", "chest"}
title "a cabinet"
descr "A tall wooden cabinet stands against the wall."
extra {}
"A cabinet of oak with two doors and three shelves, made by Calvin the carpenter."
HOUSE_CHEST("15")
weight 80
cost 1 PLATINUM_PIECE
end

                                 chest_large
names {"large chest", "large crate", "crate", "chest"}
title "a large crate"
descr "A large iron-bound crate stands in a corner."
extra {}
"A crate of heavy planks bound with iron, big enough for a whole outfit, made by
Calvin the carpenter."
HOUSE_CHEST("25")
weight 120
cost 2 PLATINUM_PIECE
end


%mobiles

                                 draught_horse
names {"draught horse", "horse"}
title "a draught horse"
descr "A sturdy draught horse stands here in its harness."
extra {}
"A big, patient horse with feathered hooves, hired from Calvin the carpenter.
Its hirer can 'mount' it and ride; a cart hitched to it follows."
flags {UNIT_FL_TRANS}
M_HORSE_SMALL(20, SEX_MALE)
capacity 2000
weight 1500
dilcopy house_horse@housing();
end

                                 architect
names {"architect", "Haldor"}
title "Haldor the architect"
descr "Haldor the architect is bent over his plans at a table."
extra {}
"A lean, grey-bearded man with ink on his fingers. Rolls of plans are stacked
on the table beside him. He builds houses: 'list' shows what he offers."
romflags {CHAR_PROTECTED}
M_AVG_HUMAN(20, SEX_MALE)
alignment 500
money 5 IRON_PIECE
dilcopy architect@housing();
end


%reset

load architect into th_citizen@midgaard max 1

%end
