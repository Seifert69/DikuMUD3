END HEADER*/

#include <macros.h>


%zone test

   reset RESET_NOT
   weather 1040
   creators {"papi"}
   title "The DIL test laboratory"
   lifespan 45

   notes
   "This is a test zone. Can we do DIL 'unit testing' ?"

   help
   "This zone is not intended for players."

// T003 is a good example of a fairly simple stand-alone test.
//      All testing is happening inside of the T003 code.

%dil

#define TEST_MAXIMUM 44  // T010, T009, ...

#define LOGT_ERROR   0
#define LOGT_SUCCESS 1
#define LOGT_INFO    2


dilbegin logtest(no : integer, ltype : integer, msg : string);
var
   sl : stringlist;
   il : intlist global errors@test;
code
{
   sl := {"ERROR", "SUCCESS", "INFO"};
   log("T"+right("00"+itoa(no),3)+"//"+sl.[ltype]+" "+msg);
   if (ltype == LOGT_ERROR)
      insert(il, length(il), no);
   return;
}
dilend

// ==================== T099 =====================

// Tests DIL template. Tempalte running on unit labcontrol@test
//
dilbegin T099(tstno : integer);
external
    logtest(no : integer, ltype : integer, msg : string);
var
    u : unitptr;
code
{
    heartbeat := PULSE_SEC * 1;
    wait(SFB_TICK, TRUE);
    logtest(tstno, LOGT_ERROR, "Failing on purpose");
    goto failure;

    logtest(tstno, LOGT_INFO, "All good");
    goto cleanup;

:failure:
    logtest(tstno, LOGT_ERROR, "Test not as expected");

:cleanup:
    // Naught

:finished:
    logtest(tstno, LOGT_INFO, "Done");
    sendtoalldil("done", "labdirector@test");
    return;
}
dilend

// ==================== T044 =====================

// On an NPC: records "b<which>", makes one call, records "a<which>". A call that stops the
// program leaves no "a" entry. 0 gamestate, 1 set_password, 2 beginedit, 3 killedit (each on an
// NPC: stops), 4 pagestring to the NPC (goes on), 5 pagestring to a room (stops), else none.
dilbegin t044ref(which : integer);
external
   t042rec(s : string);
var
   u : unitptr;
code
{
   t042rec("b" + itoa(which));
   on which goto g0, g1, g2, g3, g4, g5;
   goto after;
   :g0:
   gamestate(self, GS_MENU);
   goto after;
   :g1:
   set_password(self, "t044pw");
   goto after;
   :g2:
   beginedit(self);
   goto after;
   :g3:
   killedit(self);
   goto after;
   :g4:
   pagestring("x", self);
   goto after;
   :g5:
   u := self.outside;
   pagestring("x", u);
   :after:
   t042rec("a" + itoa(which));
   quit;
}
dilend

// Procedures that change units: addaff/subaff (a character's ability, a second affect with the
// same id, one that runs out, an id out of range, unit flags on an object), addequip/unequip,
// setbright (in the room, worn, carried), addextra/subextra, addstring/substring/insert/remove,
// set/unset, set_weight/set_weight_base, set_fighting/stop_fighting, follow, link, destroy,
// position_update, setroomexit, store, zonereset, logcrime. On an NPC: experience, reset_level,
// reset_vlevel, reset_race, acc_modify change nothing, and gamestate, set_password, beginedit,
// killedit stop the program (they need a PC). delete_player of a name no one has.
dilbegin T044(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
   string t042get(u : unitptr);
var
   nobody : unitptr;
   n : unitptr;
   o : unitptr;
   o2 : unitptr;
   c : unitptr;
   d : unitptr;
   f1 : unitptr;
   f2 : unitptr;
   f3 : unitptr;
   u : unitptr;
   w : unitptr;
   ra : unitptr;
   rb : unitptr;
   z : zoneptr;
   nz : zoneptr;
   eh : extraptr;
   sl : stringlist;
   il : intlist;
   s : string;
   i : integer;
   j : integer;
   k : integer;
   st : integer;
   lt : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T044 unit procedures running");

   n := load("experiment@test");
   link(n, self);
   secure(n, lost);

   // ---- addaff / subaff
   st := n.abilities[ABIL_STR];
   addaff(n, ID_BLANK10, -1, 0, ABIL_STR, 5, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_ABILITY);
   if ((n.abilities[ABIL_STR] != st + 5) or (not isaff(n, ID_BLANK10)))
      logtest(tstno, LOGT_ERROR, "T044 addaff: strength " + itoa(n.abilities[ABIL_STR]) + ", not " + itoa(st + 5));
   addaff(n, ID_BLANK10, -1, 0, ABIL_STR, 3, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_ABILITY);
   if (n.abilities[ABIL_STR] != st + 8)
      logtest(tstno, LOGT_ERROR, "T044 a second addaff with the same id: strength " + itoa(n.abilities[ABIL_STR]));
   subaff(n, ID_BLANK10); // one of the two goes
   i := n.abilities[ABIL_STR] - st;
   if (((i != 3) and (i != 5)) or (not isaff(n, ID_BLANK10)))
      logtest(tstno, LOGT_ERROR, "T044 subaff of one of two affects left " + itoa(i));
   subaff(n, ID_BLANK10);
   subaff(n, ID_BLANK10); // none left: nothing
   if ((n.abilities[ABIL_STR] != st) or isaff(n, ID_BLANK10))
      logtest(tstno, LOGT_ERROR, "T044 subaff of both: strength " + itoa(n.abilities[ABIL_STR]) + ", not " + itoa(st));
   addaff(n, 5000, -1, 0, ABIL_STR, 5, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_ABILITY); // id out of range
   if ((n.abilities[ABIL_STR] != st) or isaff(n, 5000))
      logtest(tstno, LOGT_ERROR, "T044 addaff with an id out of range added it");
   o := load("pbox@test");
   link(o, self);
   secure(o, lost);
   addaff(o, ID_BLANK9, -1, 0, UNIT_FL_MAGIC, 0, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_MOD_UNIT_FLAGS);
   i := isset(o.flags, UNIT_FL_MAGIC);
   subaff(o, ID_BLANK9);
   if ((not i) or isset(o.flags, UNIT_FL_MAGIC))
      logtest(tstno, LOGT_ERROR, "T044 an APF_MOD_UNIT_FLAGS affect on an object didn't set and clear the flag");
   // An affect of one beat runs out on its own and is undone
   addaff(n, ID_BLANK11, 1, PULSE_SEC, ABIL_STR, 2, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_ABILITY);
   if (n.abilities[ABIL_STR] != st + 2)
      logtest(tstno, LOGT_ERROR, "T044 the timed affect didn't apply");
   i := 0;
   while ((i < 15) and isaff(n, ID_BLANK11))
   {
      pause;
      i := i + 1;
   }
   if (isaff(n, ID_BLANK11) or (n.abilities[ABIL_STR] != st))
      logtest(tstno, LOGT_ERROR, "T044 an affect of one beat didn't run out");

   // ---- addequip / unequip
   link(o, n);
   o2 := load("pbox@test");
   link(o2, n);
   secure(o2, lost);
   addequip(o, WEAR_HEAD);
   if ((o.equip != WEAR_HEAD) or (equipment(n, WEAR_HEAD) != o))
      logtest(tstno, LOGT_ERROR, "T044 addequip: equip " + itoa(o.equip));
   addequip(o2, WEAR_HEAD); // taken
   if (o2.equip != 0)
      logtest(tstno, LOGT_ERROR, "T044 addequip at a position already taken");
   unequip(o);
   unequip(o); // not worn: nothing
   if ((o.equip != 0) or (equipment(n, WEAR_HEAD) != null) or (o.outside != n))
      logtest(tstno, LOGT_ERROR, "T044 unequip: equip " + itoa(o.equip));
   link(o2, self);
   addequip(o2, WEAR_HEAD); // not in a character
   if (o2.equip != 0)
      logtest(tstno, LOGT_ERROR, "T044 addequip of an object in a room");

   // ---- setbright: the unit, the room it is in, a character who wears it; carried, only the
   // inside of the character
   lt := self.light;
   setbright(o2, 3);
   if ((o2.bright != 3) or (self.light != lt + 3))
      logtest(tstno, LOGT_ERROR, "T044 setbright 3 in the room: bright " + itoa(o2.bright) + ", room light " +
              itoa(self.light) + " (was " + itoa(lt) + ")");
   setbright(o2, -2);
   if ((o2.bright != -2) or (self.light != lt - 2))
      logtest(tstno, LOGT_ERROR, "T044 setbright -2: bright " + itoa(o2.bright) + ", room light " + itoa(self.light));
   setbright(o2, 0);
   i := n.light;
   j := n.bright;
   setbright(o, 2); // carried by n
   if ((n.light != i + 2) or (n.bright != j) or (self.light != lt))
      logtest(tstno, LOGT_ERROR, "T044 setbright of a carried object: n light " + itoa(n.light) + ", bright " +
              itoa(n.bright) + ", room " + itoa(self.light));
   addequip(o, WEAR_BODY);
   if ((n.bright != j + 2) or (self.light != lt + 2))
      logtest(tstno, LOGT_ERROR, "T044 a worn light: n bright " + itoa(n.bright) + ", room " + itoa(self.light));
   unequip(o);
   setbright(o, 0);
   if ((n.bright != j) or (self.light != lt) or (n.light != i))
      logtest(tstno, LOGT_ERROR, "T044 light not back after setbright 0");

   // ---- addextra / subextra
   addextra(o.extra, {"t044a", "alias"}, "first");
   addextra(o.extra, {"t044a"}, "second", {4, 5}); // same name: the new one first
   eh := o.extra.["t044a"];
   if ((eh.descr != "second") or (length(eh.vals) != 2) or (eh.vals.[1] != 5))
      logtest(tstno, LOGT_ERROR, "T044 addextra with vals: " + eh.descr);
   eh := o.extra.["alias"];
   if (eh.descr != "first")
      logtest(tstno, LOGT_ERROR, "T044 the first extra by its second name: " + eh.descr);
   subextra(o.extra, "t044a"); // only the first goes
   eh := o.extra.["t044a"];
   if (eh.descr != "first")
      logtest(tstno, LOGT_ERROR, "T044 subextra removed the wrong extra");
   subextra(o.extra, "alias");
   if ("t044a" in o.extra)
      logtest(tstno, LOGT_ERROR, "T044 subextra by an extra's second name");
   addextra(o.extra, {"t044 long"}, "x");
   subextra(o.extra, "t044"); // not a whole name
   if (not ("t044 long" in o.extra))
      logtest(tstno, LOGT_ERROR, "T044 subextra removed an extra by part of its name");
   subextra(o.extra, "T044 LONG");
   if ("t044 long" in o.extra)
      logtest(tstno, LOGT_ERROR, "T044 subextra doesn't ignore case");
   addextra(o.extra, null, "t044 no names");
   eh := o.extra;
   if ((eh.descr != "t044 no names") or (length(eh.names) != 0))
      logtest(tstno, LOGT_ERROR, "T044 addextra with null names");
   addextra(o.extra, {"t044e"}, ""); // an empty text is an extra too
   eh := o.extra.["t044e"];
   if ((eh == null) or (eh.descr != ""))
      logtest(tstno, LOGT_ERROR, "T044 addextra with an empty text added nothing");
   subextra(o.extra, "t044e");
   addextra(nobody.extra, {"x"}, "y"); // a null unit: nothing
   subextra(nobody.extra, "x");

   // ---- addstring / substring / insert / remove
   sl := null;
   addstring(sl, "  two   words  ");
   addstring(sl, "b");
   addstring(sl, "b");
   if ((length(sl) != 3) or (strcmp(sl.[0], "two words") != 0) or (sl.[2] != "b"))
      logtest(tstno, LOGT_ERROR, "T044 addstring: " + itoa(length(sl)) + " entries, first '" + sl.[0] + "'");
   addstring(sl, nobody.name); // fails: nothing
   substring(sl, "B");
   if ((length(sl) != 2) or (sl.[1] != "b"))
      logtest(tstno, LOGT_ERROR, "T044 substring of one of two b");
   substring(sl, "two words and more"); // the entry is the first words of it
   substring(sl, "bb");
   substring(sl, "nosuch");
   if ((length(sl) != 1) or (sl.[0] != "b"))
      logtest(tstno, LOGT_ERROR, "T044 substring by first words: " + itoa(length(sl)) + " left");
   il := {1, 2, 3};
   insert(il, 0, 9);
   insert(il, 4, 8);   // at the length: the end
   insert(il, 9, 7);   // past the end: nothing
   insert(il, -1, 7);  // below 0: nothing
   insert(il, 1, "42"); // a string into an intlist: its number
   if ((length(il) != 6) or (il.[0] != 9) or (il.[1] != 42) or (il.[2] != 1) or (il.[5] != 8))
      logtest(tstno, LOGT_ERROR, "T044 insert into an intlist: " + itoa(length(il)) + " entries");
   remove(il, 0);
   remove(il, 9);
   remove(il, -1);
   remove(il, 4);
   if ((length(il) != 4) or (il.[0] != 42) or (il.[3] != 3))
      logtest(tstno, LOGT_ERROR, "T044 remove from an intlist: " + itoa(length(il)) + " entries");
   sl := {"a"};
   insert(sl, 0, 5); // an integer into a stringlist: its digits
   if ((length(sl) != 2) or (sl.[0] != "5"))
      logtest(tstno, LOGT_ERROR, "T044 insert of an integer into a stringlist");
   remove(sl, 0);
   remove(sl, 5);
   if ((length(sl) != 1) or (sl.[0] != "a"))
      logtest(tstno, LOGT_ERROR, "T044 remove from a stringlist");
   addextra(o.extra, {"t044n", "x"}, "y", {1});
   eh := o.extra.["t044n"];
   insert(eh.names, 1, "ins");
   insert(eh.vals, 0, 6);
   if ((eh.names.[1] != "ins") or (eh.names.[2] != "x") or (eh.vals.[0] != 6) or (length(eh.vals) != 2))
      logtest(tstno, LOGT_ERROR, "T044 insert into an extra's names and vals");
   remove(eh.names, 1);
   remove(eh.vals, 0);
   if ((length(eh.names) != 2) or (eh.names.[1] != "x") or (length(eh.vals) != 1))
      logtest(tstno, LOGT_ERROR, "T044 remove from an extra's names and vals");
   subextra(o.extra, "t044n");

   // ---- set / unset: a variable and a field; the field keeps its own size
   i := 5;
   set(i, 2);
   j := i;
   unset(i, 1);
   k := i;
   unset(i, 6 | 8);
   if ((j != 7) or (k != 6) or (i != 0))
      logtest(tstno, LOGT_ERROR, "T044 set/unset on a variable: " + itoa(j) + " " + itoa(k) + " " + itoa(i));
   i := o.flags;
   set(o.flags, UNIT_FL_MAGIC);
   j := o.flags;
   unset(o.flags, UNIT_FL_MAGIC);
   if ((j != (i | UNIT_FL_MAGIC)) or (o.flags != i))
      logtest(tstno, LOGT_ERROR, "T044 set/unset on flags: " + itoa(j) + " then " + itoa(o.flags));
   set(o.flags, 65536); // past 16 bits: lost
   if (o.flags != i)
      logtest(tstno, LOGT_ERROR, "T044 set of bit 16 in the 16-bit flags gave " + itoa(o.flags));
   set(nobody.flags, 1); // a null unit: nothing
   unset(nobody.flags, 1);

   // ---- set_weight_base / set_weight: the change goes to the units it is in
   c := load("pbox@test");
   link(c, self);
   secure(c, lost);
   d := load("pbox@test");
   link(d, c);
   secure(d, lost);
   i := c.weight;
   j := d.baseweight;
   k := d.weight;
   st := self.weight;
   set_weight_base(d, j + 10);
   if ((d.baseweight != j + 10) or (d.weight != k + 10) or (c.weight != i + 10) or (self.weight != st + 10))
      logtest(tstno, LOGT_ERROR, "T044 set_weight_base: base " + itoa(d.baseweight) + ", weight " + itoa(d.weight) +
              ", container " + itoa(c.weight));
   set_weight(d, k + 15);
   if ((d.baseweight != j + 10) or (d.weight != k + 15) or (c.weight != i + 15) or (self.weight != st + 15))
      logtest(tstno, LOGT_ERROR, "T044 set_weight: base " + itoa(d.baseweight) + ", weight " + itoa(d.weight) +
              ", container " + itoa(c.weight));
   set_weight_base(d, j);
   set_weight(d, k);
   if ((d.weight != k) or (c.weight != i) or (self.weight != st))
      logtest(tstno, LOGT_ERROR, "T044 weights not back");

   // ---- link: not into itself or what is inside it; a room only into a room; a worn object
   // comes off
   link(c, c);
   link(c, d);
   if ((c.outside != self) or (d.outside != c))
      logtest(tstno, LOGT_ERROR, "T044 link into itself or into what it holds moved it");
   ra := findroom("currentb@test");
   link(ra, c);
   if (ra.outside != null)
      logtest(tstno, LOGT_ERROR, "T044 link put a room into an object");
   addequip(o, WEAR_HEAD);
   link(o, self);
   if ((o.equip != 0) or (o.outside != self) or (equipment(n, WEAR_HEAD) != null))
      logtest(tstno, LOGT_ERROR, "T044 link of a worn object");

   // ---- destroy: with what is inside (checked at the end: loadcount still counts a unit
   // destroyed in this pass of the game loop); not a room; null nothing
   lt := o.loadcount;
   unsecure(c);
   unsecure(d);
   destroy(c); // with d in it
   i := 0;
   u := self.inside;
   while (u != null)
   {
      if (u == c)
         i := i + 1;
      u := u.next;
   }
   if (i != 0)
      logtest(tstno, LOGT_ERROR, "T044 destroy left the box in the room");
   destroy(ra);
   ra := findroom("currentb@test");
   if (ra == null)
      logtest(tstno, LOGT_ERROR, "T044 destroy removed a room");
   destroy(nobody);

   // ---- setroomexit
   ra := findroom("testlabe@test");
   rb := findroom("currentb@test");
   w := ra.exit_to[DIR_EAST];
   setroomexit(ra, DIR_EAST, rb);
   if (ra.exit_to[DIR_EAST] != rb)
      logtest(tstno, LOGT_ERROR, "T044 setroomexit didn't change an exit");
   setroomexit(ra, DIR_EAST, w);
   if (ra.exit_to[DIR_NORTH] != null)
      logtest(tstno, LOGT_ERROR, "T044 testlabe has a north exit");
   setroomexit(ra, DIR_NORTH, rb); // a new exit
   i := (ra.exit_to[DIR_NORTH] == rb);
   setroomexit(ra, DIR_NORTH, nobody); // closed again
   if ((not i) or (ra.exit_to[DIR_NORTH] != null) or (ra.exit_to[DIR_EAST] != w))
      logtest(tstno, LOGT_ERROR, "T044 setroomexit of a new exit or back");
   setroomexit(ra, DIR_ENTER, rb); // not an exit: refused
   setroomexit(ra, 99, rb);

   // ---- set_fighting / stop_fighting / change_speed, follow, position_update, logcrime, and
   // the PC-only procedures on NPCs, in testlabe (no pause while they are there)
   f1 := load("experiment@test");
   f2 := load("experiment@test");
   f3 := load("experiment@test");
   link(f1, ra);
   link(f2, ra);
   link(f3, ra);
   // f1 hits f2, and each is the other's opponent; f2 picks whom it hits in its own round
   set_fighting(f1, f2);
   if ((f1.fighting != f2) or (f1.position != POSITION_FIGHTING) or (f1.opponentcount != 1) or
       (f2.opponentcount != 1) or (not opponent(f2, f1)) or (f2.position != POSITION_STANDING))
      logtest(tstno, LOGT_ERROR, "T044 set_fighting: position " + itoa(f1.position) + ", opponents " +
              itoa(f1.opponentcount) + " and " + itoa(f2.opponentcount));
   set_fighting(f1, f3); // f1 keeps hitting f2
   if ((f1.fighting != f2) or (f3.opponentcount != 1) or (f1.opponentcount != 2) or (not opponent(f1, f3)))
      logtest(tstno, LOGT_ERROR, "T044 a second set_fighting: f1 has " + itoa(f1.opponentcount) + " opponents");
   set_fighting(f1, f1);
   set_fighting(f1, o);
   if (f1.opponentcount != 2)
      logtest(tstno, LOGT_ERROR, "T044 set_fighting with itself or an object");
   change_speed(f1, PULSE_VIOLENCE); // only the delay of its next attacks: nothing to read
   change_speed(o, PULSE_VIOLENCE);
   stop_fighting(f1, f2);
   if ((f2.fighting != null) or (f2.opponentcount != 0) or (f1.opponentcount != 1) or (not opponent(f1, f3)))
      logtest(tstno, LOGT_ERROR, "T044 stop_fighting with one: f1 has " + itoa(f1.opponentcount) + " opponents");
   stop_fighting(f1, null);
   if ((f1.fighting != null) or (f3.fighting != null) or (f1.opponentcount != 0) or (f1.position != POSITION_STANDING))
      logtest(tstno, LOGT_ERROR, "T044 stop_fighting with all: position " + itoa(f1.position));

   follow(f2, f1);
   if ((f2.master != f1) or (f1.followercount != 1) or (getfollower(f1, 0) != f2))
      logtest(tstno, LOGT_ERROR, "T044 follow: master, followercount " + itoa(f1.followercount));
   follow(f2, f3);
   if ((f2.master != f3) or (f1.followercount != 0) or (f3.followercount != 1))
      logtest(tstno, LOGT_ERROR, "T044 follow another leader");
   follow(o, f1); // not a character: nothing
   follow(f2, null);
   if ((f2.master != null) or (f3.followercount != 0) or (f1.followercount != 0))
      logtest(tstno, LOGT_ERROR, "T044 follow null didn't stop following");

   // logcrime: an NPC not protected is no victim; a protected one witnesses it
   logcrime(f2, f3, CRIME_STEALING);
   i := 0;
   eh := f3.extra;
   while (eh != null)
   {
      if (left(eh.names.[0], 8) == "$witness")
         i := i + 1;
      eh := eh.next;
   }
   set(f3.charflags, CHAR_PROTECTED);
   logcrime(o, f3, CRIME_STEALING); // not a character: nothing
   logcrime(f2, f3, CRIME_STEALING);
   j := 0;
   eh := f3.extra;
   while (eh != null)
   {
      if (left(eh.names.[0], 8) == "$witness")
         j := j + 1;
      eh := eh.next;
   }
   if ((i != 0) or (j != 1))
      logtest(tstno, LOGT_ERROR, "T044 logcrime: witness extras " + itoa(i) + " (not 0) and " + itoa(j) + " (not 1)");

   // On an NPC these change nothing (they work on players)
   i := f1.exp;
   experience(1000, f1);
   f1.level := 10;
   j := f1.level;
   reset_level(f1);
   reset_vlevel(f1);
   k := f1.weight;
   st := f1.height;
   reset_race(f1);
   acc_modify(f1, 100);
   if ((f1.exp != i) or (f1.level != j) or (f1.weight != k) or (f1.height != st))
      logtest(tstno, LOGT_ERROR, "T044 experience/reset_level/reset_race changed an NPC");

   // delete_player of a name no player has: nothing, and an NPC of that name stays
   k := f1.loadcount;
   if (isplayer("experiment"))
      logtest(tstno, LOGT_INFO, "T044 there is a player called experiment: skipped delete_player");
   else
   {
      delete_player("experiment");
      delete_player("t044nobody");
      if ((f1.loadcount != k) or isplayer("t044nobody"))
         logtest(tstno, LOGT_ERROR, "T044 delete_player of a name no player has did something");
   }

   // position_update: the position from the hit points; -11 or less dies
   f1.hp := 0;
   position_update(f1);
   i := f1.position;
   f1.hp := -4;
   position_update(f1);
   j := f1.position;
   f1.hp := -8;
   position_update(f1);
   k := f1.position;
   f1.hp := 5;
   position_update(f1);
   if ((i != POSITION_STUNNED) or (j != POSITION_INCAP) or (k != POSITION_MORTALLYW) or (f1.position != POSITION_STANDING))
      logtest(tstno, LOGT_ERROR, "T044 position_update gave " + itoa(i) + " " + itoa(j) + " " + itoa(k) + " " +
              itoa(f1.position));
   f1.position := POSITION_SLEEPING;
   position_update(f1); // 1 or more: as it is
   position_update(o);  // not a character: nothing
   if (f1.position != POSITION_SLEEPING)
      logtest(tstno, LOGT_ERROR, "T044 position_update woke a sleeping NPC with hit points");
   k := n.loadcount;
   destroy(f2);
   destroy(f3);
   f1.hp := -20;
   position_update(f1); // dies: f2, f3 and f1 gone by the end

   // ---- On an NPC: gamestate, set_password, beginedit, killedit and pagestring to a room stop
   // the program; pagestring to the NPC doesn't
   dilcopy("t044ref@test(0)", n);
   dilcopy("t044ref@test(1)", n);
   dilcopy("t044ref@test(2)", n);
   dilcopy("t044ref@test(3)", n);
   dilcopy("t044ref@test(4)", n);
   dilcopy("t044ref@test(5)", n);
   dilcopy("t044ref@test(9)", n);

   // ---- zonereset: what t044rm lost comes back, once (max 1), in a RESET_NOT zone
   z := findzone("test");
   u := findroom("t044rm@test");
   u := u.inside;
   if ((u == null) or (u.nameidx != "t044zr"))
      logtest(tstno, LOGT_ERROR, "T044 t044zr wasn't loaded at boot");
   destroy(u);
   pause; // the reset counts a unit destroyed in this pass
   zonereset(z);
   zonereset(z);
   zonereset(nz); // null: nothing
   u := findroom("t044rm@test");
   i := 0;
   u := u.inside;
   while (u != null)
   {
      if (u.nameidx == "t044zr")
         i := i + 1;
      u := u.next;
   }
   if (i != 1)
      logtest(tstno, LOGT_ERROR, "T044 zonereset: " + itoa(i) + " t044zr, not 1");

   // ---- store (T029 checks an empty unit): a container with its contents, and the contents only
   c := load("pbox@test");
   link(c, self);
   d := load("pbox@test");
   link(d, c);
   i := delunit("t044st");
   store(c, "t044st", TRUE);
   u := restore("t044st", self);
   if ((u == null) or (u == c) or (u.nameidx != "pbox") or (u.inside == null))
      logtest(tstno, LOGT_ERROR, "T044 store with the container didn't bring it back with its contents");
   destroy(u);
   store(c, "t044st", FALSE);
   w := load("pbox@test");
   link(w, self);
   u := restore("t044st", w);
   if ((u == null) or (u.outside != w) or (w.inside != u) or (u.inside != null))
      logtest(tstno, LOGT_ERROR, "T044 store of the contents only");
   i := delunit("t044st");
   destroy(w);
   destroy(c);

   // ---- Wait for the programs on n, and for the death
   i := 0;
   s := "";
   while ((i < 10) and (not ("a9;" in s)))
   {
      pause;
      i := i + 1;
      s := t042get(n);
   }
   if ((not ("b0;" in s)) or (not ("b1;" in s)) or (not ("b2;" in s)) or (not ("b3;" in s)) or
       (not ("b4;" in s)) or (not ("b5;" in s)) or (not ("a4;" in s)) or (not ("a9;" in s)))
      logtest(tstno, LOGT_ERROR, "T044 the programs on the NPC didn't all run: " + s);
   if (("a0;" in s) or ("a1;" in s) or ("a2;" in s) or ("a3;" in s) or ("a5;" in s))
      logtest(tstno, LOGT_ERROR, "T044 a program on an NPC went on after a call for a player: " + s);
   if (n.loadcount != k - 3)
      logtest(tstno, LOGT_ERROR, "T044 position_update at -20 hit points didn't kill: " + itoa(k - n.loadcount) +
              " of 3 gone");
   // Since the destroy() of the box with a box in it, as many boxes were loaded as destroyed
   if (o.loadcount != lt - 2)
      logtest(tstno, LOGT_ERROR, "T044 destroy of a box with a box in it: " + itoa(lt - o.loadcount) + " gone, not 2");
   goto cleanup;

   :lost:
   logtest(tstno, LOGT_ERROR, "T044 lost a test unit");

   :cleanup:
   unsecure(n);
   unsecure(o);
   unsecure(o2);
   unsecure(c);
   unsecure(d);
   foreach (UNIT_ST_OBJ | UNIT_ST_NPC, u)
   {
      if ((u.nameidx == "pbox") or (u.nameidx == "experiment"))
         destroy(u);
   }
   u := findroom("testlabe@test");
   u := u.inside;
   while (u != null)
   {
      w := u.next;
      if (u.type != UNIT_ST_PC)
         destroy(u);
      u := w;
   }
   logtest(tstno, LOGT_INFO, "T044 Done");
   sendtoalldil("done", "labdirector@test");
   quit;
}
dilend

// ==================== T043 =====================

// On a t043box: records each message (text/sender, +t when it is the target) and each
// SFB_DONE of "get" (D, the argument, the power, t when it is the target, e when an experiment
// did it)
dilbegin t043rcv();
external
   t042rec(s : string);
var
   s : string;
code
{
   heartbeat := PULSE_SEC;
   t042rec("ready");
   :loop:
   wait(SFB_MSG | SFB_DONE, TRUE);
   if (command("get"))
   {
      s := "D" + argument + itoa(power);
      if (target == self)
         s := s + "t";
      if (activator.nameidx == "experiment")
         s := s + "e";
      t042rec(s);
   }
   else if (command(CMD_AUTO_MSG))
   {
      s := argument + "/" + activator.nameidx;
      if (target == self)
         s := s + "t";
      t042rec(s);
   }
   goto loop;
}
dilend

// On the NPC: send()s "b" when told "dosend"; blocks its own "west" until told "unblock"
dilbegin aware fnpri(FN_PRI_BLOCK) t043snd();
external
   t042rec(s : string);
var
   blk : integer;
code
{
   heartbeat := PULSE_SEC;
   blk := 1;
   t042rec("sready");
   :loop:
   wait(SFB_MSG | SFB_CMD, TRUE);
   if (command("west"))
   {
      if (blk)
         block;
   }
   else if (argument == "dosend")
      send("b");
   else if (argument == "unblock")
      blk := 0;
   goto loop;
}
dilend

// On the NPC, after t043snd: records the commands the NPC carries out
dilbegin aware t043cmd();
external
   t042rec(s : string);
code
{
   heartbeat := PULSE_SEC;
   t042rec("cready");
   :loop:
   wait(SFB_CMD, activator == self);
   t042rec("C" + cmdstr);
   goto loop;
}
dilend

// Copied with dilcopy("t043arg@test(...)"): records its arguments
dilbegin t043arg(sx : string, ix : integer);
external
   t042rec(s : string);
code
{
   t042rec(sx + "|" + itoa(ix));
   quit;
}
dilend

dilbegin unique t043uni();
external
   t042rec(s : string);
code
{
   t042rec("u");
   quit;
}
dilend

// How many entries of a record are item
dilbegin integer t043count(rec : string, item : string);
var
   sl : stringlist;
   i : integer;
   n : integer;
code
{
   sl := split(rec, ";");
   while (i < length(sl))
   {
      if (sl.[i] == item)
         n := n + 1;
      i := i + 1;
   }
   return(n);
}
dilend

// Messages and commands between units: two boxes r1 (in testlabc) and r2 (in testlabe) with
// t043rcv count what reaches them. sendto() reaches one unit; send() (from the NPC s in
// testlabc) the units in its room; sendtoall() every unit of a definition; sendtoalldil()
// every copy of a template (and it is their target); a name without its zone, or one that
// doesn't exist, reaches no one. send_done() reaches the units around its activator and the
// "other" unit, with its argument, power and target; an unknown command sends nothing.
// exec() carries out a command (a move east and back) that the NPC's own aware programs see,
// and a block on SFB_CMD keeps the command from running and from the later programs. dilcopy()
// with arguments, with the wrong ones, and of a unique template. act() as an expression: the
// codes $1n $3n $1e $1m $1s $1a $1N $2t $$, the capital, nobody for TO_VICT without a victim;
// act() as a procedure wakes no program. sendtext()/pagestring() to an NPC show nothing and
// don't stop the program (what they send needs a PC).
dilbegin T043(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
   string t042get(u : unitptr);
   integer t043count(rec : string, item : string);
var
   r1 : unitptr;
   r2 : unitptr;
   s : unitptr;
   u : unitptr;
   w : unitptr;
   rc : unitptr;
   re : unitptr;
   t : string;
   t2 : string;
   i : integer;
   n : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T043 messages and commands running");

   r1 := load("t043box@test");
   link(r1, self);
   secure(r1, lost);
   r2 := load("t043box@test");
   link(r2, self);
   secure(r2, lost);
   s := load("experiment@test");
   link(s, self);
   secure(s, lost);
   dilcopy("t043rcv@test", r1);
   dilcopy("t043rcv@test", r2);
   dilcopy("t043snd@test", s);
   dilcopy("t043cmd@test", s);

   // dilcopy: a string (with its space) and an integer; a wrong count or a word for the
   // integer starts nothing; a unique template only once
   dilcopy("t043arg@test(abc def,42)", r1);
   dilcopy("t043arg@test(abc)", r1);
   dilcopy("t043arg@test(xyz,4x)", r1);
   dilcopy("t043uni@test", r2);
   dilcopy("t043uni@test", r2);
   dilcopy("t043nosuch@test", r2);
   if (not dilfind("t043arg@test", r1))
      logtest(tstno, LOGT_ERROR, "T043 dilcopy put no t043arg on the box");

   n := 0;
   i := 0;
   while ((n < 10) and (i < 5))
   {
      pause;
      n := n + 1;
      i := 0;
      t := t042get(r1);
      if ("ready;" in t)
         i := i + 1;
      if ("abc def|42;" in t)
         i := i + 1;
      t := t042get(r2);
      if ("ready;" in t)
         i := i + 1;
      t := t042get(s);
      if ("sready;" in t)
         i := i + 1;
      if ("cready;" in t)
         i := i + 1;
   }
   if (i < 5)
      logtest(tstno, LOGT_ERROR, "T043 only " + itoa(i) + " of 5 programs started");
   t := t042get(r1);
   if ((t043count(t, "abc def|42") != 1) or ("xyz" in t) or ("abc|" in t))
      logtest(tstno, LOGT_ERROR, "T043 dilcopy with arguments: " + t);
   t := t042get(r2);
   i := t043count(t, "u");
   if (i != 1)
      logtest(tstno, LOGT_ERROR, "T043 a unique template copied twice ran " + itoa(i) + " times");
   subextra(r1.extra, "$t042r");
   subextra(r2.extra, "$t042r");
   subextra(s.extra, "$t042r");

   // From here on no pause: the units go to other rooms, where a secure would be lost
   unsecure(r1);
   unsecure(r2);
   unsecure(s);
   rc := findroom("testlabc@test");
   re := findroom("testlabe@test");
   link(r1, rc);
   link(s, rc);
   link(r2, re);

   sendto("a", r1);
   sendto("dosend", s); // s send()s "b" to its room
   t := t042get(r1);
   t2 := t042get(r2);
   if ((t != "a/labcontrol;b/experiment;") or (t2 != ""))
      logtest(tstno, LOGT_ERROR, "T043 sendto and send: r1 got " + t + ", r2 " + t2);
   subextra(r1.extra, "$t042r");

   sendtoall("c", "t043box@test");
   sendtoalldil("d", "t043rcv@test");
   sendtoall("x1", "t043box");
   sendtoall("x2", "t043nosuch@test");
   sendtoalldil("x3", "t043rcv");
   sendtoalldil("x4", "t043nosuch@test");
   t := t042get(r1);
   t2 := t042get(r2);
   if ((t != "c/labcontrol;d/labcontrolt;") or (t2 != t))
      logtest(tstno, LOGT_ERROR, "T043 sendtoall and sendtoalldil: r1 got " + t + ", r2 " + t2);
   subextra(r1.extra, "$t042r");
   subextra(r2.extra, "$t042r");

   send_done("get", s, null, r1, 7, "garg", r2, CMD_AUTO_NONE);
   send_done("t043nosuchcmd", s, null, r1, 8, "garg", r2, CMD_AUTO_NONE);
   t := t042get(r1);
   t2 := t042get(r2);
   if ((t != "Dgarg7te;") or (t2 != "Dgarg7e;"))
      logtest(tstno, LOGT_ERROR, "T043 send_done: r1 got " + t + " (not Dgarg7te;), r2 " + t2 + " (not Dgarg7e;)");
   subextra(r1.extra, "$t042r");
   subextra(r2.extra, "$t042r");

   // act() as a procedure: NPCs and their programs never see it
   act("$1n waves.", A_ALWAYS, s, null, null, TO_ALL);
   t := t042get(r1);
   if (t != "")
      logtest(tstno, LOGT_ERROR, "T043 act() woke a program: " + t);

   // exec: the NPC walks east and back; its own block keeps it from going west until told
   exec("east", s);
   if (s.outside != re)
      logtest(tstno, LOGT_ERROR, "T043 exec east didn't move the NPC");
   exec("west", s);
   if (s.outside != re)
      logtest(tstno, LOGT_ERROR, "T043 a blocked west was carried out");
   sendto("unblock", s);
   exec("west", s);
   if (s.outside != rc)
      logtest(tstno, LOGT_ERROR, "T043 exec west after the block didn't move the NPC");
   t := t042get(s);
   if (t != "Ceast;Clook;Cwest;Clook;") // each move ends with a look; the blocked west isn't there
      logtest(tstno, LOGT_ERROR, "T043 the NPC's later program saw " + t + " (not Ceast;Clook;Cwest;Clook;)");
   exec("east", r1); // not a character: nothing
   if (r1.outside != rc)
      logtest(tstno, LOGT_ERROR, "T043 exec moved an object");

   // act() as an expression: the text as its reader would see it
   if ((strcmp(act("$1n waves at $3n.", A_ALWAYS, s, null, r1, TO_CHAR), "An experiment waves at a t043 box.<br/>") != 0) or
       (strcmp(act("$1e $1m $1s", A_ALWAYS, s, null, null, TO_CHAR), "It it its<br/>") != 0) or
       (strcmp(act("$1a $1N costs 5$$", A_ALWAYS, s, null, null, TO_CHAR), "An experiment costs 5$<br/>") != 0) or
       (strcmp(act("$2t!", A_ALWAYS, s, "hi there", null, TO_CHAR), "Hi there!<br/>") != 0) or
       (act("x", A_ALWAYS, s, null, null, TO_VICT) != ""))
      logtest(tstno, LOGT_ERROR, "T043 act() texts: '" + act("$1n waves at $3n.", A_ALWAYS, s, null, r1, TO_CHAR) +
              "' '" + act("$1e $1m $1s", A_ALWAYS, s, null, null, TO_CHAR) + "' '" +
              act("$1a $1N costs 5$$", A_ALWAYS, s, null, null, TO_CHAR) + "'");

   // Text for a player: an NPC gets nothing, and the program goes on
   i := 0;
   sendtext("hello<br/>", s);
   pagestring("hello", s);
   sendtext("hello<br/>", r1);
   i := 1;
   if (i != 1)
      logtest(tstno, LOGT_ERROR, "T043 sendtext or pagestring stopped the program");

   destroy(r1);
   destroy(r2);
   destroy(s);
   logtest(tstno, LOGT_INFO, "T043 Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:lost:
   logtest(tstno, LOGT_ERROR, "T043 lost a test unit");
   unsecure(r1);
   unsecure(r2);
   unsecure(s);
   destroy(r1);
   destroy(r2);
   destroy(s);
   logtest(tstno, LOGT_INFO, "T043 Done");
   sendtoalldil("done", "labdirector@test");
   quit;
}
dilend

// ==================== T042 =====================

// Record helpers, also used by T043 and T044: a program writes what happened to it into the
// hidden extra $t042r on its own unit, as entries each ended by ';', and the test reads it.
dilbegin t042rec(s : string);
var
   t : string;
   ex : extraptr;
code
{
   ex := self.extra.["$t042r"];
   if (ex != null)
   {
      t := ex.descr;
      subextra(self.extra, "$t042r");
   }
   addextra(self.extra, {"$t042r"}, t + s + ";");
   return;
}
dilend

dilbegin string t042get(u : unitptr);
var
   ex : extraptr;
code
{
   ex := u.extra.["$t042r"];
   if (ex == null)
      return("");
   return(ex.descr);
}
dilend

dilbegin integer t042sq(i : integer);
code
{
   return(i * i);
}
dilend

dilbegin integer t042fact(n : integer);
var
   m : integer;
code
{
   if (n <= 1)
      return(1);
   m := t042fact(n - 1);
   return(n * m);
}
dilend

// return; leaves the procedure early
dilbegin t042early(n : integer);
external
   t042rec(s : string);
code
{
   t042rec("a");
   if (n == 1)
      return;
   t042rec("b");
   return;
}
dilend

// quit in a called procedure ends the whole program
dilbegin t042quit();
external
   t042rec(s : string);
code
{
   t042rec("q");
   quit;
}
dilend

dilbegin t042qh();
external
   t042rec(s : string);
   t042quit();
code
{
   t042rec("before");
   t042quit();
   t042rec("after");
   quit;
}
dilend

// return; in the template the unit runs ends the program
dilbegin t042rh();
external
   t042rec(s : string);
code
{
   t042rec("r1");
   return;
   t042rec("r2");
   quit;
}
dilend

// Runs past its closing brace: starts again from the top with its variables kept
dilbegin t042wrap();
external
   t042rec(s : string);
   string t042get(u : unitptr);
var
   i : integer;
   s : string;
code
{
   i := i + 1;
   t042rec(itoa(i));
   if (i >= 3)
      quit;
   s := t042get(self);
   if (length(s) > 40) // the variables were lost: don't run for ever
      quit;
}
dilend

// wait() goes on only for its condition; unit variables not secured are null after every wake,
// also after waitnoop, which continues once the event that woke the program is over
dilbegin t042wt();
external
   t042rec(s : string);
var
   u : unitptr;
code
{
   heartbeat := PULSE_SEC;
   t042rec("ready");
   u := self.outside;
   wait(SFB_MSG, argument == "go");
   if (u == null)
      t042rec("cleared");
   else
      t042rec("kept");
   t042rec("go");
   u := self.outside;
   waitnoop;
   if (u == null)
      t042rec("cleared2");
   else
      t042rec("kept2");
   t042rec("noop");
   quit;
}
dilend

// Holds priority on its unit between "hold" and "release"; "holdquit" takes it and ends
dilbegin fnpri(FN_PRI_COMBAT) t042pri();
external
   t042rec(s : string);
code
{
   heartbeat := PULSE_SEC;
   t042rec("pready");
   :loop:
   wait(SFB_MSG, TRUE);
   if (argument == "hold")
      priority;
   else if (argument == "release")
      nopriority;
   else if (argument == "holdquit")
   {
      priority;
      quit;
   }
   goto loop;
}
dilend

// Blocks "stop"; "stopquit" is blocked and ends the program
dilbegin fnpri(FN_PRI_BLOCK) t042blk();
external
   t042rec(s : string);
code
{
   heartbeat := PULSE_SEC;
   t042rec("bready");
   :loop:
   wait(SFB_MSG, TRUE);
   if (argument == "stop")
      block;
   else if (argument == "stopquit")
   {
      block;
      quit;
   }
   goto loop;
}
dilend

// After t042pri or t042blk on the same unit: records every message that reaches it
dilbegin t042cnt();
external
   t042rec(s : string);
code
{
   heartbeat := PULSE_SEC;
   t042rec("ready");
   :loop:
   wait(SFB_MSG, TRUE);
   t042rec(argument);
   goto loop;
}
dilend

// Three interrupts, numbered 0, 1 and 2; clear(0) moves the others down, so clear(1) then
// removes the one that was 2. Only "ib" is left to fire.
dilbegin t042int();
external
   t042rec(s : string);
var
   i0 : integer;
   i1 : integer;
   i2 : integer;
code
{
   heartbeat := PULSE_SEC;
   i0 := interrupt(SFB_MSG, argument == "ia", la);
   i1 := interrupt(SFB_MSG, argument == "ib", lb);
   i2 := interrupt(SFB_MSG, argument == "ic", lc);
   t042rec(itoa(i0) + itoa(i1) + itoa(i2));
   clear(i0);
   clear(7); // not in use: nothing
   clear(1);
   t042rec("ready");
   :wt:
   wait(SFB_MSG, argument == "end");
   t042rec("end");
   quit;
   :la:
   t042rec("a");
   goto wt;
   :lb:
   t042rec("b");
   goto wt;
   :lc:
   t042rec("c");
   goto wt;
}
dilend

// Control flow: if/else (nesting, else if, what counts as true), while with break and continue
// in nested loops, goto, on ... goto (skip, below 0, past the end, a failed value), foreach
// (each kind of unit, transparent containers, units that leave or are destroyed before their
// turn, break and continue), return from functions and procedures (recursion, early return,
// return at the top), quit in a called procedure, a program running past its closing brace,
// wait and waitnoop (conditions, unit variables cleared), secure/unsecure (a unit leaving, a
// destroyed unit, a second secure, a kept unit), priority/nopriority, block, and clear() of
// interrupts.
dilbegin T042(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
   t042rec(s : string);
   string t042get(u : unitptr);
   integer t042sq(i : integer);
   integer t042fact(n : integer);
   t042early(n : integer);
var
   nobody : unitptr;
   notset : string;
   u : unitptr;
   w : unitptr;
   rm : unitptr;
   h1 : unitptr;
   h2 : unitptr;
   h3 : unitptr;
   h4 : unitptr;
   h5 : unitptr;
   h6 : unitptr;
   h7 : unitptr;
   b1 : unitptr;
   b2 : unitptr;
   b3 : unitptr;
   b4 : unitptr;
   b5 : unitptr;
   b6 : unitptr;
   cg : unitptr;
   e : unitptr;
   s : string;
   sv : string;
   sl : stringlist;
   il : intlist;
   i : integer;
   j : integer;
   k : integer;
   n : integer;
   total : integer;
   inner : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T042 control flow running");

   // ---- if / else
   // An else goes with the nearest if
   n := 0;
   if (1)
      if (0)
         n := 1;
      else
         n := 2;
   if (n != 2)
      logtest(tstno, LOGT_ERROR, "T042 an else didn't go with the inner if: " + itoa(n));
   n := 0;
   if (0)
      if (1)
         n := 1;
      else
         n := 2;
   if (n != 0)
      logtest(tstno, LOGT_ERROR, "T042 the else of an inner if ran when the outer if was false");
   i := 3;
   if (i == 1)
      s := "one";
   else if (i == 3)
      s := "three";
   else
      s := "other";
   if (s != "three")
      logtest(tstno, LOGT_ERROR, "T042 an else if chain gave " + s);

   // True: a non-zero integer, a unit, a string that is set (even to ""), a list with an
   // element. False: 0, null, a string never set, an empty list, and a failed value (a field
   // of null) in any comparison.
   n := 0;
   if (7)
      n := n + 1;
   if (-1)
      n := n + 1;
   if (0)
      n := n + 100;
   if (self)
      n := n + 1;
   if (nobody)
      n := n + 100;
   sv := "";
   if (sv)
      n := n + 1;
   if (notset)
      n := n + 100;
   if (sl)
      n := n + 100;
   if (il)
      n := n + 100;
   sl := {"a"};
   if (sl)
      n := n + 1;
   il := {0};
   if (il)
      n := n + 1;
   if (nobody.level)
      n := n + 100;
   if (nobody.level > 5)
      n := n + 100;
   if (nobody.level <= 5)
      n := n + 100;
   if (n != 6)
      logtest(tstno, LOGT_ERROR, "T042 if took the wrong branches: " + itoa(n) + ", not 6");

   // ---- while, break, continue: each acts on the innermost loop
   i := 0;
   total := 0;
   inner := 0;
   while (i < 5)
   {
      i := i + 1;
      if (i == 2)
         continue;
      j := 0;
      while (1)
      {
         j := j + 1;
         if (j == 2)
            continue;
         if (j > 4)
            break;
         inner := inner + j; // 1 + 3 + 4
      }
      if (i == 4)
         break;
      total := total + i;
   }
   if ((i != 4) or (total != 4) or (inner != 24))
      logtest(tstno, LOGT_ERROR, "T042 nested while with break and continue: i " + itoa(i) +
              ", total " + itoa(total) + ", inner " + itoa(inner) + " (not 4, 4, 24)");
   n := 0;
   while (0)
      n := n + 1;
   while (nobody.level >= 0) // a failed value: false
      n := n + 1;
   if (n != 0)
      logtest(tstno, LOGT_ERROR, "T042 a while with a false or failed condition ran");

   // ---- goto: backwards, forwards, and out of a loop
   n := 0;
   :gback:
   n := n + 1;
   if (n < 3)
      goto gback;
   i := 0;
   while (1)
   {
      i := i + 1;
      if (i == 5)
         goto gout;
   }
   logtest(tstno, LOGT_ERROR, "T042 goto out of a while didn't jump");
   :gout:
   if ((n != 3) or (i != 5))
      logtest(tstno, LOGT_ERROR, "T042 goto loop ran " + itoa(n) + " times, the while " + itoa(i));

   // ---- on ... goto: counts from 0; skip, below 0 and past the end go on after the on
   s := "";
   i := 0;
   :onloop:
   k := i - 1;
   on k goto on0, on1, skip, on3;
   s := s + "f";
   goto onnext;
   :on0:
   s := s + "0";
   goto onnext;
   :on1:
   s := s + "1";
   goto onnext;
   :on3:
   s := s + "3";
   :onnext:
   i := i + 1;
   if (i < 7)
      goto onloop;
   on nobody.level goto on9, on9; // a failed value goes on too
   s := s + "x";
   goto ondone;
   :on9:
   s := s + "9";
   :ondone:
   if (s != "f01f3ffx")
      logtest(tstno, LOGT_ERROR, "T042 on ... goto took " + s + ", not f01f3ffx");

   // ---- return: a function's value, recursion, a procedure that returns early
   i := t042sq(7);
   j := t042fact(5);
   if ((i != 49) or (j != 120))
      logtest(tstno, LOGT_ERROR, "T042 functions returned " + itoa(i) + " and " + itoa(j) +
              ", not 49 and 120");
   subextra(self.extra, "$t042r");
   t042early(1);
   t042early(2);
   s := t042get(self);
   subextra(self.extra, "$t042r");
   if (s != "a;a;b;")
      logtest(tstno, LOGT_ERROR, "T042 early return in a procedure: " + s + ", not a;a;b;");

   // ---- foreach. In the room: b1, b2, b3, the open transparent cage cg with b4 in it, b5
   // inside b1 (not transparent), the NPC e carrying b6. Each unit has its own weight, so a
   // sum shows which were listed, and that none came twice.
   b1 := load("pbox@test");
   link(b1, self);
   b2 := load("pbox@test");
   link(b2, self);
   b3 := load("pbox@test");
   link(b3, self);
   cg := load("cage@test");
   link(cg, self);
   b4 := load("pbox@test");
   link(b4, cg);
   b5 := load("pbox@test");
   link(b5, b1);
   e := load("experiment@test");
   link(e, self);
   b6 := load("pbox@test");
   link(b6, e);

   n := 0;
   k := 0;
   foreach (UNIT_ST_OBJ, u)
   {
      if (u == b1)
         n := n + 1;
      else if (u == b2)
         n := n + 2;
      else if (u == b3)
         n := n + 4;
      else if (u == b4)
         n := n + 8;
      else if (u == cg)
         n := n + 16;
      else if ((u == b5) or (u == b6) or (u == e))
         n := n + 100;
      if (u.type != UNIT_ST_OBJ)
         k := k + 1;
   }
   if ((n != 31) or (k != 0))
      logtest(tstno, LOGT_ERROR, "T042 foreach (UNIT_ST_OBJ) listed " + itoa(n) + " (not 31), " +
              itoa(k) + " of another type");
   n := 0;
   foreach (UNIT_ST_NPC, u)
   {
      if (u == e)
         n := n + 1;
      else if (u.type != UNIT_ST_NPC)
         n := n + 100;
   }
   if (n != 1)
      logtest(tstno, LOGT_ERROR, "T042 foreach (UNIT_ST_NPC) gave " + itoa(n) + ", not 1");
   n := 0;
   foreach (UNIT_ST_ROOM, u) // the program's own unit, a room
   {
      if (u == self)
         n := n + 1;
      else
         n := n + 100;
   }
   if (n != 1)
      logtest(tstno, LOGT_ERROR, "T042 foreach (UNIT_ST_ROOM) on a room gave " + itoa(n) + ", not 1");
   n := 0;
   foreach (0, u)
      n := n + 1;
   if (n != 0)
      logtest(tstno, LOGT_ERROR, "T042 foreach (0) ran " + itoa(n) + " times");
   n := 0;
   foreach (UNIT_ST_OBJ | UNIT_ST_NPC, u)
   {
      if (u == b1)
         n := n + 1;
      else if (u == b2)
         n := n + 2;
      else if (u == b3)
         n := n + 4;
      else if (u == b4)
         n := n + 8;
      else if (u == cg)
         n := n + 16;
      else if (u == e)
         n := n + 32;
      else if ((u == b5) or (u == b6))
         n := n + 100;
   }
   if (n != 63)
      logtest(tstno, LOGT_ERROR, "T042 foreach (UNIT_ST_OBJ | UNIT_ST_NPC) listed " + itoa(n) + ", not 63");

   // continue goes on with the next unit; a break in a while inside leaves only the while
   n := 0;
   k := 0;
   foreach (UNIT_ST_OBJ, u)
   {
      if (u == cg)
         continue;
      if (not ((u == b1) or (u == b2) or (u == b3) or (u == b4)))
         continue;
      j := 0;
      while (j < 10)
      {
         j := j + 1;
         if (j == 3)
            break;
      }
      k := k + j;
      n := n + 1;
   }
   if ((n != 4) or (k != 12))
      logtest(tstno, LOGT_ERROR, "T042 foreach with continue and an inner break: " + itoa(n) +
              " rounds, " + itoa(k) + " (not 4, 12)");
   // break leaves the foreach
   n := 0;
   foreach (UNIT_ST_OBJ, u)
   {
      if ((u == b1) or (u == b2) or (u == b3) or (u == b4) or (u == cg))
      {
         n := n + 1;
         break;
      }
   }
   if (n != 1)
      logtest(tstno, LOGT_ERROR, "T042 break didn't leave the foreach: " + itoa(n) + " rounds");

   // A unit that left before its turn is skipped: the first box moves the others out
   n := 0;
   rm := findroom("testlabc@test");
   foreach (UNIT_ST_OBJ, u)
   {
      if ((u == b1) or (u == b2) or (u == b3) or (u == b4))
      {
         n := n + 1;
         if (u != b1)
            link(b1, rm);
         if (u != b2)
            link(b2, rm);
         if (u != b3)
            link(b3, rm);
         if (u != b4)
            link(b4, rm);
      }
   }
   if (n != 1)
      logtest(tstno, LOGT_ERROR, "T042 foreach went to " + itoa(n) + " boxes moved away before their turn");
   link(b1, self);
   link(b2, self);
   link(b3, self);
   link(b4, cg);

   // ... and so is one destroyed before its turn; destroying in the loop is safe
   n := 0;
   foreach (UNIT_ST_OBJ | UNIT_ST_NPC, u)
   {
      if ((u == b1) or (u == b2) or (u == b3) or (u == cg) or (u == e))
      {
         n := n + 1;
         if (u != b1)
            destroy(b1);
         if (u != b2)
            destroy(b2);
         if (u != b3)
            destroy(b3);
         if (u != cg)
            destroy(cg);
         if (u != e)
            destroy(e);
         destroy(u);
      }
   }
   k := 0;
   foreach (UNIT_ST_OBJ | UNIT_ST_NPC, u)
   {
      if ((u.nameidx == "pbox") or (u.nameidx == "cage") or (u.nameidx == "experiment"))
         k := k + 1;
   }
   if ((n != 1) or (k != 0))
      logtest(tstno, LOGT_ERROR, "T042 foreach destroying: " + itoa(n) + " rounds (not 1), " +
              itoa(k) + " units left");

   // ---- Programs on boxes in this room, secured while they run
   h1 := load("pbox@test");
   link(h1, self);
   secure(h1, lost);
   h2 := load("pbox@test");
   link(h2, self);
   secure(h2, lost);
   h3 := load("pbox@test");
   link(h3, self);
   secure(h3, lost);
   h4 := load("pbox@test");
   link(h4, self);
   secure(h4, lost);
   h5 := load("pbox@test");
   link(h5, self);
   secure(h5, lost);
   h6 := load("pbox@test");
   link(h6, self);
   secure(h6, lost);
   h7 := load("pbox@test");
   link(h7, self);
   secure(h7, lost);
   dilcopy("t042wt@test", h1);
   dilcopy("t042qh@test", h2);
   dilcopy("t042rh@test", h3);
   dilcopy("t042pri@test", h4);
   dilcopy("t042cnt@test", h4);
   dilcopy("t042blk@test", h5);
   dilcopy("t042cnt@test", h5);
   dilcopy("t042int@test", h6);
   dilcopy("t042wrap@test", h7);
   n := 0;
   k := 0;
   while ((n < 10) and (k < 9))
   {
      pause;
      n := n + 1;
      k := 0;
      s := t042get(h1);
      if ("ready;" in s)
         k := k + 1;
      s := t042get(h2);
      if ("before;" in s)
         k := k + 1;
      s := t042get(h3);
      if ("r1;" in s)
         k := k + 1;
      s := t042get(h4);
      if ("pready;" in s)
         k := k + 1;
      if ("ready;" in replace("pready;", "", s))
         k := k + 1;
      s := t042get(h5);
      if ("bready;" in s)
         k := k + 1;
      if ("ready;" in replace("bready;", "", s))
         k := k + 1;
      s := t042get(h6);
      if ("ready;" in s)
         k := k + 1;
      s := t042get(h7);
      if ("3;" in s)
         k := k + 1;
   }
   if (k < 9)
      logtest(tstno, LOGT_ERROR, "T042 only " + itoa(k) + " of 9 helper programs started");
   subextra(h4.extra, "$t042r");
   subextra(h5.extra, "$t042r");

   // return/quit
   s := t042get(h2);
   if ((s != "before;q;") or dilfind("t042qh@test", h2))
      logtest(tstno, LOGT_ERROR, "T042 quit in a called procedure: " + s + " (not before;q;)");
   s := t042get(h3);
   if ((s != "r1;") or dilfind("t042rh@test", h3))
      logtest(tstno, LOGT_ERROR, "T042 return; at the top of a program: " + s + " (not r1;)");
   s := t042get(h7);
   if ((s != "1;2;3;") or dilfind("t042wrap@test", h7))
      logtest(tstno, LOGT_ERROR, "T042 a program running past its end: " + s + " (not 1;2;3;)");

   // wait and waitnoop
   sendto("nogo", h1);
   s := t042get(h1);
   if (s != "ready;")
      logtest(tstno, LOGT_ERROR, "T042 wait went on for a condition that was false: " + s);
   sendto("go", h1);
   s := t042get(h1);
   if (s != "ready;cleared;go;")
      logtest(tstno, LOGT_ERROR, "T042 wait woken by its message: " + s + " (not ready;cleared;go;)");
   pause;
   s := t042get(h1);
   if (s != "ready;cleared;go;cleared2;noop;")
      logtest(tstno, LOGT_ERROR, "T042 after waitnoop: " + s + " (not ready;cleared;go;cleared2;noop;)");

   // priority keeps the later program from every event until nopriority, or the end of the
   // program that holds it
   sendto("p1", h4);
   sendto("hold", h4);
   sendto("p2", h4);
   sendto("release", h4);
   sendto("p3", h4);
   sendto("holdquit", h4);
   sendto("p4", h4);
   s := t042get(h4);
   if ((left(s, 14) != "p1;release;p3;") or ("p2;" in s) or ("hold;" in s) or (not ("p4;" in s)))
      logtest(tstno, LOGT_ERROR, "T042 priority: the later program got " + s);

   // block keeps the event from the later programs, only for that event, also before a quit
   sendto("stop", h5);
   sendto("pass", h5);
   sendto("stopquit", h5);
   sendto("after", h5);
   s := t042get(h5);
   if (s != "pass;after;")
      logtest(tstno, LOGT_ERROR, "T042 block: the later program got " + s + " (not pass;after;)");

   // clear() of interrupts
   sendto("ia", h6);
   sendto("ib", h6);
   sendto("ic", h6);
   sendto("end", h6);
   s := t042get(h6);
   if (s != "012;ready;b;end;")
      logtest(tstno, LOGT_ERROR, "T042 interrupts after clear: " + s + " (not 012;ready;b;end;)");

   // ---- secure
   // A secured unit that leaves is lost at the next wake: the jump, and the variable is null
   u := load("pbox@test");
   link(u, self);
   secure(u, sec1);
   link(u, findroom("testlabc@test"));
   pause;
   logtest(tstno, LOGT_ERROR, "T042 secure didn't fire when the unit left");
   goto sec1done;
   :sec1:
   if (u != null)
      logtest(tstno, LOGT_ERROR, "T042 the variable of a lost secured unit isn't null");
   :sec1done:
   // after unsecure nothing happens
   u := load("pbox@test");
   link(u, self);
   secure(u, sec2);
   unsecure(u);
   link(u, findroom("testlabc@test"));
   pause;
   goto sec2done;
   :sec2:
   logtest(tstno, LOGT_ERROR, "T042 secure fired after unsecure");
   :sec2done:
   // destroy() of a secured unit jumps at once; a second secure only changes the label
   u := load("pbox@test");
   link(u, self);
   secure(u, sec3a);
   secure(u, sec3b);
   destroy(u);
   logtest(tstno, LOGT_ERROR, "T042 destroy of a secured unit didn't jump to the label");
   goto sec3done;
   :sec3a:
   logtest(tstno, LOGT_ERROR, "T042 the first label of a unit secured twice was used");
   goto sec3done;
   :sec3b:
   if (u != null)
      logtest(tstno, LOGT_ERROR, "T042 the variable of a destroyed secured unit isn't null");
   :sec3done:
   // a secured unit that stays is kept over a pause; one not secured is cleared
   u := load("pbox@test");
   link(u, self);
   w := load("pbox@test");
   link(w, self);
   secure(w, lost);
   pause;
   if ((u != null) or (w == null))
      logtest(tstno, LOGT_ERROR, "T042 after a pause: the unit not secured kept, or the secured one lost");
   unsecure(w);
   goto cleanup;

   :lost:
   logtest(tstno, LOGT_ERROR, "T042 lost a test unit");

   :cleanup:
   unsecure(h1);
   unsecure(h2);
   unsecure(h3);
   unsecure(h4);
   unsecure(h5);
   unsecure(h6);
   unsecure(h7);
   unsecure(w);
   foreach (UNIT_ST_OBJ | UNIT_ST_NPC, u)
   {
      if ((u.nameidx == "pbox") or (u.nameidx == "cage") or (u.nameidx == "experiment"))
         destroy(u);
   }
   u := findroom("testlabc@test");
   u := u.inside;
   while (u != null)
   {
      w := u.next;
      if (u.nameidx == "pbox")
         destroy(u);
      u := w;
   }
   subextra(self.extra, "$t042r");

   logtest(tstno, LOGT_INFO, "T042 Done");
   sendtoalldil("done", "labdirector@test");
   quit;
}
dilend

// ==================== T041 =====================

// Zone and command fields. On findzone("test"), against the %zone header and the zone's line
// in zonelist: name, fname, title, notes, help, creators (assigned, emptied with null, put
// back), resetmode, resettime (the header's lifespan), loadlevel (zonelist column 5), payonly
// (column 6), roomcount (the zone's rooms counted on the global room list), rooms (the room
// whose symbolic name sorts first), objs and npcs (a copy of the first object and NPC by
// symbolic name; objs fails while no copy is loaded), next (zhead() to the end, in order of
// name, the test zone on the way). On a cmdptr from chead(): name, type, loglevel and next,
// against commands.def. The player-only fields lifespan and info fail on an NPC.
dilbegin T041(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   z : zoneptr;
   zz : zoneptr;
   c : cmdptr;
   u : unitptr;
   npc : unitptr;
   cg : unitptr;
   e : extraptr;
   sl : stringlist;
   s : string;
   first : string;
   i : integer;
   n : integer;
   bad : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T041 zone and command fields running");
   bad := 0;

   z := findzone("test");
   if (z == null)
   {
      logtest(tstno, LOGT_ERROR, "T041 findzone(test) gave null");
      bad := 1;
      goto finish;
   }

   // The %zone header and zonelist
   if ((z.name != "test") or (z.fname != "test") or (z.title != "The DIL test laboratory"))
   {
      logtest(tstno, LOGT_ERROR, "T041 name '" + z.name + "', fname '" + z.fname + "', title '" + z.title + "'");
      bad := 1;
   }
   if ((z.notes != "This is a test zone. Can we do DIL 'unit testing' ?") or
       (z.help != "This zone is not intended for players."))
   {
      logtest(tstno, LOGT_ERROR, "T041 notes '" + z.notes + "', help '" + z.help + "'");
      bad := 1;
   }
   if ((z.resetmode != RESET_NOT) or (z.resettime != 45) or (z.loadlevel != 250) or (z.payonly != 0))
   {
      logtest(tstno, LOGT_ERROR, "T041 resetmode " + itoa(z.resetmode) + ", resettime " + itoa(z.resettime) +
              ", loadlevel " + itoa(z.loadlevel) + ", payonly " + itoa(z.payonly));
      bad := 1;
   }

   // creators: {"papi"} in the header; it can be assigned
   if ((length(z.creators) != 1) or (z.creators.[0] != "papi") or (not ("PAPI" in z.creators)))
   {
      logtest(tstno, LOGT_ERROR, "T041 creators has " + itoa(length(z.creators)) + " names, the first '" +
              z.creators.[0] + "'");
      bad := 1;
   }
   sl := {"papi", "lab assistant"};
   z.creators := sl;
   if ((length(z.creators) != 2) or (z.creators.[1] != "lab assistant"))
   {
      logtest(tstno, LOGT_ERROR, "T041 creators := {papi, lab assistant} gave " + itoa(length(z.creators)) + " names");
      bad := 1;
   }
   z.creators := null;
   if (length(z.creators) != 0)
   {
      logtest(tstno, LOGT_ERROR, "T041 creators := null left " + itoa(length(z.creators)) + " names");
      bad := 1;
   }
   sl := {"papi"};
   z.creators := sl;
   if ((length(z.creators) != 1) or (z.creators.[0] != "papi"))
   {
      logtest(tstno, LOGT_ERROR, "T041 creators not put back");
      bad := 1;
   }

   // roomcount and rooms: the zone's rooms on the global room list
   n := 0;
   first := "";
   u := room_head();
   while (u != null)
   {
      if (u.zoneidx == "test")
      {
         n := n + 1;
         if ((first == "") or (u.nameidx < first))
            first := u.nameidx;
      }
      u := u.gnext;
   }
   if ((n < 11) or (z.roomcount != n))
   {
      logtest(tstno, LOGT_ERROR, "T041 roomcount " + itoa(z.roomcount) + ", rooms on the list " + itoa(n));
      bad := 1;
   }
   // objcount and npccount: the objects and NPCs the zone defines (they were always 0), at
   // least as many as the kinds of them now in the game
   sl := null;
   u := obj_head();
   while (u != null)
   {
      if (u.type != UNIT_ST_OBJ)
         break;
      if ((u.zoneidx == "test") and (not (u.nameidx in sl)))
         addstring(sl, u.nameidx);
      u := u.gnext;
   }
   n := length(sl);
   sl := null;
   u := npc_head();
   while (u != null)
   {
      if (u.type != UNIT_ST_NPC)
         break;
      if ((u.zoneidx == "test") and (not (u.nameidx in sl)))
         addstring(sl, u.nameidx);
      u := u.gnext;
   }
   if ((n < 1) or (z.objcount < n) or (length(sl) < 1) or (z.npccount < length(sl)))
   {
      logtest(tstno, LOGT_ERROR, "T041 objcount " + itoa(z.objcount) + " for " + itoa(n) +
              " kinds loaded, npccount " + itoa(z.npccount) + " for " + itoa(length(sl)));
      bad := 1;
   }
   u := null;
   u := z.rooms;
   if ((u == null) or (u.type != UNIT_ST_ROOM) or (u.zoneidx != "test") or (u.nameidx != first))
   {
      logtest(tstno, LOGT_ERROR, "T041 rooms did not give the first room, " + first);
      bad := 1;
   }

   // objs: only a loaded copy of the first object (cage) counts
   if (findsymbolic("cage@test") == null)
   {
      u := self;
      u := z.objs;
      if (u != self)
      {
         logtest(tstno, LOGT_ERROR, "T041 objs gave a unit with no cage@test loaded");
         bad := 1;
      }
   }
   cg := load("cage@test");
   u := null;
   u := z.objs;
   if ((u == null) or (u.symname != "cage@test"))
   {
      logtest(tstno, LOGT_ERROR, "T041 objs did not give cage@test");
      bad := 1;
   }
   destroy(cg);

   // npcs: a loaded copy of the first NPC (captain)
   cg := load("captain@test");
   u := null;
   u := z.npcs;
   if ((u == null) or (u.symname != "captain@test") or (u.type != UNIT_ST_NPC))
   {
      logtest(tstno, LOGT_ERROR, "T041 npcs did not give captain@test");
      bad := 1;
   }
   destroy(cg);

   // next: every zone from zhead() in order of name
   zz := zhead();
   s := "";
   n := 0;
   i := 0;
   while (zz != null)
   {
      if ((s != "") and (zz.name <= s))
      {
         logtest(tstno, LOGT_ERROR, "T041 zone '" + zz.name + "' came after '" + s + "'");
         bad := 1;
      }
      if (zz.name == "test")
         i := 1;
      s := zz.name;
      zz := zz.next;
      n := n + 1;
   }
   if ((i == 0) or (n < 20))
   {
      logtest(tstno, LOGT_ERROR, "T041 zhead() and next went through " + itoa(n) + " zones, test among them: " + itoa(i));
      bad := 1;
   }

   // Commands, as commands.def has them
   c := chead();
   n := 0;
   while (c)
   {
      if (c.name == "ban")
         break;
      c := c.next;
      n := n + 1;
   }
   if ((not c) or (n < 10) or (c.loglevel != 240) or (c.type != 0))
   {
      logtest(tstno, LOGT_ERROR, "T041 the command ban, " + itoa(n) + " commands from chead(), has the wrong loglevel or type");
      bad := 1;
   }
   c := chead();
   while (c)
   {
      if (c.name == "consider")
         break;
      c := c.next;
   }
   if ((not c) or (c.type != TYPE_SKILL) or (c.loglevel != 0))
   {
      logtest(tstno, LOGT_ERROR, "T041 the command consider has the wrong type or loglevel");
      bad := 1;
   }

   // Fields of players only fail on an NPC
   npc := load("experiment@test");
   i := -7;
   i := npc.lifespan;
   if (i != -7)
   {
      logtest(tstno, LOGT_ERROR, "T041 lifespan of an NPC gave " + itoa(i));
      bad := 1;
   }
   cg := load("pbox@test");
   e := cg.extra;
   e := npc.info; // fails: e keeps the box's extra
   if ((npc.info == null) or (npc.info != null) or (e == null) or (e.descr != "Looks like there could be a box in a box"))
   {
      logtest(tstno, LOGT_ERROR, "T041 info of an NPC did not fail");
      bad := 1;
   }
   destroy(cg);
   destroy(npc);

:finish:
   if (bad)
      logtest(tstno, LOGT_INFO, "T041 failed");
   else
      logtest(tstno, LOGT_INFO, "T041 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;
}
dilend

// ==================== T040 =====================

// Room fields on t040room. Exits as the zone file sets them (exit_to, exit_info, exit_key,
// exit_diff, exit_names; null or a failure where there is no exit, a failure out of 0..MAX_EXIT
// and on an object), assigned (exit_diff wraps at 8 bits) and put back; roomflags, movement,
// mapx/mapy (gmap; -1 without one and on an object), title, inside_descr (vmc indents a room's
// description by three spaces). Light: light is a unit's own light plus the bright of what is in
// it; an opaque box keeps a lamp's light inside, an open transparent jar shines it out (illum,
// bright) into the room; setbright; a carried lamp lights the carrier, a held one the room as
// well. The global list: room_head(), gnext and gprevious.
dilbegin T040(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   rm : unitptr;
   far : unitptr;
   lab : unitptr;
   lamp : unitptr;
   box : unitptr;
   jar : unitptr;
   npc : unitptr;
   u : unitptr;
   sl : stringlist;
   i : integer;
   b : integer;
   bad : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T040 room, exit and light fields running");
   bad := 0;

   rm := findroom("t040room@test");
   far := findroom("t040far@test");
   lab := findroom("testlabc@test");
   lamp := load("t040lamp@test");
   box := load("t040box@test");
   jar := load("t040glass@test");
   npc := load("experiment@test");

   // Exits as the zone file sets them
   if ((rm.exit_to[NORTH] != far) or (rm.exit_to[EAST] != lab) or (rm.exit_to[WEST] != null) or
       (far.exit_to[SOUTH] != rm))
   {
      logtest(tstno, LOGT_ERROR, "T040 exit_to gave the wrong rooms");
      bad := 1;
   }
   u := self;
   u := rm.exit_to[MAX_EXIT + 1];
   if (u != self)
   {
      logtest(tstno, LOGT_ERROR, "T040 exit_to[MAX_EXIT + 1] did not fail");
      bad := 1;
   }
   u := self;
   u := lamp.exit_to[NORTH];
   if (u != self)
   {
      logtest(tstno, LOGT_ERROR, "T040 exit_to of an object did not fail");
      bad := 1;
   }
   if ((rm.exit_info[NORTH] != (EX_OPEN_CLOSE | EX_CLOSED | EX_LOCKED)) or (rm.exit_info[EAST] != 0) or
       (rm.exit_key[NORTH] != "t040key@test") or (rm.exit_key[EAST] != "") or
       (rm.exit_diff[NORTH] != 40) or (rm.exit_diff[EAST] != 0))
   {
      logtest(tstno, LOGT_ERROR, "T040 north exit: info " + itoa(rm.exit_info[NORTH]) + ", key '" +
              rm.exit_key[NORTH] + "', diff " + itoa(rm.exit_diff[NORTH]) + "; east: info " +
              itoa(rm.exit_info[EAST]) + ", key '" + rm.exit_key[EAST] + "', diff " + itoa(rm.exit_diff[EAST]));
      bad := 1;
   }
   if ((length(rm.exit_names[NORTH]) != 2) or (rm.exit_names[NORTH].[0] != "oak door") or
       (not ("door" in rm.exit_names[NORTH])) or (length(rm.exit_names[EAST]) != 0))
   {
      logtest(tstno, LOGT_ERROR, "T040 exit_names: north has " + itoa(length(rm.exit_names[NORTH])) +
              ", the first '" + rm.exit_names[NORTH].[0] + "'; east has " + itoa(length(rm.exit_names[EAST])));
      bad := 1;
   }

   // Where there is no exit, and on an object, the exit fields fail
   i := -7;
   i := rm.exit_info[WEST];
   i := rm.exit_diff[WEST];
   i := lamp.exit_info[NORTH];
   i := lamp.exit_diff[NORTH];
   sl := {"kept"};
   sl := rm.exit_names[WEST];
   sl := lamp.exit_names[NORTH];
   if ((i != -7) or (length(sl) != 1) or (rm.exit_key[WEST] == "") or (rm.exit_key[WEST] != "") or
       (lamp.exit_key[NORTH] == "") or (lamp.exit_key[NORTH] != ""))
   {
      logtest(tstno, LOGT_ERROR, "T040 an exit field gave a value without an exit: " + itoa(i) + " " +
              itoa(length(sl)));
      bad := 1;
   }

   // Assigned, and put back
   rm.exit_info[NORTH] := EX_OPEN_CLOSE;
   rm.exit_key[NORTH] := "t040other@test";
   rm.exit_diff[NORTH] := 300; // 8 bits: 300 - 256
   sl := {"gate"};
   rm.exit_names[NORTH] := sl;
   if ((rm.exit_info[NORTH] != EX_OPEN_CLOSE) or (rm.exit_key[NORTH] != "t040other@test") or
       (rm.exit_diff[NORTH] != 44) or (length(rm.exit_names[NORTH]) != 1) or (rm.exit_names[NORTH].[0] != "gate"))
   {
      logtest(tstno, LOGT_ERROR, "T040 assigned north exit: info " + itoa(rm.exit_info[NORTH]) + ", key '" +
              rm.exit_key[NORTH] + "', diff " + itoa(rm.exit_diff[NORTH]) + ", names " +
              itoa(length(rm.exit_names[NORTH])));
      bad := 1;
   }
   rm.exit_key[NORTH] := "";
   if (rm.exit_key[NORTH] != "")
   {
      logtest(tstno, LOGT_ERROR, "T040 exit_key := empty gave '" + rm.exit_key[NORTH] + "'");
      bad := 1;
   }
   rm.exit_info[NORTH] := EX_OPEN_CLOSE | EX_CLOSED | EX_LOCKED;
   rm.exit_key[NORTH] := "t040key@test";
   rm.exit_diff[NORTH] := 40;
   sl := {"oak door", "door"};
   rm.exit_names[NORTH] := sl;

   // The room's own fields
   if ((rm.roomflags != 5) or (rm.movement != SECT_FOREST) or (rm.mapx != 12) or (rm.mapy != 34) or
       (lab.mapx != -1) or (lab.mapy != -1) or (lamp.mapx != -1) or (lamp.mapy != -1))
   {
      logtest(tstno, LOGT_ERROR, "T040 roomflags " + itoa(rm.roomflags) + ", movement " + itoa(rm.movement) +
              ", map " + itoa(rm.mapx) + "," + itoa(rm.mapy) + ", testlabc's map " + itoa(lab.mapx) + "," + itoa(lab.mapy));
      bad := 1;
   }
   rm.roomflags := 300; // 8 bits: 300 - 256
   i := rm.roomflags;
   rm.roomflags := 5;
   if ((i != 44) or (rm.roomflags != 5))
   {
      logtest(tstno, LOGT_ERROR, "T040 roomflags := 300 gave " + itoa(i));
      bad := 1;
   }
   i := -7;
   i := lamp.roomflags;
   i := lamp.movement;
   if (i != -7)
   {
      logtest(tstno, LOGT_ERROR, "T040 roomflags or movement of an object gave " + itoa(i));
      bad := 1;
   }
   if ((rm.title != "The T040 Hall") or (rm.inside_descr != "   Pillars of glass.") or (rm.type != UNIT_ST_ROOM))
   {
      logtest(tstno, LOGT_ERROR, "T040 room title '" + rm.title + "', inside_descr '" + rm.inside_descr + "'");
      bad := 1;
   }

   // Light: the room's own light 1, the lamp's bright 3
   if ((rm.light != 1) or (lamp.bright != 3) or (lamp.light != 0) or (lamp.illum != 0))
   {
      logtest(tstno, LOGT_ERROR, "T040 light at the start: room " + itoa(rm.light) + ", lamp bright " +
              itoa(lamp.bright) + ", light " + itoa(lamp.light) + ", illum " + itoa(lamp.illum));
      bad := 1;
   }
   link(lamp, rm);
   link(box, rm);
   link(jar, rm);
   link(npc, rm);
   if ((rm.light != 4) or (lamp.outside != rm))
   {
      logtest(tstno, LOGT_ERROR, "T040 a lamp in the room: room light " + itoa(rm.light));
      bad := 1;
   }
   link(lamp, box); // opaque: the light stays in the box
   if ((box.light != 3) or (box.bright != 0) or (box.illum != 0) or (rm.light != 1))
   {
      logtest(tstno, LOGT_ERROR, "T040 a lamp in a box: box light " + itoa(box.light) + ", bright " +
              itoa(box.bright) + ", illum " + itoa(box.illum) + ", room light " + itoa(rm.light));
      bad := 1;
   }
   link(lamp, jar); // open and transparent: the jar shines with it
   if ((jar.light != 3) or (jar.bright != 3) or (jar.illum != 3) or (rm.light != 4) or (box.light != 0))
   {
      logtest(tstno, LOGT_ERROR, "T040 a lamp in a jar: jar light " + itoa(jar.light) + ", bright " +
              itoa(jar.bright) + ", illum " + itoa(jar.illum) + ", room light " + itoa(rm.light));
      bad := 1;
   }
   setbright(lamp, 5);
   if ((lamp.bright != 5) or (jar.light != 5) or (jar.bright != 5) or (jar.illum != 5) or (rm.light != 6))
   {
      logtest(tstno, LOGT_ERROR, "T040 setbright 5 in a jar: lamp bright " + itoa(lamp.bright) + ", jar light " +
              itoa(jar.light) + ", bright " + itoa(jar.bright) + ", illum " + itoa(jar.illum) + ", room light " +
              itoa(rm.light));
      bad := 1;
   }
   link(lamp, rm);
   if ((jar.light != 0) or (jar.bright != 0) or (jar.illum != 0) or (rm.light != 6))
   {
      logtest(tstno, LOGT_ERROR, "T040 the lamp out of the jar: jar light " + itoa(jar.light) + ", bright " +
              itoa(jar.bright) + ", room light " + itoa(rm.light));
      bad := 1;
   }
   b := npc.bright;
   i := npc.light;
   link(lamp, npc); // carried: it lights the carrier's inside only
   if ((npc.light != i + 5) or (npc.bright != b) or (rm.light != 1))
   {
      logtest(tstno, LOGT_ERROR, "T040 a carried lamp: npc light " + itoa(npc.light) + ", bright " +
              itoa(npc.bright) + ", room light " + itoa(rm.light));
      bad := 1;
   }
   addequip(lamp, WEAR_HOLD); // held: the carrier shines too
   if ((npc.bright != b + 5) or (rm.light != 6) or (lamp.equip != WEAR_HOLD))
   {
      logtest(tstno, LOGT_ERROR, "T040 a held lamp: npc bright " + itoa(npc.bright) + ", room light " + itoa(rm.light));
      bad := 1;
   }
   unequip(lamp);
   if ((npc.bright != b) or (rm.light != 1) or (lamp.equip != 0))
   {
      logtest(tstno, LOGT_ERROR, "T040 a lamp put away: npc bright " + itoa(npc.bright) + ", room light " + itoa(rm.light));
      bad := 1;
   }

   // The global list: the rooms come after everything else
   u := room_head();
   if ((u.type != UNIT_ST_ROOM) or (u.gprevious.type == UNIT_ST_ROOM) or (u.gnext.gprevious != u) or
       (rm.gnext.gprevious != rm) or (rm.gprevious.gnext != rm) or (npc.gnext.gprevious != npc))
   {
      logtest(tstno, LOGT_ERROR, "T040 gnext and gprevious don't match");
      bad := 1;
   }

   destroy(lamp);
   destroy(box);
   destroy(jar);
   destroy(npc);
   if (bad)
      logtest(tstno, LOGT_INFO, "T040 failed");
   else
      logtest(tstno, LOGT_INFO, "T040 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;
}
dilend

// ==================== T039 =====================

dilbegin t039idle();
code
{
   :loop:
   wait(SFB_MSG, argument == "t039");
   goto loop;
}
dilend

// Object fields on t039obj (a blue lantern), read as the zone file sets them and assigned:
// title, names, name, outside_descr, inside_descr, key, height (wraps at 16 bits), minv (8),
// capacity (signed 16), cost, rent (in iron pieces of 10), flags, manipulate (32 bits),
// objecttype, objectflags, value[] (fails out of 0..4 and on an NPC), openflags, opendiff,
// equip (addequip/unequip; fails on an NPC), hasfunc (self, a bare object, one given a
// dilcopy). Weight: weight is baseweight plus what is inside, up through every container
// (set_weight_base, set_weight). The unit: type, symname, nameidx, zoneidx, zone (where it is
// now, not where it is from), idx (two copies differ; findsymbolic(sym, idx) finds each),
// loadcount, outside, inside, next. Extras: the zone file's two extras in order (names,
// name, descr, vals, next), assigned and found again by the new name.
dilbegin T039(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   lan : unitptr;
   st : unitptr;
   st2 : unitptr;
   npc : unitptr;
   u : unitptr;
   vd : unitptr;
   e : extraptr;
   il : intlist;
   sl : stringlist;
   i : integer;
   n : integer;
   w : integer;
   bad : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T039 object, extra and unit fields running");
   bad := 0;

   lan := load("t039obj@test");
   st := load("t039stone@test");
   npc := load("experiment@test");

   // As the zone file sets them
   if ((lan.title != "a blue lantern") or (lan.name != "blue lantern") or (length(lan.names) != 2) or
       (lan.names.[1] != "lantern") or (lan.outside_descr != "A blue lantern stands here.") or
       (lan.inside_descr != "A wick burns in here."))
   {
      logtest(tstno, LOGT_ERROR, "T039 title '" + lan.title + "', name '" + lan.name + "', outside_descr '" +
              lan.outside_descr + "', inside_descr '" + lan.inside_descr + "'");
      bad := 1;
   }
   if ((lan.key != "t039key@test") or (lan.height != 33) or (lan.minv != 7) or (lan.capacity != 20) or
       (lan.cost != 30) or (lan.rent != 160))
   {
      logtest(tstno, LOGT_ERROR, "T039 key '" + lan.key + "', height " + itoa(lan.height) + ", minv " +
              itoa(lan.minv) + ", capacity " + itoa(lan.capacity) + ", cost " + itoa(lan.cost) + ", rent " +
              itoa(lan.rent));
      bad := 1;
   }
   if ((lan.flags != UNIT_FL_NO_BURY) or (lan.manipulate != (MANIPULATE_TAKE | MANIPULATE_HOLD)) or
       (lan.objecttype != ITEM_CONTAINER) or (lan.objectflags != OBJ_NO_DUAL) or
       (lan.openflags != (EX_OPEN_CLOSE | EX_INSIDE_OPEN)) or (lan.opendiff != 42))
   {
      logtest(tstno, LOGT_ERROR, "T039 flags " + itoa(lan.flags) + ", manipulate " + itoa(lan.manipulate) +
              ", objecttype " + itoa(lan.objecttype) + ", objectflags " + itoa(lan.objectflags) + ", openflags " +
              itoa(lan.openflags) + ", opendiff " + itoa(lan.opendiff));
      bad := 1;
   }
   if ((lan.value[0] != 11) or (lan.value[1] != 0) or (lan.value[4] != 44))
   {
      logtest(tstno, LOGT_ERROR, "T039 value[0] " + itoa(lan.value[0]) + ", value[1] " + itoa(lan.value[1]) +
              ", value[4] " + itoa(lan.value[4]));
      bad := 1;
   }

   // Assigned
   lan.title := "a red lantern";
   sl := {"red lantern", "lamp"};
   lan.names := sl;
   lan.outside_descr := "A red lantern stands here.";
   lan.inside_descr := "It is dark in here.";
   lan.key := "t039other@test";
   if ((lan.title != "a red lantern") or (lan.name != "red lantern") or (lan.names.[1] != "lamp") or
       (lan.outside_descr != "A red lantern stands here.") or (lan.inside_descr != "It is dark in here.") or
       (lan.key != "t039other@test"))
   {
      logtest(tstno, LOGT_ERROR, "T039 assigned title '" + lan.title + "', name '" + lan.name + "', outside_descr '" +
              lan.outside_descr + "', inside_descr '" + lan.inside_descr + "', key '" + lan.key + "'");
      bad := 1;
   }
   lan.key := "";
   if (lan.key != "")
   {
      logtest(tstno, LOGT_ERROR, "T039 key := empty gave '" + lan.key + "'");
      bad := 1;
   }
   lan.height := 70000;   // 16 bits: 70000 - 65536
   lan.minv := 300;       // 8 bits: 300 - 256
   lan.capacity := 40000; // signed 16 bits: 40000 - 65536
   if ((lan.height != 4464) or (lan.minv != 44) or (lan.capacity != -25536))
   {
      logtest(tstno, LOGT_ERROR, "T039 wrapped height " + itoa(lan.height) + ", minv " + itoa(lan.minv) +
              ", capacity " + itoa(lan.capacity));
      bad := 1;
   }
   lan.height := 180;
   lan.minv := 0;
   lan.capacity := 50;
   lan.cost := 1234567;
   lan.rent := 99;
   lan.flags := lan.flags | UNIT_FL_MAGIC;
   lan.manipulate := MANIPULATE_TAKE | MANIPULATE_WEAR_EAR;
   lan.objecttype := ITEM_TREASURE;
   lan.objectflags := OBJ_TWO_HANDS;
   lan.openflags := EX_OPEN_CLOSE | EX_CLOSED;
   lan.opendiff := 99;
   lan.value[2] := -5;
   lan.value[4] := 123456789;
   if ((lan.height != 180) or (lan.minv != 0) or (lan.capacity != 50) or (lan.cost != 1234567) or
       (lan.rent != 99) or (not isset(lan.flags, UNIT_FL_MAGIC)) or (not isset(lan.flags, UNIT_FL_NO_BURY)) or
       (lan.manipulate != (MANIPULATE_TAKE | MANIPULATE_WEAR_EAR)) or (lan.objecttype != ITEM_TREASURE) or
       (lan.objectflags != OBJ_TWO_HANDS) or (lan.openflags != (EX_OPEN_CLOSE | EX_CLOSED)) or
       (lan.opendiff != 99) or (lan.value[2] != -5) or (lan.value[4] != 123456789) or (lan.value[0] != 11))
   {
      logtest(tstno, LOGT_ERROR, "T039 assigned height " + itoa(lan.height) + ", capacity " + itoa(lan.capacity) +
              ", cost " + itoa(lan.cost) + ", rent " + itoa(lan.rent) + ", flags " + itoa(lan.flags) +
              ", manipulate " + itoa(lan.manipulate) + ", objecttype " + itoa(lan.objecttype) + ", objectflags " +
              itoa(lan.objectflags) + ", openflags " + itoa(lan.openflags) + ", opendiff " + itoa(lan.opendiff) +
              ", value[2] " + itoa(lan.value[2]) + ", value[4] " + itoa(lan.value[4]));
      bad := 1;
   }
   lan.objecttype := ITEM_CONTAINER;
   lan.openflags := EX_OPEN_CLOSE | EX_INSIDE_OPEN;

   // Object fields fail on an NPC, value[] out of 0..4
   i := -7;
   i := lan.value[5];
   i := lan.value[-1];
   i := npc.value[0];
   i := npc.objecttype;
   i := npc.cost;
   i := npc.equip;
   if (i != -7)
   {
      logtest(tstno, LOGT_ERROR, "T039 an object field on an NPC or value[5] gave " + itoa(i));
      bad := 1;
   }

   // Weight: the unit's own and what is in it, up through every container
   if ((lan.weight != 4) or (lan.baseweight != 4) or (st.weight != 5) or (st.baseweight != 5))
   {
      logtest(tstno, LOGT_ERROR, "T039 lantern weight " + itoa(lan.weight) + ", baseweight " + itoa(lan.baseweight) +
              ", stone weight " + itoa(st.weight));
      bad := 1;
   }
   link(st, lan);
   w := npc.weight;
   link(lan, npc);
   if ((lan.weight != 9) or (lan.baseweight != 4) or (npc.weight != w + 9))
   {
      logtest(tstno, LOGT_ERROR, "T039 a stone in the lantern: weight " + itoa(lan.weight) + ", baseweight " +
              itoa(lan.baseweight) + ", carrier " + itoa(npc.weight - w));
      bad := 1;
   }
   set_weight_base(lan, 6);
   if ((lan.baseweight != 6) or (lan.weight != 11) or (npc.weight != w + 11))
   {
      logtest(tstno, LOGT_ERROR, "T039 set_weight_base 6: baseweight " + itoa(lan.baseweight) + ", weight " +
              itoa(lan.weight) + ", carrier " + itoa(npc.weight - w));
      bad := 1;
   }
   set_weight(st, 8);
   if ((st.weight != 8) or (st.baseweight != 5) or (lan.weight != 14) or (npc.weight != w + 14))
   {
      logtest(tstno, LOGT_ERROR, "T039 set_weight 8: weight " + itoa(st.weight) + ", baseweight " +
              itoa(st.baseweight) + ", lantern " + itoa(lan.weight) + ", carrier " + itoa(npc.weight - w));
      bad := 1;
   }
   link(st, self);
   if ((lan.weight != 6) or (npc.weight != w + 6))
   {
      logtest(tstno, LOGT_ERROR, "T039 the stone out: lantern " + itoa(lan.weight) + ", carrier " + itoa(npc.weight - w));
      bad := 1;
   }

   // equip
   if (lan.equip != 0)
   {
      logtest(tstno, LOGT_ERROR, "T039 a carried lantern has equip " + itoa(lan.equip));
      bad := 1;
   }
   addequip(lan, WEAR_HOLD);
   i := lan.equip;
   unequip(lan);
   if ((i != WEAR_HOLD) or (lan.equip != 0) or (lan.outside != npc))
   {
      logtest(tstno, LOGT_ERROR, "T039 a held lantern has equip " + itoa(i) + ", put away " + itoa(lan.equip));
      bad := 1;
   }

   // hasfunc
   if ((self.hasfunc != TRUE) or (st.hasfunc != FALSE))
   {
      logtest(tstno, LOGT_ERROR, "T039 hasfunc: self " + itoa(self.hasfunc) + ", a stone " + itoa(st.hasfunc));
      bad := 1;
   }
   dilcopy("t039idle@test", st);
   if (st.hasfunc != TRUE)
   {
      logtest(tstno, LOGT_ERROR, "T039 hasfunc of a stone with a program: " + itoa(st.hasfunc));
      bad := 1;
   }

   // The unit: what it is, where it comes from and where it is
   if ((lan.type != UNIT_ST_OBJ) or (npc.type != UNIT_ST_NPC) or (self.type != UNIT_ST_ROOM) or
       (lan.symname != "t039obj@test") or (lan.nameidx != "t039obj") or (lan.zoneidx != "test") or
       (lan.zone != "test") or (self.zone != "test"))
   {
      logtest(tstno, LOGT_ERROR, "T039 type " + itoa(lan.type) + ", symname '" + lan.symname + "', nameidx '" +
              lan.nameidx + "', zoneidx '" + lan.zoneidx + "', zone '" + lan.zone + "'");
      bad := 1;
   }
   vd := findroom("void@basis");
   link(st, vd);
   if ((st.zone != "basis") or (st.zoneidx != "test") or (st.outside != vd))
   {
      logtest(tstno, LOGT_ERROR, "T039 a stone in void@basis: zone '" + st.zone + "', zoneidx '" + st.zoneidx + "'");
      bad := 1;
   }
   link(st, self);

   n := st.loadcount;
   st2 := load("t039stone@test");
   if ((n < 1) or (st.loadcount != n + 1) or (st2.loadcount != n + 1))
   {
      logtest(tstno, LOGT_ERROR, "T039 loadcount " + itoa(n) + ", then " + itoa(st.loadcount) + " and " +
              itoa(st2.loadcount));
      bad := 1;
   }
   if (st.idx == st2.idx)
   {
      logtest(tstno, LOGT_ERROR, "T039 two stones have the same idx");
      bad := 1;
   }
   u := findsymbolic("t039stone@test", st.idx);
   if (u != st)
   {
      logtest(tstno, LOGT_ERROR, "T039 findsymbolic with the first stone's idx found another unit");
      bad := 1;
   }
   u := findsymbolic("t039stone@test", st2.idx);
   if (u != st2)
   {
      logtest(tstno, LOGT_ERROR, "T039 findsymbolic with the second stone's idx found another unit");
      bad := 1;
   }

   // inside, next and outside: the last unit in comes first
   link(st, lan);
   link(st2, lan);
   if ((lan.inside != st2) or (st2.next != st) or (st.next != null) or (st.outside != lan) or
       (st2.outside != lan) or (lan.outside != npc))
   {
      logtest(tstno, LOGT_ERROR, "T039 inside, next or outside wrong for two stones in the lantern");
      bad := 1;
   }

   // Extras: the zone file's two, in order
   e := lan.extra;
   if ((e == null) or (e.name != "engraving") or (length(e.names) != 2) or (e.names.[1] != "letters") or
       (e.descr != "The letters say T039.") or (length(e.vals) != 3) or (e.vals.[0] != 7) or
       (e.vals.[1] != -3) or (e.vals.[2] != 12))
   {
      logtest(tstno, LOGT_ERROR, "T039 the first extra is not the zone file's engraving");
      bad := 1;
   }
   e := e.next;
   if ((e == null) or (e.name != "$t039hidden") or (e.descr != "hidden") or (length(e.vals) != 0) or
       (e.next != null))
   {
      logtest(tstno, LOGT_ERROR, "T039 the second extra is not the zone file's $t039hidden");
      bad := 1;
   }
   e := lan.extra.["letters"];
   e.descr := "Rewritten.";
   il := {1, 2};
   e.vals := il;
   e.vals.[1] := 20;
   sl := {"rune", "mark"};
   e.names := sl;
   if (("engraving" in lan.extra) or (not ("mark" in lan.extra)))
   {
      logtest(tstno, LOGT_ERROR, "T039 the extra renamed is still found by its old name, or not by its new one");
      bad := 1;
   }
   e := lan.extra.["mark"];
   if ((e.name != "rune") or (e.descr != "Rewritten.") or (length(e.vals) != 2) or (e.vals.[0] != 1) or
       (e.vals.[1] != 20))
   {
      logtest(tstno, LOGT_ERROR, "T039 the assigned extra did not read back");
      bad := 1;
   }
   e.vals := null;
   e.descr := "";
   if ((length(e.vals) != 0) or (e.descr != ""))
   {
      logtest(tstno, LOGT_ERROR, "T039 vals := null or descr := empty left something");
      bad := 1;
   }

   destroy(st2);
   destroy(st);
   destroy(lan);
   destroy(npc);
   if (bad)
      logtest(tstno, LOGT_INFO, "T039 failed");
   else
      logtest(tstno, LOGT_INFO, "T039 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;
}
dilend

// ==================== T038 =====================

// Who a character fights and follows: fighting, opponentcount, master, follower and
// followercount, through set_fighting()/stop_fighting() and follow(). Then the fields that only
// a player has, on an NPC: each fails (the variable keeps its value) and an assignment does
// nothing, and the program goes on; switched and editing give null and FALSE for an NPC no one
// controls. And a zone's access level (zonelist's fourth column: 0 for the test zone).
dilbegin T038(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   a : unitptr;
   b : unitptr;
   c : unitptr;
   o : unitptr;
   v : unitptr;
   nobody : unitptr;
   e : extraptr;
   z : zoneptr;
   i : integer;
   bad : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T038 fights, followers and player-only fields running");
   bad := 0;

   a := load("t036npc@test");
   b := load("t036npc@test");
   c := load("t036npc@test");
   o := load("pbox@test");

   // Nobody fights, nobody follows
   if ((a.fighting != null) or (a.opponentcount != 0) or (a.master != null) or
       (a.follower != null) or (a.followercount != 0))
   {
      logtest(tstno, LOGT_ERROR, "T038 a new NPC fights or follows");
      bad := 1;
   }

   // a attacks b: each is on the other's list; a hits b, and stands in a fight; b hits no one
   // until its own combat round picks a target
   set_fighting(a, b);
   if ((a.fighting != b) or (a.opponentcount != 1) or (b.opponentcount != 1) or
       (a.position != POSITION_FIGHTING) or (b.fighting != null))
   {
      logtest(tstno, LOGT_ERROR, "T038 after set_fighting(a, b) a.fighting is b: " +
              itoa(a.fighting == b) + ", counts " + itoa(a.opponentcount) + "/" + itoa(b.opponentcount) +
              ", a.position " + itoa(a.position));
      bad := 1;
   }
   // c joins in against a: a has two opponents and still hits b
   set_fighting(c, a);
   if ((a.fighting != b) or (a.opponentcount != 2) or (c.fighting != a) or (c.opponentcount != 1))
   {
      logtest(tstno, LOGT_ERROR, "T038 after set_fighting(c, a) a has " + itoa(a.opponentcount) +
              " opponents, c " + itoa(c.opponentcount));
      bad := 1;
   }
   stop_fighting(a, null);
   if ((a.fighting != null) or (a.opponentcount != 0) or (b.opponentcount != 0) or
       (c.opponentcount != 0) or (c.fighting != null) or (a.position != POSITION_STANDING))
   {
      logtest(tstno, LOGT_ERROR, "T038 after stop_fighting(a, null) counts are " +
              itoa(a.opponentcount) + "/" + itoa(b.opponentcount) + "/" + itoa(c.opponentcount));
      bad := 1;
   }

   // b and c follow a
   follow(b, a);
   follow(c, a);
   if ((b.master != a) or (c.master != a) or (a.followercount != 2) or
       ((a.follower != b) and (a.follower != c)) or (a.follower != getfollower(a, 0)) or
       (b.followercount != 0) or (b.follower != null))
   {
      logtest(tstno, LOGT_ERROR, "T038 with two followers a.followercount is " +
              itoa(a.followercount) + ", b.master is a: " + itoa(b.master == a));
      bad := 1;
   }
   follow(b, null); // b has a master, so this is safe
   if ((b.master != null) or (a.followercount != 1) or (a.follower != c))
   {
      logtest(tstno, LOGT_ERROR, "T038 after b stopped following a.followercount is " +
              itoa(a.followercount));
      bad := 1;
   }
   follow(c, null);

   // Characters only; on null they fail
   v := o;
   v := o.fighting;
   v := o.master;
   v := o.follower;
   v := nobody.fighting;
   v := nobody.switched;
   i := -7;
   i := o.opponentcount;
   i := o.followercount;
   i := nobody.editing;
   if ((v != o) or (i != -7))
   {
      logtest(tstno, LOGT_ERROR, "T038 fighting, master, follower or a count on an object or null");
      bad := 1;
   }

   // No player has switched into a, and an NPC doesn't edit
   v := o;
   v := a.switched;
   i := a.editing;
   if ((v != null) or (i != FALSE) or (o.switched != null) or (o.editing != FALSE))
   {
      logtest(tstno, LOGT_ERROR, "T038 switched/editing on an NPC or an object");
      bad := 1;
   }

   // Players only: on an NPC each read fails and leaves the variable as it was
   i := -7;
   i := a.acc_balance;
   i := a.acc_total;
   i := a.birth;
   i := a.playtime;
   i := a.crimes;
   i := a.drunk;
   i := a.full;
   i := a.thirst;
   i := a.pcflags;
   i := a.skill_points;
   i := a.ability_points;
   i := a.vlevel;
   i := a.profession;
   i := a.exptol;
   if (i != -7)
   {
      logtest(tstno, LOGT_ERROR, "T038 a player's number field on an NPC gave " + itoa(i));
      bad := 1;
   }
   // A failed string is neither "" nor anything else (assigned, it would empty the variable)
   if ((a.guild == "") or (a.guild != "") or (a.hometown == "") or (a.hometown != "") or
       (a.prompt == "") or (a.prompt != ""))
   {
      logtest(tstno, LOGT_ERROR, "T038 guild, hometown or prompt on an NPC didn't fail");
      bad := 1;
   }
   v := o;
   v := a.lastroom;
   e := o.extra;
   e := a.quests;
   if ((v != o) or (e == null))
   {
      logtest(tstno, LOGT_ERROR, "T038 lastroom or quests on an NPC didn't fail");
      bad := 1;
   }
   // Assigning them on an NPC does nothing, and the program goes on
   a.birth := 5;
   a.crimes := 5;
   a.drunk := 5;
   a.full := 5;
   a.thirst := 5;
   a.pcflags := PC_BRIEF;
   a.skill_points := 5;
   a.ability_points := 5;
   a.vlevel := 5;
   a.profession := PROFESSION_FIGHTER;
   a.guild := "x";
   a.hometown := "labcontrol@test";
   a.prompt := "x";
   i := -7;
   i := a.vlevel;
   i := a.skill_points;
   if ((i != -7) or (a.guild == "x") or (a.hometown != "") or (a.prompt == "x"))
   {
      logtest(tstno, LOGT_ERROR, "T038 assigning a player's field on an NPC made it readable");
      bad := 1;
   }

   // The zone's access level: the test zone is 0 in zonelist
   z := findzone("test");
   if (z.access != 0)
   {
      logtest(tstno, LOGT_ERROR, "T038 the test zone's access is " + itoa(z.access));
      bad := 1;
   }
   z := findzone("_players"); // a reserved zone: 255
   if ((z == null) or (z.access != 255))
   {
      logtest(tstno, LOGT_ERROR, "T038 the _players zone's access isn't 255");
      bad := 1;
   }
   z := null;
   i := -7;
   i := z.access;
   if (i != -7)
   {
      logtest(tstno, LOGT_ERROR, "T038 access of a null zone gave " + itoa(i));
      bad := 1;
   }

   destroy(o);
   destroy(c);
   destroy(b);
   destroy(a);
   if (bad)
      goto terminate;

   logtest(tstno, LOGT_INFO, "T038 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:terminate:
   logtest(tstno, LOGT_INFO, "T038 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T037 =====================

// The indexed fields on an NPC: abilities (0 to 7), weapons (the groups only, 0 to 6) and spells
// (the groups only, 0 to 11) as vmc shared them out from t036npc's MSET_ABILITY, MSET_WEAPON
// and MSET_SPELL: a bigger share gives a bigger value, a share of 0 gives 0, and the roots
// (WPN_ROOT, SPL_ALL) get a quarter of the best group. Each is assigned and read back; an index
// out of range fails, read or assigned. On an object, spells is its magic resistance: one
// number from 0 to 255 whatever the index. The player-only ones (skills, ability_levels,
// spell_levels, skill_levels, weapon_levels and the four *_costs) fail on an NPC.
dilbegin T037(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   u : unitptr;
   o : unitptr;
   i : integer;
   bad : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T037 indexed character fields running");
   bad := 0;

   u := load("t036npc@test");
   o := load("pbox@test");

   // MSET_ABILITY(30, 20, 10, 20, 10, 10, 0, 0): str, dex, con, hp, bra, cha, mag, div
   if ((u.abilities[ABIL_STR] <= u.abilities[ABIL_DEX]) or
       (u.abilities[ABIL_DEX] <= u.abilities[ABIL_CON]) or
       (u.abilities[ABIL_DEX] != u.abilities[ABIL_HP]) or
       (u.abilities[ABIL_CON] != u.abilities[ABIL_BRA]) or
       (u.abilities[ABIL_CON] != u.abilities[ABIL_CHA]) or
       (u.abilities[ABIL_CON] <= 0) or
       (u.abilities[ABIL_MAG] != 0) or (u.abilities[ABIL_DIV] != 0))
   {
      logtest(tstno, LOGT_ERROR, "T037 abilities don't follow the shares: str " +
              itoa(u.abilities[ABIL_STR]) + ", dex " + itoa(u.abilities[ABIL_DEX]) + ", con " +
              itoa(u.abilities[ABIL_CON]) + ", mag " + itoa(u.abilities[ABIL_MAG]));
      bad := 1;
   }
   // MSET_WEAPON(0, 40, 0, 0, 10, 0): axe/hammer, sword, club/mace, polearm, unarmed, special
   if ((u.weapons[WPN_SWORD] <= u.weapons[WPN_UNARMED]) or (u.weapons[WPN_UNARMED] <= 0) or
       (u.weapons[WPN_AXE_HAM] != 0) or (u.weapons[WPN_SPECIAL] != 0) or
       (u.weapons[WPN_ROOT] != u.weapons[WPN_SWORD] / 4))
   {
      logtest(tstno, LOGT_ERROR, "T037 weapons don't follow the shares: sword " +
              itoa(u.weapons[WPN_SWORD]) + ", unarmed " + itoa(u.weapons[WPN_UNARMED]) +
              ", axe " + itoa(u.weapons[WPN_AXE_HAM]) + ", root " + itoa(u.weapons[WPN_ROOT]));
      bad := 1;
   }
   // MSET_SPELL(0, ..., 0, 50): only SPL_EXTERNAL
   if ((u.spells[SPL_EXTERNAL] <= 0) or (u.spells[SPL_HEAT] != 0) or
       (u.spells[SPL_ALL] != u.spells[SPL_EXTERNAL] / 4))
   {
      logtest(tstno, LOGT_ERROR, "T037 spells don't follow the shares: external " +
              itoa(u.spells[SPL_EXTERNAL]) + ", heat " + itoa(u.spells[SPL_HEAT]) + ", all " +
              itoa(u.spells[SPL_ALL]));
      bad := 1;
   }

   // Assigned and read back, at both ends of the index range
   u.abilities[ABIL_MAG] := 45;
   u.abilities[ABIL_HP] := 70000; // 16 bits
   u.weapons[WPN_ROOT] := 33;
   u.weapons[WPN_SPECIAL] := -12;
   u.spells[SPL_ALL] := 21;
   u.spells[SPL_EXTERNAL] := 99;
   if ((u.abilities[ABIL_MAG] != 45) or (u.abilities[ABIL_HP] != 4464) or
       (u.weapons[WPN_ROOT] != 33) or (u.weapons[WPN_SPECIAL] != -12) or
       (u.spells[SPL_ALL] != 21) or (u.spells[SPL_EXTERNAL] != 99))
   {
      logtest(tstno, LOGT_ERROR, "T037 assignment gave abilities " + itoa(u.abilities[ABIL_MAG]) +
              "/" + itoa(u.abilities[ABIL_HP]) + ", weapons " + itoa(u.weapons[WPN_ROOT]) + "/" +
              itoa(u.weapons[WPN_SPECIAL]) + ", spells " + itoa(u.spells[SPL_ALL]) + "/" +
              itoa(u.spells[SPL_EXTERNAL]));
      bad := 1;
   }

   // Out of range: fails when read, and an assignment does nothing
   i := -7;
   i := u.abilities[8];
   i := u.abilities[-1];
   i := u.weapons[WPN_GROUP_MAX];
   i := u.weapons[WPN_DAGGER]; // a weapon, not a group: only players have it
   i := u.weapons[-1];
   i := u.spells[SPL_GROUP_MAX];
   i := u.spells[-1];
   if (i != -7)
   {
      logtest(tstno, LOGT_ERROR, "T037 an index out of range gave " + itoa(i));
      bad := 1;
   }
   u.abilities[8] := 5;
   u.weapons[WPN_GROUP_MAX] := 5;
   u.spells[SPL_GROUP_MAX] := 5;
   if ((u.abilities[ABIL_MAG] != 45) or (u.weapons[WPN_ROOT] != 33) or (u.spells[SPL_ALL] != 21))
   {
      logtest(tstno, LOGT_ERROR, "T037 an assignment out of range changed a field");
      bad := 1;
   }

   // An object's spells: its magic resistance, the index ignored, 0 to 255
   o.spells[3] := 40;
   i := o.spells[SPL_EXTERNAL];
   o.spells[0] := 300;
   if ((i != 40) or (o.spells[77] != 44))
   {
      logtest(tstno, LOGT_ERROR, "T037 an object's spells gave " + itoa(i) + " and, after 300, " +
              itoa(o.spells[77]));
      bad := 1;
   }
   i := -7;
   i := o.abilities[ABIL_STR]; // characters only
   if (i != -7)
   {
      logtest(tstno, LOGT_ERROR, "T037 abilities on an object gave " + itoa(i));
      bad := 1;
   }

   // Players only: each fails on an NPC
   i := -7;
   i := u.skills[SKI_SEARCH];
   i := u.ability_levels[ABIL_STR];
   i := u.spell_levels[SPL_ALL];
   i := u.skill_levels[SKI_SEARCH];
   i := u.weapon_levels[WPN_SWORD];
   i := u.ability_costs[ABIL_STR];
   i := u.spell_costs[SPL_ALL];
   i := u.skill_costs[SKI_SEARCH];
   i := u.weapon_costs[WPN_SWORD];
   if (i != -7)
   {
      logtest(tstno, LOGT_ERROR, "T037 a player's indexed field on an NPC gave " + itoa(i));
      bad := 1;
   }
   u.skills[SKI_SEARCH] := 50; // does nothing, and the program goes on
   u.ability_levels[ABIL_STR] := 1;
   u.spell_levels[SPL_ALL] := 1;
   u.skill_levels[SKI_SEARCH] := 1;
   u.weapon_levels[WPN_SWORD] := 1;
   i := -7;
   i := u.skills[SKI_SEARCH];
   if (i != -7)
   {
      logtest(tstno, LOGT_ERROR, "T037 skills on an NPC took " + itoa(i));
      bad := 1;
   }

   destroy(o);
   destroy(u);
   if (bad)
      goto terminate;

   logtest(tstno, LOGT_INFO, "T037 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:terminate:
   logtest(tstno, LOGT_INFO, "T037 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T036 =====================

// A character's own number fields, read on t036npc (built in %mobiles with known values) and
// assigned on it: level, race, sex, alignment, exp, speed, offensive, defensive, position,
// defaultpos, npcflags, charflags, natural_armour, attack_type, hp, max_hp, mana, endurance,
// max_mana and max_endurance. Each assignment is read back, and a value too big for the field's
// storage wraps as the manual says (level 8 bits unsigned, race 16 unsigned, offensive and mana
// 16 signed, npcflags 8 bits). max_mana and max_endurance are computed from the abilities at
// every read. The range checks of alignment, attack_type and natural_armour are T027's.
dilbegin T036(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   u : unitptr;
   o : unitptr;
   i : integer;
   j : integer;
   bad : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T036 character number fields running");
   bad := 0;

   u := load("t036npc@test");
   o := load("pbox@test");

   // As built in the zone file
   if (u.level != 12)
   {
      logtest(tstno, LOGT_ERROR, "T036 level is " + itoa(u.level) + ", built 12");
      bad := 1;
   }
   if (u.race != RACE_DWARF)
   {
      logtest(tstno, LOGT_ERROR, "T036 race is " + itoa(u.race) + ", built RACE_DWARF");
      bad := 1;
   }
   if (u.sex != SEX_FEMALE)
   {
      logtest(tstno, LOGT_ERROR, "T036 sex is " + itoa(u.sex) + ", built SEX_FEMALE");
      bad := 1;
   }
   if (u.alignment != 350)
   {
      logtest(tstno, LOGT_ERROR, "T036 alignment is " + itoa(u.alignment) + ", built 350");
      bad := 1;
   }
   if (u.exp != 77)
   {
      logtest(tstno, LOGT_ERROR, "T036 exp is " + itoa(u.exp) + ", built 77");
      bad := 1;
   }
   if (u.speed != 8)
   {
      logtest(tstno, LOGT_ERROR, "T036 speed is " + itoa(u.speed) + ", built 8");
      bad := 1;
   }
   if ((u.offensive != 13) or (u.defensive != -7))
   {
      logtest(tstno, LOGT_ERROR, "T036 offensive/defensive are " + itoa(u.offensive) + "/" +
              itoa(u.defensive) + ", built 13/-7");
      bad := 1;
   }
   if ((u.position != POSITION_SITTING) or (u.defaultpos != POSITION_RESTING))
   {
      logtest(tstno, LOGT_ERROR, "T036 position/defaultpos are " + itoa(u.position) + "/" +
              itoa(u.defaultpos) + ", built sitting/resting");
      bad := 1;
   }
   if (u.npcflags != NPC_NICE_THIEF)
   {
      logtest(tstno, LOGT_ERROR, "T036 npcflags is " + itoa(u.npcflags) + ", built NPC_NICE_THIEF");
      bad := 1;
   }
   if ((not isset(u.charflags, CHAR_PROTECTED)) or (not isset(u.charflags, CHAR_MUTE)) or
       isset(u.charflags, CHAR_SNEAK))
   {
      logtest(tstno, LOGT_ERROR, "T036 charflags is " + itoa(u.charflags) + ", built protected and mute");
      bad := 1;
   }
   if ((u.natural_armour != ARM_CHAIN) or (u.attack_type != WPN_BITE))
   {
      logtest(tstno, LOGT_ERROR, "T036 natural_armour/attack_type are " + itoa(u.natural_armour) +
              "/" + itoa(u.attack_type) + ", built ARM_CHAIN/WPN_BITE");
      bad := 1;
   }
   // vmc gives an NPC 10 + 3 * HP hit points, full; regenerate_npc@update fills its mana and
   // endurance when it is loaded
   if ((u.max_hp != 10 + 3 * u.abilities[ABIL_HP]) or (u.hp != u.max_hp))
   {
      logtest(tstno, LOGT_ERROR, "T036 hp/max_hp are " + itoa(u.hp) + "/" + itoa(u.max_hp) +
              " with HP " + itoa(u.abilities[ABIL_HP]));
      bad := 1;
   }
   if ((u.mana != u.max_mana) or (u.endurance != u.max_endurance) or (u.mana <= 100))
   {
      logtest(tstno, LOGT_ERROR, "T036 mana/endurance are " + itoa(u.mana) + "/" + itoa(u.endurance));
      bad := 1;
   }

   // Assigned and read back; values outside the storage wrap
   u.level := 30;
   i := u.level;
   u.level := 300;
   if ((i != 30) or (u.level != 44))
   {
      logtest(tstno, LOGT_ERROR, "T036 level took " + itoa(i) + ", and 300 gave " + itoa(u.level));
      bad := 1;
   }
   u.race := RACE_ELF;
   i := u.race;
   u.race := 70000;
   if ((i != RACE_ELF) or (u.race != 4464))
   {
      logtest(tstno, LOGT_ERROR, "T036 race took " + itoa(i) + ", and 70000 gave " + itoa(u.race));
      bad := 1;
   }
   u.sex := SEX_MALE;
   if (u.sex != SEX_MALE)
   {
      logtest(tstno, LOGT_ERROR, "T036 sex SEX_MALE gave " + itoa(u.sex));
      bad := 1;
   }
   u.exp := 250; // the test zone has access level 0
   if (u.exp != 250)
   {
      logtest(tstno, LOGT_ERROR, "T036 exp 250 gave " + itoa(u.exp));
      bad := 1;
   }
   u.offensive := -20;
   i := u.offensive;
   u.offensive := 40000;
   u.defensive := 1234;
   if ((i != -20) or (u.offensive != -25536) or (u.defensive != 1234))
   {
      logtest(tstno, LOGT_ERROR, "T036 offensive took " + itoa(i) + ", 40000 gave " +
              itoa(u.offensive) + ", defensive 1234 gave " + itoa(u.defensive));
      bad := 1;
   }
   u.position := POSITION_STANDING;
   u.defaultpos := POSITION_SLEEPING;
   if ((u.position != POSITION_STANDING) or (u.defaultpos != POSITION_SLEEPING))
   {
      logtest(tstno, LOGT_ERROR, "T036 position/defaultpos took " + itoa(u.position) + "/" +
              itoa(u.defaultpos));
      bad := 1;
   }
   set(u.npcflags, 2);
   i := u.npcflags;
   u.npcflags := 511;
   if ((i != NPC_NICE_THIEF + 2) or (u.npcflags != 255))
   {
      logtest(tstno, LOGT_ERROR, "T036 npcflags took " + itoa(i) + ", and 511 gave " + itoa(u.npcflags));
      bad := 1;
   }
   set(u.charflags, CHAR_SNEAK);
   unset(u.charflags, CHAR_MUTE);
   if ((not isset(u.charflags, CHAR_SNEAK)) or isset(u.charflags, CHAR_MUTE) or
       (not isset(u.charflags, CHAR_PROTECTED)))
   {
      logtest(tstno, LOGT_ERROR, "T036 set/unset on charflags gave " + itoa(u.charflags));
      bad := 1;
   }
   u.charflags := CHAR_HIDE; // replaces every flag
   if (u.charflags != CHAR_HIDE)
   {
      logtest(tstno, LOGT_ERROR, "T036 charflags := CHAR_HIDE gave " + itoa(u.charflags));
      bad := 1;
   }

   // Not capped by the maximum, on characters and objects alike
   u.max_hp := 500;
   u.hp := 900;
   o.hp := 77;
   if ((u.max_hp != 500) or (u.hp != 900) or (o.hp != 77))
   {
      logtest(tstno, LOGT_ERROR, "T036 max_hp 500 and hp 900 gave " + itoa(u.max_hp) + " and " +
              itoa(u.hp) + ", object hp 77 gave " + itoa(o.hp));
      bad := 1;
   }
   u.mana := 999;
   u.endurance := -5;
   i := u.mana;
   u.mana := 40000;
   if ((i != 999) or (u.endurance != -5) or (u.mana != -25536))
   {
      logtest(tstno, LOGT_ERROR, "T036 mana 999 and endurance -5 gave " + itoa(i) + " and " +
              itoa(u.endurance) + ", mana 40000 gave " + itoa(u.mana));
      bad := 1;
   }

   // Computed at every read: 100 + (BRA + CHA) / 2 at most 200, and CON * 2 + 150
   if ((u.max_mana != 100 + (u.abilities[ABIL_BRA] + u.abilities[ABIL_CHA]) / 2) or
       (u.max_endurance != u.abilities[ABIL_CON] * 2 + 150))
   {
      logtest(tstno, LOGT_ERROR, "T036 max_mana/max_endurance are " + itoa(u.max_mana) + "/" +
              itoa(u.max_endurance));
      bad := 1;
   }
   u.abilities[ABIL_BRA] := 100;
   u.abilities[ABIL_CHA] := 60;
   u.abilities[ABIL_CON] := 40;
   i := u.max_mana;
   j := u.max_endurance;
   u.abilities[ABIL_BRA] := 300;
   if ((i != 180) or (j != 230) or (u.max_mana != 200))
   {
      logtest(tstno, LOGT_ERROR, "T036 max_mana gave " + itoa(i) + " and " + itoa(u.max_mana) +
              " (180, 200), max_endurance " + itoa(j) + " (230)");
      bad := 1;
   }

   // Characters only: on an object each one fails and the variable keeps its value
   i := -7;
   i := o.level;
   i := o.race;
   i := o.sex;
   i := o.mana;
   i := o.endurance;
   i := o.max_mana;
   i := o.max_endurance;
   i := o.speed;
   i := o.offensive;
   i := o.position;
   i := o.charflags;
   i := o.exp;
   if (i != -7)
   {
      logtest(tstno, LOGT_ERROR, "T036 a character field on an object gave " + itoa(i));
      bad := 1;
   }
   // NPCs only
   i := -7;
   i := o.npcflags;
   i := o.defaultpos;
   if (i != -7)
   {
      logtest(tstno, LOGT_ERROR, "T036 npcflags or defaultpos on an object gave " + itoa(i));
      bad := 1;
   }

   destroy(o);
   destroy(u);
   if (bad)
      goto terminate;

   logtest(tstno, LOGT_INFO, "T036 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:terminate:
   logtest(tstno, LOGT_INFO, "T036 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T035 =====================

// The world's lists and finders. The global list: no player is on, so pc_head() is null and
// ghead() (global_head()) is the newest NPC; npc_head() and obj_head() are the newest NPC and
// object, and each section holds units of one type up to the next head. zhead() (zone_head())
// goes through the zones in name order; findzone() and findroom() find by exact name;
// findsymbolic() finds the newest copy, the copy with an idx, or a copy around a unit;
// findunit() finds by name as the searcher sees it and eats the words it matched;
// findrndunit() never picks the searcher and takes one place only. clone() copies a unit as it
// is now, without its contents, into self. pathto(): testlabc and testlabe reach each other,
// labcontrol only leads up. unitdir() and delunit() on the zone's units folder (delunit is
// TRUE when it deleted), weather is a sky value, and isplayer() is FALSE with no player file.
dilbegin T035(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   u : unitptr;
   u2 : unitptr;
   n1 : unitptr;
   n2 : unitptr;
   o1 : unitptr;
   o2 : unitptr;
   d : unitptr;
   rc : unitptr;
   re : unitptr;
   z : zoneptr;
   zn : zoneptr;
   s : string;
   sl : stringlist;
   i : integer;
   n : integer;
   f : integer;
   bad : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T035 world lists and finders running");
   bad := 0;
   rc := findroom("testlabc@test");
   re := findroom("testlabe@test");

   n1 := load("experiment@test");
   n2 := load("follower@test");
   o1 := load("pbox@test");
   o2 := load("pbox@test");
   link(n1, rc);
   link(n2, rc);
   link(o1, rc);
   link(o2, rc);

   // The global list: players, then NPCs, then objects, then rooms; the newest first
   if (pc_head() != null)
   {
      logtest(tstno, LOGT_ERROR, "T035 pc_head() isn't null with no player on");
      bad := 1;
   }
   if ((ghead() != n2) or (global_head() != n2) or (npc_head() != n2) or (n2.gnext != n1))
   {
      logtest(tstno, LOGT_ERROR, "T035 ghead/global_head/npc_head isn't the newest NPC");
      bad := 1;
   }
   if ((obj_head() != o2) or (o2.gnext != o1))
   {
      logtest(tstno, LOGT_ERROR, "T035 obj_head isn't the newest object");
      bad := 1;
   }
   u := room_head();
   if (u.type != UNIT_ST_ROOM)
   {
      logtest(tstno, LOGT_ERROR, "T035 room_head isn't a room");
      bad := 1;
   }
   // The NPC section ends at the first object, and holds the director
   d := findsymbolic("director@test");
   u := npc_head();
   n := 0;
   f := 0;
   while (u.type == UNIT_ST_NPC)
   {
      if (u == d)
         f := 1;
      n := n + 1;
      u := u.gnext;
   }
   if ((u != obj_head()) or (f == 0) or (n < 3))
   {
      logtest(tstno, LOGT_ERROR, "T035 the NPC section from npc_head ends at " + u.symname +
              ", " + itoa(n) + " NPCs, director found " + itoa(f));
      bad := 1;
   }
   logtest(tstno, LOGT_INFO, "T035 " + itoa(n) + " NPCs");
   // The rooms run to the end of the list, and hold labcontrol
   u := room_head();
   n := 0;
   f := 0;
   while (u != null)
   {
      if (u.type != UNIT_ST_ROOM)
         f := 2;
      else if (u == self)
         f := f + 1;
      n := n + 1;
      u := u.gnext;
   }
   if (f != 1)
   {
      logtest(tstno, LOGT_ERROR, "T035 the rooms from room_head: " + itoa(n) + " units, check " + itoa(f));
      bad := 1;
   }
   logtest(tstno, LOGT_INFO, "T035 " + itoa(n) + " rooms");

   // Zones in name order, the same from zhead() and zone_head()
   z := zhead();
   zn := zone_head();
   if (z.name != zn.name)
   {
      logtest(tstno, LOGT_ERROR, "T035 zhead() and zone_head() differ");
      bad := 1;
   }
   n := 0;
   f := 0;
   while (z)
   {
      if (z.name == "test")
         f := f + 1;
      zn := z.next;
      if (zn)
      {
         if (not (z.name < zn.name))
         {
            logtest(tstno, LOGT_ERROR, "T035 zone " + zn.name + " comes after " + z.name);
            bad := 1;
         }
      }
      n := n + 1;
      z := zn;
   }
   if ((f != 1) or (n < 10))
   {
      logtest(tstno, LOGT_ERROR, "T035 zhead's list: " + itoa(n) + " zones, test found " + itoa(f));
      bad := 1;
   }
   z := findzone("test");
   s := z.name;
   if (s != "test")
   {
      logtest(tstno, LOGT_ERROR, "T035 findzone(test) didn't find the zone");
      bad := 1;
   }
   z := null;
   z := findzone(self.zone);
   s := z.name;
   if (s != "test")
   {
      logtest(tstno, LOGT_ERROR, "T035 findzone(self.zone) didn't find the zone");
      bad := 1;
   }
   if ((findzone("Test") != null) or (findzone("t035nosuch") != null))
   {
      logtest(tstno, LOGT_ERROR, "T035 findzone found a zone of a wrong name");
      bad := 1;
   }

   // findroom: by symbolic name, any case; not without the zone, not an NPC
   u := findroom("TestLabC@Test");
   if ((rc.symname != "testlabc@test") or (u != rc))
   {
      logtest(tstno, LOGT_ERROR, "T035 findroom didn't find testlabc");
      bad := 1;
   }
   if ((findroom("testlabc") != null) or (findroom("experiment@test") != null) or
       (findroom("t035nosuch@test") != null))
   {
      logtest(tstno, LOGT_ERROR, "T035 findroom found a room that isn't one");
      bad := 1;
   }

   // findsymbolic: the newest copy, the copy with that idx, a copy around a unit, rooms too
   if ((findsymbolic("pbox@test") != o2) or (findsymbolic("pbox@test", o1.idx) != o1) or
       (findsymbolic("labcontrol@test") != self) or (findsymbolic("pbox") != null))
   {
      logtest(tstno, LOGT_ERROR, "T035 findsymbolic found the wrong unit");
      bad := 1;
   }
   link(o1, n1);
   if ((findsymbolic(n1, "pbox@test", FIND_UNIT_INVEN) != o1) or
       (findsymbolic(n1, "pbox@test", FIND_UNIT_EQUIP) != null) or
       (findsymbolic(n2, "pbox@test", FIND_UNIT_INVEN) != null))
   {
      logtest(tstno, LOGT_ERROR, "T035 findsymbolic around a unit found the wrong unit");
      bad := 1;
   }

   // findunit: by name, the words matched are taken off the string
   s := "box";
   u := findunit(n1, s, FIND_UNIT_INVEN, null);
   if ((u != o1) or (s != ""))
   {
      logtest(tstno, LOGT_ERROR, "T035 findunit in the inventory, left '" + s + "'");
      bad := 1;
   }
   link(o1, rc);
   s := "the follower rest";
   u := findunit(n1, s, FIND_UNIT_SURRO, null);
   if ((u != n2) or (s != "rest"))
   {
      logtest(tstno, LOGT_ERROR, "T035 findunit of the follower, left '" + s + "'");
      bad := 1;
   }
   u := findunit(n1, "1.box", FIND_UNIT_SURRO, null);
   u2 := findunit(n1, "2.box", FIND_UNIT_SURRO, null);
   if ((u == u2) or ((u != o1) and (u != o2)) or ((u2 != o1) and (u2 != o2)))
   {
      logtest(tstno, LOGT_ERROR, "T035 findunit of 1.box and 2.box");
      bad := 1;
   }
   if ((findunit(n1, "box", FIND_UNIT_SURRO, null, UNIT_ST_NPC) != null) or
       (findunit(n1, "t035nosuch", FIND_UNIT_SURRO, null) != null) or
       (findunit(n1, "self", FIND_UNIT_SURRO, null) != n1))
   {
      logtest(tstno, LOGT_ERROR, "T035 findunit with a type, an unknown name or self");
      bad := 1;
   }
   // A room that searches: only the list counts
   u := findunit(rc, "follower", FIND_UNIT_SURRO, null);
   u2 := findunit(rc, "follower", 0, rc.inside);
   if ((u != null) or (u2 != n2))
   {
      logtest(tstno, LOGT_ERROR, "T035 findunit by a room");
      bad := 1;
   }

   // findrndunit: never the searcher; one place only
   n := 0;
   f := 0;
   i := 0;
   while (i < 40)
   {
      u := findrndunit(n1, FIND_UNIT_SURRO, UNIT_ST_NPC);
      if (u != n2)
         f := 1;
      u := findrndunit(n1, FIND_UNIT_SURRO, UNIT_ST_OBJ);
      if (u == o1)
         n := n + 1;
      else if (u != o2)
         f := 1;
      i := i + 1;
   }
   if ((f != 0) or (n == 0) or (n == 40))
   {
      logtest(tstno, LOGT_ERROR, "T035 findrndunit in testlabc: o1 " + itoa(n) + " of 40, wrong " + itoa(f));
      bad := 1;
   }
   if ((findrndunit(n1, FIND_UNIT_INVEN, UNIT_ST_OBJ) != null) or
       (findrndunit(n1, FIND_UNIT_SURRO | FIND_UNIT_INVEN, UNIT_ST_OBJ) != null))
   {
      logtest(tstno, LOGT_ERROR, "T035 findrndunit found something in an empty inventory or two places");
      bad := 1;
   }

   // clone: as the unit is now, but empty, and in self
   o1.title := "a t035 box";
   u := load("deadbug@test");
   link(u, o1);
   u := clone(o1);
   if ((u == null) or (u == o1))
   {
      logtest(tstno, LOGT_ERROR, "T035 clone made no copy");
      bad := 1;
   }
   else
   {
      if ((u.title != "a t035 box") or (u.symname != "pbox@test") or (u.inside != null) or
          (u.outside != self) or (o1.inside == null))
      {
         logtest(tstno, LOGT_ERROR, "T035 clone: title " + u.title + ", " + u.symname);
         bad := 1;
      }
      destroy(u);
   }

   // pathto: the first step; a unit stands for its room
   i := pathto(rc, re);
   n := pathto(re, rc);
   if ((i != DIR_EAST) or ((n != DIR_WEST) and (n != DIR_EAST)))
   {
      logtest(tstno, LOGT_ERROR, "T035 pathto between testlabc and testlabe: " + itoa(i) + ", " + itoa(n));
      bad := 1;
   }
   if ((pathto(n1, o2) != DIR_HERE) or (pathto(n1, re) != DIR_EAST) or
       (pathto(self, rc) != DIR_IMPOSSIBLE))
   {
      logtest(tstno, LOGT_ERROR, "T035 pathto here, from a unit or one way: " + itoa(pathto(n1, o2)) + ", " +
              itoa(pathto(n1, re)) + ", " + itoa(pathto(self, rc)));
      bad := 1;
   }

   // unitdir and delunit: the files store() writes in the zone's units folder
   i := delunit("t035a");
   i := delunit("t035b");
   store(o1, "t035a", FALSE);
   sl := unitdir("t035.*");
   if ((length(sl) != 1) or (sl.[0] != "t035a"))
   {
      logtest(tstno, LOGT_ERROR, "T035 unitdir after one store: " + itoa(length(sl)) + " files");
      bad := 1;
   }
   store(o1, "t035b", FALSE);
   sl := unitdir("t035.*");
   n := length(unitdir("t035"));
   if ((length(sl) != 2) or (not ("t035b" in sl)) or (n != 0))
   {
      logtest(tstno, LOGT_ERROR, "T035 unitdir after two stores: " + itoa(length(sl)) + " files, " +
              itoa(n) + " for t035");
      bad := 1;
   }
   i := delunit("t035a");
   n := delunit("t035a");
   sl := unitdir("t035.*");
   if ((i != TRUE) or (n != FALSE) or (length(sl) != 1) or (sl.[0] != "t035b"))
   {
      logtest(tstno, LOGT_ERROR, "T035 delunit gave " + itoa(i) + " then " + itoa(n) + ", " +
              itoa(length(sl)) + " files left");
      bad := 1;
   }
   i := delunit("t035b");
   if (delunit("t035/b") != FALSE)
   {
      logtest(tstno, LOGT_ERROR, "T035 delunit of a name with a slash isn't FALSE");
      bad := 1;
   }

   // The zone's sky, and no player of a name without a player file
   i := -1;
   i := weather;
   if ((i < SKY_CLOUDLESS) or (i > SKY_LIGHTNING))
   {
      logtest(tstno, LOGT_ERROR, "T035 weather is " + itoa(i));
      bad := 1;
   }
   if (isplayer("t035nobody") != FALSE)
   {
      logtest(tstno, LOGT_ERROR, "T035 isplayer found a player with no file");
      bad := 1;
   }

   destroy(o1);
   destroy(o2);
   destroy(n1);
   destroy(n2);
   if (bad)
      goto terminate;

   logtest(tstno, LOGT_INFO, "T035 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:terminate:
   logtest(tstno, LOGT_INFO, "T035 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T034 =====================

// Characters: fights, affects, followers, equipment, money, carrying and sight. In testlabc
// meleeattack() starts a fight (fighting, opponent() both ways, getopponent()), meleedamage()
// hits without putting the attacker in the fight first, and attack_spell() deals its damage
// through an effect template (t034eff, which gets the damage). getaffects() lists an affect
// as id,apf,data0,data1,data2,duration and isaff() finds it. getfollower() is the newest
// follower first; equipment() what is worn where; fits() the size for a position;
// can_carry() 0, 1 (too many) or 2 (too heavy); transfermoney() makes, moves and destroys
// money, and purse() counts the coins; paycheck() is TRUE with accounting off. visible() and
// islight(): t034dark is a dark room, testlabc is lit.
dilbegin t034eff(med : unitptr, tgt : unitptr, hm : integer);
code
{
   addextra(self.extra, {"$t034eff"}, itoa(hm) + " " + tgt.symname);
   quit;
}
dilend

dilbegin T034(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   rc : unitptr;
   rd : unitptr;
   n1 : unitptr;
   n2 : unitptr;
   n3 : unitptr;
   o : unitptr;
   o2 : unitptr;
   u : unitptr;
   nobody : unitptr;
   s : string;
   sl : stringlist;
   i : integer;
   n : integer;
   hv : integer;
   bad : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T034 fights, affects, followers, equipment, money and sight running");
   bad := 0;
   rc := findroom("testlabc@test");
   rd := findroom("t034dark@test");

   n1 := load("experiment@test");
   n2 := load("follower@test");
   n3 := load("experiment@test");
   o := load("pbox@test");
   link(n1, rc);
   link(n2, rc);
   link(n3, rc);
   link(o, rc);
   n2.max_hp := 5000;
   n2.hp := 5000;
   n1.max_hp := 5000;
   n1.hp := 5000;

   // meleeattack: one blow, and the fight is on both ways
   if (opponent(n1, n2) or (n1.opponentcount != 0))
   {
      logtest(tstno, LOGT_ERROR, "T034 opponents before any fight");
      bad := 1;
   }
   i := meleeattack(n1, n2, 1000, WPN_FIST, TRUE);
   if ((i < 0) or (n1.fighting != n2) or (not opponent(n1, n2)) or (not opponent(n2, n1)) or
       (getopponent(n1, 0) != n2) or (getopponent(n2, 0) != n1) or (getopponent(n1, 1) != null) or
       (getopponent(n1, -1) != null) or (n1.opponentcount != 1))
   {
      logtest(tstno, LOGT_ERROR, "T034 meleeattack gave " + itoa(i) + ", opponents " + itoa(n1.opponentcount));
      bad := 1;
   }
   if ((meleeattack(n1, n1, 0, WPN_FIST, TRUE) != -1) or (opponent(n1, n3)))
   {
      logtest(tstno, LOGT_ERROR, "T034 meleeattack on itself, or opponent of one not in the fight");
      bad := 1;
   }
   i := 7;
   i := meleeattack(n1, o, 0, WPN_FIST, TRUE);
   n := 7;
   n := opponent(n1, o);
   if ((i != 7) or (n != 7))
   {
      logtest(tstno, LOGT_ERROR, "T034 meleeattack or opponent with an object didn't fail");
      bad := 1;
   }

   // meleedamage: n3 hits n2, who is fighting n1: n3 joins n2's opponents; the hp go down by
   // the damage
   hv := n2.hp;
   i := meleedamage(n3, n2, 1000, WPN_FIST);
   if ((i < 0) or (n2.hp != hv - i) or (not opponent(n2, n3)) or (n2.opponentcount != 2) or
       (getopponent(n2, 1) != n3))
   {
      logtest(tstno, LOGT_ERROR, "T034 meleedamage gave " + itoa(i) + ", hp " + itoa(hv) + " to " +
              itoa(n2.hp) + ", opponents " + itoa(n2.opponentcount));
      bad := 1;
   }

   // attack_spell: the effect template gets the damage, the target loses it
   hv := n2.hp;
   i := attack_spell(SPL_FIREBALL_1, n1, n1, n2, 1000, "t034eff@test");
   s := "";
   if ("$t034eff" in n1.extra)
      s := n1.extra.["$t034eff"].descr;
   if ((i <= 0) or (s != itoa(i) + " follower@test") or (n2.hp != hv - i))
   {
      logtest(tstno, LOGT_ERROR, "T034 attack_spell gave " + itoa(i) + ", effect '" + s + "', hv " +
              itoa(hv) + " to " + itoa(n2.hp));
      bad := 1;
   }
   i := 7;
   i := attack_spell(SPL_FIREBALL_1, o, n1, n2, 0, "");
   if (i != 7)
   {
      logtest(tstno, LOGT_ERROR, "T034 attack_spell by an object didn't fail");
      bad := 1;
   }
   stop_fighting(n1, null);
   stop_fighting(n2, null);
   stop_fighting(n3, null);
   if ((n1.fighting != null) or (n2.opponentcount != 0) or opponent(n1, n2))
   {
      logtest(tstno, LOGT_ERROR, "T034 the fight didn't end");
      bad := 1;
   }

   // getaffects and isaff
   addaff(o, ID_BLANK10, -1, 0, 1, 2, 3, TIF_NONE, TIF_NONE, TIF_NONE, APF_NONE);
   sl := getaffects(o);
   if ((length(sl) != 1) or (sl.[0] != itoa(ID_BLANK10) + ",-1,1,2,3,-1") or
       (not isaff(o, ID_BLANK10)) or isaff(o, ID_BLESS))
   {
      logtest(tstno, LOGT_ERROR, "T034 getaffects gave " + itoa(length(sl)) + " affects: " + sl.[0]);
      bad := 1;
   }
   subaff(o, ID_BLANK10);
   sl := getaffects(o);
   i := 7;
   i := isaff(nobody, ID_BLANK10);
   if ((length(sl) != 0) or isaff(o, ID_BLANK10) or (i != 7))
   {
      logtest(tstno, LOGT_ERROR, "T034 getaffects or isaff after subaff");
      bad := 1;
   }

   // getfollower: the newest follower is number 0
   follow(n2, n1);
   follow(n3, n1);
   if ((n1.followercount != 2) or (getfollower(n1, 0) != n3) or (getfollower(n1, 1) != n2) or
       (getfollower(n1, 2) != null) or (getfollower(n1, -1) != null) or (getfollower(n2, 0) != null))
   {
      logtest(tstno, LOGT_ERROR, "T034 getfollower with " + itoa(n1.followercount) + " followers");
      bad := 1;
   }
   follow(n2, null);
   follow(n3, null);

   // equipment: what is worn in that position
   o2 := load("pbox@test");
   link(o2, n1);
   addequip(o2, WEAR_HEAD);
   u := n1;
   u := equipment(o, WEAR_HEAD);
   if ((equipment(n1, WEAR_HEAD) != o2) or (equipment(n1, WEAR_BODY) != null) or (u != n1))
   {
      logtest(tstno, LOGT_ERROR, "T034 equipment found the wrong unit");
      bad := 1;
   }
   unequip(o2);
   if (equipment(n1, WEAR_HEAD) != null)
   {
      logtest(tstno, LOGT_ERROR, "T034 equipment after unequip");
      bad := 1;
   }

   // fits: the object's height in percent of the character's; body armour is stricter
   n1.height := 200;
   o2.height := 200;
   s := fits(n1, o2, WEAR_HEAD);
   o2.height := 40;
   s := s + "/" + fits(n1, o2, WEAR_HEAD);
   o2.height := 80;
   s := s + "/" + fits(n1, o2, WEAR_HEAD);
   o2.height := 110;
   s := s + "/" + fits(n1, o2, WEAR_HEAD) + "/" + fits(n1, o2, WEAR_BODY);
   o2.height := 350;
   s := s + "/" + fits(n1, o2, WEAR_HEAD);
   o2.height := 500;
   s := s + "/" + fits(n1, o2, WEAR_HEAD);
   if (s != "/way too small/too small//too small/too large/way too large")
   {
      logtest(tstno, LOGT_ERROR, "T034 fits gave " + s);
      bad := 1;
   }
   // A failed string assigned is "": a fits() that fails, joined to "x", leaves nothing
   s := fits(o, o2, WEAR_HEAD) + "x";
   if (s != "")
   {
      logtest(tstno, LOGT_ERROR, "T034 fits for an object didn't fail: '" + s + "'");
      bad := 1;
   }

   // can_carry: 0 yes, 1 too many items, 2 too heavy; n below 1 fails
   i := can_carry(n1, o2, 1);
   n := can_carry(n1, o2, 1000);
   set_weight(o2, 30000);
   hv := can_carry(n1, o2, 1);
   set_weight(o2, 1);
   if ((i != 0) or (n != 1) or (hv != 2))
   {
      logtest(tstno, LOGT_ERROR, "T034 can_carry gave " + itoa(i) + ", " + itoa(n) + ", " + itoa(hv));
      bad := 1;
   }
   i := 7;
   i := can_carry(n1, o2, 0);
   n := 7;
   n := can_carry(o, o2, 1);
   if ((i != 7) or (n != 7))
   {
      logtest(tstno, LOGT_ERROR, "T034 can_carry of 0 or by an object didn't fail");
      bad := 1;
   }

   // transfermoney and purse: the amount is a value; coins are counted per kind
   if ((purse(n1, GOLD_PIECE) != 0) or (purse(n1, IRON_PIECE) != 0))
   {
      logtest(tstno, LOGT_ERROR, "T034 a new NPC carries money");
      bad := 1;
   }
   i := transfermoney(null, n1, 2 * GOLD_MULT + 3 * IRON_MULT);
   if ((i != TRUE) or (purse(n1, GOLD_PIECE) != 2) or (purse(n1, IRON_PIECE) != 3) or
       (purse(n1, "xx") != 0))
   {
      logtest(tstno, LOGT_ERROR, "T034 transfermoney from null gave " + itoa(i) + ": " +
              itoa(purse(n1, GOLD_PIECE)) + " gold, " + itoa(purse(n1, IRON_PIECE)) + " iron");
      bad := 1;
   }
   i := transfermoney(n1, n2, 2 * GOLD_MULT + 3 * IRON_MULT);
   n := transfermoney(n1, n2, IRON_MULT);
   if ((i != TRUE) or (n != FALSE) or (purse(n1, GOLD_PIECE) != 0) or (purse(n1, IRON_PIECE) != 0) or
       (purse(n2, GOLD_PIECE) * GOLD_MULT + purse(n2, IRON_PIECE) * IRON_MULT != 2 * GOLD_MULT + 3 * IRON_MULT))
   {
      logtest(tstno, LOGT_ERROR, "T034 transfermoney between NPCs gave " + itoa(i) + " and " + itoa(n));
      bad := 1;
   }
   i := transfermoney(n2, null, 2 * GOLD_MULT + 3 * IRON_MULT);
   n := 7;
   n := transfermoney(o, n2, IRON_MULT);
   if ((i != TRUE) or (purse(n2, GOLD_PIECE) != 0) or (purse(n2, IRON_PIECE) != 0) or (n != 7))
   {
      logtest(tstno, LOGT_ERROR, "T034 transfermoney to null gave " + itoa(i) + ", from an object " + itoa(n));
      bad := 1;
   }

   // paycheck: accounting is off in the test server: always TRUE
   if ((paycheck(n1, rc) != TRUE) or (paycheck(nobody, nobody) != TRUE))
   {
      logtest(tstno, LOGT_ERROR, "T034 paycheck isn't TRUE with accounting off");
      bad := 1;
   }

   // visible and islight
   link(o2, rc);
   if ((rd == null) or (not islight(rc)) or islight(rd) or (not visible(n1, o2)))
   {
      logtest(tstno, LOGT_ERROR, "T034 islight or visible in the light");
      bad := 1;
   }
   hv := o2.flags;
   o2.flags := hv | UNIT_FL_INVISIBLE;
   i := visible(n1, o2);
   o2.flags := hv;
   hv := n1.charflags;
   n1.charflags := hv | CHAR_BLIND;
   n := visible(n1, o2);
   n1.charflags := hv;
   if ((i != FALSE) or (n != FALSE) or (not visible(n1, o2)))
   {
      logtest(tstno, LOGT_ERROR, "T034 visible of an invisible box " + itoa(i) + ", by the blind " + itoa(n));
      bad := 1;
   }
   link(n1, rd);
   i := 7;
   i := visible(n1, o2);
   n := 7;
   n := visible(o, n1);
   if ((i != FALSE) or (n != 7))
   {
      logtest(tstno, LOGT_ERROR, "T034 visible from a dark room " + itoa(i) + ", by an object " + itoa(n));
      bad := 1;
   }

   destroy(o);
   destroy(o2);
   destroy(n1);
   destroy(n2);
   destroy(n3);
   if (bad)
      goto terminate;

   logtest(tstno, LOGT_INFO, "T034 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:terminate:
   logtest(tstno, LOGT_INFO, "T034 failed");
   sendtoalldil("done", "labdirector@test");
   quit;
}
dilend

// ==================== T033 =====================

// Events and the built-ins that describe them. t033ear, on a box in testlabe, keeps what
// cmdstr, excmdstr, excmdstr_case, argument, activator, medium, target and power held at each
// event, one extra per kind ($t033cmd, $t033pre, $t033done, $t033msg). It takes SFB_PRE and
// SFB_DONE by interrupt(), skips the message "t033 skip" (an interrupt to skip), and when
// dildestroy() removes it, its SFB_DILDESTROY interrupt leaves $t033gone. In a SFB_PRE "cast"
// it sets power to 75; it blocks a SFB_PRE "north" with the argument "stop".
// T033 has an NPC type a command, an abbreviation and an unknown word (exec), give an object,
// sends the ear a message, send_pre()s, and casts bless with cast_spell(), whose result is the
// power the ear set. Also command(), self, heartbeat, dilcall(), dilfind(), dildestroy(),
// chead()/command_head(), getcmd() and sact().
dilbegin t033ear();
var
   k : string;
   kl : stringlist;
   s : string;
   i : integer;
code
{
   addextra(self.extra, {"$t033hb"}, itoa(heartbeat));
   addextra(self.extra, {"$t033self"}, self.symname);
   i := interrupt(SFB_DILDESTROY, TRUE, gone);
   i := interrupt(SFB_PRE, TRUE, gotpre);
   i := interrupt(SFB_DONE, TRUE, gotdone);
   i := interrupt(SFB_MSG, argument == "t033 skip", skip);
:loop:
   wait(SFB_CMD | SFB_MSG, TRUE);
   if (command(CMD_AUTO_MSG))
      k := "$t033msg";
   else
      k := "$t033cmd";
   goto record;

:gotpre:
   k := "$t033pre";
   if (command("cast"))
      power := 75;
   goto record;

:gotdone:
   k := "$t033done";

:record:
   s := k;
   if (cmdstr)
      s := s + "|" + cmdstr;
   else
      s := s + "|-";
   if (excmdstr)
      s := s + "|" + excmdstr;
   else
      s := s + "|-";
   if (excmdstr_case)
      s := s + "|" + excmdstr_case;
   else
      s := s + "|-";
   if (argument)
      s := s + "|" + argument;
   else
      s := s + "|-";
   if (activator)
      s := s + "|" + activator.symname;
   else
      s := s + "|-";
   if (medium)
      s := s + "|" + medium.symname;
   else
      s := s + "|-";
   if (target)
      s := s + "|" + target.symname;
   else
      s := s + "|-";
   s := s + "|" + itoa(power) + "|" + itoa(command("north")) + itoa(command("give")) +
        itoa(command("xyzzyq")) + itoa(command(CMD_AUTO_UNKNOWN)) + itoa(command(CMD_AUTO_MSG));
   if (self.extra.[k] != null)
      subextra(self.extra, k);
   kl := {"x"};
   kl.[0] := k;
   addextra(self.extra, kl, s);
   if ((k == "$t033pre") and command("north") and (argument == "stop"))
      block;
   goto loop;

:gone:
   addextra(self.extra, {"$t033gone"}, "gone");
   quit;
}
dilend

// Called by dilcall(): runs in the caller's program, so self is the caller's
dilbegin integer t033fn(u : unitptr, i : integer, s : string);
code
{
   return (i * 10 + length(s) + 1000 * (self == u));
}
dilend

dilbegin T033(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   re : unitptr;
   b : unitptr;
   n1 : unitptr;
   n2 : unitptr;
   o : unitptr;
   c : cmdptr;
   c2 : cmdptr;
   s : string;
   i : integer;
   n : integer;
   f : integer;
   bad : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T033 events, commands and DIL programs running");
   bad := 0;

   // self is the unit the program runs on: the lab director copies the test onto labcontrol
   if ((self != findroom("labcontrol@test")) or (self.symname != "labcontrol@test"))
   {
      logtest(tstno, LOGT_ERROR, "T033 self isn't labcontrol");
      bad := 1;
   }

   re := findroom("testlabe@test");
   b := load("pbox@test");
   link(b, re);
   dilcopy("t033ear@test", b);
   i := 0;
:earwait:
   pause;   // the copy starts at a later tick
   // Woken by a tick: no activator, and command() says so
   if ((activator != null) or (not command(CMD_AUTO_TICK)) or command("north") or command(CMD_AUTO_MSG))
   {
      logtest(tstno, LOGT_ERROR, "T033 a tick with an activator, or command() not the tick");
      bad := 1;
   }
   // Unit variables are null after the pause: find them again
   re := findroom("testlabe@test");
   b := findsymbolic(re, "pbox@test", FIND_UNIT_INVEN);
   i := i + 1;
   if ((not ("$t033hb" in b.extra)) and (i < 10))
      goto earwait;
   if (not dilfind("t033ear@test", b))
   {
      logtest(tstno, LOGT_ERROR, "T033 dilfind doesn't find the ear's program");
      bad := 1;
   }
   if (dilfind("t033fn@test", b) or dilfind("t033ear", b))
   {
      logtest(tstno, LOGT_ERROR, "T033 dilfind found a program the box hasn't, or one without its zone");
      bad := 1;
   }
   // A new program's heartbeat is PULSE_SEC; self in the ear is its box
   s := "";
   if ("$t033hb" in b.extra)
      s := b.extra.["$t033hb"].descr + " " + b.extra.["$t033self"].descr;
   if (s != itoa(PULSE_SEC) + " pbox@test")
   {
      logtest(tstno, LOGT_ERROR, "T033 the ear started with heartbeat and self '" + s + "'");
      bad := 1;
   }

   n1 := load("experiment@test");
   n2 := load("follower@test");
   link(n1, re);
   link(n2, re);

   // A command typed as an abbreviation: cmdstr is the command, excmdstr the word in lower case,
   // excmdstr_case as typed
   exec("N", n1);
   s := b.extra.["$t033cmd"].descr;
   if (strcmp(s, "$t033cmd|north|n|N||experiment@test|-|-|0|10000") != 0)
   {
      logtest(tstno, LOGT_ERROR, "T033 the command N: " + s);
      bad := 1;
   }
   // A word that is no command: CMD_AUTO_UNKNOWN, and command() of the word itself
   exec("Xyzzyq  Foo  Bar ", n1);
   s := b.extra.["$t033cmd"].descr;
   if (strcmp(s, "$t033cmd|xyzzyq|xyzzyq|Xyzzyq|Foo  Bar|experiment@test|-|-|0|00110") != 0)
   {
      logtest(tstno, LOGT_ERROR, "T033 the unknown word: " + s);
      bad := 1;
   }

   // give: SFB_DONE with the item as medium and the receiver as target
   o := load("deadbug@test");
   link(o, n1);
   exec("give bug follower", n1);
   s := b.extra.["$t033done"].descr;
   if ((o.outside != n2) or (strcmp(s, "$t033done|give|give|give||experiment@test|deadbug@test|follower@test|0|01000") != 0))
   {
      logtest(tstno, LOGT_ERROR, "T033 give: " + s);
      bad := 1;
   }

   // A message: the sender is the activator, no command
   sendto("t033 hello", b);
   s := b.extra.["$t033msg"].descr;
   if (strcmp(s, "$t033msg|-|-|-|t033 hello|labcontrol@test|-|-|0|00001") != 0)
   {
      logtest(tstno, LOGT_ERROR, "T033 a message: " + s);
      bad := 1;
   }
   // An interrupt to skip: the message never reaches the program's wait
   sendto("t033 skip", b);
   if (b.extra.["$t033msg"].descr != s)
   {
      logtest(tstno, LOGT_ERROR, "T033 the skipped message arrived: " + b.extra.["$t033msg"].descr);
      bad := 1;
   }

   // send_pre: the receivers see its activator, medium, target, power and argument, and one blocks
   i := send_pre("north", n1, o, n2, 33, "stop", null);
   s := b.extra.["$t033pre"].descr;
   if ((i != SFR_BLOCK) or (strcmp(s, "$t033pre|north|-|-|stop|experiment@test|deadbug@test|follower@test|33|10000") != 0))
   {
      logtest(tstno, LOGT_ERROR, "T033 send_pre north stop gave " + itoa(i) + ": " + s);
      bad := 1;
   }
   i := send_pre("north", n1, null, null, 5, "go", null);
   s := b.extra.["$t033pre"].descr;
   if ((i != SFR_SHARE) or (strcmp(s, "$t033pre|north|-|-|go|experiment@test|-|-|5|10000") != 0))
   {
      logtest(tstno, LOGT_ERROR, "T033 send_pre north go gave " + itoa(i) + ": " + s);
      bad := 1;
   }
   i := 7;
   i := send_pre("t033nosuch", n1, null, null, 5, "go", null);
   if (i != 7)
   {
      logtest(tstno, LOGT_ERROR, "T033 send_pre of no command gave " + itoa(i));
      bad := 1;
   }

   // cast_spell: the ear sets the power of the cast in its SFB_PRE, and that is the result;
   // the SFB_DONE after it has the spell number as power
   i := cast_spell(SPL_BLESS, n1, n1, n1, "");
   s := b.extra.["$t033pre"].descr;
   if ((i != 75) or (not isaff(n1, ID_BLESS)) or (not ("$t033pre|cast|" in s)) or
       (not (("|" + itoa(SPL_BLESS) + "|experiment@test|experiment@test|experiment@test|75|") in s)))
   {
      logtest(tstno, LOGT_ERROR, "T033 cast_spell of bless gave " + itoa(i) + ", blessed " +
              itoa(isaff(n1, ID_BLESS)) + ": " + s);
      bad := 1;
   }
   s := b.extra.["$t033done"].descr;
   if (not (("|experiment@test|experiment@test|experiment@test|" + itoa(SPL_BLESS) + "|") in s))
   {
      logtest(tstno, LOGT_ERROR, "T033 the done event of the cast: " + s);
      bad := 1;
   }
   i := 7;
   i := cast_spell(SPL_BLESS, o, n1, n1, "");
   n := 7;
   n := cast_spell(SPL_GROUP_MAX - 1, n1, n1, n1, "");
   if ((i != 7) or (n != 0))
   {
      logtest(tstno, LOGT_ERROR, "T033 cast_spell by an object gave " + itoa(i) + ", of a spell group " + itoa(n));
      bad := 1;
   }

   // dilcall: a function named by a string; -1 for no such template
   s := "t033" + "fn@test";
   i := dilcall(s)(self, 4, "abc");
   n := dilcall(s)(n1, 2, "");
   f := dilcall("t033nosuch@test")(self, 1, "");
   if ((i != 1043) or (n != 20) or (f != -1))
   {
      logtest(tstno, LOGT_ERROR, "T033 dilcall gave " + itoa(i) + ", " + itoa(n) + ", " + itoa(f));
      bad := 1;
   }

   // dildestroy: the program gets SFB_DILDESTROY, then it is gone
   i := dildestroy("t033ear@test", b);
   n := dildestroy("t033ear@test", b);
   if ((i != TRUE) or (n != FALSE) or dilfind("t033ear@test", b) or (not ("$t033gone" in b.extra)))
   {
      logtest(tstno, LOGT_ERROR, "T033 dildestroy gave " + itoa(i) + " then " + itoa(n));
      bad := 1;
   }

   // The command list: chead() and command_head() are its start; getcmd() finds as typed.
   c := chead();
   c2 := command_head();
   if (c.name != c2.name)
   {
      logtest(tstno, LOGT_ERROR, "T033 chead and command_head differ");
      bad := 1;
   }
   // == and != on cmdptrs: they gave an error value, false even for c == null
   if ((not (c == c2)) or (c != c2) or (c == null) or (not (c != null)))
   {
      logtest(tstno, LOGT_ERROR, "T033 == or != on a cmdptr is wrong");
      bad := 1;
   }
   n := 0;
   f := 0;
   while (c)
   {
      if (c.name == "look")
         f := f + 1;
      n := n + 1;
      c := c.next;
   }
   if ((f != 1) or (n < 100))
   {
      logtest(tstno, LOGT_ERROR, "T033 chead's list: " + itoa(n) + " commands, look " + itoa(f));
      bad := 1;
   }
   c := getcmd("look");
   c2 := getcmd("n");
   s := c.name + " " + c2.name;
   c := getcmd("Look");
   c2 := getcmd("t033nosuch");
   f := 0;
   if (c)
      f := 1;
   if (c2)
      f := 1;
   if ((s != "look north") or (f != 0) or (not (c == null)) or (c2 != null))
   {
      logtest(tstno, LOGT_ERROR, "T033 getcmd found " + s);
      bad := 1;
   }

   // sact: the text one character would see
   s := sact("$1n gives $2n to $3n.", A_ALWAYS, n1, o, n2, TO_CHAR);
   if (strcmp(s, "An experiment gives a dead bug to a follower.") != 0)
   {
      logtest(tstno, LOGT_ERROR, "T033 sact gave " + s);
      bad := 1;
   }

   destroy(o);
   destroy(n1);
   destroy(n2);
   destroy(b);
   if (bad)
      goto terminate;

   logtest(tstno, LOGT_INFO, "T033 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:terminate:
   logtest(tstno, LOGT_INFO, "T033 failed");
   sendtoalldil("done", "labdirector@test");
   quit;
}
dilend

// ==================== T032 =====================

// Adds s to the text of the extra named k on u; makes the extra the first time
dilbegin t032add(u : unitptr, k : string, s : string);
var
   eh : extraptr;
   sl : stringlist;
code
{
   eh := k in u.extra;
   if (eh == null)
   {
      addstring(sl, k);
      addextra(u.extra, sl, s);
   }
   else
      eh.descr := eh.descr + s;
   return;
}
dilend

// unique: a second copy on the same unit isn't made
dilbegin unique t032uq();
external
   t032add(u : unitptr, k : string, s : string);
code
{
   t032add(self, "$t032uq", "x");
   wait(SFB_MSG, argument == "t032stop");
   quit;
}
dilend

dilbegin t032nu();
external
   t032add(u : unitptr, k : string, s : string);
code
{
   t032add(self, "$t032nu", "x");
   wait(SFB_MSG, argument == "t032stop");
   quit;
}
dilend

// fnpri: the lower number hears the message first, whatever the order of copying
dilbegin fnpri(FN_PRI_COMBAT) t032p1();
external
   t032add(u : unitptr, k : string, s : string);
code
{
   wait(SFB_MSG, argument == "t032pri");
   t032add(self, "$t032pri", "1");
   quit;
}
dilend

dilbegin t032p2();
external
   t032add(u : unitptr, k : string, s : string);
code
{
   wait(SFB_MSG, argument == "t032pri");
   t032add(self, "$t032pri", "2");
   quit;
}
dilend

// aware: only an aware program hears the commands of its own unit
dilbegin aware t032aw();
external
   t032add(u : unitptr, k : string, s : string);
code
{
   wait(SFB_CMD, (activator == self) and command("smile"));
   t032add(self, "$t032aw", "x");
   quit;
}
dilend

dilbegin t032na();
external
   t032add(u : unitptr, k : string, s : string);
code
{
   wait(SFB_CMD, (activator == self) and command("smile"));
   t032add(self, "$t032na", "x");
   quit;
}
dilend

// recall: a stored and restored program goes on at its wait; without recall it starts over,
// with its variables (n) as they were saved
dilbegin recall t032rc();
external
   t032add(u : unitptr, k : string, s : string);
var
   n : integer;
code
{
   n := n + 1;
   wait(SFB_MSG, argument == "t032n");
   t032add(self, "$t032rc", itoa(n));
   quit;
}
dilend

dilbegin t032nr();
external
   t032add(u : unitptr, k : string, s : string);
var
   n : integer;
code
{
   n := n + 1;
   wait(SFB_MSG, argument == "t032n");
   t032add(self, "$t032nr", itoa(n));
   quit;
}
dilend

// Files and template options: savestr, loadstr, delstr and strdir (the zone's strings
// directory, ../lib/test/strings), flog (the log directory, ../log), store/restore (the units
// directory), and shell's refusals (the program it runs is outside the game: a name with /, ;
// or .. runs nothing, which only vme.log shows, and still gives 0, the start of its thread).
// The dilbegin options unique, fnpri, aware and recall, and global variables: the key with its
// case is what is shared.
// A check of a call or a field is written not (x == y), not x != y: a failed value is false in
// every comparison, so x != y would let a call that fails pass.
dilbegin T032(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   s : string;
   notset : string;
   sl : stringlist;
   g1 : stringlist global t032g@test;
   g2 : stringlist global T032G@test;
   g3 : stringlist global t032g@test;
   i : integer;
   j : integer;
   k : integer;
   n : integer;
   b1 : unitptr;
   b2 : unitptr;
   npc : unitptr;
   r : unitptr;
   r2 : unitptr;
   rf : unitptr;
   u : unitptr;
   nobody : unitptr;
   eh : extraptr;
   bad : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T032 files and template options running");
   bad := 0;

   // savestr "w" writes the file anew, "a" adds to it; loadstr reads it back
   i := delstr("t032a.txt");
   i := delstr("t032b.txt");
   i := savestr("t032a.txt", "first and longer", "w");
   j := savestr("t032a.txt", "first", "w");
   k := savestr("t032a.txt", " second", "a");
   n := loadstr("t032a.txt", s);
   if ((i != FILE_SAVED) or (j != FILE_SAVED) or (k != FILE_SAVED) or (n != FILE_LOADED) or
       (not (strcmp(s, "first second") == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T032 savestr/loadstr gave " + itoa(i) + itoa(j) + itoa(k) + itoa(n) + " '" + s + "'");
      bad := 1;
   }
   // A mode other than a lower-case w or a is refused; an empty text fails
   i := savestr("t032a.txt", "x", "W");
   j := 7;
   j := savestr("t032a.txt", "", "w");
   k := loadstr("t032a.txt", s);
   if ((i != FILE_ILEGAL_OPP) or (j != 7) or (not (strcmp(s, "first second") == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T032 savestr with a bad mode or no text: " + itoa(i) + " " + itoa(j) + " '" + s + "'");
      bad := 1;
   }
   // loadstr: no such file, or a name with characters other than letters, digits, _ and .,
   // is FILE_NOT_FOUND, and the variable keeps its text
   s := "kept";
   i := loadstr("t032none.txt", s);
   j := loadstr("a/b", s);
   if ((i != FILE_NOT_FOUND) or (j != FILE_NOT_FOUND) or (s != "kept"))
   {
      logtest(tstno, LOGT_ERROR, "T032 loadstr of no file: " + itoa(i) + " " + itoa(j) + " '" + s + "'");
      bad := 1;
   }
   // savestr refuses the same names (it wrote "../t032x.txt" outside the strings directory)
   i := savestr("../t032x.txt", "x", "w");
   j := savestr("a/b", "x", "w");
   if ((i != FALSE) or (j != FALSE))
   {
      logtest(tstno, LOGT_ERROR, "T032 savestr of a name that isn't one: " + itoa(i) + " " + itoa(j));
      bad := 1;
   }

   // strdir: the names in the strings directory that match a whole regular expression
   i := savestr("t032b.txt", "b", "w");
   sl := strdir("t032.*");
   if ((not (length(sl) == 2)) or (not ("t032a.txt" in sl)) or (not ("t032b.txt" in sl)) or
       (not (length(strdir("t032a[.]txt")) == 1)) or (not (length(strdir("t032")) == 0)) or
       (not (length(strdir("")) >= 2)))
   {
      logtest(tstno, LOGT_ERROR, "T032 strdir found " + itoa(length(sl)) + " files");
      bad := 1;
   }

   // delstr: TRUE when it deleted the file, FALSE when there was none or the name is illegal
   i := delstr("t032a.txt");
   j := delstr("t032a.txt");
   k := delstr("a/b");
   n := delstr("t032b.txt");
   if ((i != TRUE) or (j != FALSE) or (k != FALSE) or (n != TRUE) or
       (not (loadstr("t032a.txt", s) == FILE_NOT_FOUND)) or
       (not (length(strdir("t032.*")) == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T032 delstr gave " + itoa(i) + itoa(j) + itoa(k) + itoa(n));
      bad := 1;
   }

   // flog: FILE_SAVED; a bad mode or a name with .. is FILE_ILEGAL_OPP, no text FILE_NOT_SAVED
   i := flog("t032.log", "T032 first<br/>", "w");
   j := flog("t032.log", "T032 second<br/>", "a");
   k := flog("t032.log", "x", "W");
   n := flog("../t032.log", "x", "a");
   if ((i != FILE_SAVED) or (j != FILE_SAVED) or (k != FILE_ILEGAL_OPP) or (n != FILE_ILEGAL_OPP) or
       (not (flog("t032.log", "", "a") == FILE_NOT_SAVED)) or (not (flog(notset, "x", "a") == FILE_ILEGAL_OPP)))
   {
      logtest(tstno, LOGT_ERROR, "T032 flog gave " + itoa(i) + " " + itoa(j) + " " + itoa(k) + " " + itoa(n));
      bad := 1;
   }

   // shell: only refusals (see above); a failed argument fails
   i := shell("t032/none");
   j := shell("t032;none");
   k := shell("..t032");
   n := 7;
   n := shell(nobody.name);
   if ((i != 0) or (j != 0) or (k != 0) or (n != 7))
   {
      logtest(tstno, LOGT_ERROR, "T032 shell refusals gave " + itoa(i) + " " + itoa(j) + " " + itoa(k) + " " + itoa(n));
      bad := 1;
   }

   // global: every variable with the same key (case and all) is the same list
   g1 := null;
   g2 := null;
   addstring(g1, "t032");
   if ((not (length(g3) == 1)) or (not (g3.[0] == "t032")) or (not (length(g2) == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T032 global lists: " + itoa(length(g3)) + " and " + itoa(length(g2)));
      bad := 1;
   }
   g1 := null;

   // unique, fnpri and recall on a box; aware on an NPC
   b1 := load("pbox@test");
   b2 := load("pbox@test");
   npc := load("experiment@test");
   secure(b1, lost);
   secure(b2, lost);
   secure(npc, lost);
   link(load("deadbug@test"), b1);
   dilcopy("t032uq@test", b1);
   dilcopy("t032uq@test", b1);
   dilcopy("t032nu@test", b1);
   dilcopy("t032nu@test", b1);
   dilcopy("t032p2@test", b1);
   dilcopy("t032p1@test", b1);
   dilcopy("t032rc@test", b1);
   dilcopy("t032nr@test", b1);
   dilcopy("t032aw@test", npc);
   dilcopy("t032na@test", npc);
   // A dilcopy()'d program first runs PULSE_SEC later; until then it hears nothing. Two fixed
   // ticks (2 * PULSE_SEC), not two pauses: a pause is random (half to one and a half
   // heartbeats), so two of them could end at PULSE_SEC, together with the programs' start,
   // and the smile came before the aware program listened (the test failed now and then).
   wait(SFB_TICK, TRUE);
   wait(SFB_TICK, TRUE);
   exec("smile", npc);
   sendto("t032pri", b1);
   pause;
   eh := "$t032uq" in b1.extra;
   if (eh == null)
   {
      logtest(tstno, LOGT_ERROR, "T032 the unique program never ran");
      bad := 1;
   }
   else if (not (eh.descr == "x"))
   {
      logtest(tstno, LOGT_ERROR, "T032 unique: '" + eh.descr + "'");
      bad := 1;
   }
   eh := "$t032nu" in b1.extra;
   if (eh == null)
   {
      logtest(tstno, LOGT_ERROR, "T032 the program without unique never ran");
      bad := 1;
   }
   else if (not (eh.descr == "xx"))
   {
      logtest(tstno, LOGT_ERROR, "T032 without unique: '" + eh.descr + "'");
      bad := 1;
   }
   eh := "$t032pri" in b1.extra;
   if (eh == null)
   {
      logtest(tstno, LOGT_ERROR, "T032 the fnpri programs never heard the message");
      bad := 1;
   }
   else if (not (eh.descr == "12"))
   {
      logtest(tstno, LOGT_ERROR, "T032 fnpri order: '" + eh.descr + "'");
      bad := 1;
   }
   if ((not (("$t032aw" in npc.extra) != null)) or (not (("$t032na" in npc.extra) == null)))
   {
      logtest(tstno, LOGT_ERROR, "T032 aware: the aware program heard " + itoa(("$t032aw" in npc.extra) != null) +
              ", the other " + itoa(("$t032na" in npc.extra) != null));
      bad := 1;
   }

   // store with the container, then restore: the box comes back with its contents and programs,
   // into the unit given (or the program's own unit for null), as often as it is restored
   i := delunit("t032box");
   store(b1, "t032box", TRUE);
   r := restore("t032box", b2);
   r2 := restore("t032box", null);
   if ((r == null) or (r2 == null))
   {
      logtest(tstno, LOGT_ERROR, "T032 restore of a stored box gave null");
      bad := 1;
      goto terminate;
   }
   if ((not (r.nameidx == "pbox")) or (not (r.outside == b2)) or (not (r2.outside == self)) or
       (not (r.inside != null)) or
       (not (r.inside.nameidx == "deadbug")))
   {
      logtest(tstno, LOGT_ERROR, "T032 restore put the box in the wrong place or without its contents");
      bad := 1;
   }
   link(r, self); // out of the box, where secure can keep it
   secure(r, lost);
   secure(r2, lost);
   // without the container: the first of the contents
   i := delunit("t032cnt");
   store(b1, "t032cnt", FALSE);
   u := restore("t032cnt", b2);
   if (u == null)
   {
      logtest(tstno, LOGT_ERROR, "T032 restore of stored contents gave null");
      bad := 1;
   }
   else if ((not (u.nameidx == "deadbug")) or (not (u.outside == b2)))
   {
      logtest(tstno, LOGT_ERROR, "T032 restore of stored contents gave " + u.nameidx);
      bad := 1;
   }
   // no such file, or a name that isn't one
   if ((not (restore("t032none", b2) == null)) or (not (restore("..", b2) == null)) or
       (not (restore("a/b", b2) == null)))
   {
      logtest(tstno, LOGT_ERROR, "T032 restore of no file isn't null");
      bad := 1;
   }
   // a failed name fails (it stopped the program with a type error)
   rf := b2;
   rf := restore(nobody.name, b2);
   if (not (rf == b2))
   {
      logtest(tstno, LOGT_ERROR, "T032 restore of a failed name changed the variable");
      bad := 1;
   }
   i := delunit("t032box");
   i := delunit("t032cnt");

   // recall: on the restored box the recall program is still at its wait (n is 1); the other
   // started over and counted again (2). On the first box both say 1. A restored program that
   // waits for no tick only runs at the first event that reaches it, and that event wakes it
   // without being seen by its wait: so the message goes twice.
   pause;
   sendto("t032n", r);
   sendto("t032n", r);
   sendto("t032n", b1);
   pause;
   eh := "$t032rc" in r.extra;
   if (eh == null)
   {
      logtest(tstno, LOGT_ERROR, "T032 the restored recall program didn't answer");
      bad := 1;
   }
   else if (not (eh.descr == "1"))
   {
      logtest(tstno, LOGT_ERROR, "T032 recall: the restored program counted " + eh.descr);
      bad := 1;
   }
   eh := "$t032nr" in r.extra;
   if (eh == null)
   {
      logtest(tstno, LOGT_ERROR, "T032 the restored program without recall didn't answer");
      bad := 1;
   }
   else if (not (eh.descr == "2"))
   {
      logtest(tstno, LOGT_ERROR, "T032 without recall: the restored program counted " + eh.descr);
      bad := 1;
   }
   s := "";
   eh := "$t032rc" in b1.extra;
   if (eh != null)
      s := eh.descr;
   eh := "$t032nr" in b1.extra;
   if (eh != null)
      s := s + eh.descr;
   if (s != "11")
   {
      logtest(tstno, LOGT_ERROR, "T032 the programs on the first box didn't answer 1");
      bad := 1;
   }

   unsecure(b1);
   unsecure(b2);
   unsecure(npc);
   unsecure(r);
   unsecure(r2);
   destroy(r2);
   destroy(b1);
   destroy(b2);
   destroy(npc);
   if (bad)
      goto terminate;

   logtest(tstno, LOGT_INFO, "T032 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:lost:
   logtest(tstno, LOGT_ERROR, "T032 lost a test unit");

:terminate:
   unsecure(b1);
   unsecure(b2);
   unsecure(npc);
   unsecure(r);
   unsecure(r2);
   destroy(r2);
   destroy(b1);
   destroy(b2);
   destroy(npc);
   i := delunit("t032box");
   i := delunit("t032cnt");
   logtest(tstno, LOGT_INFO, "T032 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T031 =====================

// Records what argument held at a tick and at a message, and what getword() left of it
dilbegin t031arg();
var
   w : string;
   s : string;
   sl : stringlist;
code
{
   heartbeat := PULSE_SEC * 1;
   wait(SFB_TICK, TRUE);
   s := "[" + argument + "]";
   wait(SFB_MSG, "t031msg" in argument);
   w := getword(argument);
   addstring(sl, "$t031arg");
   addextra(self.extra, sl, s + w + "|" + argument);
   quit;
}
dilend

// Records the messages it gets, but an interrupt with skip makes it ignore "t031ignored"
dilbegin t031skp();
var
   i : integer;
   eh : extraptr;
   sl : stringlist;
code
{
   heartbeat := PULSE_SEC * 1;
   i := interrupt(SFB_MSG, argument == "t031ignored", skip);
   addstring(sl, "$t031skp");
   addextra(self.extra, sl, "got");
:waitmsg:
   wait(SFB_MSG, TRUE);
   eh := "$t031skp" in self.extra;
   eh.descr := eh.descr + " " + argument;
   goto waitmsg;
}
dilend

// Numbers, logic and lookups: and, or, not, isset, rnd, openroll, getinteger, realtime and the
// mud clock (mudhour, mudday, mudmonth, mudyear), moneystring, skill_name, weapon_name,
// weapon_info, spellindex, spellinfo, load, argument, skip (in on ... goto and as the label of
// an interrupt), getcolor; the integer, intlist, unitptr,
// extraptr, zoneptr and cmdptr types and null. and/or give 0 or 1, work on any type and always
// work out both sides; the checks of how tightly they bind are only those that PR #596 (and/or
// looser than the comparisons) leaves as they are. The colour functions and check_password()
// need a player: on an NPC they fail.
// A check of a call or a field is written not (x == y), not x != y: a failed value is false in
// every comparison, so x != y would let a call that fails pass.
dilbegin T031(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   a : integer;
   b : integer;
   z : integer;
   i : integer;
   j : integer;
   k : integer;
   n : integer;
   h : integer;
   e : integer;
   r1 : integer;
   r2 : integer;
   r3 : integer;
   r4 : integer;
   r5 : integer;
   r6 : integer;
   r7 : integer;
   s : string;
   s2 : string;
   notset : string;
   sl : stringlist;
   il : intlist;
   il2 : intlist;
   u : unitptr;
   npc : unitptr;
   box : unitptr;
   nobody : unitptr;
   eh : extraptr;
   c : cmdptr;
   c2 : cmdptr;
   zp : zoneptr;
   bad : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T031 numbers, logic and lookups running");
   bad := 0;

   // and/or are logical (0 or 1), unlike & and |; a failed side is false; any type counts
   a := 2;
   b := 4;
   z := 0;
   if ((not ((a and b) == 1)) or (not ((a & b) == 0)) or (not ((a or z) == 1)) or (not ((z or z) == 0)) or
       (not ((a | b) == 6)) or
       (not ((not a) == 0)) or (not ((not z) == 1)))
   {
      logtest(tstno, LOGT_ERROR, "T031 and/or/not on integers");
      bad := 1;
   }
   if ((not ((nobody.level and 1) == 0)) or (not ((nobody.level or 1) == 1)) or (not ((not nobody.level) == 1)))
   {
      logtest(tstno, LOGT_ERROR, "T031 and/or/not with a failed side");
      bad := 1;
   }
   s := "x";
   if ((not ((self and s) == 1)) or (not ((nobody or notset) == 0)) or (not ((not nobody) == 1)) or
       (not ((not self) == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T031 and/or/not on units and strings");
      bad := 1;
   }
   // Both sides are always worked out: getword() on the right takes its word
   s := "one two";
   i := z and (getword(s) == "one");
   j := a or (getword(s) == "two");
   if ((i != 0) or (j != 1) or (s != ""))
   {
      logtest(tstno, LOGT_ERROR, "T031 and/or skipped their right side, leaving '" + s + "'");
      bad := 1;
   }
   // and binds tighter than or; not tighter than and, or and the comparisons. That holds with
   // and/or above the comparisons (now) or below them (PR #596); how and/or bind against the
   // comparisons is left out.
   a := 1;
   i := a or z and z;   // a or (z and z)
   j := z and a or a;   // (z and a) or a
   k := not z and z;    // (not z) and z
   n := not a or a;     // (not a) or a
   h := not z == 5;     // (not z) == 5
   if ((i != 1) or (j != 1) or (k != 0) or (n != 1) or (h != 0))
   {
      logtest(tstno, LOGT_ERROR, "T031 and/or/not bind wrongly: " + itoa(i) + itoa(j) + itoa(k) + itoa(n) + itoa(h));
      bad := 1;
   }

   // isset: any of the bits
   i := 5;
   i := isset(nobody.level, 1);
   if ((not (isset(6, 2) == 1)) or (not (isset(6, 1) == 0)) or (not (isset(6, 9) == 0)) or
       (not (isset(6, 1 | 4) == 1)) or (i != 5))
   {
      logtest(tstno, LOGT_ERROR, "T031 isset");
      bad := 1;
   }

   // integer: 32 bits that wrap, division cut towards 0, a division by 0 fails, hexadecimal
   a := 2147483647;
   b := 1;
   z := 0;
   i := 11;
   i := 5 / z;
   j := 12;
   j := 5 % z;
   if ((not (a + b == -2147483647 - 1)) or (not ((-7) / 2 == -3)) or (not ((-7) % 3 == -1)) or
       (not (7 % (-3) == 1)) or (not (0x2A == 42)) or
       (i != 11) or (j != 12))
   {
      logtest(tstno, LOGT_ERROR, "T031 integer arithmetic");
      bad := 1;
   }

   // rnd: both ends included, the ends may come in either order
   il := {0, 0, 0};
   i := 0;
   while (i < 300)
   {
      j := rnd(1, 3);
      if ((j < 1) or (j > 3))
         break;
      il.[j - 1] := il.[j - 1] + 1;
      j := rnd(10, 1);
      if ((j < 1) or (j > 10))
         break;
      i := i + 1;
   }
   k := 7;
   k := rnd(nobody.level, 5);
   if ((i != 300) or (not (il.[0] != 0)) or (not (il.[1] != 0)) or (not (il.[2] != 0)) or
       (not (rnd(5, 5) == 5)) or (k != 7))
   {
      logtest(tstno, LOGT_ERROR, "T031 rnd out of range or a value never came");
      bad := 1;
   }

   // openroll(10, 3): 1 to 10; 8 to 10 roll again and add, 1 and 2 roll again and subtract, so 2
   // and 8 never come out. It is 0 unless end < dice / 2 - 1.
   il := {0, 0, 0, 0};
   i := 0;
   while (i < 300)
   {
      j := openroll(10, 3);
      if ((j == 2) or (j == 8))
         break;
      if (j <= 1)
         il.[0] := il.[0] + 1;
      else if (j <= 7)
         il.[1] := il.[1] + 1;
      else
         il.[2] := il.[2] + 1;
      i := i + 1;
   }
   if ((i != 300) or (not (il.[0] != 0)) or (not (il.[1] != 0)) or (not (il.[2] != 0)) or
       (not (openroll(20, 10) == 0)) or
       (not (openroll(0, 0) == 0)) or (not (openroll(10, 4) == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T031 openroll: " + itoa(j) + " after " + itoa(i) + " rolls; low " + itoa(il.[0]) +
              ", plain " + itoa(il.[1]) + ", high " + itoa(il.[2]));
      bad := 1;
   }

   // getinteger: the experience table (300 * level + 200 * level * level), other numbers, and
   // an unknown index fails (logged)
   if ((not (getinteger(DIL_GINT_REQXP, null, 0) == 0)) or (not (getinteger(DIL_GINT_REQXP, null, 1) == 500)) or
       (not (getinteger(DIL_GINT_REQXP, null, 2) == 1400)) or (not (getinteger(DIL_GINT_LEVELXP, null, 1) == 900)))
   {
      logtest(tstno, LOGT_ERROR, "T031 getinteger experience table");
      bad := 1;
   }
   npc := load("experiment@test");
   box := load("pbox@test");
   i := getinteger(DIL_GINT_CRIMENO, null, 0);
   j := getinteger(DIL_GINT_CRIMENO, null, 0);
   if ((j <= i) or (not (getinteger(DIL_GINT_DESCRIPTOR, null, 0) == 1)) or
       (not (getinteger(DIL_GINT_DESCRIPTOR, npc, 0) == 1)) or
       (not (getinteger(DIL_GINT_HITREG, null, 0) == 0)) or (not (getinteger(DIL_GINT_HITREG, box, 0) == 0)) or
       (not (getinteger(DIL_GINT_HITREG, npc, 0) > 0)) or (not (getinteger(DIL_GINT_MOVEREG, npc, 0) > 0)) or
       (not (getinteger(DIL_GINT_MANAREG, npc, 0) >= 0)) or (not (getinteger(DIL_GINT_EFFDEX, npc, 0) >= 0)) or
       (not (getinteger(DIL_GINT_BONUS_A, null, 0) == 0)) or (not (getinteger(DIL_GINT_BONUS_B, null, 0) == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T031 getinteger crime number, descriptor, regeneration or bonus");
      bad := 1;
   }
   i := getinteger(DIL_GINT_REALMONTH, null, 0);
   j := getinteger(DIL_GINT_REALDAY, null, 0);
   k := getinteger(DIL_GINT_PRESSURE, null, 0);
   if ((not (getinteger(DIL_GINT_REALYEAR, null, 0) >= 2026)) or (i < 1) or (i > 12) or (j < 1) or (j > 31) or
       (k < 900) or (k > 1100))
   {
      logtest(tstno, LOGT_ERROR, "T031 getinteger real date or pressure: month " + itoa(i) + ", day " + itoa(j) +
              ", pressure " + itoa(k));
      bad := 1;
   }
   i := 5;
   i := getinteger(99, null, 0);
   if (i != 5)
   {
      logtest(tstno, LOGT_ERROR, "T031 getinteger(99) gave " + itoa(i));
      bad := 1;
   }

   // realtime is the real clock; the mud clock counts mud hours (300 seconds) since 11 Aug 1990
   // 01:05:15 (650336715), 24 to a day, 14 days to a month, 9 months to a year. With vme -w the
   // game clock runs ahead of the real one, so the mud time may be later, but not by a mud month.
   if ((mudhour < 0) or (mudhour > 23) or (mudday < 0) or (mudday > 13) or (mudmonth < 0) or (mudmonth > 8) or
       (mudyear < 1261) or (realtime < 1767225600))
   {
      logtest(tstno, LOGT_ERROR, "T031 mud clock out of range: " + itoa(mudhour) + " " + itoa(mudday) + " " +
              itoa(mudmonth) + " " + itoa(mudyear));
      bad := 1;
   }
   h := ((mudyear * 9 + mudmonth) * 14 + mudday) * 24 + mudhour;
   e := (realtime - 650336715) / 300;
   if ((not (h - e >= -2)) or (not (h - e <= 14 * 24)))
   {
      logtest(tstno, LOGT_ERROR, "T031 mud clock " + itoa(h) + " hours, the real clock " + itoa(e));
      bad := 1;
   }

   // moneystring: the fewest coins of the default currency; under one iron piece is one
   if ((not (moneystring(1230, TRUE) == "a silver piece, 7 copper pieces and 3 iron pieces")) or
       (not (moneystring(1230, FALSE) == "1 sp, 7 cp and 3 ip")) or (not (moneystring(0, FALSE) == "1 ip")) or
       (not (moneystring(-50, TRUE) == "an iron piece")))
   {
      logtest(tstno, LOGT_ERROR, "T031 moneystring gave '" + moneystring(1230, TRUE) + "'");
      bad := 1;
   }

   // skill_name: "" outside 0..299; weapon_name: null outside 0..199
   s := "kept";
   s := weapon_name(200);
   if ((not (skill_name(SKI_PICK_POCKETS) == "pick pockets")) or (not (skill_name(-1) == "")) or
       (not (skill_name(300) == "")) or
       (not (weapon_name(WPN_DAGGER) == "dagger")) or (not (weapon_name(200) == null)) or
       (not (weapon_name(-1) == null)) or
       (s != ""))
   {
      logtest(tstno, LOGT_ERROR, "T031 skill_name or weapon_name");
      bad := 1;
   }

   // weapon_info: hands, speed, kind of damage, shield, group, then offset, damage and alpha for
   // each armour type (weapons.def: a dagger is one-handed, pierces, a sword, 40 against clothes
   // and 100 against plate)
   il := weapon_info(WPN_DAGGER);
   if ((not (length(il) == 20)) or (not (il.[0] == 1)) or (not (il.[2] == 2)) or
       (not (il.[3] == SHIELD_M_BLOCK)) or (not (il.[4] == WPN_SWORD)) or
       (not (il.[5] == 40)) or (not (il.[5 + 3 * ARM_PLATE] == 100)))
   {
      logtest(tstno, LOGT_ERROR, "T031 weapon_info(WPN_DAGGER)");
      bad := 1;
   }
   il := weapon_info(200);
   il2 := weapon_info(-1);
   if ((not (length(il) == 0)) or (not (length(il2) == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T031 weapon_info out of range isn't empty");
      bad := 1;
   }

   // spellindex: every word may be abbreviated; the name matching the most words wins, the
   // lowest number on a tie (the spheres come first)
   if ((not (spellindex("cu li wo") == SPL_CURE_WOUNDS_1)) or
       (not (spellindex("  CURE LIGHT") == SPL_CURE_WOUNDS_1)) or
       (not (spellindex("cure light wounds now") == SPL_CURE_WOUNDS_1)) or
       (not (spellindex("fire") == SPL_HEAT)) or
       (not (spellindex("burn") == SPL_FIREBALL_1)) or (not (spellindex("") == -1)) or
       (not (spellindex("xyzzy") == -1)))
   {
      logtest(tstno, LOGT_ERROR, "T031 spellindex");
      bad := 1;
   }
   i := 3;
   i := spellindex(notset);
   if (i != 3)
   {
      logtest(tstno, LOGT_ERROR, "T031 spellindex of an unset string gave " + itoa(i));
      bad := 1;
   }

   // spellinfo: the name, and seven variables set from spells.def. Burn: magic, fire sphere,
   // 10 mana, an attack, SPLCST_IGNORE (3, spelldef.h), cast as a spell (MEDIA_SPELL 1) but not
   // a potion (2), aimed at a character in the room (FIND_UNIT_SURRO 4, TAR_CHAR 64)
   s := spellinfo(SPL_FIREBALL_1, r1, r2, r3, r4, r5, r6, r7);
   if ((s != "burn") or (r1 != ABIL_MAG) or (r2 != SPL_HEAT) or (r3 != 10) or (r4 == 0) or (r5 != 3) or
       (not isset(r6, 1)) or isset(r6, 2) or (not isset(r7, FIND_UNIT_SURRO)) or (not isset(r7, 64)))
   {
      logtest(tstno, LOGT_ERROR, "T031 spellinfo(SPL_FIREBALL_1) gave " + s + " " + itoa(r1) + " " + itoa(r2) + " " +
              itoa(r3) + " " + itoa(r4) + " " + itoa(r5) + " " + itoa(r6) + " " + itoa(r7));
      bad := 1;
   }
   s := spellinfo(r2, r1, r1, r1, r1, r1, r1, r1); // a sphere is a spell number too
   r1 := 77;
   s2 := spellinfo(500, r1, r1, r1, r1, r1, r1, r1); // out of range: fails, the variables stay
   if ((s != "fire sphere") or (r1 != 77) or (s2 != ""))
   {
      logtest(tstno, LOGT_ERROR, "T031 spellinfo of a sphere or out of range");
      bad := 1;
   }
   // A failed argument makes them fail, as it does the other functions (they stopped the
   // program with a type error): a string variable is emptied, an integer keeps its value
   s := "kept";
   s := spellinfo(nobody.level, r1, r1, r1, r1, r1, r1, r1);
   s2 := "kept";
   s2 := moneystring(nobody.level, TRUE);
   i := 7;
   i := openroll(nobody.level, 5);
   j := 7;
   j := openroll(100, nobody.level);
   il := weapon_info(nobody.level);
   if ((s != "") or (s2 != "") or (r1 != 77) or (i != 7) or (j != 7))
   {
      logtest(tstno, LOGT_ERROR, "T031 spellinfo, moneystring or openroll of a failed value");
      bad := 1;
   }
   i := 7;
   i := can_carry(npc, box, nobody.level);
   j := 7;
   j := meleeattack(npc, npc, nobody.level, WPN_FIST, TRUE);
   k := 7;
   k := attack_spell(SPL_FIREBALL_1, nobody.outside, npc, npc, 0, "");
   u := box;
   u := getopponent(npc, nobody.level);
   s := "kept";
   s := fits(npc, box, nobody.level);
   if ((i != 7) or (j != 7) or (k != 7) or (u != box) or (s != ""))
   {
      logtest(tstno, LOGT_ERROR, "T031 can_carry, meleeattack, attack_spell, getopponent or fits of a failed value");
      bad := 1;
   }
   u := box;
   u := getfollower(npc, nobody.level);
   if (u != box)
   {
      logtest(tstno, LOGT_ERROR, "T031 getfollower of a failed value");
      bad := 1;
   }
   // A null caster fails like a null medium or target (it stopped the program); == with a
   // failed right side fails as != does and as a failed left side does (it compared as null)
   k := 7;
   k := attack_spell(SPL_FIREBALL_1, nobody, npc, npc, 0, "");
   u := null;
   i := 7;
   i := (u == nobody.outside);
   j := 7;
   j := (nobody.outside == u);
   if ((k != 7) or (i != 7) or (j != 7))
   {
      logtest(tstno, LOGT_ERROR, "T031 attack_spell with a null caster, or == with a failed side");
      bad := 1;
   }

   // load: a new unit inside the program's own unit; null for no such unit and for a room
   if ((npc == null) or (not (npc.outside == self)) or (not (npc.nameidx == "experiment")) or
       (not (box.zoneidx == "test")))
   {
      logtest(tstno, LOGT_ERROR, "T031 load didn't put the unit in the program's unit");
      bad := 1;
   }
   u := load("nosuch@test");
   if (u != null)
   {
      logtest(tstno, LOGT_ERROR, "T031 load of no such unit isn't null");
      bad := 1;
   }
   u := load("testlabe@test");
   if (u != null)
   {
      logtest(tstno, LOGT_ERROR, "T031 load of a room isn't null");
      bad := 1;
   }

   // getcolor is only the tag. The colour functions and check_password need a player: on an
   // NPC they fail (zone log) and the variable keeps its value.
   i := 7;
   i := addcolor(npc, "t031", "cw bn");
   j := 7;
   j := changecolor(npc, "t031", "cw bn");
   k := 7;
   k := delcolor(npc, "t031");
   n := 7;
   n := check_password(npc, "x");
   if ((not (strcmp(getcolor("clan"), "<div class='clan'>") == 0)) or (i != 7) or (j != 7) or (k != 7) or (n != 7))
   {
      logtest(tstno, LOGT_ERROR, "T031 colour functions or check_password on an NPC: " + itoa(i) + itoa(j) + itoa(k) + itoa(n));
      bad := 1;
   }

   // intlist: copied on assignment, out of range read fails and write does nothing, null empties
   il := {1, 2};
   il2 := il;
   il2.[0] := 9;
   i := 5;
   i := il.[5];
   il.[5] := 9;
   if ((not (il.[0] == 1)) or (not (il2.[0] == 9)) or (not (length(il) == 2)) or (i != 5))
   {
      logtest(tstno, LOGT_ERROR, "T031 intlist copy or bounds");
      bad := 1;
   }
   il2 := null;
   if ((not (length(il2) == 0)) or (not (il2 == null)) or (il == null))
   {
      logtest(tstno, LOGT_ERROR, "T031 intlist and null");
      bad := 1;
   }

   // on ... goto: skip, and a value past the list, go on after the on
   s := "";
   i := 0;
:onloop:
   on i goto onzero, skip, ontwo;
   s := s + "f" + itoa(i);
   goto onnext;
:onzero:
   s := s + "a";
   goto onnext;
:ontwo:
   s := s + "c";
:onnext:
   i := i + 1;
   if (i < 4)
      goto onloop;
   if (not (strcmp(s, "af1cf3") == 0))
   {
      logtest(tstno, LOGT_ERROR, "T031 on ... goto with skip went '" + s + "'");
      bad := 1;
   }

   // cmdptr and zoneptr: start null, keep their value through a wait; a unitptr not secured and
   // an extraptr are null after it; integers, strings and lists keep theirs.
   if ((c != null) or (zp != null) or (eh != null))
   {
      logtest(tstno, LOGT_ERROR, "T031 a pointer variable didn't start null");
      bad := 1;
   }
   c := getcmd("smile");
   c2 := c;
   zp := findzone("test");
   u := self; // not secured
   addextra(box.extra, {"$t031"}, "x");
   eh := "$t031" in box.extra;
   if ((c == null) or (c2 != c) or (not (c.name == "smile")) or (zp == null) or
       (not (zp.name == "test")) or (u != self) or
       (eh == null))
   {
      logtest(tstno, LOGT_ERROR, "T031 cmdptr, zoneptr, unitptr or extraptr not set");
      bad := 1;
   }
   secure(npc, lost);
   secure(box, lost);
   dilcopy("t031arg@test", box);
   dilcopy("t031skp@test", box);
   i := 42;
   s := "kept";
   sl := {"kept"};
   il := {42};
   pause;
   if ((not (c.name == "smile")) or (not (zp.name == "test")) or (u != null) or (eh != null) or
       (npc == null) or (i != 42) or
       (s != "kept") or (not (sl.[0] == "kept")) or (not (il.[0] == 42)))
   {
      logtest(tstno, LOGT_ERROR, "T031 what variables kept through a wait");
      bad := 1;
   }
   c := null;
   if (c or (c != null) or (not (c == null)))
   {
      logtest(tstno, LOGT_ERROR, "T031 a cmdptr set to null isn't null");
      bad := 1;
   }

   // argument: "" at a tick, the message at SFB_MSG; getword() takes its first word off it.
   // t031arg listens from 2 * PULSE_SEC after its dilcopy() (its first run, then a tick). Fixed
   // ticks, not pauses: three random pauses could add up to 1.5 * PULSE_SEC, and the message
   // came before it listened (the test failed now and then).
   wait(SFB_TICK, TRUE);
   wait(SFB_TICK, TRUE);
   sendto("t031msg hello  world", box);
   pause;
   eh := "$t031arg" in box.extra;
   if (eh == null)
   {
      logtest(tstno, LOGT_ERROR, "T031 the argument program didn't report");
      bad := 1;
   }
   else if (not (strcmp(eh.descr, "[]t031msg|hello  world") == 0))
   {
      logtest(tstno, LOGT_ERROR, "T031 argument: '" + eh.descr + "'");
      bad := 1;
   }

   // interrupt(..., skip): while its condition holds, the event passes the program by
   sendto("t031ignored", box);
   sendto("t031seen", box);
   pause;
   eh := "$t031skp" in box.extra;
   if (eh == null)
   {
      logtest(tstno, LOGT_ERROR, "T031 the skip program never ran");
      bad := 1;
   }
   else if (not (strcmp(eh.descr, "got t031msg hello  world t031seen") == 0))
   {
      logtest(tstno, LOGT_ERROR, "T031 interrupt with skip: '" + eh.descr + "'");
      bad := 1;
   }

   unsecure(npc);
   unsecure(box);
   destroy(npc);
   destroy(box);
   if (bad)
      goto terminate;

   logtest(tstno, LOGT_INFO, "T031 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:lost:
   logtest(tstno, LOGT_ERROR, "T031 lost a test unit");

:terminate:
   unsecure(npc);
   unsecure(box);
   destroy(npc);
   destroy(box);
   logtest(tstno, LOGT_INFO, "T031 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T030 =====================

// Strings: left, right, mid, length, replace, tolower, toupper, itoa, atoi, strcmp, strncmp,
// textformat, asctime, getword, getwords, split, and the three forms of in (in a string, in a
// stringlist, in a list of extras); the string and stringlist types and null with them. ==, !=,
// <, >, <= and >= on strings ignore case; strcmp() and strncmp() don't. A call that fails empties
// the string variable it is assigned to; an integer variable keeps its value.
// A check of a call or a field is written not (x == y), not x != y: a failed value is false in
// every comparison, so x != y would let a call that fails pass.
dilbegin T030(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   s : string;
   s2 : string;
   w : string;
   notset : string;
   sl : stringlist;
   sl2 : stringlist;
   o : unitptr;
   nobody : unitptr;
   eh : extraptr;
   i : integer;
   t : integer;
   bad : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T030 strings running");
   bad := 0;

   // left, right and mid cut; mid's third argument is a position, counted from 1
   if ((not (left("shorten me", 5) == "short")) or (not (left("abc", 10) == "abc")) or
       (not (left("abc", 0) == "")) or
       (not (left("abc", -2) == "")))
   {
      logtest(tstno, LOGT_ERROR, "T030 left");
      bad := 1;
   }
   if ((not (right("This is Easy", 4) == "Easy")) or (not (right("abc", 10) == "abc")) or
       (not (right("abc", 0) == "")))
   {
      logtest(tstno, LOGT_ERROR, "T030 right");
      bad := 1;
   }
   if ((not (mid("sprocket", 3, 6) == "rock")) or (not (mid("abc", 0, 2) == "ab")) or
       (not (mid("abc", 2, 99) == "bc")) or
       (not (mid("abc", 5, 9) == "")))
   {
      logtest(tstno, LOGT_ERROR, "T030 mid");
      bad := 1;
   }
   s := "kept";
   s := mid("abcdef", 3, 2); // last before first: fails (zone log), and the variable is emptied
   if (s != "")
   {
      logtest(tstno, LOGT_ERROR, "T030 mid(s, 3, 2) gave '" + s + "'");
      bad := 1;
   }

   // length in bytes: an escape is one; a string never set is 0; a list's entries
   sl := {"a", "b", "c"};
   if ((not (length("abc") == 3)) or (not (length("") == 0)) or (not (length(notset) == 0)) or
       (not (length("a\nb") == 3)) or
       (not (length(sl) == 3)))
   {
      logtest(tstno, LOGT_ERROR, "T030 length");
      bad := 1;
   }

   // replace(old, new, s) replaces every old, minds case, and doesn't search what it put in
   if ((not (strcmp(replace("a", "aa", "banana"), "baanaanaa") == 0)) or
       (not (strcmp(replace("", "x", "abc"), "abc") == 0)) or
       (not (strcmp(replace("A", "x", "banana"), "banana") == 0)) or
       (not (strcmp(replace("an", "", "banana"), "ba") == 0)) or
       (not (replace("x", "y", notset) == "")))
   {
      logtest(tstno, LOGT_ERROR, "T030 replace");
      bad := 1;
   }

   // tolower, toupper: only A-Z and a-z change; compared with strcmp, since == ignores case
   if ((not (strcmp(tolower("HeLLo 1!"), "hello 1!") == 0)) or
       (not (strcmp(toupper("HeLLo 1!"), "HELLO 1!") == 0)) or
       (not (tolower("") == "")) or (not (toupper(notset) == "")))
   {
      logtest(tstno, LOGT_ERROR, "T030 tolower/toupper");
      bad := 1;
   }

   // itoa and atoi; atoi reads the number at the start, C style
   if ((not (itoa(-7) == "-7")) or (not (itoa(0) == "0")) or (not (atoi("12 apples") == 12)) or
       (not (atoi("  -5x") == -5)) or
       (not (atoi("abc") == 0)) or (not (atoi("+3") == 3)) or (not (atoi("") == 0)) or
       (not (atoi(itoa(2147483647)) == 2147483647)))
   {
      logtest(tstno, LOGT_ERROR, "T030 itoa/atoi");
      bad := 1;
   }
   i := 9;
   i := atoi(notset); // a string never set: fails, i keeps its value
   s := "kept";
   s := itoa(nobody.level); // a failed argument: fails, the string is emptied
   if ((i != 9) or (s != ""))
   {
      logtest(tstno, LOGT_ERROR, "T030 atoi of an unset string gave " + itoa(i) + ", itoa of a failed value '" + s + "'");
      bad := 1;
   }

   // Comparing strings: the operators ignore case, all six; strcmp and strncmp don't
   if ((not ("Sword" == "sword")) or (not (("Sword" != "sword") == 0)) or (not ("B" > "a")) or (not ("a" < "B")) or
       (not (("b" < "A") == 0)) or (not ("abc" <= "ABC")) or (not ("abc" >= "ABC")))
   {
      logtest(tstno, LOGT_ERROR, "T030 string comparison isn't case-blind");
      bad := 1;
   }
   if ((not (strcmp("Z", "a") < 0)) or (not (strcmp("abc", "ABC") > 0)) or (not (strcmp("abc", "abc") == 0)) or
       (not (strcmp("a", "b") < 0)) or (not (strcmp(notset, "") == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T030 strcmp");
      bad := 1;
   }
   if ((not (strncmp("GOD:x", "GOD:y", 4) == 0)) or (not (strncmp("god:", "GOD:", 4) != 0)) or
       (not (strncmp("ab", "abc", 3) < 0)) or
       (not (strncmp("abc", "xyz", 0) == 0)) or (not (strncmp("abc", "abd", -1) < 0)))
   {
      logtest(tstno, LOGT_ERROR, "T030 strncmp");
      bad := 1;
   }
   i := 7;
   i := strcmp(nobody.name, "x");
   if (i != 7)
   {
      logtest(tstno, LOGT_ERROR, "T030 strcmp with a failed argument gave " + itoa(i));
      bad := 1;
   }

   // textformat turns a backslash and n (or r) made at run time into a line break; vmc does the
   // same in the zone file, where a backslash before another letter stays as it is
   s := replace("q", "n", "a\qb"); // a, backslash, n, b
   s2 := textformat(s);
   if ((not (length(s) == 4)) or (not (length(s2) == 3)) or (not (strcmp(s2, "a\nb") == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T030 textformat of backslash n gave " + itoa(length(s2)) + " characters");
      bad := 1;
   }
   s := replace("q", "r", "a\qb");
   s2 := textformat(s);
   if (not (strcmp(s2, "a\rb") == 0))
   {
      logtest(tstno, LOGT_ERROR, "T030 textformat of backslash r");
      bad := 1;
   }
   s := "a\qb";
   if ((not (length(s) == 4)) or (not (strcmp(textformat(s), s) == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T030 textformat changed another escape");
      bad := 1;
   }

   // asctime: "Www Mmm dd hh:mm:ss yyyy" in the server's time zone (1000000000 is 9 Sep 2001 UTC)
   t := 1000000000;
   s := asctime(t);
   if ((not (length(s) == 24)) or (not (right(s, 4) == "2001")) or (not (mid(s, 5, 7) == "Sep")) or
       (not (mid(s, 14, 14) == ":")))
   {
      logtest(tstno, LOGT_ERROR, "T030 asctime(1000000000) gave '" + s + "'");
      bad := 1;
   }
   s := asctime(realtime);
   if ((not (length(s) == 24)) or (not (atoi(right(s, 4)) >= 2026)))
   {
      logtest(tstno, LOGT_ERROR, "T030 asctime(realtime) gave '" + s + "'");
      bad := 1;
   }
   s := "kept";
   s := asctime(nobody.level);
   if (s != "")
   {
      logtest(tstno, LOGT_ERROR, "T030 asctime of a failed value gave '" + s + "'");
      bad := 1;
   }

   // getword takes the first word, with its case, and the spaces after it off a variable;
   // not off an expression
   s := "  ONE   two three";
   w := getword(s);
   if ((not (strcmp(w, "ONE") == 0)) or (not (strcmp(s, "two three") == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T030 getword gave '" + w + "', left '" + s + "'");
      bad := 1;
   }
   w := getword(s);
   w := getword(s);
   s2 := getword(s);
   if ((w != "three") or (s != "") or (s2 != ""))
   {
      logtest(tstno, LOGT_ERROR, "T030 getword to the end gave '" + w + "', '" + s2 + "', left '" + s + "'");
      bad := 1;
   }
   s := "a b";
   w := getword(s + "");
   if ((w != "a") or (s != "a b"))
   {
      logtest(tstno, LOGT_ERROR, "T030 getword of an expression changed the variable: '" + s + "'");
      bad := 1;
   }

   // getwords: every word, runs of spaces are one, no empty entries; the string stays
   s := "  open   the door ";
   sl := getwords(s);
   if ((not (length(sl) == 3)) or (not (sl.[0] == "open")) or (not (sl.[2] == "door")) or
       (s != "  open   the door ") or
       (not (length(getwords("")) == 0)) or (not (length(getwords("   ")) == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T030 getwords gave " + itoa(length(sl)) + " words");
      bad := 1;
   }

   // split: empty pieces kept, each piece trimmed and its runs of spaces made one, the separator
   // matched with case, and it may be longer than one character
   sl := split("a,,b", ",");
   if ((not (length(sl) == 3)) or (not (sl.[1] == "")) or (not (sl.[2] == "b")))
   {
      logtest(tstno, LOGT_ERROR, "T030 split with an empty piece gave " + itoa(length(sl)));
      bad := 1;
   }
   sl := split(" x  y , z ", ",");
   if ((not (length(sl) == 2)) or (not (strcmp(sl.[0], "x y") == 0)) or (not (strcmp(sl.[1], "z") == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T030 split didn't trim the pieces");
      bad := 1;
   }
   if ((not (length(split("aXbxc", "x")) == 2)) or (not (length(split("a<br/>b<br/>c", "<br/>")) == 3)) or
       (not (length(split("abc", ";")) == 1)) or (not (length(split("a,", ",")) == 2)) or
       (not (length(split("", ",")) == 1)))
   {
      logtest(tstno, LOGT_ERROR, "T030 split's separator");
      bad := 1;
   }

   // in a string: a substring, ignoring case; "" is in every string
   if ((not (("key" in "Do you have a KEY?") == 1)) or (not (("spook" in "nospook") == 1)) or
       (not (("xyz" in "abc") == 0)) or
       (not (("" in "abc") == 1)))
   {
      logtest(tstno, LOGT_ERROR, "T030 in a string");
      bad := 1;
   }

   // in a stringlist: the position plus one of the first entry that is the string or its first
   // words, ignoring case and spaces in front; 0 for none
   sl := {"red", "dark blue"};
   if ((not (("red apple" in sl) == 1)) or (not (("dark  blue" in sl) == 2)) or (not (("re" in sl) == 0)) or
       (not (("  RED" in sl) == 1)) or
       (not (("dark" in sl) == 0)) or (not (("reddish" in sl) == 0)))
   {
      logtest(tstno, LOGT_ERROR, "T030 in a stringlist");
      bad := 1;
   }

   // in a list of extras: the first with that whole name, ignoring case and spaces in front
   o := load("pbox@test");
   if (not (("box" in o.names) == 3))
   {
      logtest(tstno, LOGT_ERROR, "T030 'box' in the box's names gave " + itoa("box" in o.names));
      bad := 1;
   }
   addextra(o.extra, {"$t030a", "second"}, "one");
   eh := "$t030a" in o.extra;
   if (eh == null)
   {
      logtest(tstno, LOGT_ERROR, "T030 in extras didn't find an extra");
      bad := 1;
   }
   else if ((not (eh.descr == "one")) or (not (("SECOND" in o.extra) == eh)) or
            (not (("  $T030A" in o.extra) == eh)) or
            (not (("$t030" in o.extra) == null)) or (not (("$t030a " in o.extra) == null)) or
            (not (("nosuch" in o.extra) == null)))
   {
      logtest(tstno, LOGT_ERROR, "T030 in extras matched the wrong names");
      bad := 1;
   }
   eh := "" in o.extra; // pbox's own extra has no names
   if (eh == null)
   {
      logtest(tstno, LOGT_ERROR, "T030 '' in extras didn't find the extra with no names");
      bad := 1;
   }
   else if (not ("box in a box" in eh.descr))
   {
      logtest(tstno, LOGT_ERROR, "T030 '' in extras found '" + eh.descr + "'");
      bad := 1;
   }
   destroy(o);

   // A string set to "" isn't null, and counts as true; one never set is null, equal to "", and false
   s := "";
   if ((s == null) or (not (notset == null)) or (notset != "") or (not s) or notset)
   {
      logtest(tstno, LOGT_ERROR, "T030 an empty or unset string against null");
      bad := 1;
   }
   // s.[i] is one character; a copy is a copy
   s := "hello";
   s2 := s;
   s2 := s2 + "!";
   if ((not (s.[1] == "e")) or (not (s.[4] == "o")) or (s != "hello") or (s2 != "hello!"))
   {
      logtest(tstno, LOGT_ERROR, "T030 string index or copy");
      bad := 1;
   }

   // A stringlist: copied on assignment, out of range read fails and write does nothing, null
   // empties it, and an empty list equals null; sl.[i].[j] is a character of an entry
   sl := {"red", "green"};
   sl2 := sl;
   sl2.[0] := "black";
   s := "kept";
   s := sl.[5];
   sl.[5] := "x";
   if ((not (sl.[0] == "red")) or (not (sl2.[0] == "black")) or (not (length(sl) == 2)) or (s != "") or
       (not (sl.[1].[0] == "g")))
   {
      logtest(tstno, LOGT_ERROR, "T030 stringlist copy or bounds");
      bad := 1;
   }
   sl := null;
   if ((not (length(sl) == 0)) or (not (sl == null)) or (sl2 == null))
   {
      logtest(tstno, LOGT_ERROR, "T030 stringlist and null");
      bad := 1;
   }

   if (bad)
      goto terminate;

   logtest(tstno, LOGT_INFO, "T030 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:terminate:
   logtest(tstno, LOGT_INFO, "T030 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T029 =====================

// DIL built-ins that crashed the server or did the wrong thing (dilinst.cpp and the C they
// call). Each check logs its own ERROR and the test goes on, so one run shows every failure;
// the checks that crashed come last.
// t029pri holds priority on a unit while t029noop, after it on that unit, sits in waitnoop.
dilbegin fnpri(FN_PRI_COMBAT) t029pri();
code
{
   wait(SFB_MSG, argument == "hold");
   priority;
   wait(SFB_MSG, argument == "release");
   nopriority;
   quit;
}
dilend

dilbegin t029noop();
code
{
   wait(SFB_MSG, argument == "go");
   waitnoop;
   addextra(self.extra, {"$t029noop"}, "ran");
   quit;
}
dilend

// Wakes on the save event that store() sends (aware: store(self, ...) sends it from self)
dilbegin aware t029save();
code
{
   wait(SFB_SAVE, TRUE);
   addextra(self.extra, {"$t029save"}, "saved");
   quit;
}
dilend

// Called through a string with an intlist
dilbegin t029il(il : intlist);
code
{
   addextra(self.extra, {"$t029il"}, itoa(il.[1]));
   return;
}
dilend

// Its own program: a failed symbolic call stops the program that made it
dilbegin t029call();
var
   il : intlist;
   s : string;
code
{
   il := {4, 7};
   s := "t029il@test";
   s(il);
   quit;
}
dilend

dilbegin T029(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   n : unitptr;
   n2 : unitptr;
   o : unitptr;
   a : unitptr;
   b2 : unitptr;
   r : unitptr;
   rm : unitptr;
   eh : extraptr;
   ea : extraptr;
   eb : extraptr;
   sl : stringlist;
   bad : integer;
   st : integer;
   i : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T029 DIL built-ins: crashes and wrong results running");
   bad := 0;

   n := load("experiment@test");
   link(n, self);
   secure(n, lost);
   o := load("pbox@test");
   link(o, n);

   // addequip on an object already worn gave its transfer affects a second time; unequip
   // took one set off
   addaff(o, -ID_BLANK10, -1, 0, ABIL_STR, 5, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_ABILITY);
   st := n.abilities[ABIL_STR];
   addequip(o, WEAR_BODY);
   addequip(o, WEAR_HEAD);
   if (n.abilities[ABIL_STR] != st + 5)
   {
      logtest(tstno, LOGT_ERROR, "T029 addequip of a worn object: strength " +
              itoa(n.abilities[ABIL_STR]) + ", not " + itoa(st + 5));
      bad := 1;
   }
   unequip(o);
   if (n.abilities[ABIL_STR] != st)
   {
      logtest(tstno, LOGT_ERROR, "T029 unequip left strength " + itoa(n.abilities[ABIL_STR]) +
              ", not " + itoa(st));
      bad := 1;
   }

   // subaff of a transfer affect on a worn object left the wearer's copy
   st := n.abilities[ABIL_STR];
   addequip(o, WEAR_BODY);
   subaff(o, -ID_BLANK10);
   if (n.abilities[ABIL_STR] != st)
   {
      logtest(tstno, LOGT_ERROR, "T029 subaff of a worn object's transfer affect left strength " +
              itoa(n.abilities[ABIL_STR]) + ", not " + itoa(st));
      bad := 1;
   }
   unequip(o);
   if (n.abilities[ABIL_STR] != st)
   {
      logtest(tstno, LOGT_ERROR, "T029 unequip after subaff: strength " + itoa(n.abilities[ABIL_STR]) +
              ", not " + itoa(st));
      bad := 1;
   }

   // A transfer affect added while the object is worn reaches the wearer at once, and taking
   // it off again takes only that copy, not the copy of the object's other transfer affect
   addaff(o, -ID_BLANK10, -1, 0, ABIL_STR, 5, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_ABILITY);
   st := n.abilities[ABIL_STR];
   addequip(o, WEAR_BODY);
   addaff(o, -ID_BLANK11, -1, 0, ABIL_STR, 3, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_ABILITY);
   if (n.abilities[ABIL_STR] != st + 8)
   {
      logtest(tstno, LOGT_ERROR, "T029 addaff of a transfer affect to a worn object: strength " +
              itoa(n.abilities[ABIL_STR]) + ", not " + itoa(st + 8));
      bad := 1;
   }
   subaff(o, -ID_BLANK11);
   if (n.abilities[ABIL_STR] != st + 5)
   {
      logtest(tstno, LOGT_ERROR, "T029 subaff of the added transfer affect: strength " +
              itoa(n.abilities[ABIL_STR]) + ", not " + itoa(st + 5));
      bad := 1;
   }
   subaff(o, -ID_BLANK10);
   unequip(o);

   // Armour at WEAR_ANKLE_R (24, WEAR_MAX) counted past the end of the table of body parts
   n.abilities[ABIL_DEX] := 50;
   a := load("pbox@test");
   a.objecttype := ITEM_ARMOR;
   a.value[0] := ARM_PLATE;
   link(a, n);
   i := getinteger(DIL_GINT_EFFDEX, n, 0);
   addequip(a, WEAR_ANKLE_R);
   if (getinteger(DIL_GINT_EFFDEX, n, 0) != i)
   {
      logtest(tstno, LOGT_ERROR, "T029 plate at the right ankle made dex " +
              itoa(getinteger(DIL_GINT_EFFDEX, n, 0)) + ", not " + itoa(i));
      bad := 1;
   }
   destroy(a);

   // subextra of an extra not first in the list cleared the variables at the first one and
   // left those at the removed one
   addextra(o.extra, {"t029a"}, "a");
   addextra(o.extra, {"t029b"}, "b");
   eh := o.extra;
   ea := o.extra.["t029a"];
   eb := o.extra.["t029b"];
   if (eh == ea) // remove one that isn't first: the variables at it go, the others stay
   {
      subextra(o.extra, "t029b");
      i := (eh == null) or (ea == null) or (eb != null);
   }
   else
   {
      subextra(o.extra, "t029a");
      i := (eh == null) or (eb == null) or (ea != null);
   }
   if (i)
   {
      logtest(tstno, LOGT_ERROR, "T029 subextra cleared the wrong extraptr variables");
      bad := 1;
   }

   // store() of an empty unit kept the old file, and restore() brought its contents back
   i := delunit("t029store");
   a := load("deadbug@test");
   link(o, self);
   link(a, o);
   store(o, "t029store", FALSE);
   link(a, self);
   store(o, "t029store", FALSE);
   destroy(a);
   b2 := load("pbox@test");
   r := restore("t029store", b2);
   if ((r != null) or (b2.inside != null))
   {
      logtest(tstno, LOGT_ERROR, "T029 restore after store of an empty box brought back its old contents");
      bad := 1;
   }
   destroy(b2);
   i := delunit("t029store");

   // wait(SFB_SAVE) never woke: wait dropped the flag. store() sends the save event.
   dilcopy("t029save@test", o);
   // a program in waitnoop was lost when an earlier program on its unit held priority
   n2 := load("pbox@test");
   link(n2, self);
   secure(n2, lost);
   dilcopy("t029pri@test", n2);
   dilcopy("t029noop@test", n2);
   // an intlist through a string call was taken for a type error
   dilcopy("t029call@test", n);
   secure(o, lost);
   // Two fixed ticks, not two pauses: the copied programs first run PULSE_SEC later, and two
   // random pauses could end right then (see T032)
   wait(SFB_TICK, TRUE);
   wait(SFB_TICK, TRUE);
   store(o, "t029store", TRUE);
   i := delunit("t029store");
   if (not ("$t029save" in o.extra))
   {
      logtest(tstno, LOGT_ERROR, "T029 wait(SFB_SAVE, ...) didn't wake on store()");
      bad := 1;
   }
   if (o.extra.["$t029save"] != null)
      subextra(o.extra, "$t029save");
   sendto("go", n2);
   sendto("hold", n2);
   pause;
   pause;
   sendto("release", n2);
   i := 0;
   while ((i < 20) and (not ("$t029noop" in n2.extra)))
   {
      pause;
      i := i + 1;
   }
   if (not ("$t029noop" in n2.extra))
   {
      logtest(tstno, LOGT_ERROR, "T029 waitnoop never came back after the priority ended");
      bad := 1;
   }
   eh := n.extra.["$t029il"];
   if (eh == null)
   {
      logtest(tstno, LOGT_ERROR, "T029 a template called through a string didn't take an intlist");
      bad := 1;
   }
   else if (eh.descr != "7")
   {
      logtest(tstno, LOGT_ERROR, "T029 the intlist called through a string arrived as " + eh.descr);
      bad := 1;
   }
   unsecure(n2);
   destroy(n2);

   // The checks below crashed the server
   // insert() at -1 wrote at namelist[4 billion]; far past the end, padded the list that far
   sl := {"a", "b"};
   insert(sl, -1, "x");
   insert(sl, 50000, "x");
   insert(sl, 3, "c");
   if ((length(sl) != 4) or (sl.[2] != "") or (sl.[3] != "c"))
   {
      logtest(tstno, LOGT_ERROR, "T029 insert into a stringlist gave length " + itoa(length(sl)));
      bad := 1;
   }

   // stop_fighting(u, t) when u isn't fighting
   r := load("experiment@test");
   link(r, self);
   stop_fighting(n, r);
   destroy(r);

   // follow(u, null) when u follows no one (midgaard's hand cuffs do this), and on an object
   follow(n, null);
   follow(o, null);

   // addaff with an apply function for another kind of unit: on an object, a character, a room
   r := load("pbox@test");
   addaff(r, ID_BLANK10, -1, 0, ABIL_STR, 1, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_ABILITY);
   addaff(r, ID_BLANK11, -1, 0, CHAR_BLIND, 0, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_MOD_CHAR_FLAGS);
   destroy(r);
   addaff(n, ID_BLANK9, -1, 0, OBJ_NO_UNEQUIP, 0, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_MOD_OBJ_FLAGS);
   subaff(n, ID_BLANK9);
   rm := findroom("currentb@test");
   addaff(rm, ID_BLANK9, -1, 0, ABIL_STR, 1, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_ABILITY);
   subaff(rm, ID_BLANK9);

   // setroomexit on a unit in a room took it for the room, and an exit could lead to an object
   setroomexit(rm, DIR_WEST, o);
   if (rm.exit_to[DIR_WEST] != null)
   {
      logtest(tstno, LOGT_ERROR, "T029 setroomexit made an exit to an object");
      bad := 1;
      setroomexit(rm, DIR_WEST, rm); // not to the object destroyed below
   }
   setroomexit(o, DIR_EAST, rm);
   setroomexit(n, DIR_EAST, rm);

   unsecure(o);
   unsecure(n);
   destroy(o);
   destroy(n);
   if (bad)
      goto terminate;

   logtest(tstno, LOGT_INFO, "T029 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:lost:
   logtest(tstno, LOGT_ERROR, "T029 lost a test unit");

:terminate:
   logtest(tstno, LOGT_INFO, "T029 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T028 =====================

// Built-ins that crashed the server or gave a wrong answer. Crashed: isplayer() and loadstr()
// with "." or ".." (a directory: a player's "mail <note> .." stopped the game),
// check_password() with a unit variable holding null, getword() with a word longer than
// 12287 characters, attack_spell() at an object. Wrong: split() on "" (read past the end of
// it), attack_spell() with a null effect, getopponent()/getfollower() with no one (stopped the
// program), interrupt() with its flags in a variable (never fired), strdir() with a bad
// pattern (stopped the program), in with a string never set (stopped the program), delstr()
// (TRUE when nothing was deleted), savestr("w") over a longer text (kept its tail),
// findrndunit() in the equipment (not one at random, often none) and a heartbeat over 32767
// (read back below 0).
dilbegin T028(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   notset : string;
   nobody : unitptr;
   npc    : unitptr;
   npc2   : unitptr;
   u      : unitptr;
   b1     : unitptr;
   b2     : unitptr;
   b3     : unitptr;
   s      : string;
   w      : string;
   sl     : stringlist;
   il     : intlist;
   i      : integer;
   n      : integer;
   f      : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T028 built-in crashes running");

   npc := load("experiment@test");
   npc2 := load("experiment@test");
   b1 := load("pbox@test");
   b2 := load("pbox@test");
   b3 := load("pbox@test");

   // "." and ".." are directories: no player, no string file
   if (isplayer(".") or isplayer("..") or isplayer("") or isplayer("a/b"))
   {
      logtest(tstno, LOGT_ERROR, "T028 isplayer found a player that can't be");
      goto terminate;
   }
   s := "kept";
   if ((loadstr("..", s) != FALSE) or (loadstr(".", s) != FALSE) or (s != "kept") or
       (savestr("..", "x", "w") != FALSE))
   {
      logtest(tstno, LOGT_ERROR, "T028 loadstr or savestr used a directory");
      goto terminate;
   }

   // A unit variable holding null
   i := 7;
   i := check_password(nobody, "x");

   // A word longer than getword's buffer: the first 12287 characters of it, and the rest is skipped
   s := "x";
   i := 0;
   while (i < 17)
   {
      s := s + s;
      i := i + 1;
   }
   s := s + " next";
   w := getword(s);
   if ((length(w) != 12287) or (s != "next"))
   {
      logtest(tstno, LOGT_ERROR, "T028 getword with a huge word gave " + itoa(length(w)) +
              " characters, leaving '" + left(s, 20) + "'");
      goto terminate;
   }

   // Nothing to split on
   sl := split("a b", "");
   if ((length(sl) != 1) or (sl.[0] != "a b"))
   {
      logtest(tstno, LOGT_ERROR, "T028 split on an empty separator");
      goto terminate;
   }

   // No one to fight or follow is null (both stopped the program)
   u := npc;
   u := getopponent(npc, 0);
   if (u != null)
   {
      logtest(tstno, LOGT_ERROR, "T028 getopponent of one not fighting isn't null");
      goto terminate;
   }
   u := npc;
   u := getfollower(nobody, 0);
   if (u != null)
   {
      logtest(tstno, LOGT_ERROR, "T028 getfollower of null isn't null");
      goto terminate;
   }

   // The target must be a character (an object crashed); null for no effect
   i := 7;
   i := attack_spell(SPL_FIREBALL_1, npc, npc, b1, 0, "");
   if (i != 7)
   {
      logtest(tstno, LOGT_ERROR, "T028 attack_spell at an object didn't fail");
      goto terminate;
   }
   i := -1;
   i := attack_spell(SPL_FIREBALL_1, npc, npc, npc2, -1000, null);
   if (i < 0)
   {
      logtest(tstno, LOGT_ERROR, "T028 attack_spell with a null effect gave no damage");
      goto terminate;
   }

   // A pattern that isn't one fails, as in unitdir() (it stopped the program)
   sl := {"kept"};
   sl := strdir("[");
   if (sl.[0] != "kept")
   {
      logtest(tstno, LOGT_ERROR, "T028 strdir with a bad pattern gave a list");
      goto terminate;
   }

   // A string never set holds nothing and is found nowhere (stopped the program)
   n := (notset in "abc") + ("a" in notset) + (notset in {"a"});
   if (n != 0)
   {
      logtest(tstno, LOGT_ERROR, "T028 in with a string never set isn't FALSE");
      goto terminate;
   }

   // "w" writes the whole file; delstr is TRUE when it deleted
   i := savestr("t028.txt", "a longer text", "w");
   i := savestr("t028.txt", "short", "w");
   i := loadstr("t028.txt", s);
   if (s != "short")
   {
      logtest(tstno, LOGT_ERROR, "T028 savestr w left '" + s + "'");
      goto terminate;
   }
   if ((delstr("t028.txt") != TRUE) or (delstr("t028.txt") != FALSE))
   {
      logtest(tstno, LOGT_ERROR, "T028 delstr's answer is the wrong way round");
      goto terminate;
   }

   // One of the equipment at random
   link(b1, npc2);
   link(b2, npc2);
   link(b3, npc2);
   addequip(b1, WEAR_HEAD);
   addequip(b2, WEAR_BODY);
   addequip(b3, WEAR_LEGS);
   il := {0, 0, 0};
   i := 0;
   while (i < 300)
   {
      u := findrndunit(npc2, FIND_UNIT_EQUIP, UNIT_ST_OBJ);
      if (u == b1)
         il.[0] := il.[0] + 1;
      else if (u == b2)
         il.[1] := il.[1] + 1;
      else if (u == b3)
         il.[2] := il.[2] + 1;
      i := i + 1;
   }
   if ((il.[0] < 50) or (il.[1] < 50) or (il.[2] < 50))
   {
      logtest(tstno, LOGT_ERROR, "T028 findrndunit in the equipment picked " + itoa(il.[0]) + ", " +
              itoa(il.[1]) + " and " + itoa(il.[2]) + " times of 300");
      goto terminate;
   }

   // The heartbeat is unsigned 16 bits
   heartbeat := 40000;
   i := heartbeat;
   heartbeat := PULSE_SEC * 1;
   if (i != 40000)
   {
      logtest(tstno, LOGT_ERROR, "T028 heartbeat 40000 read back as " + itoa(i));
      goto terminate;
   }

   destroy(b1);
   destroy(b2);
   destroy(b3);
   destroy(npc);
   destroy(npc2);

   // Flags in a variable: the interrupt fires on the next tick (after a wait, the unit
   // variables not secured are null)
   f := SFB_TICK;
   n := interrupt(f, TRUE, ticked);
   i := 0;
:tickwait:
   pause;
   i := i + 1;
   if (i < 3)
      goto tickwait;
   logtest(tstno, LOGT_ERROR, "T028 interrupt with its flags in a variable never fired");
   goto terminate;

:ticked:
   clear(n);
   logtest(tstno, LOGT_INFO, "T028 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:terminate:
   destroy(b1);
   destroy(b2);
   destroy(b3);
   destroy(npc);
   destroy(npc2);
   logtest(tstno, LOGT_INFO, "T028 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T027 =====================

// Fields and built-ins that crashed the server or gave the wrong value: npc.exptol (asked an
// NPC for a player's level), asctime() of a constant (vmc made no code for the constant, and
// the stack ran empty), a dilcopy() string longer than the copy buffer or with more arguments
// than it has room for, and "if (u.title)" (false for a title that is set). Also attack_type,
// natural_armour and movement took any value, read later past the end of the weapon, armour
// and landscape tables: a value outside the table is now refused (logged). Alignment took any
// value, not -1000..1000: it now clamps, as setAlignment() does.
dilbegin T027(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   u : unitptr;
   r : unitptr;
   i : integer;
   j : integer;
   s : string;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T027 field limits running");

   u := load("experiment@test");
   i := -7;
   i := u.exptol; // an NPC: fails, i keeps its value
   if (i != -7)
   {
      logtest(tstno, LOGT_ERROR, "T027 npc.exptol gave " + itoa(i));
      goto terminate;
   }

   s := asctime(31536000); // one year after 1 January 1970
   if (not ("1971" in s))
   {
      logtest(tstno, LOGT_ERROR, "T027 asctime(31536000) gave '" + s + "'");
      goto terminate;
   }

   // Both only have to come back
   s := "x";
   while (length(s) < 13000)
      s := s + s;
   dilcopy("nosuchdil@test(" + s + ")", self);
   s := "1,";
   while (length(s) < 4000) // 2048 arguments
      s := s + s;
   dilcopy("nosuchdil@test(" + s + ")", self);

   if (u.title) // "an experiment"
      i := 0;
   else
   {
      logtest(tstno, LOGT_ERROR, "T027 if (u.title) is false for '" + u.title + "'");
      goto terminate;
   }
   u.title := "";
   if (u.title)
   {
      logtest(tstno, LOGT_ERROR, "T027 if (u.title) is true for an empty title");
      goto terminate;
   }

   u.attack_type := WPN_DAGGER;
   u.attack_type := 200;
   i := u.attack_type;
   u.attack_type := 3; // a weapon group, not an attack type
   if ((i != WPN_DAGGER) or (u.attack_type != WPN_DAGGER))
   {
      logtest(tstno, LOGT_ERROR, "T027 attack_type took " + itoa(i) + " and " + itoa(u.attack_type));
      goto terminate;
   }
   u.attack_type := WPN_FIST;
   if (u.attack_type != WPN_FIST)
   {
      logtest(tstno, LOGT_ERROR, "T027 attack_type WPN_FIST gave " + itoa(u.attack_type));
      goto terminate;
   }

   u.natural_armour := ARM_LEATHER;
   u.natural_armour := 9;
   i := u.natural_armour;
   u.natural_armour := -1;
   if ((i != ARM_LEATHER) or (u.natural_armour != ARM_LEATHER))
   {
      logtest(tstno, LOGT_ERROR, "T027 natural_armour took " + itoa(i) + " and " + itoa(u.natural_armour));
      goto terminate;
   }

   r := findroom("testlabe@test");
   j := r.movement;
   r.movement := 50;
   i := r.movement;
   r.movement := j;
   if (i != j)
   {
      logtest(tstno, LOGT_ERROR, "T027 movement took " + itoa(i));
      goto terminate;
   }

   u.alignment := 5000;
   i := u.alignment;
   u.alignment := -70000;
   if ((i != 1000) or (u.alignment != -1000))
   {
      logtest(tstno, LOGT_ERROR, "T027 alignment took " + itoa(i) + " and " + itoa(u.alignment));
      goto terminate;
   }
   u.alignment := -350;
   if (u.alignment != -350)
   {
      logtest(tstno, LOGT_ERROR, "T027 alignment -350 gave " + itoa(u.alignment));
      goto terminate;
   }

   destroy(u);
   logtest(tstno, LOGT_INFO, "T027 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;

:terminate:
   destroy(u);
   logtest(tstno, LOGT_INFO, "T027 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T026 =====================

// and/or bind looser than the comparisons, as in C: a == 1 and b == 2 is
// (a == 1) and (b == 2). Before, and sat with * and or with +, so it was
// (a == (1 and b)) == 2, and every condition written without brackets was wrong.
dilbegin T026(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   a : integer;
   b : integer;
   s : string;
code
{
   logtest(tstno, LOGT_INFO, "T026 and/or precedence running");
   a := 1;
   b := 2;
   s := "x";

   if (not (a == 1 and b == 2))
   {
      logtest(tstno, LOGT_ERROR, "T026 a == 1 and b == 2 is false");
      goto terminate;
   }
   if (a == 2 or b == 3)
   {
      logtest(tstno, LOGT_ERROR, "T026 a == 2 or b == 3 is true");
      goto terminate;
   }
   if (not (a == 6 or a == 12 or a == 1))
   {
      logtest(tstno, LOGT_ERROR, "T026 a chain of or comparisons is false");
      goto terminate;
   }
   if (not (a < b and s == "X" and b != 5))
   {
      logtest(tstno, LOGT_ERROR, "T026 mixed comparisons with and are false");
      goto terminate;
   }
   // and binds tighter than or
   if (not (a == 2 and b == 2 or a == 1))
   {
      logtest(tstno, LOGT_ERROR, "T026 and doesn't bind tighter than or");
      goto terminate;
   }
   // All constants: worked out by vmc, through the same rules
   if (not (1 == 1 and 2 == 2) or (1 == 2 or 2 == 3))
   {
      logtest(tstno, LOGT_ERROR, "T026 constant comparisons with and/or are wrong");
      goto terminate;
   }
   // not still binds tightest: not a == 1 is (not a) == 1
   if ((not a == 1) or not (not (a == 2) and "x" in s))
   {
      logtest(tstno, LOGT_ERROR, "T026 not with and/in is wrong");
      goto terminate;
   }
   // + and & are unchanged: they still bind tighter than the comparisons
   if ((a + 1 != b) or ((b & 2) != 2))
   {
      logtest(tstno, LOGT_ERROR, "T026 + or & changed");
      goto terminate;
   }

   logtest(tstno, LOGT_INFO, "T026 Success");
   sendtoalldil("done", "labdirector@test");
   quit;

:terminate:
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T025 =====================

// The Yule wish (yule_q@holiday22): the rung of the player's level, one lower with fewer than
// 24 spokes, never below good (2), nothing under 16, and an artifact only at level 100 with
// all 24.

dilbegin T025(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
   integer yule_q@holiday22(lvl : integer, c : integer);
var
   il : intlist;
   i : integer;
   q : integer;
code
{
   logtest(tstno, LOGT_INFO, "T025 Yule wish ladder running");
   // level, spokes, quality
   il := {1, 15, -1,   1, 16, 2,   1, 24, 2,   5, 16, 2,   5, 24, 2,   19, 24, 2,
          20, 23, 2,   20, 24, 3,   59, 24, 4,   60, 16, 4,   79, 24, 5,   80, 24, 6,
          99, 24, 6,   100, 23, 6,   100, 24, 7,   150, 16, 6,   150, 15, -1};
   i := 0;
   while (i < length(il))
   {
      q := yule_q@holiday22(il.[i], il.[i + 1]);
      if (q != il.[i + 2])
      {
         logtest(tstno, LOGT_ERROR, "T025 level " + itoa(il.[i]) + " with " + itoa(il.[i + 1]) +
                 " spokes gives " + itoa(q) + ", not " + itoa(il.[i + 2]));
         sendtoalldil("fail", "labdirector@test");
         quit;
      }
      i := i + 3;
   }

   logtest(tstno, LOGT_INFO, "T025 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   quit;
}
dilend

// ==================== T024 =====================

// watercurrent@basemove: currenta's current (east to currentb, a swim no one makes) drowns
// the experiment, then carries both boxes after it. It looped on the drowned unit for ever
// (the DIL was killed as an endless loop, and the boxes stayed), and it followed a moved
// unit into currentb's list, so only one box drifted on a beat.

dilbegin T024(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   u : unitptr;
   w : unitptr;
   n : integer;
   i : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T024 watercurrent running");

   u := load("pbox@test");
   link(u, findroom("currenta@test"));
   u := load("pbox@test");
   link(u, findroom("currenta@test"));
   u := load("experiment@test"); // linked last: the first the current comes to
   link(u, findroom("currenta@test"));
   u.hp := -9; // mortally wounded: any failed swim drowns it

   n := 0;
   i := 0;
   while ((n == 0) and (i < 60))
   {
      pause;
      i := i + 1;
      u := findroom("currentb@test"); // unit variables are cleared at each pause
      u := u.inside;
      while (u != null)
      {
         if (u.nameidx == "pbox")
            n := n + 1;
         u := u.next;
      }
   }

   if (n == 0)
   {
      logtest(tstno, LOGT_ERROR, "T024 the boxes never drifted: the current stopped at the drowned unit");
      goto terminate;
   }
   if (n != 2)
   {
      logtest(tstno, LOGT_ERROR, "T024 only " + itoa(n) + " box drifted on the beat");
      goto terminate;
   }
   u := findroom("currentb@test");
   u := u.inside;
   while (u != null)
   {
      if ((u.nameidx == "experiment") and (u.type == UNIT_ST_NPC))
      {
         logtest(tstno, LOGT_ERROR, "T024 the experiment swam: the drowned unit wasn't tried");
         goto terminate;
      }
      u := u.next;
   }

   logtest(tstno, LOGT_INFO, "T024 Success");
   logtest(tstno, LOGT_INFO, "Done");
   i := 1;
   goto cleanup;

:terminate:
   logtest(tstno, LOGT_INFO, "T024 failed");
   i := 0;

:cleanup: // what T024 made, the corpse too, so T003 finds only its own boxes
   u := findroom("currenta@test");
   u := u.inside;
   while (u != null)
   {
      w := u.next;
      destroy(u);
      u := w;
   }
   u := findroom("currentb@test");
   u := u.inside;
   while (u != null)
   {
      w := u.next;
      destroy(u);
      u := w;
   }
   if (i)
      sendtoalldil("done", "labdirector@test");
   else
      sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T023 =====================

// DIL built-ins and a string variable that was never set (it holds null, not ""): replace,
// mid, strcmp, strncmp, addcolor, changecolor, delcolor, flog, send_pre, send_done and act()
// as an expression passed the null on to C and crashed the whole server. A string never set
// now counts as "". Also: mid outside the string, left/right with a count below 0 (wrote
// before the buffer), + with an unset string ("(NIL POINTER)x"), and the act statement with
// a string as the actor (crashed), with the texts act() and sact() give.
dilbegin T023(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   notset : string;
   nobody : unitptr;
   i      : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T023 built-ins with a null string running");

   if ((replace("$x", notset, "a $x b") != "a  b") or
       (replace(notset, "y", "a b") != "a b") or
       (replace("a", "y", notset) != ""))
   {
      logtest(tstno, LOGT_ERROR, "T023 replace with a null string gave the wrong text");
      goto terminate;
   }
   if ((mid(notset, 1, 2) != "") or (mid("abcdef", 0, 2) != "ab") or (mid("abcdef", -3, 2) != "ab") or
       (mid("abc", 2, 9) != "bc") or (mid("abc", 5, 9) != "") or (mid("abcdef", 2, 4) != "bcd"))
   {
      logtest(tstno, LOGT_ERROR, "T023 mid gave the wrong text");
      goto terminate;
   }
   if ((left("abc", -1) != "") or (right("abc", -1) != "") or (left("abc", 2) != "ab") or
       (right("abc", 2) != "bc"))
   {
      logtest(tstno, LOGT_ERROR, "T023 left or right gave the wrong text");
      goto terminate;
   }
   if ((strcmp(notset, "") != 0) or (strcmp("", notset) != 0) or (strncmp(notset, "a", 1) >= 0) or
       (strcmp("b", "a") <= 0))
   {
      logtest(tstno, LOGT_ERROR, "T023 strcmp or strncmp with a null string gave the wrong answer");
      goto terminate;
   }
   if ((notset + "x" != "x") or ("x" + notset != "x"))
   {
      logtest(tstno, LOGT_ERROR, "T023 + with a null string gave the wrong text");
      goto terminate;
   }

   // These only have to come back: the old code crashed on each
   i := addcolor(self, notset, "red");
   i := addcolor(nobody, "key", notset);
   i := changecolor(self, notset, "red");
   i := delcolor(self, notset);
   i := delcolor(nobody, "key");
   // A unit variable never set: the server crashed on each of these
   pagestring("x", nobody);
   set_password(nobody, "x");
   beginedit(nobody);
   killedit(nobody);
   gamestate(nobody, 0);
   reset_level(nobody);
   reset_vlevel(nobody);
   reset_race(nobody);
   i := flog(notset, "x", "a");
   i := flog("t023.log", "x", notset);
   i := flog("../t023.log", "x", "a");   // refused: outside the log directory
   // An empty command fails: search_trie("") would have given the first command (north)
   if ((send_pre(notset, self, null, null, 0, "", null) == SFR_SHARE) or
       (send_pre(notset, self, null, null, 0, "", null) == SFR_BLOCK))
   {
      logtest(tstno, LOGT_ERROR, "T023 send_pre with an unset command ran a command");
      goto terminate;
   }
   send_done(notset, self, null, null, 0, "", null, CMD_AUTO_NONE);
   nobody := load("experiment@test");
   notset := act(notset, A_ALWAYS, nobody, null, null, TO_CHAR); // act() as an expression
   // A blank or empty text is a line too; sact() adds no <br/>, and gives "" for a string where
   // the one it is about goes
   if ((act(" ", A_ALWAYS, nobody, null, null, TO_CHAR) != " <br/>") or
       (act("$2t", A_ALWAYS, nobody, "", null, TO_CHAR) != "<br/>") or
       (sact("hi", A_ALWAYS, nobody, null, null, TO_CHAR) != "Hi") or
       (sact("hi", A_ALWAYS, "str", null, null, TO_CHAR) != ""))
   {
      destroy(nobody);
      logtest(tstno, LOGT_ERROR, "T023 act() or sact() gave the wrong text");
      goto terminate;
   }
   destroy(nobody);
   act("x", A_ALWAYS, "str", null, null, TO_CHAR); // a string as the actor crashed the server

   logtest(tstno, LOGT_INFO, "T023 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   return;

:terminate:
   logtest(tstno, LOGT_INFO, "T023 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T022 =====================

// Ship: ship@function on the room shipdeck (dwell 30 s, 30 s at sea) moves it between
// shipport1 and shipport2 through shipsea. A passenger aboard can't "exit" or "leave" at sea
// (the ship's $no_exit extra) and rides on; in port "exit" puts it on the quay. shipwatch keeps
// the ship's last message to the deck. The ship runs from boot, so the test takes it wherever
// it is: the first check is whichever state comes first. A captain (ship_captain@function)
// starts on the quay when the ship is in port, is aboard at sea, and steps onto the quay when
// the ship arrives.
// On shipdeck: the last move ship@function announced, in the $shipev extra
dilbegin shipwatch();
code
{
   addextra(self.extra, {"$shipev"}, "none");
   :start:
   wait(SFB_MSG, "ship " in argument);
   subextra(self.extra, "$shipev");
   addextra(self.extra, {"$shipev"}, argument);
   goto start;
}
dilend

dilbegin T022(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
   integer ship_next@function(departs : intlist, hour : integer);
var
   ship  : unitptr;
   u     : unitptr;
   c     : unitptr;
   k     : integer;
   i     : integer;
   seaok : integer;  // the exit was refused at sea
   portok : integer; // the exit worked in port
   arrived : integer; // it reached a port after the sea
   last  : string;   // the port the ship lay at before the sea
   back  : integer;  // the captain came back to the ship's dock
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T022 ship running");

   // The next departure: later the same day, at this very hour, past midnight, and in a list
   // that starts in the afternoon
   if ((ship_next@function({3, 9, 15, 21}, 4) != 1) or
       (ship_next@function({3, 9, 15, 21}, 9) != 1) or
       (ship_next@function({3, 9, 15, 21}, 22) != 0) or
       (ship_next@function({16, 18, 20, 22, 0, 2}, 23) != 4) or
       (ship_next@function({16, 18, 20, 22, 0, 2}, 10) != 0))
   {
      logtest(tstno, LOGT_ERROR, "T022 ship_next picked the wrong departure");
      u := null;
      goto terminate;
   }
   ship := findroom("shipdeck@test");
   u := load("passenger@test");
   link(u, ship);
   // In port the captain starts ashore and has to board; at sea aboard. Also aboard once the
   // ship is boarding: it may sail within a second or two, before his program first runs
   // (PULSE_SEC after the load) and boards, and the test failed now and then.
   c := load("captain@test");
   if ((ship.outside.symname == "shipsea@test") or
       (("$ship_last" in ship.extra) and ("ship boarding " in ship.extra.["$ship_last"].descr)))
      link(c, ship);
   else
      link(c, ship.outside);

   i := 0;
   while ((i < 100) and ((seaok == 0) or (portok == 0) or (arrived == 0) or (back == 0)))
   {
      pause;
      i := i + 1;
      ship := findroom("shipdeck@test");
      u := findsymbolic("passenger@test");
      if (u == null)
      {
         logtest(tstno, LOGT_ERROR, "T022 the passenger was lost");
         goto terminate;
      }

      if (ship.outside.symname == "shipsea@test")
      {
         if (not ("$no_exit" in ship.extra))
         {
            logtest(tstno, LOGT_ERROR, "T022 at sea without $no_exit");
            goto terminate;
         }
         if (seaok == 0)
         {
            if (not ("ship at sea shipdeck@test shipport" in ship.extra.["$shipev"].descr))
            {
               logtest(tstno, LOGT_ERROR, "T022 no 'ship at sea' message to the deck");
               goto terminate;
            }
            exec("exit", u);
            exec("leave", u);
            if (u.outside != ship)
            {
               logtest(tstno, LOGT_ERROR, "T022 the passenger left the ship at sea");
               goto terminate;
            }
            c := findsymbolic("captain@test");
            if (c == null)
            {
               logtest(tstno, LOGT_ERROR, "T022 the captain was lost");
               goto terminate;
            }
            if (c.outside != ship)
            {
               logtest(tstno, LOGT_ERROR, "T022 the captain isn't aboard at sea");
               goto terminate;
            }
            seaok := 1;
         }
      }
      else if ((ship.outside.symname == "shipport1@test") or (ship.outside.symname == "shipport2@test"))
      {
         if ("$no_exit" in ship.extra)
         {
            logtest(tstno, LOGT_ERROR, "T022 in port with $no_exit");
            goto terminate;
         }
         if ((seaok == 1) and (arrived == 0))
         {
            if (last == ship.outside.symname)
            {
               logtest(tstno, LOGT_ERROR, "T022 the ship came back to " + last);
               goto terminate;
            }
            if (not (("ship arrived shipdeck@test " + ship.outside.symname) in ship.extra.["$shipev"].descr))
            {
               logtest(tstno, LOGT_ERROR, "T022 no 'ship arrived' message for " + ship.outside.symname);
               goto terminate;
            }
            if (u.outside != ship)
            {
               logtest(tstno, LOGT_ERROR, "T022 the passenger didn't ride on");
               goto terminate;
            }
            // The captain steps ashore on the next tick, not while the ship tells its arrival
            k := 0;
            c := findsymbolic("captain@test");
            while ((k < 5) and (c != null) and (c.outside != ship.outside))
            {
               pause;
               k := k + 1;
               c := findsymbolic("captain@test");
               ship := findroom("shipdeck@test");
            }
            ship := findroom("shipdeck@test");
            u := findsymbolic("passenger@test");
            if (c == null)
            {
               logtest(tstno, LOGT_ERROR, "T022 the captain was lost");
               goto terminate;
            }
            if (c.outside != ship.outside)
            {
               logtest(tstno, LOGT_ERROR, "T022 the captain didn't step onto the quay");
               goto terminate;
            }
            arrived := 1;

            // Carried off elsewhere in the zone, he hurries back to the dock when he hears his
            // ship come in: its arrival again, sent to every captain as ship_signal sends it
            link(c, findroom("labcontrol@test"));
            sendtoalldil(ship.extra.["$ship_last"].descr, "ship_captain@function");
            k := 0;
            c := findsymbolic("captain@test");
            while ((k < 5) and (c != null) and (c.outside != ship.outside))
            {
               pause;
               k := k + 1;
               c := findsymbolic("captain@test");
               ship := findroom("shipdeck@test");
            }
            ship := findroom("shipdeck@test");
            u := findsymbolic("passenger@test");
            if (c == null)
            {
               logtest(tstno, LOGT_ERROR, "T022 the captain was lost");
               goto terminate;
            }
            if (c.outside != ship.outside)
            {
               logtest(tstno, LOGT_ERROR, "T022 the captain didn't come back to the ship's dock");
               goto terminate;
            }
            back := 1;
         }
         if (seaok == 0)
            last := ship.outside.symname;
         if (portok == 0)
         {
            exec("exit", u);
            if (u.outside != ship.outside)
            {
               logtest(tstno, LOGT_ERROR, "T022 the passenger couldn't leave in port");
               goto terminate;
            }
            portok := 1;
            exec("enter ship", u); // aboard again (for the sea, when that's still to come)
            if (u.outside != ship)
            {
               logtest(tstno, LOGT_ERROR, "T022 the passenger couldn't board");
               goto terminate;
            }
         }
      }
      else if (ship.outside != null)
      {
         logtest(tstno, LOGT_ERROR, "T022 the ship is in " + ship.outside.symname);
         goto terminate;
      }
   }

   if ((seaok == 0) or (portok == 0) or (arrived == 0) or (back == 0))
   {
      logtest(tstno, LOGT_ERROR, "T022 the ship didn't sail in 100 seconds");
      goto terminate;
   }

   destroy(u);
   c := findsymbolic("captain@test");
   if (c != null)
      destroy(c);
   logtest(tstno, LOGT_INFO, "T022 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   return;

:terminate:
   if (u != null)
      destroy(u);
   c := findsymbolic("captain@test");
   if (c != null)
      destroy(c);
   logtest(tstno, LOGT_INFO, "T022 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T021 =====================

// Weather: getinteger(DIL_GINT_PRESSURE / DIL_GINT_PRESSURECHG) read the zone's air pressure
// (950..1050 mb) and its last change (-12..12); with a null unit they read the DIL's own zone.
//
dilbegin T021(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   p : integer;
   c : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T021 weather pressure running");

   p := getinteger(DIL_GINT_PRESSURE, self, 0);
   c := getinteger(DIL_GINT_PRESSURECHG, self, 0);
   logtest(tstno, LOGT_INFO, "T021 pressure " + itoa(p) + ", change " + itoa(c));

   if ((p < 950) or (p > 1050))
   {
      logtest(tstno, LOGT_ERROR, "T021 pressure out of range");
      goto terminate;
   }
   if ((c < -12) or (c > 12))
   {
      logtest(tstno, LOGT_ERROR, "T021 change out of range");
      goto terminate;
   }
   if (getinteger(DIL_GINT_PRESSURE, null, 0) != p)
   {
      logtest(tstno, LOGT_ERROR, "T021 a null unit doesn't read the own zone");
      goto terminate;
   }

   logtest(tstno, LOGT_INFO, "T021 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   return;

:terminate:
   logtest(tstno, LOGT_INFO, "T021 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T020 =====================

// Confusion: a confused NPC in testlabc (one exit, east) that tries to go west stumbles
// out the east exit now and then (confused@spells); once the confusion is gone it stays,
// and confused@spells has quit. confprobe tries "west" up to 20 times on the NPC and
// leaves "moved" or "stayed" in its $probe extra.
dilbegin confprobe();
var
   i : integer;
   s : string;
code
{
   s := "stayed";
   i := 0;
   while (i < 20)
   {
      exec("west", self);
      if (self.outside.nameidx == "testlabe")
      {
         s := "moved";
         break;
      }
      pause;
      i := i + 1;
   }
   subextra(self.extra, "$probe");
   addextra(self.extra, {"$probe"}, s);
   quit;
}
dilend

dilbegin unitptr findexp();
var
   u : unitptr;
code
{
   u := findroom("testlabc@test");
   u := u.inside;
   while (u)
   {
      if (u.symname == "experiment@test")
         return (u);
      u := u.next;
   }
   u := findroom("testlabe@test");
   u := u.inside;
   while (u)
   {
      if (u.symname == "experiment@test")
         return (u);
      u := u.next;
   }
   return (u);  // null: not found
}
dilend

dilbegin T020(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
   unitptr findexp@test();
var
   u : unitptr;
   r : unitptr;
   i : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T020 confusion running");
   u := load("experiment@test");
   link(u, findroom("testlabc@test"));
   addaff(u, ID_CONFUSION, 10, WAIT_SEC*15, 0, 0, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_NONE);
   dilcopy("confused@spells", u);
   dilcopy("confprobe@test", u);

   i := 0;
:wait1:
   pause;
   u := findexp@test();
   i := i + 1;
   if ((u != null) and (not("$probe" in u.extra)) and (i < 60))
      goto wait1;
   if (u == null)
   {
      logtest(tstno, LOGT_ERROR, "T020 the experiment was lost");
      goto terminate;
   }
   if (not("$probe" in u.extra) or (u.extra.["$probe"].descr != "moved"))
   {
      logtest(tstno, LOGT_ERROR, "T020 a confused NPC never stumbled east in 20 tries");
      goto terminate;
   }

   subaff(u, ID_CONFUSION);
   link(u, findroom("testlabc@test"));
   subextra(u.extra, "$probe");
   dilcopy("confprobe@test", u);
   i := 0;
:wait2:
   pause;
   u := findexp@test();
   i := i + 1;
   if ((u != null) and (not("$probe" in u.extra)) and (i < 60))
      goto wait2;
   if ((u == null) or (not("$probe" in u.extra)) or (u.extra.["$probe"].descr != "stayed"))
   {
      logtest(tstno, LOGT_ERROR, "T020 an NPC no longer confused still stumbled");
      goto terminate;
   }
   if (dilfind("confused@spells", u))
   {
      logtest(tstno, LOGT_ERROR, "T020 confused@spells didn't quit with the confusion");
      goto terminate;
   }

   destroy(u);
   logtest(tstno, LOGT_INFO, "T020 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   return;

:terminate:
   if (u != null)
      destroy(u);
   logtest(tstno, LOGT_INFO, "T020 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T019 =====================

// Detect curse: get_aura@baselook shows (orange) for a cursed object to someone with
// CHAR_DETECT_CURSE, and nothing before it is cursed. auraprobe runs get_aura as that NPC
// and leaves the answer in its $aura extra.
dilbegin auraprobe();
external
   string get_aura@baselook(item : unitptr);
var
   o : unitptr;
   s : string;
code
{
   o := findunit(self, "box", FIND_UNIT_SURRO, null);  // cage@test is pandora's box
   s := "no box";
   if (o != null)
      s := get_aura@baselook(o);
   subextra(self.extra, "$aura");
   addextra(self.extra, {"$aura"}, s);
   quit;
}
dilend

dilbegin T019(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   u : unitptr;
   o : unitptr;
   s : string;
   i : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T019 detect curse running");
   o := load("cage@test");
   link(o, self);
   u := load("experiment@test");
   link(u, self);
   secure(o, lost);
   secure(u, lost);
   set(u.charflags, CHAR_DETECT_CURSE);

   dilcopy("auraprobe@test", u);
   i := 0;
   while ((i < 5) and (not ("$aura" in u.extra)))
   {
      pause;
      i := i + 1;
   }
   if (not ("$aura" in u.extra))
   {
      logtest(tstno, LOGT_ERROR, "T019 the aura probe didn't run");
      goto terminate;
   }
   s := u.extra.["$aura"].descr;
   if ("orange" in s)
   {
      logtest(tstno, LOGT_ERROR, "T019 orange aura before the curse: " + s);
      goto terminate;
   }

   addaff(o, ID_CURSE, 10, WAIT_SEC*30, OBJ_NO_UNEQUIP, 0, 0, TIF_NONE, TIF_NONE, TIF_NONE, APF_MOD_OBJ_FLAGS);
   subextra(u.extra, "$aura");
   dilcopy("auraprobe@test", u);
   i := 0;
   while ((i < 5) and (not ("$aura" in u.extra)))
   {
      pause;
      i := i + 1;
   }
   s := u.extra.["$aura"].descr;
   if (not ("(orange)" in s))
   {
      logtest(tstno, LOGT_ERROR, "T019 no orange aura on the cursed cage: " + s);
      goto terminate;
   }

   unsecure(u);
   destroy(u);
   unsecure(o);
   destroy(o);
   logtest(tstno, LOGT_INFO, "T019 Success: " + s);
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   return;

:lost:
   logtest(tstno, LOGT_ERROR, "T019 a test unit was lost");

:terminate:
   logtest(tstno, LOGT_INFO, "T019 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T018 =====================

// Frenzy: an NPC in a fight throws itself into a frenzy (frenzy_rounds@skills); its strength
// grows while it fights, and everything is gone again once the fight ends.
dilbegin T018(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   u1 : unitptr;
   u2 : unitptr;
   str : integer;
   i : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T018 frenzy running");
   u1 := load("experiment@test");
   link(u1, self);
   u2 := load("experiment@test");
   link(u2, self);
   secure(u1, lost);
   secure(u2, lost);
   // sturdy, so the fight lasts: a level 1 zombie can die in one round
   u1.max_hp := 5000;
   u1.hp := 5000;
   u2.max_hp := 5000;
   u2.hp := 5000;
   str := u1.abilities[ABIL_STR];

   exec("frenzy", u1);
   pause;
   if (dilfind("frenzy_rounds@skills", u1))
   {
      logtest(tstno, LOGT_ERROR, "T018 a frenzy without a fight");
      goto terminate;
   }

   set_fighting(u1, u2);
   set_fighting(u2, u1);
   i := 0;
   while ((i < 40) and (not dilfind("frenzy_rounds@skills", u1)))
   {
      u1.endurance := 300;
      u1.hp := u1.max_hp;
      u2.hp := u2.max_hp;
      if (u1.fighting == null)
         set_fighting(u1, u2);
      exec("frenzy", u1);
      pause;
      i := i + 1;
   }
   if (not dilfind("frenzy_rounds@skills", u1))
   {
      logtest(tstno, LOGT_ERROR, "T018 no frenzy after 40 tries");
      goto terminate;
   }
   logtest(tstno, LOGT_INFO, "T018 frenzy after " + itoa(i) + " tries");

   i := 0;
   while ((i < 15) and (u1.abilities[ABIL_STR] < str + 4))
   {
      u1.hp := u1.max_hp;
      u2.hp := u2.max_hp;
      u1.endurance := 300;
      pause;
      i := i + 1;
   }
   if (u1.abilities[ABIL_STR] < str + 4)
   {
      logtest(tstno, LOGT_ERROR, "T018 strength didn't grow: " + itoa(str) + " -> " + itoa(u1.abilities[ABIL_STR]) +
              ", fighting " + itoa(u1.fighting != null) + ", frenzy " + itoa(dilfind("frenzy_rounds@skills", u1)) +
              ", hp " + itoa(u1.hp) + "/" + itoa(u2.hp));
      goto terminate;
   }
   logtest(tstno, LOGT_INFO, "T018 strength " + itoa(str) + " -> " + itoa(u1.abilities[ABIL_STR]));

   stop_fighting(u1, null);
   stop_fighting(u2, null);
   i := 0;
   while ((i < 15) and dilfind("frenzy_rounds@skills", u1))
   {
      pause;
      i := i + 1;
   }
   if (dilfind("frenzy_rounds@skills", u1) or isaff(u1, ID_FRENZY) or (u1.abilities[ABIL_STR] != str))
   {
      logtest(tstno, LOGT_ERROR, "T018 the frenzy didn't end cleanly, strength " + itoa(u1.abilities[ABIL_STR]));
      goto terminate;
   }

   unsecure(u1);
   destroy(u1);
   unsecure(u2);
   destroy(u2);
   logtest(tstno, LOGT_INFO, "T018 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   return;

:lost:
   logtest(tstno, LOGT_ERROR, "T018 a test unit was lost");

:terminate:
   logtest(tstno, LOGT_INFO, "T018 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T017 =====================

// Rage: an NPC works itself into a rage: ID_RAGE, more strength, less dexterity; a second
// rage is refused while the first lasts.
dilbegin T017(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);
var
   u : unitptr;
   str : integer;
   dex : integer;
   str2 : integer;
   i : integer;
code
{
   heartbeat := PULSE_SEC * 1;
   logtest(tstno, LOGT_INFO, "T017 rage running");
   u := load("experiment@test");
   link(u, self);
   secure(u, lost);
   str := u.abilities[ABIL_STR];
   dex := u.abilities[ABIL_DEX];

   i := 0;
   while ((i < 40) and (not isaff(u, ID_RAGE)))
   {
      u.endurance := 300;
      exec("rage", u);
      pause;
      i := i + 1;
   }
   if (not isaff(u, ID_RAGE))
   {
      logtest(tstno, LOGT_ERROR, "T017 no rage after 40 tries");
      goto terminate;
   }
   if ((u.abilities[ABIL_STR] <= str) or (u.abilities[ABIL_DEX] > dex) or (u.abilities[ABIL_DEX] < 1))
   {
      logtest(tstno, LOGT_ERROR, "T017 STR " + itoa(str) + " -> " + itoa(u.abilities[ABIL_STR]) +
              ", DEX " + itoa(dex) + " -> " + itoa(u.abilities[ABIL_DEX]));
      goto terminate;
   }
   logtest(tstno, LOGT_INFO, "T017 rage after " + itoa(i) + " tries: STR " + itoa(str) + " -> " +
           itoa(u.abilities[ABIL_STR]) + ", DEX " + itoa(dex) + " -> " + itoa(u.abilities[ABIL_DEX]));

   str2 := u.abilities[ABIL_STR];
   u.endurance := 300;
   exec("rage", u);
   pause;
   if (u.abilities[ABIL_STR] != str2)
   {
      logtest(tstno, LOGT_ERROR, "T017 a second rage stacked: STR " + itoa(u.abilities[ABIL_STR]));
      goto terminate;
   }

   unsecure(u);
   destroy(u);
   logtest(tstno, LOGT_INFO, "T017 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   return;

:lost:
   logtest(tstno, LOGT_ERROR, "T017 a test unit was lost");

:terminate:
   logtest(tstno, LOGT_INFO, "T017 failed");
   sendtoalldil("fail", "labdirector@test");
   quit;
}
dilend

// ==================== T016 =====================

dilbegin T016(tstno : integer);
external
   logtest(no : integer, ltype : integer, msg : string);

var
   r : unitptr;
code
{
   logtest(tstno, LOGT_INFO, "T016 running");
   r := findroom("testlabc@test");

   if (r.exit_to[DIR_NORTH] != null)
   {
      logtest(tstno, LOGT_INFO, "There shouldn't be a room exit north");
      goto terminate;
   }

   if (r.exit_to[DIR_EAST] == null)
   {
      logtest(tstno, LOGT_INFO, "east direction was null but should be set");
      goto terminate;
   }

   setroomexit(r, DIR_NORTH, r); // Point to self

   if (r.exit_to[DIR_NORTH] != r)
   {
      logtest(tstno, LOGT_INFO, "T016 north direction not set to self room");
      goto terminate;
   }

   r := null;
   setroomexit(r, DIR_NORTH, r); // Drop the exit again
 
   if (r.exit_to[DIR_NORTH] != null)
   {
      logtest(tstno, LOGT_INFO, "T016 north direction not reset back to null");
      goto terminate;
   }

   logtest(tstno, LOGT_INFO, "T016 Success");
   logtest(tstno, LOGT_INFO, "Done");
   sendtoalldil("done", "labdirector@test");
   return;

