dilbegin fnpri(FN_PRI_MISSION) failsafe();
external
   logtest(no : integer, ltype : integer, msg : string);
   rebooting@commands(s : string);
code
{
   heartbeat := PULSE_SEC*60*5; // After 5 minutes, abort
   wait(SFB_TICK, TRUE);
   log("Test/T000//ERROR Fail safe triggered");
   reboot(99); // a failed run: exit code 0 would pass in CI
   quit;
}
dilend

dilbegin labdirector();
external
   logtest(no : integer, ltype : integer, msg : string);
var 
   i : integer;
   tstno : integer;
   il : intlist global errors@test;
   s : string;
code
{
   logtest(0, LOGT_INFO, "Lab director starting.");

   tstno := TEST_MAXIMUM; // If you add a new T003, then set this to 3, and so forth

   heartbeat := PULSE_SEC * 30;
   interrupt(SFB_MSG, TRUE, nexttest);

:loop:
   s := "T" + right("00"+itoa(tstno), 3) + "@test" + "(" + itoa(tstno) + ")";
   logtest(0, LOGT_INFO, "Lab director launching test " + s);
   dilcopy(s, self.outside);
   i := 0;
   while (i < 6) // 2.5 to 3 minutes: a ship test may wait out a whole voyage
   {
      pause;
      i := i + 1;
   } 
   goto timeout;

:nexttest:
   logtest(tstno, LOGT_INFO, "Lab director received signal=" + argument);
   if (argument != "done")
      goto shutdown;
   tstno := tstno - 1;
   if (tstno > 0)
      goto loop;

   logtest(tstno, LOGT_SUCCESS, "Lab director finished running all tests.");
   goto shutdown;

:timeout:
   logtest(tstno, LOGT_ERROR, "Lab director stuck.");
   goto shutdown;

:shutdown:
   if (length(il) > 0)
   {
      s := "";
      i := length(il)-1;
      while (i >= 0)
      {
         s := s + itoa(il.[i]) + " ";
         i := i - 1;
      }
      log("The following tests failed : " + s);
      log("Exiting with code " + itoa(il.[0]));
      reboot(il.[0]);
   }
   else
      reboot(0);
   quit;
}
dilend
end


