#include <macros.h>

%zone	holiday22

lifespan 25       // Lifespan is controlled in Santa's room
reset RESET_NEVER // Only reset in Santa's control room

creators {"Ratlin"}

notes
"Largely taken from the holiday22 zone. See it for more details.
2023... Trying to reuse the zone from 2022 by simply renaming
the quests. Let's see how it goes..."

help
"Player should never be in here."


%dil

// What Santa's helpers share: spirits, out of reach of a fight (spirit_nokill)
// (one line: a backslash before CRLF doesn't continue a #define)
#define XMAS_SPIRIT race RACE_SPIRIT MSET_ABILITY (20,20,1,20,15,4,15,5) MSET_WEAPON(9,4,4,4,3,3) MSET_SPELL(9,4,0,7,6,5,10,14,6,6,6)

#define XMAS_SANTA_IDX   0
#define XMAS_DONE_IDX    1
#define XMAS_DAY_IDX     2
#define XMAS_CHARGES_IDX 3
#define XMAS_NO_DEC_IDX  4
#define XMAS_EXP_IDX     5


//
// Initialize these global DIL values for the xmas zone 
// so that we can reuse it year after year.
//
dilbegin xmas_initialize();
var
    xmas_quests  : stringlist global xmas_done@holiday22;

/*  xmas_santa   : string global xmas_santa@holiday22;
    xmas_done    : string global xmas_done@holiday22;
    xmas_day     : string global xmas_day@holiday22;
    xmas_charges : string global xmas_charges@holiday22;
    xmas_no_dec  : string global xmas_no_dec@holiday22;
    xmas_exp     : string global xmas_exp@holiday22;*/

    year : integer;
code
{
    year := getinteger(DIL_GINT_REALYEAR, self, 0);
    addstring(xmas_quests, "Visiting Santa " + itoa(year));
    addstring(xmas_quests, "Holiday Gift " + itoa(year) + " Received");
    addstring(xmas_quests, "Holiday Gift " + itoa(year) + " Upgraded");
    addstring(xmas_quests, "$XMAS_Charges " + itoa(year));
    addstring(xmas_quests, "$NO_DEC" + itoa(year));
    addstring(xmas_quests, "$XMASEXP" + itoa(year));
    log("xmas debug year = " + itoa(year));
    return;
}
dilend

// Copy a quest_restrict onto the calling object
// using the xmas_done quest
//
dilbegin xmas_restrict();
var
    xmas_quests  : stringlist global xmas_done@holiday22;
code
{
   dilcopy("quest_restrict@function("+xmas_quests.[XMAS_DONE_IDX]+", 0, 0,)", self);
   return;
}
dilend


dilbegin rocket(holiday : string);
external
	act_world (s:string);
	ast_launch();
	act_launcher(s:string);
var
	pc,item 	: unitptr;
	s,pname,col,col2,holstr1,holstr2 : string;
code
{
	heartbeat:=PULSE_SEC*3;
:start:
	wait (SFB_CMD, (command ("light") and ("rocket" in argument)));
	block;
	pc:=activator;
	secure (pc,start);
	if(pc.outside.type!=UNIT_ST_ROOM)
	{
		act ("You can not light that from here!",
		A_ALWAYS,pc,null,null,TO_CHAR);
		unsecure (pc);
		goto start;
	}
	item:=findunit(pc,argument,FIND_UNIT_SURRO,null);
	if ((item==null) or (item!=self))
    {
		unsecure (pc);
		goto start;
    }
    if (item.outside.type!=UNIT_ST_ROOM)
	{
		act ("You need to put it on the ground first.",
		A_ALWAYS,pc,null,null,TO_CHAR);
		unsecure (pc);
		unsecure (item);
		goto start;
	}
    secure (item,start);
	

	
    act ("$1n bends down and lights $2n.",A_ALWAYS,pc,self,null,TO_REST);
    act ("You bend down and light $2n.",A_ALWAYS,pc,self,null,TO_CHAR);
	pname:=pc.name;
	pause;
    act ("<div class='cr'>ss</div><div class='cpr'>ss</div><div class='cpy'>ss</div><div class='cy'>ss</div><div class='cr'>ss</div><div class='cpr'>ss</div><div class='cy'>ss</div><div class='cpy'>ss</div><div class='cw'></div>",
		A_ALWAYS,self,null,null,TO_ALL);
    pause;
    act ("$1n leaves the ground with blinding speed!",A_ALWAYS,self,null,null,TO_ALL);
    self.minv:=200;
    pause;

    on rnd (1,6) goto ired, igreen, iyellow, iblue, imagenta, icyan;

	:ired:
		col := "cpr";
		col2 := "<div class='"+col+"'>red";
		goto conti;

	:igreen:
		col := "cpg";
		col2 := "<div class='"+col+"'>green";
		goto conti;

	:iyellow:
		col := "cpy";
		col2 := "<div class='"+col+"'>yellow";
		goto conti;

	:iblue:
		col := "cpb";
		col2 := "<div class='"+col+"'>blue";
		goto conti;

	:imagenta:
		col := "cpm";
		col2 := "<div class='"+col+"'>purple";
		goto conti;

	:icyan:
		col := "cpc";
		col2 := "<div class='"+col+"'>cyan";
		goto conti;

	:iwhite:
		col := "cpw";
		col2 := "<div class='"+col+"'>white";
		goto conti;
	   
:conti:

	s:="";
	item:=self.inside;
	while (item)
	{
		if (item.type!=UNIT_ST_OBJ)
		{
			item:=item.next;
			continue;
		}
		if (item.objecttype!=ITEM_NOTE)
		{
			item:=item.next;
			continue;
		}
		if (item.extra==null)
			goto default;
		s:=item.extra.descr;
		break;
   }
   	if (holiday == "NY")
	{
		holstr1 := "<div class='cpw'>A burst of " + col2 + " sparkles</div> explodes in the sky above spelling out <br/><br/><div class='"+col+"'>" + s +"<br/></div></div>";
		holstr2 := "<div class='cpw'>A burst of " + col2 + " sparkles</div> explodes in the sky above and drifts spectacularly down to the ground.<br/>";
	}
	if (holiday == "XMAS")
	{
		holstr1 := "<div class='cpw'>A flurry of " + col2 + " snowflakes</div> can be seen in the sky above spelling out <br/><br/><div class='"+col+"'>" + s +"<br/></div></div>";
		holstr2 := "<div class='cpw'>A flurry of " + col2 + " snowflakes</div> can be seen in the sky drifting slowly down to the ground.<br/>";
	}	
	if (holiday == "Halloween")
	{
		holstr1 := "<div class='cpw'>A massive " + col2 + " skull</div> appears in the sky above. It echoes out <br/><br/><div class='"+col+"'>" + s +"<br/></div></div>";
		holstr2 := "<div class='cpw'>A massive " + col2 + " skull</div> appears in the sky above. It cackles before fading away.<br/>";
	}		
	if (holiday == "VD")
	{
		holstr1 := "<div class='cpw'>An explosion of " + col2 + " hearts</div> appear in the sky spelling out <br/><br/><div class='"+col+"'>" + s +"<br/></div></div>";
		holstr2 := "<div class='cpw'>An explosion of " + col2 + " hearts</div> appear in the sky above. They hang for a period of time, and fade.<br/>";
	}
	if (s=="")
		goto default;

	act_launcher(pname);
	act_world ("<div class='cpw'>You hear a loud boom!</div><br/>");
	ast_launch();	
	act_world (holstr1);

	item:=self.inside;
	while (item)
	{
		if (item.type==UNIT_ST_PC)
		{
			item.minv:=0;
			act("The rocket you are riding in explodes dumping your guts on your keyboard!",
				A_ALWAYS,item,null,null,TO_CHAR);
		}
		item:=item.next;
	}

	self.minv:=0;
	destroy(self);
	quit;

	:default:
	act_world("<div class='cpw'>You hear a loud boom!</div><div class='cw'><br/></div>");
	ast_launch();
	act_world(holstr2);

	item:=self.inside;
	while (item)
	{
		if (item.type==UNIT_ST_PC)
		{
			item.minv:=0;
			act("The rocket you are riding in explodes dumping your guts on your keyboard!",
				A_ALWAYS,item,null,null,TO_CHAR);
		}
		item:=item.next;
	}
	self.minv:=0;
	destroy (self);
	quit;

}
dilend

dilbegin holiday_burn();
code
{
	act ("Your $2N sparkles and you drop it to the ground.",
		A_ALWAYS,self.outside,self,null,TO_CHAR);
	act ("$1n's $2N sparkles and drops to the ground.",
		A_SOMEONE,self.outside,self,null,TO_REST);
	act ("You have been added to Santa's Naughty List for trying to use someone else's gift!",
		A_ALWAYS,self.outside,null,null,TO_CHAR);
	return;
}
dilend
dilbegin hq_burn();
code
{
	act ("You $2n sparkles and you drop it to the ground.",
		A_ALWAYS,self.outside,self,null,TO_CHAR);
	act ("$1n's $2N sparkles and drops to the ground.",
		A_SOMEONE,self.outside,self,null,TO_REST);
	act ("You have been added to Santa's Naughty List. You haven't done the holiday quest!",
		A_ALWAYS,self.outside,null,null,TO_CHAR);
	return;
}
dilend



/* Maintains the counts of gift types loaded so that mud 
   does not become flooded with presents in low population hours. */
// i must be [0..11]
//
dilbegin string gift_name(i:integer);
var
	gifts	:	stringlist;
code
{
	gifts:={"boom_box2","boom_box2","boom_box4","boom_box2",
		"boom_box4","boom_box3","boom_box2","boom_box3",
		"boom_box4","boom_box3","boom_box2","boom_box4"};
	return (gifts.[i]);
}
dilend


// count must be in [0..11] and will load a random gift based on the number
// i is 0 for placed in random npc, 1 random room
//
dilbegin gift_func(count:integer, i:integer);
external
	string gift_name (i:integer);
var
	item	:	unitptr;
	namer	:	string;
	place	:	unitptr;
	gift	:	unitptr;
code
{
    namer:=gift_name(count);
    gift:=load(namer+"@holiday22");

    if (gift.loadcount > 250)
	{
		destroy(gift);
		return;
	}
	else if ((gift.nameidx == "boom_box3") and (gift.loadcount > 100))
	{
		destroy(gift);
		return;
	}
	else if ((gift.nameidx == "boom_box4") and (gift.loadcount > 150))
	{
		destroy(gift);
		return;
	}

	
:loop:
	if (i==0)
		place:=findrndunit(self,FIND_UNIT_WORLD,UNIT_ST_NPC);
	else
		place:=findrndunit(self,FIND_UNIT_WORLD,UNIT_ST_ROOM);

	if ((place==null) or (place==self))
		goto loop;

	item:=place;

	while (item.type!=UNIT_ST_ROOM)
	{
		if (item.type==UNIT_ST_PC)
			goto loop;
		item:=item.outside;
	}
	link(gift,place);

	return;
}
dilend   


// Once every 20 minutes, try to load a lot of gifts randomly in the world
//
dilbegin load_gift();
external
	gift_func(count:integer,i:integer);
var
	count:integer;
	exclude:integer;
code
{     
:start:
	heartbeat := PULSE_SEC*3;
	exclude := rnd(0,11);
	count := 0;
	while (count < 12)
	{
		if (exclude==count) // Place in room
		{
			gift_func(count, 1);
			pause;
			gift_func(count, 1);
			pause;
			gift_func(count, 1);
			pause;
			gift_func(count, 1);
			pause;
		}
		else
		{
			gift_func(count, 0);
			pause;
			gift_func(count, 0);
			pause;
			gift_func(count, 0);
			pause;
			gift_func(count, 0);
			pause;
		}

		count := count + 1;
	}

	heartbeat:=PULSE_SEC*1200; 
	wait(SFB_TICK,TRUE);
	goto start;
}
dilend  


/* Heal routine for newbie candy can presents (under level 50) */
dilbegin candy_heal(medi : unitptr, targ : unitptr, hm : integer);
code
{
	act("Your $2N glows <div class='cpr'>b</div><div class='cpw'>r</div><div class='cpr'>i</div><div class='cpw'>g</div><div class='cpr'>h</div><div class='cpw'>t</div><div class='cpr'>l</div><div class='cpw'>y</div>!", A_ALWAYS, self, medi, targ , TO_CHAR);
	act("$1n's $2N glows <div class='cpr'>b</div><div class='cpw'>r</div><div class='cpr'>i</div><div class='cpw'>g</div><div class='cpr'>h</div><div class='cpw'>t</div><div class='cpr'>l</div><div class='cpw'>y</div>!",A_SOMEONE, targ, medi, null, TO_REST);
	return;
}
dilend

/*start the quest, touch the pole if char less than level 50 give newbie gift
otherwise, set the flag, and start the exp tracker */ 
dilbegin touch_pole();
external
    integer realmmdd@function();
    integer yule_count(pc : unitptr);
    string yule_year();
var
    xmas_quests  : stringlist global xmas_done@holiday22;
	pc 			: unitptr;
	newbie_gift	: unitptr;
	item		: unitptr;
	z 			: integer;
	i 			: integer;
    sl          : stringlist;

code
{

:start:
	wait(SFB_CMD, (command("touch")) and ("pole" in argument));
	block;

	pc := activator;
	secure(pc, lostpc);

	// December 24 to 31: Jolnir sees those with 16 spokes of the Yule Wheel, any level
	z := realmmdd@function();
	if ((z >= 1224) and (z <= 1231) and (yule_count(pc) >= 16) and
	    not (("Yule Gift " + yule_year()) in pc.quests))
	{
		act("You touch the pole, and the Yule fire seems to roar in your ears.", A_ALWAYS, pc, null, null, TO_CHAR);
		act("$1n touches the pole and vanishes in a swirl of snow.", A_SOMEONE, pc, null, null, TO_REST);
		link(pc, findroom("yulehall@holiday22"));
		act("$1n appears out of a swirl of snow.", A_SOMEONE, pc, null, null, TO_REST);
		exec("look", pc);
		unsecure(pc);
		goto start;
	}

	if (xmas_quests.[XMAS_NO_DEC_IDX] in pc.extra)
	{
		act("We are sorry, but you have not played here long enough to get on our gift list.", A_ALWAYS, activator, null, null, TO_CHAR);
		act("But we still Wish you a Happy Holiday Season!", A_ALWAYS, activator, null, null, TO_CHAR);
		log(pc.name+"has not played here long enough to receive a gift.");
		unsecure(pc);
		goto start;
	}
	if (xmas_quests.[XMAS_DONE_IDX] in pc.quests)
	{
		act("Greedy little snot aren't we!", A_ALWAYS, activator, null, null, TO_CHAR);
		unsecure(pc);

		goto start;
	}
    if (pc.level < 49)
	{
		act("We are sorry, but you have not played here long enough to get on our regular gift list.", A_ALWAYS, activator, null, null, TO_CHAR);
		act("But please take this small token and Have a Happy Holiday Season!", A_ALWAYS, activator, null, null, TO_CHAR);
		newbie_gift:= load("newbgift@holiday22");
        sl := null;
        addstring(sl, xmas_quests.[XMAS_DONE_IDX]);
		addextra(pc.quests, sl, "");
		dilcopy ("ply_restrict@function("+pc.name+",0,25,holiday_burn@holiday22)",newbie_gift);
		newbie_gift.height:= pc.height;
		log(pc.name+" received a "+newbie_gift.nameidx);
		link(newbie_gift, pc);
		unsecure(pc);
		goto start;
	}
	if (not(xmas_quests.[XMAS_EXP_IDX] in pc.extra))
	{
        sl := null;
        addstring(sl, xmas_quests.[XMAS_EXP_IDX]);
		addextra (pc.extra,sl,itoa(pc.exp)); 
		act("Come back when you have gained some experience!", A_ALWAYS, activator, null, null, TO_CHAR);
		goto start;
	}
	else if ((pc.exp - atoi(pc.extra.[xmas_quests.[XMAS_EXP_IDX]].descr)) >=200000)
	{   /* they got it */	
		act("You touch the pole, and visions of sugar plums start dancing in your head!", A_ALWAYS, activator, null, null, TO_CHAR);
		act("You suddenly feel like you're floating.", A_ALWAYS, activator, null, null, TO_CHAR);
		act("$1n starts floating away from the ground.", A_SOMEONE, activator,null, null, TO_REST);
		act("$1n is surrounded by sparkling lights, then disappears.", A_SOMEONE, activator,null, null, TO_REST);
		link(pc, findroom("study@holiday22"));
		act("$1n appears in a flash of light!.", A_SOMEONE, activator, null, null,TO_REST);
		act("You find yourself mysteriously transferred to the north pole!", A_ALWAYS, activator, null, null, TO_CHAR);
		pause;
		pause;
		exec("look ", pc);
		unsecure(pc);
		goto start;
	}
	else 
	{  /*they need */
		act( "You need "+itoa(200000 - (pc.exp - atoi(pc.extra.[xmas_quests.[XMAS_EXP_IDX]].descr)))
		+ " more experience to see Santa.", A_ALWAYS, activator, null, null, TO_CHAR);
		goto start;
	}

:lostpc:

	unsecure(pc);
	goto start;
}
dilend   

/*these are sant's shouts change as you please to vary periodically*/
dilbegin santa_shout();
var
code
{
:start:

	heartbeat := PULSE_SEC * rnd(60,240);
	wait(SFB_CMD|SFB_TICK, TRUE);
	pause;
	on rnd(0,6) goto shout_one, shout_two, shout_three, shout_four, shout_five, shout_six,shout_seven;

:shout_one:
	pause;
	exec("shout HAPPY HOLIDAY ONE AND ALL!!!!!!!!!!!!", self);
	pause;
	goto start;

:shout_two:
	pause;
	exec("shout Kobolds roasting on an open fire!", self);
	exec ("shout Dark Elves cutting off their toes." , self);
	pause;
	goto start;

:shout_three:
	pause;
	exec("shout I know if you have been bad or good!", self);
	pause;
	goto start;

:shout_four:
	pause;
	exec("shout Hey, players leave those elves alone!", self);
	pause;
	goto start;

:shout_five:
	pause;
	exec("shout Merry Christmas and Happy New Year to everyone!!!", self);
	pause;
	goto start;

:shout_six:
	pause;
	exec("shout Is that slay bells I hear already!", self);
	pause;
	exec("shout Let the Christmas Slaying Begin!!", self);
	pause;
	goto start;

:shout_seven:
	pause;
	exec("shout On the fourth day of slaying God Odin gave to me,",self);
	exec("shout Four rods of lightning, three silver flagons,",self);
	exec("shout Two swords of healing and the ravens Thought and Memory,",self); 
	pause;
	goto start;
}
dilend 

/* So they can't kill Santa or howard */
dilbegin spirit_nokill ();
var
code
{
:start:
	wait (SFB_PRE, command (CMD_AUTO_DAMAGE) and (self==target));
	block;
	act ("Magic guardians knock you unconscious.",A_ALWAYS,self,null,activator,TO_VICT);
	activator.position:=POSITION_STUNNED;
	self.position:=POSITION_STANDING;
	activator.hp:=0;
	goto start;
}
dilend 

/*santa's rountines for once they get exp */
dilbegin look_santa();
var
    xmas_quests  : stringlist global xmas_done@holiday22;
	pc : unitptr;
    sl : stringlist;
code
{
	heartbeat := PULSE_SEC*4;

:start:

	wait(SFB_CMD, (command("look")) and ("santa" in argument));
    block;

	pc := activator;
	secure(pc, lostpc);

	if (xmas_quests.[XMAS_DONE_IDX] in pc.quests)
	{
		exec("whisper "+pc.name+ "Don't be greedy or I shall take your gift away!", self);
		goto start;
    }
	else if (xmas_quests.[XMAS_SANTA_IDX] in pc.quests)
	{
		exec("say "+pc.name+ ", I'd love to talk more, but I have a lot to do. " +
		"My assistant will take care of you. The workshop is over there.", self);
		exec("point ", self);
		goto start;
    }
	
	exec("say HO! HO! HO!", self);
	pause;
	exec("say Hello there "+pc.name+"!", self);
	pause;
	exec("say Let's see I have you on a list here somewhere!", self);
	pause;
	exec("say Ahhh! Okay, I see you have been a good person this year!", self);
	pause;
	exec("eye "+pc.name, self);
	pause;
	exec("say Well, I see you have tried to be at least.",self);
	pause;
	exec("say We'll just overlook those four times.",self);
	pause; 
	exec("say Go see the elf in the work shop.", self);
	pause;
	exec("say He will make a special gift for you "+pc.name+".",self);
	pause;
	exec("say I along with the Admin here at Valhalla, wish you a very Happy Holiday!", self);
	pause;
	exec("wave "+pc.name,self);
    sl := null;
    addstring(sl, xmas_quests.[XMAS_SANTA_IDX]);
	addextra(pc.quests, sl, "");

:lostpc:

	unsecure(pc);
	goto start;
}
dilend   

dilbegin xmas_day_func();
var
    xmas_quests  : stringlist global xmas_done@holiday22;
	pc		:  	unitptr;
	item 	:   unitptr;
    sl      :   stringlist;

code
{
	on_activation((self.position < POSITION_SITTING) or (self.position == POSITION_FIGHTING), skip);

:start:

	secure(pc, lost_pc);
	heartbeat:= PULSE_SEC*4;
	wait(SFB_DONE, (command("look")) and (activator.type == UNIT_ST_PC) and (target == self));

	pc := activator;
	
	if ((not(xmas_quests.[XMAS_DONE_IDX] in pc.quests)) or (xmas_quests.[XMAS_DAY_IDX] in pc.quests))
		goto start;

	secure(pc, lost_pc);

	exec("say Hello "+pc.name+", a very merry Christmas to you my dear!", self);
	pause;

:choose:

	exec("say I see that Mr. Claus found you on his nice list, thats good.", self);
	pause;
	exec("say Now listen here darling, I'm offering a special holiday treat this year.", self);
	pause;
	exec("say If you would like to have a little extra holiday magic added to your gift, I can help!", self);
	pause;
	exec("say just hand me this year's gift, and I'll work a special charm onto it.", self);

	wait(SFB_DONE, (command("give")) and (activator == pc) and (target == self));
	
	item := medium;
	if ((item.zoneidx == "holiday22") and (not(xmas_quests.[XMAS_DAY_IDX] in pc.quests)) and (item.type == 8))
	{
        sl := null;
        addstring(sl, xmas_quests.[XMAS_DAY_IDX]);
		addextra(pc.quests, sl, "");
		dilcopy ("xmas_magic@holiday22()",item);
		dilcopy ("x_charge@holiday22()",item);
		item.extra.descr := item.extra.descr + " It has a <div class='cpg'>magical</div><div class='cpw'> twinkle</div>.";
		exec("Emote grasps the "+item.name+" and gives a little chickle.", self);
		act ("A magical twinkle surrounds the "+item.name+".",A_ALWAYS,self,null,null,TO_ROOM);
		link(item,pc);
		pause;
		exec("say Simply exclaim 'Merry Christmas!' to call on the magic!", self);
		
		log("Mrs Claus DIL: ("+pc.name+") recieved an upgrade!");
	
		exec("shout <div class='cg'>Happy Holidays "+pc.name+"!</div>",self);
	}
	else
	{
		log("XMAS MAGIC: Failed. Item symname = "+item.symname+" Item Type: "+itoa(item.type)); 
		exec("Say Oh, deary me. "+pc.name+" I can not help you with this.", self);
		link(item,pc);
		pause;
		exec("Say Here, you have this back now.", self);
	}

:lost_pc:

	unsecure(pc);
	goto start;
}
dilend  // xmas_day

dilbegin xmas_magic();
var
    xmas_quests  : stringlist global xmas_done@holiday22;
	pc		: unitptr;
	charges : integer;
	i 		: integer;
    sl      : stringlist;
code
{
	heartbeat := PULSE_SEC;
:start:
// item will carry 1 charge. recharges once per day. will restore wearer to full health.
	wait(SFB_CMD, (command("say") and (argument == "Merry Christmas!") and (activator == self.outside) and (self.equip > 0)));
	pc := activator;
	secure(pc,lostpc);
	
	if(not(xmas_quests.[XMAS_CHARGES_IDX] in self.extra))
    {
        sl := null;
        addstring(sl, xmas_quests.[XMAS_CHARGES_IDX]);
		addextra(self.extra, sl, "charged");
    }

	if(self.extra.[xmas_quests.[XMAS_CHARGES_IDX]].descr == "empty") 
	{
		wait(SFB_TICK, command(CMD_AUTO_TICK));
		act("Your $2N seems to be drained of its holiday magic.",A_ALWAYS,self.outside,self,null,TO_CHAR);
		goto start;
	}
	wait(SFB_TICK, command(CMD_AUTO_TICK));
	self.extra.[xmas_quests.[XMAS_CHARGES_IDX]].descr := "empty";
	self.extra.[0].descr := replace(" It has a <div class='cpg'>magical</div><div class='cpw'> twinkle</div>.","",self.extra.[0].descr);
	
	act("A burst of holiday magic erupts from your $2N!",A_ALWAYS,self.outside,self,null,TO_CHAR);
	act("Your $2N has fully restored you!",A_ALWAYS,self.outside,self,null,TO_CHAR);
	act("A burst of holiday magic erupts from $1n's $2N!",A_ALWAYS,self.outside,self,null,TO_REST);
	pc.hp := pc.max_hp;
	pc.endurance := pc.max_endurance;
	pc.mana := pc.max_mana;
	position_update(pc);
	
	:lostpc:
	unsecure(pc);
	goto start;
}
dilend
// *********************** DIL x_charge **************************
// Program will add charges to the christmas item.

dilbegin recall x_charge();
var
    xmas_quests  : stringlist global xmas_done@holiday22;
    charge 	: integer;
    sl : stringlist;
code
{
	:start:
	heartbeat := PULSE_SEC*SECS_PER_MUD_DAY;
	wait(SFB_TICK, (self.equip > 0));
	
	if(not(xmas_quests.[XMAS_CHARGES_IDX] in self.extra))
    {
        sl := null;
        addstring(sl, xmas_quests.[XMAS_CHARGES_IDX]);
		addextra(self.extra, sl, "charged");
    }
	
	act("Your $2N twinkles magically!",A_ALWAYS,self.outside,self,null,TO_CHAR);
	act("$1n's $2N twinkles magically!",A_ALWAYS,self.outside,self,null,TO_REST);
	if(self.extra.[xmas_quests.[XMAS_CHARGES_IDX]].descr == "empty")
	{
		self.extra.[0].descr := self.extra.[0].descr + " It has a <div class='cpg'>magical</div><div class='cpw'> twinkle</div>.";
		self.extra.[xmas_quests.[XMAS_CHARGES_IDX]].descr := "charged";
	}
	goto start;
	
}
dilend // END x_charge

/*pc picks item */
dilbegin christmas_2022();
var
    xmas_quests  : stringlist global xmas_done@holiday22;
	pc		:  	unitptr;
	gift	:	unitptr;
	stat	:	string;
	spot	:	string;
	sl		:	stringlist;

code
{
	on_activation((self.position < POSITION_SITTING) or (self.position == POSITION_FIGHTING), skip);

:start:

	secure(pc, lost_pc);
	heartbeat:= PULSE_SEC*4;
	wait(SFB_DONE, (command("look")) and (activator.type == UNIT_ST_PC) and (target == self));

	if (xmas_quests.[XMAS_DONE_IDX] in activator.quests)
		goto start;

	pc := activator;
	secure(pc, lost_pc);

	exec("say Hello there "+pc.name+", I see you have come for your gift.", self);
	pause;

:choose:

	exec("say Now listen closely, and wait for me to ask for your choice.", self);
	pause;
	exec("say First off, where would you like to wear the gift?", self);
	pause;
	exec("say You may choose ankle, belt, ring, wrist, back, chest, cape, neck, ear.", self);
	pause;
	exec("say You can choose just ONE area to wear it!", self);
	pause;
	exec("say Make your choice now.", self);

	wait(SFB_DONE, (command("say")) and (activator== pc));
	sl := {"ankle","belt","ring","wrist","back","chest","cape","neck","ear"};
	spot := argument;
	log("SANTA DIL: ("+pc.name+") Spot is "+spot);
	if (spot in sl)
	{
		exec("say Okay, you have chosen "+spot+".", self);
		pause;
	}
	else
	{
		exec("say I wish you would pick one of the categories I specified.", self);
		pause;
		goto choose;
	}
	
	exec("say Now you must choose the ability the gift will give.", self);
	pause;
	
:choose2:	

	exec("say Now listen closely, and again wait for me to ask for your choice.", self);
	pause;
	exec("say You may choose STR, DEX, CHA, CON, DIV, BRA, MAG.", self);
	pause;
	exec("say You can choose just ONE ability!", self);
	pause;
	exec("say Make your choice now.", self);
	
	wait(SFB_DONE, (command("say")) and (activator== pc));
	sl := {"STR","DEX","CHA","CON","DIV","BRA","MAG"};
	stat := argument;
	
	log("SANTA DIL: ("+pc.name+") Stat is "+stat);
	if (stat in sl)
	{
		exec("say Okay, you want to boost "+stat+".", self);
		pause;
	}
	else
	{
		exec("say I wish you would pick one of the abilities I specified.", self);
		pause;
		goto choose2;
	}

	exec("say Now I will make your gift.", self);
	pause;
	exec("say Be patient as this is a busy time of year for us elves!", self);
	pause;
	exec("emote starts gathering materials to make your gift.",self);
	pause;

	gift := load(spot+"_"+stat+"@holiday22");
	dilcopy ("ply_restrict@function("+pc.name+",0,25,holiday_burn@holiday22)",gift);
	dilcopy ("quest_restrict@function("+xmas_quests.[XMAS_DONE_IDX]+",0,25,hq_burn@holiday22)",gift);
	gift.height := pc.height;
	link(gift,pc);
	log("SANTA DIL: ("+pc.name+") received a "+gift.symname);
	exec("say Here is your gift.", self);
	pause;
    sl := null;
    addstring(sl, xmas_quests.[XMAS_DONE_IDX]);
	addextra(pc.quests, sl, "");
	subextra(pc.quests, xmas_quests.[XMAS_SANTA_IDX]);
	pause;
	exec("shout <div class='cpr'>Happy Holidays "+pc.name+"</div>",self);
	link(pc, findroom("square@udgaard"));
	pause;
	exec("look",pc);

:lost_pc:

	unsecure(pc);
	goto start;
}
dilend

dilbegin act_world (s:string);
var
	pc:unitptr;
code
{
	heartbeat:=PULSE_SEC*3;
	pc:=ghead();
	while (pc.type==UNIT_ST_PC)
	{
		sendtext(s,pc);
		pc:=pc.gnext;
	}
	return;
}
dilend

dilbegin act_launcher (s:string);
var
	pc:unitptr;
code
{
	heartbeat:=PULSE_SEC*3;
	pc:=ghead();
	while (pc.type==UNIT_ST_PC)
	{
		if (pc.level > 200)
			sendtext("<div class='hint'>"+s+" Launched this firework:</div><br/>",pc);
		pc:=pc.gnext;
	}
	return;
}
dilend

dilbegin ast_launch();
var
	pc,rm,temp:unitptr;
code
{
	pc:=self.inside;
	while (pc)
	{
		temp:=pc.next;
		if (pc.type==UNIT_ST_PC)
		{
			sendtext ("The explosion of the rocket throws you clear and you are falling fast.<br/>",pc);
			pc.hp:=0;
			pc.mana:=0;
			pc.endurance:=0;
			position_update (pc);
			rm:=findrndunit(self,FIND_UNIT_WORLD, UNIT_ST_ROOM);
			sendtext ("You hit the ground with a splat!  Ouch that hurt!<br/>",pc);
			if (rm!=null)
				link (pc,rm);
			else
				link (pc,findroom("void@basis"));
		}
		pc:=temp;
	}
	return;
}
dilend

// Christmas's own extras, run by season@function on the workshop: Mrs. Claus comes to
// Udgaard's market on Christmas Day, and when December has ended anyone still in Santa's
// rooms is sent back to the square.
dilbegin xmas_season(inseason : integer);
external
    integer realmmdd@function();
var
    rml : stringlist;
    u : unitptr;
    nxt : unitptr;
    rm : unitptr;
    i : integer;
code
{
    if (inseason)
    {
        // Santa's sleigh on Christmas Eve and Day
        i := realmmdd@function() % 100;
        if ((i == 24) or (i == 25))
        {
            if (findsymbolic("sleigh_elf@holiday22") == null)
            {
                u := load("sleigh_elf@holiday22");
                link(u, findroom("square@udgaard"));
            }
        }
        else
        {
            u := findsymbolic("sleigh_elf@holiday22");
            if (u != null)
                destroy(u);
        }
        if ((i > 24) and
            (findsymbolic("norma@holiday22") == null))
        {
            u := load("norma@holiday22");
            link(u, findroom("market@udgaard"));
            log(u.name + " was loaded and placed in market@udgaard.");
        }
        quit;
    }

    rml := {"study@holiday22", "workshop@holiday22", "yulehall@holiday22"};
    i := 0;
    while (i < length(rml))
    {
        rm := findroom(rml.[i]);
        u := rm.inside;
        while (u != null)
        {
            nxt := u.next;
            if (u.type == UNIT_ST_PC)
            {
                sendtext("Santa's workshop closes for the year, and you find yourself back in Udgaard.<br/>", u);
                link(u, findroom("square@udgaard"));
                exec("look", u);
            }
            u := nxt;
        }
        i := i + 1;
    }
    quit;
}
dilend

// ======================== THE YULE WHEEL ========================
// From December 1 to 24 a spoke of the Yule Wheel turns each day: spoke n is a small task
// in a safe place (yspoke01..24, put out by the season's resets), open from December n for
// seven days. The spokes a player turned are the names "s<n>" of the quest "Yule Wheel
// <year>". With 16 spokes or more a player may wish for a gift: they mail their wish to the
// player Jolnir, a game master reads it and gives it a kind of item with gmyule, and from
// December 24 to 31 the pole takes them to Jolnir's hall, where kneeling makes the gift:
// the rung of the player's level (yule_rung), one lower with fewer than 24 spokes.

// The rung of random treasure a player of level lvl can use: gmtreasure's rungs (randomt's
// level restrictions), and at Yule an artifact (7) from level 100.
dilbegin integer yule_rung(lvl : integer);
external
   integer gm_trquality@commands(lvl : integer);
code
{
   if (lvl >= 100)
      return (BONUS_ARTIFACT);
   return (gm_trquality@commands(lvl));
}
dilend

// This year, for the Yule's quest names ("Yule Wheel 2026") and the store of wishes
dilbegin string yule_year();
code
{
   return (itoa(getinteger(DIL_GINT_REALYEAR, self, 0)));
}
dilend

// The spokes pc has turned this year
dilbegin integer yule_count(pc : unitptr);
external
   string yule_year();
var
   ex : extraptr;
code
{
   ex := ("Yule Wheel " + yule_year()) in pc.quests;
   if (ex == null)
      return (0);
   return (length(ex.names) - 1);
}
dilend

// The quality of Jolnir's gift for a player of level lvl with c spokes, or -1 under 16
// spokes: the rung of their level, one lower with fewer than 24 (T025 pins it)
dilbegin integer yule_q(lvl : integer, c : integer);
external
   integer yule_rung(lvl : integer);
var
   q : integer;
code
{
   if (c < 16)
      return (-1);
   q := yule_rung(lvl);
   if ((c < 24) and (q > 0))
      q := q - 1;
   return (q);
}
dilend

// A quality in words
dilbegin string yule_qname(q : integer);
var
   sl : stringlist;
code
{
   sl := {"an average treasure", "an average-plus treasure", "a good treasure",
          "a good-plus treasure", "an excellent treasure", "an excellent-plus treasure",
          "a superior treasure", "an artifact"};
   if ((q < 0) or (q > 7))
      return ("nothing");
   return (sl.[q]);
}
dilend

// What pc's spokes are worth, in a line or two
dilbegin string yule_ladder(pc : unitptr);
external
   integer yule_q(lvl : integer, c : integer);
   integer yule_count(pc : unitptr);
   string yule_qname(q : integer);
var
   c : integer;
   lvl : integer;
   r : integer;
   lo : integer;
   s : string;
code
{
   c := yule_count(pc);
   lvl := pc.vlevel;
   r := yule_q(lvl, 24);  // all spokes
   lo := yule_q(lvl, 16); // a wish's worth, short of all 24
   s := "You have turned " + itoa(c) + " of the 24 spokes";
   if (c >= 24)
      return ("You have turned all 24 spokes: Jolnir's gift will be " + yule_qname(r) +
              ", the best your level allows.");
   if (c >= 16)
   {
      if (lo == r)
         return (s + ": Jolnir's gift would be " + yule_qname(r) + ", the best your level allows.");
      return (s + ": Jolnir's gift would be " + yule_qname(lo) + ". With all 24 it would be " +
              yule_qname(r) + ".");
   }
   if (lo == r)
      return (s + ". At 16, Jolnir grants you a wish: " + yule_qname(r) + " at your level.");
   return (s + ". At 16, Jolnir grants you a wish: " + yule_qname(lo) + " at your level, and " +
           "with all 24 spokes, " + yule_qname(r) + ".");
}
dilend

// Where spoke n is and what to type there
dilbegin string yule_hint(n : integer);
var
   sl : stringlist;
code
{
   sl := {"In Udgaard's Village Square, the straw Yule goat is hungry: feed goat.",
          "In the Temple of Udgaard, a Yule candle waits to be lit: light candle.",
          "In the Udgaard Market, a Yule bell hangs on a post: ring bell.",
          "In the back room of Udgaard's inn, the Yule log burns: toast yule.",
          "In Mammon's Nest, Udgaard's bank, lies a Yule coin for luck: polish coin.",
          "Up in Udgaard's wooden watchtower, the Yule beacon is dark: light beacon.",
          "In the Forest Clearing of Haon-Dor, west of Udgaard, a young fir is bare: hang star.",
          "In Mary's cabin in Haon-Dor, the Yule porridge simmers: taste porridge.",
          "On the top of the green hill in Haon-Dor, the winter wind sings: listen wind.",
          "On the top of the hill in the Cypress forest, the low sun rises: greet sun.",
          "In the Cypress Tree Circle stands the oldest tree: hug tree.",
          "At the blacksmith's forge in the Cypress forest, Yule nails wait: strike anvil.",
          "On Midgaard's Market Square, the Yule lantern by the obelisk is dark: light lantern.",
          "In the Cathedral Nave of Midgaard, the Yule altar is dressed: bow altar.",
          "Midgaard's Park Pond has frozen over: skate pond.",
          "On Baker Street in Midgaard, gingerbread is baking: smell gingerbread.",
          "In the Midgaard stable, Santa's reindeer rest: pat reindeer.",
          "Outside Midgaard's South Gate lies the Yule log: pull log.",
          "Outside Barnham's Farm, the Yule sheaf for the birds is waiting: hang sheaf.",
          "On Torsbay Square, the carol singers sing: clap singers.",
          "Outside Torsbay's lighthouse, its old lamp is dark: light lamp.",
          "On the gravel beach of Torsbay, a Yule wreath is for the sea: throw wreath.",
          "At the end of the dock in the Mushroom Forest (by ship from Torsbay), spores drift: catch spores.",
          "On Christmas Eve, in the Temple of Udgaard: kneel odin."};
   if ((n < 1) or (n > 24))
      return ("");
   return (sl.[n - 1]);
}
dilend

// A spoke of the Yule Wheel: verb noun turns spoke n, from December n for seven days
dilbegin yule_spoke(n : integer, verb : string, noun : string, msg : string, rmsg : string);
external
   string yule_year();
   integer realmmdd@function();
   integer yule_count(pc : unitptr);
   string yule_ladder(pc : unitptr);
var
   pc : unitptr;
   ex : extraptr;
   sl : stringlist;
   yw : string;
   today : integer;
   day : integer;
code
{
:start:
   wait(SFB_CMD, command(verb) and (noun in argument) and (activator.type == UNIT_ST_PC));
   block;
   pc := activator;
   today := realmmdd@function();
   day := today % 100;
   if (today / 100 != 12)
   {
      act("The Yule Wheel only turns in December.", A_ALWAYS, pc, null, null, TO_CHAR);
      goto start;
   }
   if (day < n)
   {
      act("Not yet: this is spoke " + itoa(n) + " of the Yule Wheel, and it turns on " +
          "December " + itoa(n) + ".", A_ALWAYS, pc, null, null, TO_CHAR);
      goto start;
   }
   if (day > n + 7)
   {
      act("The Yule Wheel has turned past spoke " + itoa(n) + ": a spoke waits only seven days.",
          A_ALWAYS, pc, null, null, TO_CHAR);
      goto start;
   }
   yw := "Yule Wheel " + yule_year();
   ex := yw in pc.quests;
   if (ex == null)
   {
      sl := null;
      addstring(sl, yw);
      addextra(pc.quests, sl, "The spokes of the Yule Wheel you have turned.");
      ex := yw in pc.quests;
   }
   if (("s" + itoa(n)) in ex.names)
   {
      act("You have turned this spoke of the Yule Wheel already.", A_ALWAYS, pc, null, null, TO_CHAR);
      goto start;
   }
   addstring(ex.names, "s" + itoa(n));
   act(msg, A_ALWAYS, pc, null, null, TO_CHAR);
   act(rmsg, A_SOMEONE, pc, null, null, TO_ROOM);
   act("<div class='cpg'>Spoke " + itoa(n) + " of the Yule Wheel turns.</div> " + yule_ladder(pc),
       A_ALWAYS, pc, null, null, TO_CHAR);
   log(pc.name + " turned spoke " + itoa(n) + " of the Yule Wheel (" + itoa(yule_count(pc)) + ").");
   goto start;
}
dilend

// The Yule Wheel in Udgaard's square: look wheel shows today's spoke, the open ones, what
// the player's spokes are worth, and how to wish
dilbegin yule_wheel();
external
   string yule_year();
   integer realmmdd@function();
   string yule_ladder(pc : unitptr);
   string yule_hint(n : integer);
var
   pc : unitptr;
   ex : extraptr;
   s : string;
   today : integer;
   day : integer;
   i : integer;
code
{
:start:
   wait(SFB_CMD, command("look") and ("wheel" in argument) and (activator.type == UNIT_ST_PC));
   block;
   pc := activator;
   today := realmmdd@function();
   day := today % 100;
   s := "The Yule Wheel, the year's wheel, turns one spoke a day from December 1 to 24. " +
        "Each spoke is a small task somewhere in the world, and waits seven days.<br/>";
   if ((today / 100 == 12) and (day <= 31))
   {
      ex := ("Yule Wheel " + yule_year()) in pc.quests;
      i := day - 7;
      if (i < 1)
         i := 1;
      while ((i <= day) and (i <= 24))
      {
         if (ex == null)
            s := s + "<br/>Spoke " + itoa(i) + ": " + yule_hint(i);
         else if (not (("s" + itoa(i)) in ex.names))
            s := s + "<br/>Spoke " + itoa(i) + ": " + yule_hint(i);
         i := i + 1;
      }
      s := s + "<br/>";
   }
   s := s + "<br/>" + yule_ladder(pc) + "<br/><br/>Tell Jolnir your wish by letter: at a post " +
        "office, type write, write your wish, end with @, then mail paper jolnir. He reads every " +
        "letter, and grants one gift. From December 24 to 31, touch the pole in Udgaard's square, " +
        "and Jolnir will see you.<br/>";
   sendtext(s, pc);
   goto start;
}
dilend

// Jolnir, the Yule one, in his hall: kneel, and he makes the gift. Its kind is the game
// master's reading of the wish (gmyule), or any; its quality yule_quality's.
dilbegin jolnir_gift();
external
   integer yule_q(lvl : integer, c : integer);
   integer yule_count(pc : unitptr);
   string yule_qname(q : integer);
   string yule_year();
var
   pc : unitptr;
   u : unitptr;
   cont : unitptr;
   ex : extraptr;
   sl : stringlist;
   yg : string;
   kind : string;
   line : string;
   q : integer;
   c : integer;
code
{
:start:
   wait(SFB_CMD, command("kneel") and (activator.type == UNIT_ST_PC));
   block;
   pc := activator;
   secure(pc, lost);
   yg := "Yule Gift " + yule_year();
   if (yg in pc.quests)
   {
      exec("say You have had my gift this Yule, " + pc.name + ".", self);
      goto home;
   }
   q := pc.vlevel;
   c := yule_count(pc);
   q := yule_q(q, c);
   if (q < 0)
   {
      exec("say Sixteen spokes of the wheel earn a wish, " + pc.name + ". Come back next Yule.", self);
      goto home;
   }

   kind := "any";
   line := "";
   cont := restore("yulewishes" + yule_year(), null);
   if (cont != null)
   {
      ex := tolower(pc.name) in cont.extra;
      if (ex != null)
      {
         sl := split(ex.descr, "|");
         kind := sl.[0];
         if (length(sl) > 1)
            line := sl.[1];
      }
      destroy(cont);
   }
   if (kind == "")
      kind := "any";

   // Made as gmtreasure makes it: randomt keeps its rolls on the item's first extra, so the
   // runes and the binding wait until it's done
   u := load("treasure@randomt");
   link(u, pc);
   addextra(u.extra, {"$treasure_height"}, itoa(pc.height));
   dilcopy("Treasure@randomt(" + itoa(q) + "," + replace(",", " ", kind) + ")", u);
   secure(u, made);
   pause;
   if (line != "")
      addextra(u.extra, {"runes", "inscription"}, "Runes run along it: '" + line + "' Jolnir's Yule gift to " + pc.name + ".");
   dilcopy("ply_restrict@function(" + pc.name + ",0,25,holiday_burn@holiday22)", u);
   unsecure(u);
:made:
   sl := null;
   addstring(sl, yg);
   addextra(pc.quests, sl, "Jolnir's Yule gift: " + yule_qname(q) + ".");
   act("Jolnir lays his hand on your head, and something heavy settles into your pack.",
       A_ALWAYS, pc, null, null, TO_CHAR);
   act("Jolnir lays his hand on $1n's head.", A_SOMEONE, pc, null, null, TO_ROOM);
   if (line != "")
      exec("say " + line, self);
   else
      exec("say A good Yule to you, " + pc.name + ".", self);
   log(pc.name + " received Jolnir's Yule gift: " + yule_qname(q) + ", " + kind + ".");

:home:
   pause;
   pause;
   act("The fire flares, the hall fades, and you stand in Udgaard's square again.",
       A_ALWAYS, pc, null, null, TO_CHAR);
   link(pc, findroom("square@udgaard"));
   exec("look", pc);
   unsecure(pc);
   goto start;

:lost:
   unsecure(pc);
   goto start;
}
dilend

/* gmyule <player> <kind of item> : <a line from Jolnir>: the game master's reading of a
 * player's Yule wish (mailed to the player Jolnir). Jolnir makes the gift when the player
 * kneels before him, December 24 to 31 (jolnir_gift@holiday22): this kind ("ring", "long
 * sword", "plate boots", or "any"), the line carved on it, and the quality the Yule Wheel
 * gives, never chosen here. gmyule <player> shows it, gmyule <player> clear removes it,
 * gmyule list shows them all. Kept with store(), so a reboot doesn't lose them; it lives in
 * this zone, as jolnir_gift does, so both read and write the same file (store() and
 * restore() use the zone's own directory). */
dilbegin gmyule(arg : string);
external
   string yule_year();
var
   cont : unitptr;
   ex : extraptr;
   sl : stringlist;
   w : string;
   pname : string;
   kind : string;
   line : string;
   wkey : string;
   s : string;
   i : integer;
code
{
   if (self.type != UNIT_ST_PC)
      quit;

   wkey := "yulewishes" + yule_year();
   w := getword(arg);
   if (w == "")
   {
      sendtext("Usage: gmyule &lt;player&gt; &lt;kind of item&gt; : &lt;a line from Jolnir&gt;, " +
               "gmyule &lt;player&gt; [clear], gmyule list<br/>", self);
      quit;
   }

   cont := restore(wkey, null);
   if (w == "list")
   {
      s := "";
      if (cont != null)
      {
         ex := cont.extra;
         while (ex != null)
         {
            if (length(ex.names) > 0) // the envelope's own description has no names
               s := s + "  " + ex.names.[0] + ": " + replace("|", " : ", ex.descr) + "<br/>";
            ex := ex.next;
         }
         destroy(cont);
      }
      if (s == "")
         s := "  none yet<br/>";
      sendtext("Yule wishes read:<br/>" + s, self);
      quit;
   }

   pname := tolower(w);
   if (not isplayer(pname))
   {
      if (cont != null)
         destroy(cont);
      sendtext("No player called " + w + ".<br/>", self);
      quit;
   }

   if ((arg == "") or (arg == "clear"))
   {
      ex := null;
      if (cont != null)
         ex := pname in cont.extra;
      if (arg == "")
      {
         if (ex == null)
            sendtext(w + "'s wish isn't read yet: Jolnir would give any kind.<br/>", self);
         else
            sendtext(w + ": " + replace("|", " : ", ex.descr) + "<br/>", self);
      }
      else if (ex != null)
      {
         subextra(cont.extra, pname);
         store(cont, wkey, TRUE);
         sendtext(w + "'s wish is cleared.<br/>", self);
      }
      if (cont != null)
         destroy(cont);
      quit;
   }

   sl := split(arg, ":");
   kind := sl.[0];
   line := "";
   i := 1;
   while (i < length(sl))
   {
      if (line != "")
         line := line + ": ";
      line := line + sl.[i];
      i := i + 1;
   }
   if (kind == "")
      kind := "any";
   line := replace("|", "/", line);

   if (cont == null)
      cont := load("envelope@mail");
   subextra(cont.extra, pname);
   sl := null;
   addstring(sl, pname);
   addextra(cont.extra, sl, kind + "|" + line);
   store(cont, wkey, TRUE);
   destroy(cont);
   sendtext("Jolnir will give " + w + " " + kind + ", with the words: " + line + "<br/>", self);
   quit;
}
dilend

%rooms

study
title "Santa's Study"
descr
"You are in Santa's study, a large room with books and list neatly arranged
in stacks and piles. It seems it is here he makes his list of those that are
bad or good. You certainly hope he finds your name on the good list!"

flags {UNIT_FL_NO_WEATHER, UNIT_FL_INDOORS, UNIT_FL_NO_TELEPORT}
ALWAYS_LIGHT
east to workshop;
end

workshop
title "Santa's Workshop"
descr
"You are in Santa's work shop, a huge building that is round in shape. Weird
contraptions, run by elves, are busy at work making toys and gifts.
Apparently the treasures are beyond the reach of mere mortals."

flags {UNIT_FL_NO_WEATHER, UNIT_FL_INDOORS, UNIT_FL_NO_TELEPORT}
ALWAYS_LIGHT
west to study;

dilbegin init_xmas();
external
   	xmas_initialize();
code
{
    xmas_initialize(); // JIC someone resets the zone
    quit;
}
dilend

// December: the zone resets every 25 minutes; when it ends, what it put out is taken away.
dilcopy season@function(12, 1, 12, 31, 25,
                        {"santa@holiday22", "elf@holiday22", "norma@holiday22",
                         "graf_jan@holiday22", "northpole@holiday22", "xmas_tree@holiday22",
                         "xmas_tree2@holiday22", "mistletoe@holiday22",
                         "yule_wheel@holiday22", "jolnir@holiday22", "sleigh_elf@holiday22", "sleigh@holiday22",
                         "sleigh_driver@holiday22", "yspoke01@holiday22",
                         "yspoke02@holiday22", "yspoke03@holiday22", "yspoke04@holiday22",
                         "yspoke05@holiday22", "yspoke06@holiday22", "yspoke07@holiday22",
                         "yspoke08@holiday22", "yspoke09@holiday22", "yspoke10@holiday22",
                         "yspoke11@holiday22", "yspoke12@holiday22", "yspoke13@holiday22",
                         "yspoke14@holiday22", "yspoke15@holiday22", "yspoke16@holiday22",
                         "yspoke17@holiday22", "yspoke18@holiday22", "yspoke19@holiday22",
                         "yspoke20@holiday22", "yspoke21@holiday22", "yspoke22@holiday22",
                         "yspoke23@holiday22", "yspoke24@holiday22"},
                        "xmas_season@holiday22");
end

sky
title "High Above the World"
descr
"   The sleigh races through the night, high above the clouds. Below, the world
lies white and quiet, and the stars seem close enough to touch."
movement SECT_FIELD
flags {UNIT_FL_NO_WEATHER, UNIT_FL_NOSAVE, UNIT_FL_NO_TELEPORT}
light 5
end

yulehall
title "Jolnir's Yule Hall"
descr
"A long hall of smoke-dark timber, lit by a great fire. On a high seat at its
end sits an old man in a blue cloak: Jolnir, the Yule one. Kneel before him to
receive his gift."
movement SECT_INSIDE
flags {UNIT_FL_NO_TELEPORT, UNIT_FL_INDOORS, UNIT_FL_NOSAVE}
end

