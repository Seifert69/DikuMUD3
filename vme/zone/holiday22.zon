sleigh_elf
names {"sleigh elf", "elf", "sleigh"}
title "the sleigh elf"
descr "An elf in red and green holds the reins of Santa's sleigh: list, then hire sky."
extra {}
"A bright-eyed elf with frost in her hair. On Christmas Eve and Christmas Day she takes anyone up
in Santa's sleigh, for a ride over the whole world and back. Type list, then hire sky."
alignment +1000
level 150
sex SEX_FEMALE
weight 60
height 120
exp 110
XMAS_SPIRIT
flags {UNIT_FL_NO_TELEPORT}
dilcopy spirit_nokill();
dilcopy hire_ship@function("square@udgaard",
   {"sky", "1", "1", "square@udgaard"},
   "sleigh@holiday22", "sleigh_driver@holiday22", "sky@holiday22",
   {"unknown The sleigh only goes one way: up! Type hire sky.",
    "busy The sleigh is up in the sky. It will be back soon.",
    "shake Maybe next Christmas, then.",
    "poor Just one iron piece, for the reindeer's oats.",
    "noexit You can't get out of the sleigh up here in the sky!",
    "depart $1n shakes the reins, the bells ring out, and the sleigh leaps into the sky.",
    "land The lights of Udgaard twinkle below as the sleigh comes down.",
    "dock The sleigh lands softly in Udgaard's square, its bells ringing.",
    "sea Far below, Midgaard's towers glitter with Yule lanterns.",
    "sea You drop a present down the chimney of a sleeping village.",
    "sea The beam of Torsbay's lighthouse sweeps the dark sea beneath you.",
    "sea Over the Mushroom Forest, glowing spores rise to meet the sleigh.",
    "sea The northern lights ripple green and violet across the sky.",
    "sea The reindeer's bells ring out over the snowy forests."});
end

