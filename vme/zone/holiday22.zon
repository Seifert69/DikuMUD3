yule_wheel
names {"yule wheel", "wheel"}
title "the Yule Wheel"
descr "A great wooden Yule Wheel stands in the square, its 24 spokes hung with candles."
extra {}
"The year's wheel: one spoke turns each day from December 1 to 24. Look at the wheel to see today's spoke."
type ITEM_OTHER
weight 5000
dilcopy yule_wheel@holiday22();
end

yspoke01
names {"straw goat", "yule goat", "goat"}
title "a straw Yule goat"
descr "A straw Yule goat, tied with red ribbon, stands here looking hungry."
extra {}
"A goat of plaited straw, as tall as a child, its horns bound in red ribbon. An old Yule custom: someone has to feed it."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(1, "feed", "goat", "You feed the straw Yule goat a handful of oats. Its straw eyes seem to twinkle.", "$1n feeds the straw Yule goat a handful of oats.");
end

yspoke02
names {"yule candle", "candle"}
title "a Yule candle"
descr "A tall Yule candle stands unlit by the altar."
extra {}
"A thick candle of beeswax, carved with the twelve days of Yule. It waits to be lit."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(2, "light", "candle", "You light the Yule candle. Its warm light reaches every corner of the temple.", "$1n lights the Yule candle, and warm light fills the temple.");
end

yspoke03
names {"yule bell", "bell"}
title "a Yule bell"
descr "A bronze Yule bell hangs on a post here."
extra {}
"An old bronze bell on a carved post, rung for luck at Yule."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(3, "ring", "bell", "You ring the Yule bell, and its clear note carries over the market.", "$1n rings the Yule bell, and its clear note carries over the market.");
end

yspoke04
names {"yule log", "log", "yule"}
title "the Yule log"
descr "The Yule log burns slowly in the hearth."
extra {}
"A great oak log, set to burn through all the twelve nights of Yule. The guests raise their mugs to it."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(4, "toast", "yule", "You raise your mug and toast the Yule. Around you, the guests cheer.", "$1n raises a mug and toasts the Yule.");
end

yspoke05
names {"yule coin", "coin"}
title "a Yule coin"
descr "A tarnished Yule coin lies in a bowl on the counter."
extra {}
"An old silver coin stamped with a sun wheel, kept for Yule luck. It could do with a polish."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(5, "polish", "coin", "You polish the Yule coin until the sun wheel on it shines.", "$1n polishes the old Yule coin until it shines.");
end

yspoke06
names {"yule beacon", "beacon"}
title "the Yule beacon"
descr "A dark iron beacon stands ready on the watchtower."
extra {}
"An iron basket of pitch-soaked wood, lit at Yule to tell the countryside the light is coming back."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(6, "light", "beacon", "You light the Yule beacon, and its fire leaps up against the winter sky.", "$1n lights the Yule beacon, and its fire leaps up against the sky.");
end

yspoke07
names {"young fir", "fir", "stars", "star"}
title "a young fir"
descr "A young fir stands bare in the clearing, a pile of glass stars at its foot."
extra {}
"A slender fir, just right for decorating. Someone has left a pile of glass stars beside it."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(7, "hang", "star", "You hang a glass star on the young fir. It catches the light like ice.", "$1n hangs a glass star on the young fir.");
end

yspoke08
names {"porridge pot", "porridge", "pot"}
title "a pot of Yule porridge"
descr "A pot of Yule porridge simmers on the stove."
extra {}
"Rice porridge with cinnamon, made for Yule. Somewhere in it hides a single almond."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(8, "taste", "porridge", "You taste Mary's Yule porridge. Sweet and warm, with a hint of cinnamon.", "$1n tastes the Yule porridge and smiles.");
end

yspoke09
names {"winter wind", "wind"}
title "the winter wind"
descr "The winter wind sings over the hilltop."
extra {}
"The wind sweeps over the green hill, and if you listen, it seems to carry voices."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(9, "listen", "wind", "You listen to the winter wind. Far away, the Wild Hunt rides across the sky.", "$1n stands very still, listening to the wind.");
end

yspoke10
names {"low sun", "sun"}
title "the low winter sun"
descr "The low winter sun hangs over the trees."
extra {}
"The sun barely clears the treetops this time of year. From now on, the days grow longer."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(10, "greet", "sun", "You greet the returning sun. Its pale light warms your face.", "$1n greets the low winter sun.");
end

yspoke11
names {"oldest cypress", "oldest tree", "tree"}
title "the oldest cypress"
descr "The oldest cypress in the circle is hung with ribbons."
extra {}
"Older than anyone remembers, its trunk hung with ribbons left by those who came before."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(11, "hug", "tree", "You hug the oldest cypress. The bark is rough and the tree feels very old and very patient.", "$1n hugs the oldest cypress in the circle.");
end

yspoke12
names {"yule nails", "nails", "anvil"}
title "Yule nails on the anvil"
descr "Yule nails lie ready on the anvil."
extra {}
"Iron nails for the Yule log, to be struck once each for luck."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(12, "strike", "anvil", "You strike the anvil, and the Yule nails ring like a bell.", "$1n strikes the anvil, and the Yule nails ring.");
end

yspoke13
names {"yule lantern", "lantern"}
title "a Yule lantern"
descr "An unlit Yule lantern hangs by the obelisk."
extra {}
"A lantern of red glass, hung by the obelisk for Yule. It waits for a flame."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(13, "light", "lantern", "You light the Yule lantern, and red light spills over the square.", "$1n lights the Yule lantern, and red light spills over the square.");
end

yspoke14
names {"yule altar", "altar"}
title "the Yule altar"
descr "The altar is dressed in evergreen for Yule."
extra {}
"Boughs of fir and holly cover the altar, and candles burn among them."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(14, "bow", "altar", "You bow before the Yule altar. For a moment, the cathedral is very quiet.", "$1n bows before the Yule altar.");
end

yspoke15
names {"frozen pond", "pond", "ice"}
title "the frozen pond"
descr "The park pond has frozen over, smooth as glass."
extra {}
"Thick, clear ice. Children have been sliding on it all morning."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(15, "skate", "pond", "You slide across the frozen pond, arms wide, and nearly keep your balance.", "$1n slides across the frozen pond, arms wide.");
end

yspoke16
names {"gingerbread", "smell"}
title "the smell of gingerbread"
descr "The smell of gingerbread fills the street."
extra {}
"From a bakery window comes the smell of ginger, honey and cloves."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(16, "smell", "gingerbread", "You breathe in the smell of gingerbread. It smells exactly like Yule.", "$1n breathes in deeply, smelling the gingerbread.");
end

yspoke17
names {"reindeer", "deer"}
title "a resting reindeer"
descr "One of Santa's reindeer rests here, steaming gently."
extra {}
"A reindeer with a frosty muzzle and a bell on its harness, resting before the long night."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(17, "pat", "reindeer", "You pat the reindeer. It nuzzles your hand and its bell jingles.", "$1n pats the reindeer, and its bell jingles.");
end

yspoke18
names {"yule log", "log"}
title "a Yule log"
descr "A great Yule log lies here, waiting to be hauled into town."
extra {}
"A huge log of oak, wrapped in a rope for hauling to a hearth."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(18, "pull", "log", "You take the rope and haul the Yule log a few steps toward town. Others will pull it further.", "$1n hauls the Yule log a few steps toward town.");
end

yspoke19
names {"yule sheaf", "sheaf", "pole"}
title "a sheaf on a pole"
descr "A sheaf of oats is ready to go up on a pole for the birds."
extra {}
"An old Yule custom: a sheaf of oats on a pole, so the birds have a feast too."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(19, "hang", "sheaf", "You hang the Yule sheaf on its pole. At once, the sparrows come.", "$1n hangs the Yule sheaf on its pole, and the sparrows come.");
end

yspoke20
names {"carol singers", "singers"}
title "the carol singers"
descr "Carol singers stand in the square, singing for Yule."
extra {}
"A group of sailors and their families, singing old Yule songs in the cold."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(20, "clap", "singers", "You clap for the carol singers. They bow and start another verse.", "$1n claps for the carol singers.");
end

yspoke21
names {"lighthouse lamp", "lamp"}
title "the lighthouse lamp"
descr "The old lighthouse lamp stands dark."
extra {}
"A great lamp of brass and glass. On Yule night, someone keeps it lit for the ships at sea."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(21, "light", "lamp", "You light the old lamp, and its beam sweeps out over the dark sea.", "$1n lights the old lighthouse lamp.");
end

yspoke22
names {"yule wreath", "wreath"}
title "a Yule wreath"
descr "A wreath of fir lies on the stones, meant for the sea."
extra {}
"Sailors give a wreath to the sea at Yule, for the ones who didn't come home."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(22, "throw", "wreath", "You throw the Yule wreath into the sea. The waves carry it out, slowly.", "$1n throws a Yule wreath into the sea.");
end

yspoke23
names {"drifting spores", "spores"}
title "drifting spores"
descr "Glowing spores drift over the end of the dock."
extra {}
"Tiny lights drift down from the giant mushrooms. They say catching one brings a good year."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(23, "catch", "spores", "You catch a glowing spore. It warms your hand for a moment, then fades.", "$1n catches a glowing spore.");
end

yspoke24
names {"yule fire", "fire"}
title "the Yule fire before Odin"
descr "A small Yule fire burns before Odin's statue."
extra {}
"On Christmas Eve, a fire is lit before Odin, Jolnir, the Yule one. People kneel to him tonight."
type ITEM_OTHER
weight 1000
dilcopy yule_spoke@holiday22(24, "kneel", "odin", "You kneel before Odin. The Yule fire flares, and for a moment his stone eye seems to look at you.", "$1n kneels before the statue of Odin.");
end

